*.log

# WSL base image cache and test instance.
files/.wsl-*

id_ed25519
id_rsa
*.pem

files/config/instances/

# nix-backup rollback snapshots: whole-payload tarballs, secrets included.
files/config/snapshots/
files/config/.backup.lock

files/config/shared/gitconfig/
files/config/shared/shell/
# Cleartext tokens copied here by `nix-backup`.
files/config/shared/secrets/
# A filled-in provisioning config carries the same tokens in cleartext.
files/config/user_data.yaml
files/config/shared/ssh/*
!files/config/shared/ssh/keys/
files/config/shared/ssh/keys/*
!files/config/shared/ssh/keys/.gitkeep

# Claude Code agent scratch.
.claude/
nixos.wsl
