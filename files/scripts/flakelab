#!/usr/bin/env zsh

set -uo pipefail

#
# flakelab — the single entrypoint for this repo's distro commands.
#
# It is a ROUTER, not an implementation. Every subcommand below is still its own
# file in this directory (or, for `clone`, still generated by nix/scripts.nix);
# this script only picks one and execs it. That is deliberate: the per-command
# nix wrappers in nix/scripts.nix each pin their own PATH and export their own
# environment (FLAKELAB_REPO_ROOT, FLAKELAB_BACKUP_ROOT, FLAKELAB_KIRO_PLUGIN_*),
# and the safest way to keep every subcommand's environment byte-identical to
# what it had as a standalone command is to keep running THOSE wrappers.
#
# Two resolution modes, and they must stay behaviourally equivalent:
#
#   installed  FLAKELAB_DISPATCH_DIR is set (nix/cli.nix points it at a
#              symlinkJoin of the per-command wrappers). The target is
#              $FLAKELAB_DISPATCH_DIR/<wrapper>, i.e. exactly the binary that
#              used to be on PATH under its old name.
#   checkout   No dispatch dir: run the sibling script directly, the way
#              `./files/scripts/<name>` always worked. The scripts derive the
#              repo root from ${0:A:h:h:h}, and since the sibling still lives in
#              files/scripts/ that derivation is unchanged.
#
# This script deliberately calls NO external binary — only zsh builtins — so it
# does not need a pinned PATH of its own and therefore cannot perturb the
# environment the subcommand's own wrapper sets up.
#
# Usage:
#   flakelab <command> [args...]
#   flakelab --help
#

_self="${0:t}"

# --- the command table -------------------------------------------------------
# Order here is the order `--help` prints. Four parallel maps keyed by
# subcommand: the wrapper name to exec in installed mode, the sibling script to
# exec in checkout mode, any arguments pinned ahead of the caller's, and the
# one-line description.
#
# `update-all` is the one entry where the two modes differ in shape, exactly as
# they do today: the installed wrapper `nix-update-all` already bakes in --all,
# so installed mode must NOT add it again, while checkout mode has no such file
# and passes --all to `nix-update` itself. `_args` therefore applies in checkout
# mode ONLY — see the dispatch at the bottom. Both end up running nix-update
# with --all exactly once.
_order=(
  update
  update-all
  doctor
  backup
  clone
  provision
  overlay-gen
  build-distro
  test-provision
  distro-name
  clone-repos
  activate-hooks
  stale-repos
  glab-projects
)

typeset -A _bin _file _args _desc

_bin=(
  update          nix-update
  update-all      nix-update-all
  doctor          nix-doctor
  backup          nix-backup
  clone           nix-clone-repos
  provision       nix-provision
  overlay-gen     nix-overlay-generate
  build-distro    build-dev-wsl-nix
  test-provision  test-provision-nix
  distro-name     get_current_wsl_distro_name
  clone-repos     clone-repos
  activate-hooks  activate-hooks
  stale-repos     report-stale-repos
  glab-projects   glab-group-projects
)

# Empty value = no sibling script, so checkout mode cannot serve it. `clone` is
# the only one: nix-clone-repos is GENERATED by nix/scripts.nix out of the
# configured gitlabGroups/repos, so no file for it exists in this directory.
_file=(
  update          nix-update
  update-all      nix-update
  doctor          nix-doctor
  backup          nix-backup
  clone           ''
  provision       nix-provision
  overlay-gen     nix-overlay-generate
  build-distro    build-dev-wsl-nix
  test-provision  test-provision-nix
  distro-name     get_current_wsl_distro_name
  clone-repos     clone-repos
  activate-hooks  activate-hooks
  stale-repos     report-stale-repos
  glab-projects   glab-group-projects
)

_args=(
  update          ''
  update-all      '--all'
  doctor          ''
  backup          ''
  clone           ''
  provision       ''
  overlay-gen     ''
  build-distro    ''
  test-provision  ''
  distro-name     ''
  clone-repos     ''
  activate-hooks  ''
  stale-repos     ''
  glab-projects   ''
)

_desc=(
  update          'rebuild THIS distro from the configured flake + overlay'
  update-all      'update, then re-run the GitLab clone sweep'
  doctor          'diagnose this distro and print what to run next'
  backup          'back up home-dir data to the Windows mount (--restore to read it back)'
  clone           'discover and clone the configured GitLab groups and repos'
  provision       'drive the Windows provisioning script from inside WSL'
  overlay-gen     'scaffold a private flakelab overlay from a user_data.yaml'
  build-distro    'build a THROWAWAY dev distro from this flake (interop-wiping)'
  test-provision  'end-to-end provisioning test in a throwaway distro (interop-wiping)'
  distro-name     'print this distro'\''s WSL name'
  clone-repos     'plumbing: clone the repo list arriving on stdin'
  activate-hooks  'plumbing: install pre-commit hooks across a repos dir'
  stale-repos     'plumbing: report archived/deletion-scheduled clones still on disk'
  glab-projects   'plumbing: list a GitLab group'\''s projects as NDJSON'
)

# --- help --------------------------------------------------------------------
usage() {
  print -r -- "${_self} - one entrypoint for the flakelab distro commands"
  print -r -- ""
  print -r -- "  ${_self} <command> [args...]"
  print -r -- ""
  print -r -- "Commands:"
  local c
  for c in ${_order}; do
    printf '  %-15s %s\n' "$c" "${_desc[$c]}"
  done
  print -r -- ""
  print -r -- "Every command takes its own flags; ${_self} <command> --help shows them."
  print -r -- "gitchecker, gitcleaner and gitpublisher stay standalone commands."
}

# --- did-you-mean ------------------------------------------------------------
# Levenshtein distance, pure zsh arithmetic so the router keeps needing no
# external binary. prev[k] holds D[i-1][k-1]; zsh arrays are 1-indexed, hence
# the +1 offsets throughout.
_lev() {
  local a="$1" b="$2"
  local -i i j la=${#1} lb=${#2} cost d
  local -a prev cur
  prev=( {0..$lb} )
  for (( i = 1; i <= la; i++ )); do
    cur=( $i )
    for (( j = 1; j <= lb; j++ )); do
      if [[ "${a[i]}" == "${b[j]}" ]]; then cost=0; else cost=1; fi
      d=$(( prev[j+1] + 1 ))
      (( cur[j] + 1 < d )) && d=$(( cur[j] + 1 ))
      (( prev[j] + cost < d )) && d=$(( prev[j] + cost ))
      cur+=( $d )
    done
    prev=( ${cur} )
  done
  print -r -- ${prev[lb+1]}
}

# Best match wins, and only if it is actually close: a prefix of a real command
# ("flakelab up"), or within two edits of one. Anything further away gets the
# plain command list rather than a misleading guess.
_suggest() {
  local want="$1" c best="" ; local -i d bestd=3
  for c in ${_order}; do
    if [[ "$c" == "${want}"* ]]; then
      print -r -- "$c"
      return 0
    fi
  done
  for c in ${_order}; do
    d=$(_lev "$want" "$c")
    if (( d < bestd )); then
      bestd=$d
      best="$c"
    fi
  done
  [[ -n "$best" ]] && print -r -- "$best"
  return 0
}

# --- argument handling -------------------------------------------------------
# No arguments and --help both print the list. No arguments exits 0: the plan
# calls for a listing, and a bare `flakelab` is a question, not an error.
if (( $# == 0 )); then
  usage
  exit 0
fi

case "$1" in
  -h|--help|help)
    usage
    exit 0
    ;;
esac

_cmd="$1"
shift

if [[ -z "${_bin[$_cmd]:-}" ]]; then
  print -ru2 -- "${_self}: unknown command: ${_cmd}"
  _guess="$(_suggest "$_cmd")"
  [[ -n "$_guess" ]] && print -ru2 -- "${_self}: did you mean '${_guess}'?"
  print -ru2 -- ""
  usage >&2
  exit 2
fi

# --- dispatch ----------------------------------------------------------------
# Installed mode: exec the wrapper verbatim. No `_args` here — the wrapper name
# in `_bin` already encodes them (`nix-update-all` is `nix-update --all`), so
# adding them again would hand nix-update `--all --all`.
if [[ -n "${FLAKELAB_DISPATCH_DIR:-}" ]]; then
  _target="${FLAKELAB_DISPATCH_DIR}/${_bin[$_cmd]}"
  if [[ ! -x "$_target" ]]; then
    print -ru2 -- "${_self}: ${_cmd}: no executable at ${_target}"
    exit 1
  fi
  exec "$_target" "$@"
fi

# Checkout mode: the sibling script, with `_args` prepended because there is no
# wrapper here to have baked them in.
_extra=( ${=_args[$_cmd]} )

if [[ -z "${_file[$_cmd]}" ]]; then
  print -ru2 -- "${_self}: ${_cmd} is generated by nix/scripts.nix from the configured"
  print -ru2 -- "${_self}: gitlabGroups/repos, so it only exists on an installed distro."
  print -ru2 -- "${_self}: rebuild with '${_self} update', then re-run '${_self} ${_cmd}'."
  exit 1
fi

_target="${0:A:h}/${_file[$_cmd]}"
if [[ ! -x "$_target" ]]; then
  print -ru2 -- "${_self}: ${_cmd}: no executable at ${_target}"
  exit 1
fi
exec "$_target" ${_extra} "$@"
