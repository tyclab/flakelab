#!/usr/bin/env zsh

set -uo pipefail

# Offline suite for `flakelab web` (files/scripts/web, files/scripts/lib/web.py):
# the server on 127.0.0.1 with a free port, stand-ins for `accounts` and
# `claude-sessions` that answer canned JSON and record what they were asked,
# and curl as the client. No real tool, no network beyond loopback.
#
# Usage: files/scripts/test-web

SCRIPT_DIR="${0:A:h}"
CMD="${SCRIPT_DIR}/web"
SERVER="${SCRIPT_DIR}/lib/web.py"
typeset -i PASS=0 FAIL=0

ok()       { print -r -- "  ok   $1"; (( PASS++ )); return 0 }
bad()      { print -r -u2 -- "  FAIL $1"; (( FAIL++ )); return 0 }
check()    { [[ "$2" == "$3" ]] && ok "$1" || { bad "$1"; print -r -u2 -- "       expected: $3"; print -r -u2 -- "       actual:   $2" } }
contains() { [[ "$2" == *"$3"* ]] && ok "$1" || { bad "$1"; print -r -u2 -- "       missing: $3"; print -r -u2 -- "       in: $2" } }
excludes() { [[ "$2" != *"$3"* ]] && ok "$1" || bad "$1 (unexpected: $3)" }

BASE="$(mktemp -d)"
SERVER_PID=""
trap '[[ -n "${SERVER_PID}" ]] && kill "${SERVER_PID}" 2>/dev/null; rm -rf "${BASE}"' EXIT
export HOME="${BASE}/home"
mkdir -p "${HOME}" "${BASE}/bin" "${BASE}/static"
LOG="${BASE}/calls.log"
export FAKE_LOG="${LOG}"

# The accounts stand-in.
cat > "${BASE}/bin/accounts" <<'STUB'
#!/usr/bin/env zsh
print -r -- "accounts $*" >> "${FAKE_LOG}"
ROSTER='{"version":1,"active":{"claude":2},"accounts":[{"id":1,"tool":"claude","alias":"home","label":"a@example.com","usage":{"windows":[{"label":"5h","class":"session","pct":20}],"fetchedAt":1}},{"id":2,"tool":"claude","alias":"work","label":"b@example.com","usage":{"windows":[]}}]}'
case "$1" in
  --json) print -r -- "$ROSTER" ;;
  --fetch) print -r -- "$ROSTER" ;;
  status) print -r -- '{"claude":{"active":{"id":2,"alias":"work"},"live":{"account":"x"},"matches":false}}' ;;
  switch) [[ "$2" == 9 ]] && { print -ru2 -- "Error: entry 9 is running in a profile session"; exit 2 }; print -r -- "Switched claude to $2" ;;
  auto) print -r -- '{"event":"poll","tool":"claude"}'; print -r -- '{"event":"switch","tool":"claude","from":2,"to":1,"trigger":"proactive","dryRun":true}' ;;
  config)
    case "$2" in
      --json) print -r -- '{"path":"/s/settings.json","settings":{"weekThreshold":{"value":92,"source":"runtime","base":97,"baseSource":"flake"},"autoSwitch":{"value":true,"source":"runtime","base":false,"baseSource":"flake"}},"ignored":[]}' ;;
      set) [[ "$3" == bogus ]] && { print -ru2 -- "Error: unknown setting 'bogus'"; exit 2 }; print -r -- "$3 = $4 (runtime; flake 97); the next auto tick uses it" ;;
      unset) print -r -- "$3 = 97 again (flake)" ;;
    esac ;;
  log) print -r -- '{"event":"poll","tool":"claude","ts":"2025-09-25T11:33:20Z"}'; print -r -- '{"event":"no-switch","tool":"claude","reason":"cooldown","ts":"2025-09-25T11:33:20Z"}' ;;
  *) exit 2 ;;
esac
STUB
# The sessions stand-in.
cat > "${BASE}/bin/claude-sessions" <<'STUB'
#!/usr/bin/env zsh
print -r -- "claude-sessions $*" >> "${FAKE_LOG}"
case "$1" in
  --json) print -r -- '[{"tool":"claude","pid":100,"age":"2h01m","session":"11111111-2222-3333-4444-555555555555","host":{"session":"agents","window":"claude-work","id":"@1"},"dir":"/w"}]' ;;
  --start) print -r -- "started $2 in $3" ;;
  *) exit 2 ;;
esac
STUB
chmod +x "${BASE}/bin/"*
print -r -- '<!doctype html><title>flakelab</title><p>dashboard' > "${BASE}/static/index.html"

typeset -i RC=0
OUT=""; ERR=""
run() { OUT="$("${CMD}" "$@" 2>"${BASE}/err" </dev/null)"; RC=$?; ERR="$(<"${BASE}/err")"; }

print -r -- "the wrapper"
run --help
check "--help exits 0" "${RC}" "0"
run --bogus
check "an unknown option exits 2" "${RC}" "2"
run --port 0
check "a port outside 1-65535 is refused" "${RC}" "2"
run --bind 0.0.0.0
check "binding every interface is refused" "${RC}" "2"
contains "with the address to name instead" "${ERR}" "WireGuard"
run --print-token --token-file "${BASE}/none"
check "--print-token before a first start exits 1" "${RC}" "1"

print -r -- ""
print -r -- "the server"
TOKEN_FILE="${BASE}/state/web/token"
# A ttyd stand-in on a Unix socket: answers every request with its request
# line and whether a Cookie header reached it.
TTYD_SOCK="${BASE}/ttyd.sock"
cat > "${BASE}/ttyd.py" <<'PY'
import socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.bind(sys.argv[1]); s.listen(5)
while True:
    c, _ = s.accept()
    data = b""
    while b"\r\n\r\n" not in data:
        chunk = c.recv(4096)
        if not chunk: break
        data += chunk
    text = data.decode(errors="replace")
    body = ("ttyd " + text.split("\r\n")[0] + "\ncookie=" + str("\r\nCookie:" in text) + "\n").encode()
    c.sendall(b"HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: %d\r\nConnection: close\r\n\r\n" % len(body) + body)
    c.close()
PY
python3 "${BASE}/ttyd.py" "${TTYD_SOCK}" &
TTYD_PID=$!
trap '[[ -n "${SERVER_PID}" ]] && kill "${SERVER_PID}" 2>/dev/null; kill "${TTYD_PID}" 2>/dev/null; rm -rf "${BASE}"' EXIT
FLAKELAB_WEB_BIND=0 FLAKELAB_WEB_PORT=0 FLAKELAB_WEB_TOKEN_FILE="${TOKEN_FILE}" PYTHONDONTWRITEBYTECODE=1 timeout 10 python3 "${SERVER}" 2>"${BASE}/bind0.err"
check "the server itself refuses the unspecified address in any spelling" "$?" "2"
contains "and says which address to name" "$(<"${BASE}/bind0.err")" "name the WireGuard address"
print -r -- '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 4 4"><rect width="4" height="4"/></svg>' > "${BASE}/logo.svg"
# start_server <stderr file> [VAR=value...]: the server in the background on
# 127.0.0.1 and a free port, over the stand-ins; STARTED_PID, and STARTED_PORT
# once it names one (empty after five seconds without).
start_server() {
  local err="$1" i
  shift
  env FLAKELAB_WEB_BIND=127.0.0.1 FLAKELAB_WEB_PORT=0 FLAKELAB_WEB_TOKEN_FILE="${TOKEN_FILE}" FLAKELAB_WEB_STATIC="${BASE}/static" \
    FLAKELAB_WEB_ACCOUNTS="${BASE}/bin/accounts" FLAKELAB_WEB_SESSIONS="${BASE}/bin/claude-sessions" \
    PYTHONDONTWRITEBYTECODE=1 "$@" python3 "${SERVER}" 2>"${err}" &
  STARTED_PID=$!
  STARTED_PORT=""
  for i in {1..50}; do
    STARTED_PORT="$(grep -oE 'http://127\.0\.0\.1:[0-9]+/' "${err}" 2>/dev/null | head -1 | grep -oE '[0-9]+/' | tr -d /)"
    [[ -n "${STARTED_PORT}" ]] && break
    sleep 0.1
  done
}
start_server "${BASE}/server.err" FLAKELAB_WEB_TERMINAL_SOCKET="${TTYD_SOCK}" FLAKELAB_WEB_LOGO="${BASE}/logo.svg"
SERVER_PID="${STARTED_PID}" PORT="${STARTED_PORT}"
[[ -n "$PORT" ]] && ok "the server starts and names its port" || { bad "the server did not start"; cat "${BASE}/server.err" >&2; print -r -- "${PASS} passed, ${FAIL} failed"; exit 1 }
URL="http://127.0.0.1:${PORT}"
check "the token file is made on the first start, private" "$(stat -c %a "${TOKEN_FILE}") $(stat -c %a "${TOKEN_FILE:h}")" "600 700"
TOKEN="$(<"${TOKEN_FILE}")"
run --print-token --token-file "${TOKEN_FILE}"
check "--print-token prints it" "${OUT}" "${TOKEN}"

# get <path> [token]; post <path> <body> [token]: BODY and CODE.
BODY=""; CODE=""
get() {
  local -a auth=()
  [[ -n "${2:-}" ]] && auth=(-H "Authorization: Bearer $2")
  BODY="$(curl -s -o - -w '\n%{http_code}' "${auth[@]}" "${URL}$1")"; CODE="${BODY##*$'\n'}"; BODY="${BODY%$'\n'*}"
}
post() {
  local -a auth=()
  [[ -n "${3:-}" ]] && auth=(-H "Authorization: Bearer $3")
  BODY="$(curl -s -o - -w '\n%{http_code}' -X POST -H 'Content-Type: application/json' "${auth[@]}" --data "$2" "${URL}$1")"; CODE="${BODY##*$'\n'}"; BODY="${BODY%$'\n'*}"
}
calls() { cat "${LOG}" 2>/dev/null; : > "${LOG}" }

get /
check "the page is served" "${CODE}" "200"
contains "and is the dashboard" "${BODY}" "<title>flakelab</title>"
get /api/health
check "health needs no token" "${CODE}" "200"
get /api/state
check "state without a token is 401" "${CODE}" "401"
get /api/state wrong-token
check "state with the wrong token is 401" "${CODE}" "401"
get /api/state "${TOKEN}"
check "state with the token is 200" "${CODE}" "200"
check "and carries the roster" "$(print -r -- "$BODY" | jq -r '.accounts.accounts[1].alias')" "work"
check "the status" "$(print -r -- "$BODY" | jq -r '.status.claude.matches')" "false"
check "the sessions" "$(print -r -- "$BODY" | jq -r '.sessions[0].host.window')" "claude-work"
check "and that a terminal is on" "$(print -r -- "$BODY" | jq -r '.terminal')" "true"
contains "each read was one CLI call" "$(calls)" "accounts --json"
get /nope "${TOKEN}"
check "an unknown path is 404" "${CODE}" "404"
get /api/nope "${TOKEN}"
check "an unknown API path is 404" "${CODE}" "404"

post /api/switch '{"entry":"2"}'
check "a write without a token is 401" "${CODE}" "401"
check "and nothing ran" "$(calls)" ""
post /api/switch '{"entry":"2"}' "${TOKEN}"
check "switch runs the CLI" "${CODE}" "200"
contains "with the entry" "$(calls)" "accounts switch 2"
check "and returns its output" "$(print -r -- "$BODY" | jq -r '.call.stdout')" "Switched claude to 2"
post /api/switch '{"entry":"2","force":true}' "${TOKEN}"
contains "force adds --force" "$(calls)" "accounts switch 2 --force"
post /api/switch '{"entry":"9"}' "${TOKEN}"
check "a CLI refusal is 409" "${CODE}" "409"
contains "with the reason" "$(print -r -- "$BODY" | jq -r '.call.stderr')" "running in a profile session"
post /api/switch '{"entry":""}' "${TOKEN}"
check "an empty entry is 400" "${CODE}" "400"
post /api/switch '{"entry":"--next"}' "${TOKEN}"
check "an option as the entry is 400" "${CODE}" "400"
post /api/switch 'not json' "${TOKEN}"
check "a body that is not JSON is 400" "${CODE}" "400"
post /api/switch '[1]' "${TOKEN}"
check "a body that is not an object is 400" "${CODE}" "400"
: > "${LOG}"

post /api/fetch '{}' "${TOKEN}"
check "fetch runs the poll" "${CODE}" "200"
contains "as --fetch --json" "$(calls)" "accounts --fetch --json"
post /api/auto '{}' "${TOKEN}"
check "auto is a dry run by default" "${CODE}" "200"
contains "with --dry-run" "$(calls)" "accounts auto --once --json --dry-run"
check "and the events parsed" "$(print -r -- "$BODY" | jq -r '.events[1] | [.event, .to] | join(" ")')" "switch 1"
post /api/auto '{"dryRun":false,"tool":"claude"}' "${TOKEN}"
contains "a real tick drops --dry-run and names the tool" "$(calls)" "accounts auto --once --json --tool claude"
post /api/auto '{"tool":"gemini"}' "${TOKEN}"
check "an unknown tool is 400" "${CODE}" "400"
: > "${LOG}"

get /api/state "${TOKEN}"
check "state carries the engine's settings" "$(print -r -- "$BODY" | jq -r '.config.settings.weekThreshold | [.value, .source] | join(" ")')" "92 runtime"
check "on or off among them" "$(print -r -- "$BODY" | jq -r '.config.settings.autoSwitch.value')" "true"
check "and its last events, parsed" "$(print -r -- "$BODY" | jq -r '.events[1].reason')" "cooldown"
ST_CALLS="$(calls)"
contains "read with config --json" "${ST_CALLS}" "accounts config --json"
contains "and log --json" "${ST_CALLS}" "accounts log --json --lines 30"
post /api/config '{"key":"weekThreshold","value":92}' "${TOKEN}"
check "config set runs the CLI" "${CODE}" "200"
contains "with the key and the value" "$(calls)" "accounts config set weekThreshold 92"
check "and returns its output" "$(print -r -- "$BODY" | jq -r '.call.stdout')" "weekThreshold = 92 (runtime; flake 97); the next auto tick uses it"
post /api/config '{"key":"autoSwitch","value":false}' "${TOKEN}"
contains "a boolean goes as true or false: the on/off switch" "$(calls)" "accounts config set autoSwitch false"
post /api/config '{"key":"hysteresis","value":5.0}' "${TOKEN}"
contains "a whole float as an integer" "$(calls)" "accounts config set hysteresis 5"
post /api/config '{"key":"modelWindows","value":" Fable,Opus "}' "${TOKEN}"
contains "a string as it came, trimmed" "$(calls)" "accounts config set modelWindows Fable,Opus"
post /api/config '{"key":"weekThreshold","unset":true}' "${TOKEN}"
contains "unset one key" "$(calls)" "accounts config unset weekThreshold"
post /api/config '{"all":true,"unset":true}' "${TOKEN}"
contains "or every one" "$(calls)" "accounts config unset --all"
post /api/config '{"key":"bogus","value":1}' "${TOKEN}"
check "a CLI refusal is 409" "${CODE}" "409"
contains "with the reason" "$(print -r -- "$BODY" | jq -r '.call.stderr')" "unknown setting"
: > "${LOG}"
post /api/config '{"key":"--all","value":1}' "${TOKEN}"
check "an option as the key is 400" "${CODE}" "400"
post /api/config '{"value":1}' "${TOKEN}"
check "no key is 400" "${CODE}" "400"
post /api/config '{"key":"weekThreshold"}' "${TOKEN}"
check "no value is 400" "${CODE}" "400"
post /api/config '{"key":"weekThreshold","value":{"x":1}}' "${TOKEN}"
check "a value that is no scalar is 400" "${CODE}" "400"
post /api/config '{"key":"hysteresis","value":2.5}' "${TOKEN}"
check "nor a fraction" "${CODE}" "400"
post /api/config '{"unset":true}' "${TOKEN}"
check "an unset without a key or all is 400" "${CODE}" "400"
check "and none of them ran" "$(calls)" ""

post /api/sessions/start "{\"tool\":\"codex\",\"dir\":\"${BASE}\"}" "${TOKEN}"
check "start runs the sessions command" "${CODE}" "200"
contains "detached, in the directory" "$(calls)" "claude-sessions --start codex ${BASE} --detach"
post /api/sessions/start "{\"tool\":\"claude\",\"dir\":\"${BASE}\",\"args\":[\"--model\",\"x\"]}" "${TOKEN}"
contains "arguments go after --" "$(calls)" "claude-sessions --start claude ${BASE} --detach -- --model x"
post /api/sessions/start '{"tool":"claude","dir":"/no/such/dir"}' "${TOKEN}"
check "a missing directory is 400" "${CODE}" "400"
post /api/sessions/start "{\"tool\":\"vim\",\"dir\":\"${BASE}\"}" "${TOKEN}"
check "an unknown tool is 400" "${CODE}" "400"
post /api/sessions/start "{\"tool\":\"claude\",\"dir\":\"${BASE}\",\"args\":\"x\"}" "${TOKEN}"
check "args that are not a list are 400" "${CODE}" "400"

print -r -- ""
print -r -- "the terminal: ttyd behind the dashboard's own session"
get /terminal/
check "the terminal without a session is 401" "${CODE}" "401"
post /api/terminal '{}'
check "a session without the token is 401" "${CODE}" "401"
SETCOOKIE="$(curl -s -o /dev/null -D - -X POST -H "Authorization: Bearer ${TOKEN}" -H 'Content-Type: application/json' --data '{}' "${URL}/api/terminal" | grep -i '^set-cookie:' | tr -d '\r')"
contains "with the token, a session cookie scoped to /terminal" "${SETCOOKIE}" "; Path=/terminal; HttpOnly; SameSite=Strict"
SID="${${SETCOOKIE#*flakelab_terminal=}%%;*}"
BODY="$(curl -s -b "flakelab_terminal=${SID}" "${URL}/terminal/")"
contains "with the cookie, the request reaches ttyd as it came" "${BODY}" "ttyd GET /terminal/ HTTP/1.1"
contains "without the cookie" "${BODY}" "cookie=False"
BODY="$(curl -s -b "flakelab_terminal=${SID}" "${URL}/terminal/ws?x=1")"
contains "and so does everything under /terminal" "${BODY}" "ttyd GET /terminal/ws?x=1 HTTP/1.1"
BODY="$(curl -s -o - -w '\n%{http_code}' -b "flakelab_terminal=not-a-session" "${URL}/terminal/")"
check "a made-up cookie is 401" "${BODY##*$'\n'}" "401"
get /api/health
check "the dashboard still answers" "${CODE}" "200"

print -r -- ""
print -r -- "Host: only this server's address"
BODY="$(curl -s -o - -w '\n%{http_code}' -H 'Host: evil.example' "${URL}/api/health")"
check "a request for another name is 421" "${BODY##*$'\n'}" "421"
BODY="$(curl -s -o - -w '\n%{http_code}' -H "Host: localhost:${PORT}" "${URL}/api/health")"
check "localhost names a loopback server" "${BODY##*$'\n'}" "200"

print -r -- ""
print -r -- "the logo: static like the page, only when configured"
get /logo
check "the logo is served without a token" "${CODE}" "200"
check "as the image type its suffix says" "$(curl -s -o /dev/null -w '%{content_type}' "${URL}/logo")" "image/svg+xml"
check "byte for byte" "$(curl -s "${URL}/logo")" "$(<"${BASE}/logo.svg")"
get /api/health
check "and health says one is there" "$(print -r -- "$BODY" | jq -r '.logo')" "true"
run --logo "${BASE}/missing.svg" --token-file "${TOKEN_FILE}"
check "an unreadable --logo refuses with exit 2" "${RC}" "2"
contains "and says so" "${ERR}" "is not readable"
print -r -- 'x' > "${BASE}/logo.txt"
FLAKELAB_WEB_BIND=127.0.0.1 FLAKELAB_WEB_PORT=0 FLAKELAB_WEB_TOKEN_FILE="${TOKEN_FILE}" FLAKELAB_WEB_LOGO="${BASE}/logo.txt" PYTHONDONTWRITEBYTECODE=1 timeout 10 python3 "${SERVER}" 2>"${BASE}/logo.err"
check "a logo that is no image type refuses at start" "$?" "2"
contains "naming the types" "$(<"${BASE}/logo.err")" "not an image type"
check "under the server's prefix" "${$(<"${BASE}/logo.err")%%FLAKELAB_WEB_LOGO*}" "flakelab web: refusing "
start_server "${BASE}/server2.err"
check "without a logo, /logo is 404" "$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:${STARTED_PORT}/logo")" "404"
check "and health says none" "$(curl -s "http://127.0.0.1:${STARTED_PORT}/api/health" | jq -r '.logo')" "false"
kill "${STARTED_PID}" 2>/dev/null; wait "${STARTED_PID}" 2>/dev/null

print -r -- ""
print -r -- "--rotate-token: the running server follows, every terminal session ends"
run --rotate-token --token-file "${TOKEN_FILE}"
check "--rotate-token exits 0" "${RC}" "0"
contains "and says so" "${ERR}" "token rotated"
NEW_TOKEN="$(<"${TOKEN_FILE}")"
[[ "${NEW_TOKEN}" != "${TOKEN}" && ${#NEW_TOKEN} -ge 40 ]] && ok "the file holds a new token" || bad "the token did not change"
check "still private" "$(stat -c %a "${TOKEN_FILE}")" "600"
get /api/state "${TOKEN}"
check "the old token is refused at once" "${CODE}" "401"
get /api/state "${NEW_TOKEN}"
check "the new one works with no restart" "${CODE}" "200"
BODY="$(curl -s -o - -w '\n%{http_code}' -b "flakelab_terminal=${SID}" "${URL}/terminal/")"
check "the terminal session issued against the old token is over" "${BODY##*$'\n'}" "401"
TOKEN="${NEW_TOKEN}"

kill "${SERVER_PID}" 2>/dev/null; wait "${SERVER_PID}" 2>/dev/null; SERVER_PID=""
excludes "the server never printed the token" "$(<"${BASE}/server.err")" "${TOKEN}"
excludes "nor the terminal session" "$(<"${BASE}/server.err")" "${SID}"

print -r -- ""
print -r -- "${PASS} passed, ${FAIL} failed"
(( FAIL == 0 ))
