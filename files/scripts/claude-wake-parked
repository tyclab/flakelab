#!/usr/bin/env zsh
# claude-wake-parked: a Claude Code session that hit a usage limit parks until the reset its error
# named and never re-reads the login before; after tycswap moved a login, this tells each parked
# session in tmux to go on, when the live account of the session's own store has room for the limit
# that session hit. A store must match the reported login. An unknown store waits for native recovery.
# Once per pane, store, account and window; never into a pane that
# works, shows a dialog, is in copy mode or holds typed text, and Enter only after the pane shows the line.
emulate -L zsh
setopt pipefail extended_glob

STATE="${FLAKELAB_WAKE_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/flakelab/wake-parked}"
PROC="${FLAKELAB_WAKE_PROC:-/proc}"
command -v tmux >/dev/null 2>&1 && command -v tycswap >/dev/null 2>&1 || exit 0
st="$(tycswap status --json 2>/dev/null)" || exit 0

cfg="$(tycswap config list 2>/dev/null)"
bar() { local v; v="$(awk -v k="$1" '$1 == k {print $2; exit}' <<<"$cfg")"; print -r -- "${v:-$2}" }
# tycswap's own defaults when its settings cannot be read.
b5="$(bar autoswitch.fiveHourThreshold 85)" b7="$(bar autoswitch.sevenDayThreshold 97)" bm="$(bar autoswitch.modelThreshold 95)"

session_room() { (( p7 < b7 )) && { [[ "${p5:--}" == - ]] || (( p5 < b5 )) } }
fable_room() { session_room && [[ "${pf:--}" != - ]] && (( pf < bm )) }
# One name per window: tycswap's reset time differs by a fraction of a second from fetch to fetch.
window() {
  local s
  if [[ "$1" == [0-9](#c4)-[0-9](#c2)-[0-9](#c2)T* ]] && s="$(date -u -d "$1" +%s 2>/dev/null)"; then
    print -r -- $(( (s + 30) / 60 ))
  else
    print -r -- "$1"
  fi
}

# Each store's live account and windows: the shared login's from .active, the Fable store's from
# .fable while it is on. Usage that is not known is not room; only a missing 5-hour window is.
typeset -A ROOM
load() {
  local n fetched p5 r5 p7 r7 pf rf
  read -r n fetched p5 r5 p7 r7 pf rf < <(jq -r "$2"' as $a | $a.usage as $u | [
    ($a.number // "-"), ($a.usageStatus // "-"),
    ($u.fiveHour.pct // "-"), ($u.fiveHour.resetsAt // "-"),
    ($u.sevenDay.pct // "-"), ($u.sevenDay.resetsAt // "-"),
    ([$u.scoped[]? | select(.name | test("fable"; "i"))] | max_by(.pct) | (.pct // "-")),
    ([$u.scoped[]? | select(.name | test("fable"; "i"))] | max_by(.pct) | (.resetsAt // "-"))
  ] | map(tostring) | join(" ")' <<<"$st" 2>/dev/null)
  [[ "${n:--}" != - && "$fetched" == ok && "${p7:--}" != - ]] || return 0
  ROOM[$1]="$n ${p5:--} $p7 ${pf:--} $(window "${r5:--}") $(window "${r7:--}") $(window "${rf:--}")"
}
load default .active
# Only a positively identified default pane can use the shared login.
fdir="$(jq -r '.fable.storeDir // empty' <<<"$st" 2>/dev/null)"
[[ -n "$fdir" && "$(jq -r '.fable.state // empty' <<<"$st" 2>/dev/null)" == on ]] && load fable .fable
(( ${#ROOM} )) || exit 0

# Identify the credential store from the native Claude process. Private stores,
# custom providers and unreadable processes cannot use either account's room.
pane_store() {
  local p f item exe store profile process_env
  local -a queue=("$1")
  local -A seen
  while (( ${#queue} )); do
    p="${queue[1]}"; shift queue
    [[ "$p" == <-> && -z "${seen[$p]:-}" ]] || continue
    seen[$p]=1
    if exe="$(readlink "${PROC}/${p}/exe" 2>/dev/null)" && [[ "${exe:t}" == claude || "$exe" == */claude/versions/* ]]; then
      [[ -r "${PROC}/${p}/environ" ]] || return 1
      process_env="$(<"${PROC}/${p}/environ")" || return 1
      [[ -n "$process_env" ]] || return 1
      store="" profile=""
      for item in "${(@0)process_env}"; do
        case "$item" in
          CLAUDE_SECURESTORAGE_CONFIG_DIR=*) store="${item#*=}" ;;
          CLAUDE_CONFIG_DIR=*) profile="${item#*=}" ;;
          ANTHROPIC_*KEY=?*|ANTHROPIC_*TOKEN=?*|ANTHROPIC_*URL=?*|ANTHROPIC_CUSTOM_HEADERS=?*|CLAUDE_CODE_OAUTH_TOKEN=?*|CLAUDE_CODE_*FILE_DESCRIPTOR=?*|CLAUDE_CODE_USE_*=?*) return 1 ;;
        esac
      done
      [[ -z "$profile" || "$profile" == "${HOME}/.claude" ]] || return 1
      if [[ -z "$store" || "$store" == "${HOME}/.claude" ]]; then print -r -- default
      elif [[ -n "$fdir" && "$store" == "$fdir" ]]; then print -r -- fable
      else return 1
      fi
      return 0
    fi
    for f in "${PROC}/${p}"/task/*/children(N); do queue+=(${=$(<"$f")}); done 2>/dev/null
  done
  return 1
}

source "${0:A:h}/lib/claude_input.zsh" || exit 1

# Claude Code's own lines, by their shape: with their mark anywhere near the end of the screen,
# without it only below the input box, where no reply's text can stand.
shape="(Usage limit reached · |You've hit your [A-Za-z0-9 -]*limit · resets |Automatic continue stopped · )"
mkdir -p "$STATE" 2>/dev/null || exit 0
tmux list-panes -a -F '#{pane_id} #{pane_in_mode} #{pane_current_command} #{pane_pid}' 2>/dev/null | while read -r pane mode cmd top; do
  [[ "$cmd" == claude || "$cmd" == [0-9]##.[0-9]##.[0-9]## ]] || continue
  [[ "$mode" == 0 ]] || continue
  look "$pane" || continue
  last="$(print -rl -- "${plain[@]}" | grep -av '^[[:space:]]*$' | tail -n 12)"
  foot="$(print -rl -- "${(@)plain[at[-1] + 1,-1]}")"
  hit="$(grep -aE "^[[:space:]]*(⚠|⎿)[[:space:]]+${shape}" <<<"$last"; grep -aE "^[[:space:]]*${shape}" <<<"$foot")"
  [[ -n "$hit" ]] || continue
  grep -qaE '… \(|esc to interrupt|requests your input|Accept +Decline|Do you want|Compacting|Enter to select|to navigate' <<<"$last" && continue
  store="$(pane_store "$top")" || continue
  [[ -n "${ROOM[$store]:-}" ]] || continue
  read -r acct p5 p7 pf w5 w7 wf <<<"${ROOM[$store]}"
  # Shared 5-hour and weekly usage do not establish room on a separate model limit.
  if grep -aF "You've hit your " <<<"$hit" | grep -aviE "You've hit your (Fable|5-hour|weekly|seven-day|7-day) limit" >/dev/null; then continue; fi
  if grep -qa 'Fable limit' <<<"$hit"; then
    fable_room || continue; key="${store}|${acct}|${wf}|${w5}"
  else
    session_room || continue; key="${store}|${acct}|${w5}|${w7}"
  fi
  # One line between the rules, empty or a dim placeholder.
  (( at[-1] - at[-2] == 2 )) && [[ -z "$(box)" ]] || continue
  # A key written before the stores were named is the shared login's.
  old="$(<"$STATE/${pane#%}" 2>/dev/null)"
  [[ -z "$old" || "$old" == (default|fable)\|* ]] || old="default|${old}"
  [[ "$old" == "$key" ]] && continue
  [[ "$store" == fable ]] && login="Fable login" || login="shared login"
  msg="flakelab: the ${login} is on an account with room now (account ${acct}); go on where you stopped."
  tmux send-keys -t "$pane" -l "$msg" || continue
  sleep "${FLAKELAB_WAKE_SETTLE:-0.5}"
  if ! look "$pane" || [[ "$(box)" != "$(bare "$msg")" ]]; then
    print -r -- "not submitted in ${pane}: its input box does not show the line"
    continue
  fi
  tmux send-keys -t "$pane" Enter || continue
  print -r -- "$key" >"$STATE/${pane#%}"
  print -r -- "woke ${pane} (account ${acct}, ${key})"
done
exit 0
