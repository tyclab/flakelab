#!/usr/bin/env zsh

set -uo pipefail

#
# Offline suite for nix-update's pre-flight: the real script against throwaway
# overlays under a mktemp root, with `sudo` shimmed so the switch it ends in is
# recorded instead of run. Under test is the shape gate in front of the drift
# check - a plain directory, a repository with no remote, a repository with one
# - and that the switch still happens, or is refused, for the right reason.
# Nothing here is a terminal, so every case takes the non-interactive branch:
# the one automation and agents hit.
#
# The PATH is rebuilt from symlinks with five names left out. `sudo`,
# `nix-clone-repos` and `flakelab-switch-result` are shimmed below; `claude` and
# `systemctl` are simply absent, so the marketplace refresh and the boot-settle
# wait skip themselves instead of talking to the real ones. HOME is a fresh
# directory for the same reason: no ~/.claude, no ~/.gitconfig.
#
# Usage: files/scripts/test-nix-update
#

SCRIPT_DIR="${0:A:h}"
UPDATE="${SCRIPT_DIR}/nix-update"
typeset -i PASS=0 FAIL=0

ok()       { print -r -- "  ok   $1"; (( PASS++ )); return 0 }
bad()      { print -r -u2 -- "  FAIL $1"; (( FAIL++ )); return 0 }
check()    { [[ "$2" == "$3" ]] && ok "$1" || { bad "$1"; print -r -u2 -- "       expected: $3"; print -r -u2 -- "       actual:   $2" } }
contains() { [[ "$2" == *"$3"* ]] && ok "$1" || { bad "$1"; print -r -u2 -- "       missing: $3" } }
excludes() { [[ "$2" != *"$3"* ]] && ok "$1" || bad "$1 (unexpected: $3)" }

BASE="$(mktemp -d)"
trap 'rm -rf "${BASE}"' EXIT

TOOLS="${BASE}/tools"
mkdir -p "${TOOLS}"
for f in ${^path}/*(N-*); do
  case "${f:t}" in
    sudo|nix-clone-repos|claude|systemctl|flakelab-switch-result) continue ;;
  esac
  [[ -e "${TOOLS}/${f:t}" ]] || ln -s "${f}" "${TOOLS}/${f:t}"
done

# `sudo` records its argv and exits with SUDO_RC, so the switch is observable
# without a root and a failing rebuild's status can be checked for surviving.
# SUDO_WRITES_LOCK makes the switch leave a lock the caller cannot write - root's,
# which a read-only mode stands in for, since the suite has no root to chown to.
SHIM="${BASE}/bin"
mkdir -p "${SHIM}"
cat > "${SHIM}/sudo" <<'STUB'
#!/usr/bin/env zsh
print -r -- "$@" >> "${SUDO_LOG}"
if [[ -n "${SUDO_WRITES_LOCK:-}" && "$1" == nixos-rebuild ]]; then
  print -r -- '{ "written": "by root" }' > "${FLAKELAB_REPO_ROOT}/flake.lock"
  chmod 444 "${FLAKELAB_REPO_ROOT}/flake.lock"
fi
exit "${SUDO_RC:-0}"
STUB
chmod +x "${SHIM}/sudo"

# The classifier's own verdicts are test-switch-result's; here it answers as told.
# By default it maps the status the way a clean record would (0 applied, 4
# degraded, anything else its own code); RESULT_RC and RESULT_FAILED override that.
cat > "${SHIM}/flakelab-switch-result" <<'STUB'
#!/usr/bin/env zsh
print -r -- "$*" >> "${RESULT_LOG}"
rc="${RESULT_RC:-$2}"
print -r -- "verdict=scripted"
print -r -- "failed=${RESULT_FAILED:-}"
exit "${rc}"
STUB
chmod +x "${SHIM}/flakelab-switch-result"
export RESULT_LOG="${BASE}/result.log"

export HOME="${BASE}/home"
mkdir -p "${HOME}"
git config --global user.name "test-nix-update"
git config --global user.email "t@example.invalid"
git config --global init.defaultBranch main
export SUDO_LOG="${BASE}/sudo.log"

typeset -i RC=0
OUT=""
# run_update <overlay> <args...> - sets OUT and RC; stdin is /dev/null so the
# script sees no terminal. RUN_CWD starts it from another directory and RUN_PATH
# puts a directory in front of the tools, for the cases about where the operator
# stands and about a git that misbehaves.
RUN_CWD="" RUN_PATH=""
run_update() {
  local repo="$1"
  shift
  : > "${SUDO_LOG}"
  OUT="$(cd "${RUN_CWD:-${PWD}}" && PATH="${SHIM}:${RUN_PATH:+${RUN_PATH}:}${TOOLS}" \
    FLAKELAB_REPO_ROOT="${repo}" "${UPDATE}" "$@" 2>&1 < /dev/null)"
  RC=$?
}
switches() { grep -c "nixos-rebuild switch" "${SUDO_LOG}" }

# Fixtures: the three overlay shapes. Each has a flake.nix so the directory
# looks like an overlay; none has a flake.lock, so the re-lock step is a no-op.
# mk_plain has no .gitignore, so the adoption leaves it alone and the plain
# directory stays plain; mk_plain_ignored carries the template .gitignore, the
# shape an overlay from before the generators made repositories really has.
GITIGNORE="${SCRIPT_DIR:h:h}/templates/overlay/.gitignore"
mk_plain() {
  local d="${BASE}/$1"
  mkdir -p "${d}"
  print -r -- '{ }' > "${d}/flake.nix"
  print -r -- "${d}"
}
mk_plain_ignored() {
  local d
  d="$(mk_plain "$1")"
  cp "${GITIGNORE}" "${d}/.gitignore"
  print -r -- "${d}"
}
mk_local() {
  local d
  d="$(mk_plain "$1")"
  git -C "${d}" init -q
  git -C "${d}" add -A
  git -C "${d}" commit -q -m init
  print -r -- "${d}"
}
mk_remote() {
  local d
  d="$(mk_local "$1")"
  git init -q --bare "${BASE}/$1.git"
  git -C "${d}" remote add origin "${BASE}/$1.git"
  git -C "${d}" push -q -u origin main > /dev/null 2>&1
  git -C "${d}" remote set-head origin -a > /dev/null
  print -r -- "${d}"
}

print -r -- "test-nix-update"

# ---------------------------------------------------------------------------
# 1. A plain directory switches, and becomes the repository the generators leave
# ---------------------------------------------------------------------------
# What `provision` left behind before the overlay became a repository, and what
# a hand-made overlay still is. Nothing can be stale against a remote that does
# not exist, so the switch runs; with the template .gitignore in place the
# directory is adopted first - one commit, no remote - and the ignored files
# stay out of it.
print -r -- "a plain directory with the template .gitignore is adopted, then switches"
d="$(mk_plain_ignored plain)"
mkdir -p "${d}/files/config/shared/ssh/keys" "${d}/files/config/instances/box/aws"
print -r -- 'PRIVATE' > "${d}/files/config/shared/ssh/keys/id_ed25519"
: > "${d}/files/config/shared/ssh/keys/.gitkeep"
print -r -- 'TOKEN=x' > "${d}/secrets.env"
print -r -- '[saml]' > "${d}/files/config/instances/box/aws/credentials"
# The suite's own global config says main and names an identity, so with it in
# place neither --initial-branch nor the -c identity could be seen missing.
git config --global init.defaultBranch trunk
run_update "${d}"
git config --global init.defaultBranch main
check    "it switches"                      "${RC}" "0"
check    "exactly once"                     "$(switches)" "1"
contains "from the overlay, as path:"       "$(< "${SUDO_LOG}")" "--flake path:${d}#default"
contains "and says it was initialised"      "${OUT}" "${d} initialised as a repository (one commit, no remote)"
check    "committed as flakelab, not as the operator" "$(git -C "${d}" log -1 --format='%an <%ae>')" "flakelab <flakelab@localhost>"
check    "as a repository"                  "$(git -C "${d}" rev-parse --is-inside-work-tree 2>/dev/null)" "true"
check    "on main"                          "$(git -C "${d}" branch --show-current)" "main"
check    "with exactly one commit"          "$(git -C "${d}" rev-list --count HEAD)" "1"
check    "and no remote"                    "$(git -C "${d}" remote | wc -l | tr -d ' ')" "0"
check    "autocrlf pinned off"              "$(git -C "${d}" config core.autocrlf)" "false"
contains "flake.nix committed"              "$(git -C "${d}" ls-files)" "flake.nix"
contains "and the .gitignore itself"        "$(git -C "${d}" ls-files)" ".gitignore"
excludes "but not the private key"          "$(git -C "${d}" ls-files)" "id_ed25519"
excludes "nor secrets.env"                  "$(git -C "${d}" ls-files)" "secrets.env"
excludes "nor the backup payload"           "$(git -C "${d}" ls-files)" "files/config/instances/"
# That overlay is in the layout from before `<overlay>-payload`: a key and a
# payload under its files/config. Ignored, so not committed - and copied into the
# store by the switch all the same, which is said on every run until it is moved.
contains "and warns that the switch copies the payload into the store" "${OUT}" "${d}/files/config still holds shared, instances"
contains "pointing at the doctor for the move" "${OUT}" "flakelab doctor"
excludes "with no fetch attempted"          "${OUT}" "fetch failed"
excludes "and no origin/HEAD advice"        "${OUT}" "origin/HEAD"
excludes "and no stale refusal"             "${OUT}" "stale"

print -r -- "the second update finds a repository with no remote, not a plain directory"
run_update "${d}"
check    "it switches"                      "${RC}" "0"
contains "and says why nothing was fetched" "${OUT}" "no git remote"
excludes "without initialising again"       "${OUT}" "initialised"
check    "still one commit"                 "$(git -C "${d}" rev-list --count HEAD)" "1"

# ls-files answers relative to the directory git runs in, and only below it. An
# operator standing inside the overlay is the ordinary case, so the list has to
# be the whole overlay from there too - and a leak above them still a leak.
print -r -- "an overlay with nothing under files/config gets no payload warning"
d="$(mk_plain_ignored cleanlayout)"
run_update "${d}"
excludes "no warning"                       "${OUT}" "still holds"

print -r -- "an update started from inside the overlay adopts the whole of it"
d="$(mk_plain_ignored inside)"
mkdir -p "${d}/notes/deeper"
print -r -- 'n' > "${d}/notes/deeper/todo.txt"
RUN_CWD="${d}/notes/deeper" run_update "${d}"
check    "it switches"                      "${RC}" "0"
contains "and says it was initialised"      "${OUT}" "${d} initialised as a repository"
check    "with all three files in the one commit" "$(git -C "${d}" ls-files | wc -l | tr -d ' ')" "3"
contains "the one below the starting directory by its full path" "$(git -C "${d}" ls-files)" "notes/deeper/todo.txt"
contains "and the ones above it"            "$(git -C "${d}" ls-files)" "flake.nix"
check    "and a clean tree"                 "$(git -C "${d}" status --porcelain)" ""

print -r -- "and a leak above the directory it was started from is still refused"
d="$(mk_plain inside-leaky)"
print -r -- 'result' > "${d}/.gitignore"
print -r -- 'TOKEN=x' > "${d}/secrets.env"
mkdir -p "${d}/notes"
RUN_CWD="${d}/notes" run_update "${d}"
contains "it refuses the adoption"          "${OUT}" "${d} not initialised"
contains "naming the secrets file"          "${OUT}" "    secrets.env"
check    "with no .git left"                "$([[ -e "${d}/.git" ]] && print yes || print no)" "no"

# No .gitignore means the template never reached this overlay, and a commit of
# everything in it would be a commit of the key: leave it plain, say what to do.
print -r -- "a plain directory without .gitignore is left alone, and still switches"
d="$(mk_plain bare)"
print -r -- 'TOKEN=x' > "${d}/secrets.env"
run_update "${d}"
check    "it switches"                      "${RC}" "0"
check    "exactly once"                     "$(switches)" "1"
contains "and says it was left as it is"    "${OUT}" "${d} is not a git checkout and has no .gitignore"
contains "naming the template to copy"      "${OUT}" "templates/overlay/.gitignore"
check    "no repository was made"           "$([[ -e "${d}/.git" ]] && print yes || print no)" "no"

# A .gitignore that does not cover the secrets is worse than none: the add would
# stage them. The repository just made is removed again and the paths named.
print -r -- "a .gitignore that lets a secret through refuses, and removes the repository again"
d="$(mk_plain leaky)"
print -r -- 'result' > "${d}/.gitignore"
mkdir -p "${d}/files/config/shared/ssh/keys"
print -r -- 'PRIVATE' > "${d}/files/config/shared/ssh/keys/id_ed25519"
print -r -- 'TOKEN=x' > "${d}/secrets.env"
run_update "${d}"
check    "it switches"                      "${RC}" "0"
contains "and refuses the adoption"         "${OUT}" "${d} not initialised"
contains "naming the key"                   "${OUT}" "files/config/shared/ssh/keys/id_ed25519"
contains "and the secrets file"             "${OUT}" "secrets.env"
check    "with no .git left"          "$([[ -e "${d}/.git" ]] && print yes || print no)" "no"

# The measure is the template, not a list of names: whatever it ignores is a
# leak, in whatever directory and under whatever name the .gitignore missed it.
print -r -- "every kind of path the template ignores is refused"
d="$(mk_plain kinds)"
print -r -- 'secrets.env' > "${d}/.gitignore"
mkdir -p "${d}/certs dir" "${d}/files/config/snapshots/s1" "${d}/files/config/instances/box/aws"
print -r -- 'K' > "${d}/certs dir/tls ü.pem"
print -r -- 'S' > "${d}/files/config/snapshots/s1/history"
print -r -- '[saml]' > "${d}/files/config/instances/box/aws/credentials"
print -r -- '{}' > "${d}/flake.lock"
run_update "${d}"
check    "it switches"                      "${RC}" "0"
contains "and refuses the adoption"         "${OUT}" "${d} not initialised"
contains "naming the certificate verbatim"  "${OUT}" "certs dir/tls ü.pem"
contains "the snapshot"                     "${OUT}" "files/config/snapshots/s1/history"
contains "the payload credentials"          "${OUT}" "files/config/instances/box/aws/credentials"
contains "and the lock the template keeps untracked" "${OUT}" "    flake.lock"
check    "with no .git left"                "$([[ -e "${d}/.git" ]] && print yes || print no)" "no"

# README "Secrets": the sops ciphertext is committed on purpose, re-included by
# the overlay's own `!secrets/secrets.env`. It passes because it IS ciphertext -
# the same path holding one plaintext value is a leak like any other.
sops_dotenv() {
  print -r -- '#ENC[AES256_GCM,data:Zm9v,iv:aXY=,tag:dGFn,type:comment]'
  print -r -- 'GITLAB_TOKEN=ENC[AES256_GCM,data:Zm9v,iv:aXY=,tag:dGFn,type:str]'
  print -r -- 'EMPTY='
  print -r -- 'sops_age__list_0__map_recipient=age1example'
  print -r -- 'sops_lastmodified=2026-09-17T00:00:00Z'
  print -r -- 'sops_mac=ENC[AES256_GCM,data:bWFj,iv:aXY=,tag:dGFn,type:str]'
  print -r -- 'sops_version=3.13.3'
}
print -r -- "a re-included sops dotenv is committed"
d="$(mk_plain_ignored sops)"
print -r -- '!secrets/secrets.env' >> "${d}/.gitignore"
mkdir -p "${d}/secrets"
sops_dotenv > "${d}/secrets/secrets.env"
run_update "${d}"
check    "it switches"                      "${RC}" "0"
contains "and says it was initialised"      "${OUT}" "${d} initialised as a repository"
contains "with the ciphertext in the commit" "$(git -C "${d}" ls-files)" "secrets/secrets.env"

print -r -- "the same path with a plaintext value in it is not"
d="$(mk_plain_ignored sopsplain)"
print -r -- '!secrets/secrets.env' >> "${d}/.gitignore"
mkdir -p "${d}/secrets"
{ sops_dotenv; print -r -- 'BW_SESSION=hunter2' } > "${d}/secrets/secrets.env"
run_update "${d}"
check    "it switches"                      "${RC}" "0"
contains "and refuses the adoption"         "${OUT}" "${d} not initialised"
contains "naming the file"                  "${OUT}" "    secrets/secrets.env"
check    "with no .git left"                "$([[ -e "${d}/.git" ]] && print yes || print no)" "no"

# `rev-parse --git-dir` also fails on a .git that is damaged, and that one holds
# someone's history: it is reported and left exactly as it is, never
# re-initialised and never removed.
print -r -- "a .git that git cannot read is left untouched"
d="$(mk_local damaged)"
print -r -- 'TOKEN=x' > "${d}/secrets.env"
rm "${d}/.git/HEAD"
before="$(cd "${d}/.git" && print -rl -- **/*(.N) | sort)"
run_update "${d}"
check    "it switches"                      "${RC}" "0"
contains "and says the .git is unreadable"  "${OUT}" "${d}/.git exists but git cannot read it"
check    "with every file in it still there" "$(cd "${d}/.git" && print -rl -- **/*(.N) | sort)" "${before}"
check    "and HEAD not written back"        "$([[ -e "${d}/.git/HEAD" ]] && print yes || print no)" "no"

# The commit runs under the operator's global git config. Signing without a key
# and a hooksPath that rejects are theirs to have; neither decides whether the
# overlay gets its history.
print -r -- "commit.gpgsign and a rejecting hooksPath do not stop the adoption"
d="$(mk_plain_ignored signed)"
mkdir -p "${BASE}/hooks"
print -r -- $'#!/bin/sh\nexit 1' > "${BASE}/hooks/pre-commit"
chmod +x "${BASE}/hooks/pre-commit"
git config --global commit.gpgsign true
git config --global core.hooksPath "${BASE}/hooks"
run_update "${d}"
git config --global --unset commit.gpgsign
git config --global --unset core.hooksPath
check    "it switches"                      "${RC}" "0"
check    "with exactly one commit"          "$(git -C "${d}" rev-list --count HEAD 2>/dev/null)" "1"

# All or nothing. A git that dies between `init` and the commit must not leave a
# .git behind: the next run would read it as a repository with uncommitted
# changes and never adopt it. With nothing left, the next run simply tries again.
print -r -- "a commit that fails leaves a plain directory, and the next update adopts it"
d="$(mk_plain_ignored halfway)"
BADGIT="${BASE}/badgit"
mkdir -p "${BADGIT}"
cat > "${BADGIT}/git" <<STUB
#!/bin/sh
for a in "\$@"; do [ "\$a" = commit ] && { echo "fatal: scripted commit failure" >&2; exit 128; }; done
exec "${TOOLS}/git" "\$@"
STUB
chmod +x "${BADGIT}/git"
RUN_PATH="${BADGIT}" run_update "${d}"
check    "it switches"                      "${RC}" "0"
contains "and says it could not"            "${OUT}" "${d} could not be initialised as a repository"
contains "with git's reason"                "${OUT}" "scripted commit failure"
check    "with no .git left"                "$([[ -e "${d}/.git" ]] && print yes || print no)" "no"
run_update "${d}"
contains "the next update adopts it"        "${OUT}" "${d} initialised as a repository"
check    "with exactly one commit"          "$(git -C "${d}" rev-list --count HEAD 2>/dev/null)" "1"

# git warns on a SUCCESSFUL listing too - a directory it cannot open - and the
# list is NUL-separated data: a warning folded into it is the first path's name.
print -r -- "a directory git cannot open does not end up in the path list"
d="$(mk_plain_ignored unreadable)"
mkdir -p "${d}/locked"
chmod 000 "${d}/locked"
run_update "${d}"
chmod 755 "${d}/locked"
check    "it switches"                      "${RC}" "0"
contains "and says it was initialised"      "${OUT}" "${d} initialised as a repository"
excludes "with no pathspec made of a warning" "${OUT}" "pathspec"
check    "with exactly one commit"          "$(git -C "${d}" rev-list --count HEAD 2>/dev/null)" "1"

# "Rebuild the checkout as it is" includes a plain directory staying one, which
# is also how an overlay is kept plain on purpose.
print -r -- "FLAKELAB_STALE_OK=1 leaves a plain directory plain"
d="$(mk_plain_ignored asitis)"
FLAKELAB_STALE_OK=1 run_update "${d}"
check    "it switches"                      "${RC}" "0"
contains "and says it was left"             "${OUT}" "${d} is not a git checkout — FLAKELAB_STALE_OK=1, left a plain directory"
check    "no repository was made"           "$([[ -e "${d}/.git" ]] && print yes || print no)" "no"

# The refusal is not a stop - the switch runs - so it is not the red ✗ every
# stopping condition in the script uses, and it stays readable when the
# .gitignore missed a whole payload.
print -r -- "a refusal is a warning, and a long list is capped"
d="$(mk_plain manyleaks)"
print -r -- 'result' > "${d}/.gitignore"
mkdir -p "${d}/files/config/instances/box"
for i in {01..25}; do print -r -- 'x' > "${d}/files/config/instances/box/f${i}"; done
run_update "${d}"
check    "it switches"                      "${RC}" "0"
contains "it warns"                         "${OUT}" "⚠ ${d} not initialised"
excludes "without the stopping marker"      "${OUT}" "✗"
contains "says how many"                    "${OUT}" "would let 25 path(s)"
contains "names the twentieth"              "${OUT}" "files/config/instances/box/f20"
excludes "but not the twenty-first"         "${OUT}" "files/config/instances/box/f21"
contains "and counts the rest"              "${OUT}" "… and 5 more"

# An overlay on a mount that is not up is not a directory without a .gitignore.
print -r -- "a missing overlay directory is named as that"
run_update "${BASE}/not-there"
contains "it says so"                       "${OUT}" "${BASE}/not-there is not a directory"
excludes "without an install hint into it"  "${OUT}" "install -m 644"

# With FLAKELAB_REPO_ROOT unset the script rebuilds the tree it sits in - a
# flakelab checkout, or a ZIP of one with no .git. That tree is flakelab, not an
# overlay: both generators refuse to write over it, and the update does not
# adopt it.
print -r -- "the tree the script itself sits in is never adopted"
OWN="${BASE}/own-tree"
mkdir -p "${OWN}/files/scripts/lib" "${OWN}/templates/overlay"
cp "${UPDATE}" "${OWN}/files/scripts/"
cp "${SCRIPT_DIR}"/lib/*.zsh "${OWN}/files/scripts/lib/"
cp "${GITIGNORE}" "${OWN}/templates/overlay/.gitignore"
cp "${GITIGNORE}" "${OWN}/.gitignore"
print -r -- '{ }' > "${OWN}/flake.nix"
: > "${SUDO_LOG}"
OUT="$(env -u FLAKELAB_REPO_ROOT PATH="${SHIM}:${TOOLS}" "${OWN}/files/scripts/nix-update" 2>&1 < /dev/null)"
RC=$?
check    "it switches"                      "${RC}" "0"
contains "and says it is not a checkout"    "${OUT}" "${OWN} is not a git checkout — no drift check"
check    "no repository was made"           "$([[ -e "${OWN}/.git" ]] && print yes || print no)" "no"

# The sops exception lists the metadata keys sops writes; any other sops_ name
# is a value like the rest, and plaintext in it is a leak.
print -r -- "a plaintext value under a made-up sops_ key is not ciphertext"
d="$(mk_plain_ignored sopskey)"
print -r -- '!secrets/secrets.env' >> "${d}/.gitignore"
mkdir -p "${d}/secrets"
{ sops_dotenv; print -r -- 'sops_token=glpat-plaintext' } > "${d}/secrets/secrets.env"
run_update "${d}"
contains "it refuses the adoption"          "${OUT}" "${d} not initialised"
contains "naming the file"                  "${OUT}" "    secrets/secrets.env"

# What the template itself must cover, since it is the measure: the provisioning
# config setup-wsl-nix.ps1 parks in the overlay carries tokens in cleartext, and
# a key is a key under any of ssh-keygen's names - its .pub is not.
print -r -- "the template keeps the provisioning config and every key name out"
d="$(mk_plain_ignored tplcover)"
mkdir -p "${d}/files/config" "${d}/keys"
print -r -- 'custom_env_vars: { GITLAB_TOKEN: x }' > "${d}/files/config/user_data.yaml"
print -r -- 'PRIVATE' > "${d}/keys/id_ecdsa"
print -r -- 'ssh-ecdsa AAAA' > "${d}/keys/id_ecdsa.pub"
print -r -- 'TOKEN=x' > "${d}/.env"
run_update "${d}"
contains "it is initialised"                "${OUT}" "${d} initialised as a repository"
tracked="$(git -C "${d}" ls-files)"
excludes "without the provisioning config"  "${tracked}" "user_data.yaml"
excludes "without the dotenv"               "${tracked}" ".env"
contains "with the public key"              "${tracked}" "keys/id_ecdsa.pub"
check    "and not the private one"          "$(git -C "${d}" ls-files keys/id_ecdsa)" ""

# A `%` is a prompt escape to print -P and a backslash an escape to print, so a
# path carrying either used to come out rewritten: `%B` turned bold, `\t` a tab.
print -r -- "a path with % and a backslash is printed as it is"
d="$(mk_plain 'odd%Bdir\tname')"
run_update "${d}"
check    "it switches"                      "${RC}" "0"
contains "naming the path verbatim"         "${OUT}" "${d} is not a git checkout"

# Without git there is nothing to adopt with; the old one-liner stands.
print -r -- "without git on PATH the plain directory is named as unchecked"
d="$(mk_plain_ignored nogit)"
# The one link is moved aside for the run: a second copy of the tool farm is
# thousands of `ln` processes for the sake of leaving one name out.
mv "${TOOLS}/git" "${BASE}/git.aside"
run_update "${d}"
mv "${BASE}/git.aside" "${TOOLS}/git"
check    "it switches"                      "${RC}" "0"
check    "exactly once"                     "$(switches)" "1"
contains "and says the check was skipped"   "${OUT}" "${d} is not a git checkout — no drift check"
check    "no repository was made"           "$([[ -e "${d}/.git" ]] && print yes || print no)" "no"

# ---------------------------------------------------------------------------
# 2. A repository with no remote: local history, nothing to be behind
# ---------------------------------------------------------------------------
print -r -- "a repository without a remote switches"
d="$(mk_local local)"
run_update "${d}"
check    "it switches"                      "${RC}" "0"
check    "exactly once"                     "$(switches)" "1"
contains "and says why nothing was fetched" "${OUT}" "no git remote"
excludes "with no origin/HEAD advice"       "${OUT}" "origin/HEAD"
excludes "and no stale refusal"             "${OUT}" "stale"

print -r -- "a dirty local repository is still warned about"
print -r -- '# edit' >> "${d}/flake.nix"
run_update "${d}"
check    "it switches"                      "${RC}" "0"
contains "and names the uncommitted change" "${OUT}" "uncommitted changes"

# ---------------------------------------------------------------------------
# 3. A repository with a remote keeps the drift check it always had
# ---------------------------------------------------------------------------
print -r -- "a repository in sync with its remote switches quietly"
d="$(mk_remote synced)"
run_update "${d}"
check    "it switches"                      "${RC}" "0"
check    "exactly once"                     "$(switches)" "1"
excludes "with no skipped-check line"       "${OUT}" "no drift check"
excludes "and no warning at all"            "${OUT}" "⚠"

print -r -- "a clean repository behind its remote is pulled and switched"
d="$(mk_remote behind)"
git clone -q "${BASE}/behind.git" "${BASE}/behind-other"
push_upstream() {
  print -r -- "$1" >> "${BASE}/behind-other/flake.nix"
  git -C "${BASE}/behind-other" commit -q -am "$1"
  git -C "${BASE}/behind-other" push -q origin main
}
push_upstream '# upstream'
run_update "${d}"
check    "it switches"                      "${RC}" "0"
check    "exactly once"                     "$(switches)" "1"
contains "naming the commit count"          "${OUT}" "1 commit(s) behind remote"
contains "and the pull"                     "${OUT}" "pulled --rebase"
check    "and HEAD is the remote's"         "$(git -C "${d}" rev-parse HEAD)" "$(git -C "${d}" rev-parse origin/main)"
excludes "with no stale refusal"            "${OUT}" "stale"

print -r -- "FLAKELAB_STALE_OK=1 rebuilds the stale tree as it is"
push_upstream '# upstream 2'
before="$(git -C "${d}" rev-parse HEAD)"
FLAKELAB_STALE_OK=1 run_update "${d}"
check    "it switches"                      "${RC}" "0"
check    "exactly once"                     "$(switches)" "1"
contains "saying so"                        "${OUT}" "FLAKELAB_STALE_OK=1"
check    "and HEAD is untouched"            "$(git -C "${d}" rev-parse HEAD)" "${before}"

print -r -- "a dirty repository behind its remote is refused, not stashed"
print -r -- '# local edit' >> "${d}/flake.nix"
run_update "${d}"
check    "it refuses"                       "${RC}" "1"
check    "with no switch"                   "$(switches)" "0"
contains "naming the uncommitted change"    "${OUT}" "commit or stash first"
check    "and the edit is still there"      "$(git -C "${d}" status --porcelain)" " M flake.nix"
git -C "${d}" checkout -q -- flake.nix

print -r -- "a conflicting rebase is aborted and refused"
print -r -- '# upstream 2' > "${d}/flake.nix"
print -r -- '# mine' >> "${d}/flake.nix"
git -C "${d}" commit -q -am mine
before="$(git -C "${d}" rev-parse HEAD)"
run_update "${d}"
check    "it refuses"                       "${RC}" "1"
check    "with no switch"                   "$(switches)" "0"
contains "naming the failed pull"           "${OUT}" "pull --rebase failed"
check    "HEAD is untouched"                "$(git -C "${d}" rev-parse HEAD)" "${before}"
check    "and no rebase is left in progress" "$([[ -d "${d}/.git/rebase-merge" || -d "${d}/.git/rebase-apply" ]] && print yes || print no)" "no"

print -r -- "the fetch prunes remote branches that are gone"
git -C "${BASE}/behind-other" push -q origin main:gone
git -C "${d}" fetch -q
check    "origin/gone is known before"      "$(git -C "${d}" branch -r --list origin/gone | tr -d ' ')" "origin/gone"
git -C "${BASE}/behind-other" push -q origin --delete gone
FLAKELAB_STALE_OK=1 run_update "${d}"
check    "it switches"                      "${RC}" "0"
check    "and origin/gone is pruned"        "$(git -C "${d}" branch -r --list origin/gone | tr -d ' ')" ""

# The checkout is usually the overlay, not flakelab: the warning names the one it
# actually could not fetch.
print -r -- "a failed fetch names the checkout it could not fetch"
d="$(mk_remote unreachable)"
git -C "${d}" remote set-url origin "${BASE}/nowhere.git"
run_update "${d}"
check    "it refuses"                       "${RC}" "1"
check    "with no switch"                   "$(switches)" "0"
contains "naming the checkout"              "${OUT}" "Could not fetch ${d}"
excludes "without blaming flakelab"         "${OUT}" "flakelab updates"

# ---------------------------------------------------------------------------
# 4. A lock the caller cannot write is taken back, pins intact
# ---------------------------------------------------------------------------
# Root leaves one behind whenever its switch had to lock; the caller's re-lock then
# fails and the switch builds the stale snapshot. The lock content is not a real
# lock, so the re-lock step reads no flakelab input and stays out of the way -
# except where `nix` is shimmed to report a path: input whose re-lock fails.
# Root writes through a read-only mode, so as root none of this is observable.
lock_state() { [[ -w "$1/flake.lock" ]] && print -r -- writable || print -r -- read-only }
shim_nix() {
cat > "${SHIM}/nix" <<'STUB'
#!/usr/bin/env zsh
case "$1" in
  eval)  print -rn -- "path|/flakelab||" ;;
  flake) print -r -u2 -- "error: opening file \"${FLAKELAB_REPO_ROOT}/flake.lock\": Permission denied"; exit 1 ;;
esac
exit 0
STUB
  chmod +x "${SHIM}/nix"
}

if (( EUID == 0 )); then
  print -r -- "lock cases skipped: root can write a read-only lock"
else
  print -r -- "a read-only lock is taken back before the switch"
  d="$(mk_plain lockro)"
  print -r -- '{ "pins": "kept" }' > "${d}/flake.lock"
  chmod 444 "${d}/flake.lock"
  run_update "${d}"
  check    "it switches"                    "${RC}" "0"
  check    "exactly once"                   "$(switches)" "1"
  check    "the lock is writable again"     "$(lock_state "${d}")" "writable"
  check    "with its content unchanged"     "$(< "${d}/flake.lock")" '{ "pins": "kept" }'
  contains "saying so"                      "${OUT}" "took it back"
  check    "and no temporary copy is left"  "$(print -r -- "${d}"/.flake.lock.reclaim.*(N))" ""

  print -r -- "a lock the switch writes as root is taken back after it"
  d="$(mk_plain lockafter)"
  SUDO_WRITES_LOCK=1 run_update "${d}"
  check    "it switches"                    "${RC}" "0"
  check    "the lock is writable"           "$(lock_state "${d}")" "writable"
  check    "and is the one the switch wrote" "$(< "${d}/flake.lock")" '{ "written": "by root" }'

  print -r -- "and after a switch that failed"
  d="$(mk_plain lockfailed)"
  SUDO_WRITES_LOCK=1 SUDO_RC=100 run_update "${d}"
  check    "the switch's status comes through" "${RC}" "100"
  check    "and the lock is writable"       "$(lock_state "${d}")" "writable"

  print -r -- "a symlinked lock is left a symlink"
  d="$(mk_plain locklink)"
  print -r -- '{ }' > "${BASE}/locklink-target"
  chmod 444 "${BASE}/locklink-target"
  ln -s "${BASE}/locklink-target" "${d}/flake.lock"
  run_update "${d}"
  check    "it switches"                    "${RC}" "0"
  check    "and the link survives"          "$([[ -L "${d}/flake.lock" ]] && print yes || print no)" "yes"

  # A directory the caller cannot write stands in for a lock that cannot be taken back.
  print -r -- "a lock that cannot be taken back only warns when no path: re-lock needs it"
  d="$(mk_plain lockstuck)"
  print -r -- '{ }' > "${d}/flake.lock"
  chmod 444 "${d}/flake.lock"
  chmod 555 "${d}"
  run_update "${d}"
  check    "it switches"                    "${RC}" "0"
  check    "exactly once"                   "$(switches)" "1"
  contains "naming the chown"               "${OUT}" "sudo chown $(id -u):$(id -g) '${d}/flake.lock'"

  print -r -- "and refuses the switch when a path: re-lock fails on it"
  shim_nix
  run_update "${d}"
  chmod 755 "${d}"
  check    "it refuses"                     "${RC}" "1"
  check    "with no switch"                 "$(switches)" "0"
  contains "saying why"                     "${OUT}" "refusing to switch into the previously locked snapshot"
  contains "naming the chown"               "${OUT}" "sudo chown $(id -u):$(id -g) '${d}/flake.lock'"

  print -r -- "a path: re-lock that fails on a writable lock still only warns"
  d="$(mk_plain lockwritable)"
  print -r -- '{ }' > "${d}/flake.lock"
  run_update "${d}"
  rm -f "${SHIM}/nix"
  check    "it switches"                    "${RC}" "0"
  check    "exactly once"                   "$(switches)" "1"
  contains "with the warning it always had" "${OUT}" "could not re-lock"
  excludes "and no refusal"                 "${OUT}" "refusing"
fi

# ---------------------------------------------------------------------------
# 5. The switch's own status and the --all tail survive
# ---------------------------------------------------------------------------
print -r -- "a failed switch keeps nixos-rebuild's exit status"
d="$(mk_local rcpass)"
: > "${RESULT_LOG}"
SUDO_RC=100 run_update "${d}"
check    "exit 100 comes through"           "${RC}" "100"
contains "the classifier was given it"      "$(< "${RESULT_LOG}")" "--rc 100"

cat > "${SHIM}/nix-clone-repos" <<'STUB'
#!/usr/bin/env zsh
print -r -- "ran:nix-clone-repos"
STUB
chmod +x "${SHIM}/nix-clone-repos"

print -r -- "an activated switch with units down carries on, then exits 4"
SUDO_RC=4 RESULT_FAILED="user@1000.service docker.service" run_update "${d}" --all
check    "the switch ran"                   "$(switches)" "1"
contains "it names the units"               "${OUT}" "units are not running: user@1000.service docker.service"
contains "the sweep after it still ran"     "${OUT}" "ran:nix-clone-repos"
check    "and 4 is the exit status"         "${RC}" "4"

print -r -- "a 4 standing over a failed activation stops at the switch"
SUDO_RC=4 RESULT_RC=2 run_update "${d}" --all
check    "it exits 2"                       "${RC}" "2"
excludes "the sweep did not run"            "${OUT}" "ran:nix-clone-repos"

print -r -- "an unverifiable switch stops at the switch"
SUDO_RC=0 RESULT_RC=3 run_update "${d}" --all
check    "it exits 3"                       "${RC}" "3"
excludes "the sweep did not run"            "${OUT}" "ran:nix-clone-repos"

print -r -- "without the classifier on PATH only a clean switch carries on"
mv "${SHIM}/flakelab-switch-result" "${BASE}/switch-result.off"
SUDO_RC=4 run_update "${d}" --all
check    "it exits 4 at the switch"         "${RC}" "4"
excludes "the sweep did not run"            "${OUT}" "ran:nix-clone-repos"
contains "saying why"                       "${OUT}" "cannot be told apart from a failed activation"
run_update "${d}" --all
check    "a clean switch still exits 0"     "${RC}" "0"
contains "and sweeps"                       "${OUT}" "ran:nix-clone-repos"
mv "${BASE}/switch-result.off" "${SHIM}/flakelab-switch-result"
rm -f "${SHIM}/nix-clone-repos"

print -r -- "--all runs the clone sweep after the switch"
cat > "${SHIM}/nix-clone-repos" <<'STUB'
#!/usr/bin/env zsh
print -r -- "ran:nix-clone-repos"
STUB
chmod +x "${SHIM}/nix-clone-repos"
run_update "${d}" --all
check    "it exits clean"                   "${RC}" "0"
contains "and the sweep ran"                "${OUT}" "ran:nix-clone-repos"
rm -f "${SHIM}/nix-clone-repos"

print -r -- "--all without nix-clone-repos on PATH fails after the switch"
run_update "${d}" --all
check    "it exits 1"                       "${RC}" "1"
check    "after switching"                  "$(switches)" "1"
contains "and says what did not run"        "${OUT}" "nix-clone-repos is not on PATH"

# ---------------------------------------------------------------------------
# 6. The activation behind an unchanged generation
# ---------------------------------------------------------------------------
# `nixos-rebuild switch` restarts home-manager-<user>.service only when that unit
# changed, so a rebuild that builds the same closure leaves every deferred
# activation step deferred — the fresh-provision case, where the ssh key arrives
# between the two switches. The re-run is gated on there being something to
# re-run, so the cases below pair an unmoved stamp with a deferred log and
# without one. They all need a systemctl on PATH, so the boot-settle wait runs
# too and the shim answers that as well. The restart goes through sudo, which the
# shim above already records.
cat > "${SHIM}/systemctl" <<'STUB'
#!/usr/bin/env zsh
case "$1" in
  is-system-running) print -r -- running ;;
  is-active)         print -r -- active ;;
  is-failed)         [[ -n "${UNIT_FAILED:-}" ]] && exit 0; exit 1 ;;
  show)
    # show -p <stamp> --value <unit>. The stamp only moves when the case under test
    # says the switch restarted the unit, and ActiveEnterTimestampMonotonic only
    # when that start succeeded, the way systemd keeps both.
    print -r -- "$(< "${STAMP_FILE}")"
    if [[ -n "${STAMP_BUMP:-}" && ( "$3" != ActiveEnterTimestampMonotonic || -z "${UNIT_FAILED:-}" ) ]]; then
      print -r -- "$(( $(< "${STAMP_FILE}") + 1 ))" > "${STAMP_FILE}"
    fi
    ;;
esac
exit 0
STUB
chmod +x "${SHIM}/systemctl"
export STAMP_FILE="${BASE}/stamp"
print -r -- 100 > "${STAMP_FILE}"
DEFER_LOG="${HOME}/.local/state/flakelab/activation-deferred"
mkdir -p "${DEFER_LOG:h}"

print -r -- "a unit the switch left alone gets the activation re-run for its deferred steps"
d="$(mk_local rerun)"
print -r -- "kiro-plugin not cloned: no key yet" > "${DEFER_LOG}"
run_update "${d}"
check    "it switches"                      "${RC}" "0"
contains "it says the switch left the unit alone" "${OUT}" "the switch left home-manager-"
contains "and names what it re-runs for"    "${OUT}" "retry the 1 step(s)"
excludes "claiming nothing about the generation" "${OUT}" "generation unchanged"
contains "and restarts the unit"            "$(< "${SUDO_LOG}")" "systemctl restart home-manager-"
contains "the deferred count is named"      "${OUT}" "activation deferred"
contains "and the step is listed"           "${OUT}" "kiro-plugin not cloned"

print -r -- "a unit the switch left alone with nothing deferred is not restarted"
rm -f "${DEFER_LOG}"
run_update "${d}"
check    "it switches"                      "${RC}" "0"
excludes "with no restart line"             "${OUT}" "restarting it"
excludes "and no restart"                   "$(< "${SUDO_LOG}")" "systemctl restart"

print -r -- "a unit that has not activated at all this boot is re-run regardless"
print -r -- 0 > "${STAMP_FILE}"
run_update "${d}"
check    "it switches"                      "${RC}" "0"
contains "it says why"                      "${OUT}" "not activated at all this boot"
contains "and restarts the unit"            "$(< "${SUDO_LOG}")" "systemctl restart home-manager-"
print -r -- 100 > "${STAMP_FILE}"

print -r -- "a unit the switch restarted is left alone, deferred steps or not"
print -r -- "kiro-plugin not cloned: no key yet" > "${DEFER_LOG}"
export STAMP_BUMP=1
run_update "${d}"
unset STAMP_BUMP
check    "it switches"                      "${RC}" "0"
excludes "with no restart line"             "${OUT}" "restarting it"
excludes "and no restart"                   "$(< "${SUDO_LOG}")" "systemctl restart"
contains "but the deferred step is still listed" "${OUT}" "kiro-plugin not cloned"
rm -f "${DEFER_LOG}"

# The health check fails the unit on anything flakelab-warn recorded and on its
# own post-conditions, and `flakelab doctor` answers both with "Re-run: flakelab
# update" — which a switch building the same closure never does on its own.
FAIL_LOG="${HOME}/.local/state/flakelab/activation-failures"
print -r -- "a unit whose last activation failed is re-run, nothing deferred"
export UNIT_FAILED=1
run_update "${d}"
unset UNIT_FAILED
check    "it switches"                      "${RC}" "0"
contains "it says why"                      "${OUT}" "because its last activation failed"
contains "and restarts the unit"            "$(< "${SUDO_LOG}")" "systemctl restart home-manager-"

print -r -- "recorded failures are retried behind a unit that did not fail"
print -r -- "kiro-cli install failed" > "${FAIL_LOG}"
run_update "${d}"
check    "it switches"                      "${RC}" "0"
contains "it names what it retries"         "${OUT}" "retry the 1 step(s) the last activation reported failed"
contains "and restarts the unit"            "$(< "${SUDO_LOG}")" "systemctl restart home-manager-"
rm -f "${FAIL_LOG}"

# A failed start never enters `active`, so a stamp read from there would not
# move, and the gate would re-run what the switch had just run and seen fail.
print -r -- "a unit the switch restarted into a failure is not run a second time"
export STAMP_BUMP=1 UNIT_FAILED=1
run_update "${d}"
unset STAMP_BUMP UNIT_FAILED
check    "it switches"                      "${RC}" "0"
excludes "with no restart line"             "${OUT}" "restarting it"
excludes "and no restart"                   "$(< "${SUDO_LOG}")" "systemctl restart"
rm -f "${SHIM}/systemctl"

# ---------------------------------------------------------------------------
# 7. What the re-lock reports
# ---------------------------------------------------------------------------
# `nix flake update` exits 0 whether or not the input moved, so the run reads the
# lock on both sides and says which it was. The count comes from a local clone of
# the same repo that already has both revs - no fetch, no network. `nix` is shimmed
# for `flake update` only (it would reach github); `eval` goes to the real one, so
# the expression that reads the lock is under test too — which needs TOOLS in the
# shim's own environment. The check sandbox has a nix for this suite, evaluating
# against a dummy store, so there is no second reading of the lock to fall back on.
export TOOLS
cat > "${SHIM}/nix" <<'STUB'
#!/usr/bin/env zsh
if [[ "$1" == flake && "$2" == update ]]; then
  [[ -n "${LOCK_AFTER:-}" ]] && cp "${LOCK_AFTER}" "${FLAKELAB_REPO_ROOT}/flake.lock"
  print -r -- "• Updated input 'flakelab'"
  exit 0
fi
exec "${TOOLS}/nix" "$@"
STUB
chmod +x "${SHIM}/nix"

# The clone the count is read from: three commits, its origin naming the same repo
# as the lock below.
CLONE="${HOME}/git/tyclab/flakelab"
mkdir -p "${CLONE}"
git -C "${CLONE}" init -q
for _i in 1 2 3 4; do
  print -r -- "${_i}" > "${CLONE}/n"
  git -C "${CLONE}" add -A
  git -C "${CLONE}" commit -q -m "c${_i}"
done
git -C "${CLONE}" remote add origin git@github.com:tyclab/flakelab.git
REV_OLD="$(git -C "${CLONE}" rev-parse HEAD~3)"
REV_NEW="$(git -C "${CLONE}" rev-parse HEAD)"
REV_GONE="0123456789abcdef0123456789abcdef01234567"

# mk_lock_entry <locked fields> <file>: a lock whose flakelab input is locked as given.
mk_lock_entry() {
  print -r -- "{\"nodes\":{\"root\":{\"inputs\":{\"flakelab\":\"flakelab\"}},\"flakelab\":{\"locked\":{$1}}},\"root\":\"root\",\"version\":7}" > "$2"
}
mk_lock() {
  mk_lock_entry "\"type\":\"github\",\"owner\":\"tyclab\",\"repo\":\"flakelab\",\"rev\":\"$1\"" "$2"
}

print -r -- "an input that moved names both revs and counts what came in"
d="$(mk_local relock)"
mk_lock "${REV_OLD}" "${d}/flake.lock"
mk_lock "${REV_NEW}" "${BASE}/lock.after"
export LOCK_AFTER="${BASE}/lock.after"
run_update "${d}"
check    "it switches"                      "${RC}" "0"
contains "it names the old rev"             "${OUT}" "${REV_OLD[1,7]} →"
contains "and the new one"                  "${OUT}" "→ ${REV_NEW[1,7]}"
contains "and how many commits came in"     "${OUT}" "3 commit(s)"

print -r -- "an input that moved to a rev no clone has is named without a count"
mk_lock "${REV_OLD}" "${d}/flake.lock"
mk_lock "${REV_GONE}" "${BASE}/lock.after"
export LOCK_AFTER="${BASE}/lock.after"
run_update "${d}"
check    "it switches"                      "${RC}" "0"
contains "it still names both revs"         "${OUT}" "${REV_OLD[1,7]} → ${REV_GONE[1,7]}"
excludes "with no count"                    "${OUT}" "commit(s)"

print -r -- "an input that went backwards says so"
mk_lock "${REV_NEW}" "${d}/flake.lock"
mk_lock "${REV_OLD}" "${BASE}/lock.after"
export LOCK_AFTER="${BASE}/lock.after"
run_update "${d}"
contains "it counts the other way"          "${OUT}" "3 commit(s) back"

print -r -- "an input that did not move is not called updated"
mk_lock "${REV_NEW}" "${d}/flake.lock"
mk_lock "${REV_NEW}" "${BASE}/lock.after"
export LOCK_AFTER="${BASE}/lock.after"
run_update "${d}"
check    "it switches"                      "${RC}" "0"
contains "it says unchanged, with the rev"  "${OUT}" "flakelab input unchanged (${REV_NEW[1,7]})"
excludes "and never claims an update"       "${OUT}" "input updated"

# The lock names a repo as `owner/repo` (a GitLab subgroup's owner keeps its `/`)
# or, for a git input, as a whole URL; a clone's origin is any of the three URL
# shapes. Both come down to the path after the host, and the clone is looked for
# as deep as the clone sweep mirrors a namespace.
# elsewhere <dir under ~/git> <origin>: another clone of the same history.
elsewhere() {
  git clone -q "${CLONE}" "${HOME}/git/$1"
  git -C "${HOME}/git/$1" remote set-url origin "$2"
}
# relock_between <locked fields before> <locked fields after>
relock_between() {
  mk_lock_entry "$1" "${d}/flake.lock"
  mk_lock_entry "$2" "${BASE}/lock.after"
  run_update "${d}"
}

print -r -- "a git input is counted in the clone its URL names"
elsewhere grp/flakelab git@gitlab.com:grp/flakelab.git
relock_between "\"type\":\"git\",\"url\":\"https://gitlab.com/Grp/flakelab.git\",\"rev\":\"${REV_OLD}\"" \
               "\"type\":\"git\",\"url\":\"https://gitlab.com/Grp/flakelab.git\",\"rev\":\"${REV_NEW}\""
check    "it switches"                      "${RC}" "0"
contains "and counts what came in"          "${OUT}" "${REV_OLD[1,7]} → ${REV_NEW[1,7]} — 3 commit(s)"
relock_between "\"type\":\"git\",\"url\":\"ssh://git@gitlab.com:2222/grp/flakelab\",\"rev\":\"${REV_OLD}\"" \
               "\"type\":\"git\",\"url\":\"ssh://git@gitlab.com:2222/grp/flakelab\",\"rev\":\"${REV_NEW}\""
contains "as an ssh:// URL with a port too" "${OUT}" "— 3 commit(s)"
rm -rf "${HOME}/git/grp"

print -r -- "a GitLab subgroup is counted in its clone three levels down"
elsewhere grp/sub/flakelab https://gitlab.com/grp/sub/flakelab.git
relock_between "\"type\":\"gitlab\",\"owner\":\"grp/sub\",\"repo\":\"flakelab\",\"rev\":\"${REV_OLD}\"" \
               "\"type\":\"gitlab\",\"owner\":\"grp/sub\",\"repo\":\"flakelab\",\"rev\":\"${REV_NEW}\""
check    "it switches"                      "${RC}" "0"
contains "and counts what came in"          "${OUT}" "— 3 commit(s)"
rm -rf "${HOME}/git/grp"

print -r -- "a repo whose path only ends in the same letters is not the input's clone"
mv "${CLONE}" "${BASE}/clone.aside"
git clone -q "${BASE}/clone.aside" "${HOME}/git/nottyclab/flakelab"
git -C "${HOME}/git/nottyclab/flakelab" remote set-url origin git@github.com:nottyclab/flakelab.git
mk_lock "${REV_OLD}" "${d}/flake.lock"
mk_lock "${REV_NEW}" "${BASE}/lock.after"
run_update "${d}"
check    "it switches"                      "${RC}" "0"
contains "it names both revs"               "${OUT}" "${REV_OLD[1,7]} → ${REV_NEW[1,7]}"
excludes "with no count from the other repo" "${OUT}" "commit(s)"
rm -rf "${HOME}/git/nottyclab"
mv "${BASE}/clone.aside" "${CLONE}"

# nix locks a `git+file:` input as type `git` with a file:// URL.
print -r -- "a git+file: input is named as local, and still re-locked"
relock_between "\"type\":\"git\",\"url\":\"file:///srv/flakelab\",\"rev\":\"${REV_OLD}\"" \
               "\"type\":\"git\",\"url\":\"file:///srv/flakelab\",\"rev\":\"${REV_NEW}\""
check    "it switches"                      "${RC}" "0"
contains "it names the checkout"            "${OUT}" "LOCAL flakelab (git+file: /srv/flakelab) — only committed content is in this build"
contains "and what the re-lock moved"       "${OUT}" "${REV_OLD[1,7]} → ${REV_NEW[1,7]}"

# A tarball input locks no rev, only the hash of what it unpacked to.
print -r -- "an input with no rev is compared by its content hash"
relock_between '"type":"tarball","url":"https://example.invalid/f.tar.gz","narHash":"sha256-AAAA"' \
               '"type":"tarball","url":"https://example.invalid/f.tar.gz","narHash":"sha256-BBBB"'
check    "it switches"                      "${RC}" "0"
contains "a moved hash is an update"        "${OUT}" "flakelab input updated"
excludes "not unchanged"                    "${OUT}" "input unchanged"
relock_between '"type":"tarball","url":"https://example.invalid/f.tar.gz","narHash":"sha256-BBBB"' \
               '"type":"tarball","url":"https://example.invalid/f.tar.gz","narHash":"sha256-BBBB"'
contains "the same hash is unchanged"       "${OUT}" "flakelab input unchanged"
excludes "and not an update"                "${OUT}" "input updated"
unset LOCK_AFTER
rm -f "${SHIM}/nix"

# A box with no `nix` on PATH, like a lock it cannot read, yields nothing to split:
# every field has to survive that, or `set -u` kills the run at 127.
print -r -- "a lock the eval cannot read leaves the input alone and still switches"
cat > "${SHIM}/nix" <<'STUB'
#!/usr/bin/env zsh
exit 0
STUB
chmod +x "${SHIM}/nix"
run_update "${d}"
check    "it switches"                      "${RC}" "0"
check    "exactly once"                     "$(switches)" "1"
excludes "saying nothing about the input"   "${OUT}" "flakelab input"
excludes "and not dying on the short split" "${OUT}" "parameter not set"
rm -f "${SHIM}/nix"

print -r -- "usage"
run_update "${d}" --help
check    "--help exits 0"                   "${RC}" "0"
run_update "${d}" --bogus
check    "an unknown flag exits 2"          "${RC}" "2"

# ---------------------------------------------------------------------------
print -r -- ""
print -r -- "${PASS} passed, ${FAIL} failed"
(( FAIL == 0 ))
