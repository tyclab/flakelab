#!/usr/bin/env zsh

set -uo pipefail

#
# Offline test suite for nix-overlay-generate.
#
# Same shape as test-nix-backup and test-gitpublisher: the real script, driven
# end to end against throwaway --out directories under a mktemp root, so no test
# touches the caller's own files. The tracked templates/overlay/ and profiles/
# ARE the fixtures for everything the generator reads out of the checkout - the
# point of this suite is that the shipped template and the shipped example
# config produce a usable overlay, which a hand-made copy of either would stop
# proving the moment one of them changed.
#
# NO `nix` HERE, deliberately. `nix flake metadata` on a generated overlay is
# the real acceptance check, and it is run by hand (see the MR that added this
# file), but it cannot live in this suite: `nix flake check` builds it inside a
# sandbox with no nix, no network and no store access, and a case that quietly
# skipped there would be the exact silent green flake.nix's suiteCheck bans skip
# lines to prevent. So every assertion below is on FILE CONTENT - placeholder
# resolved, values substituted, secrets absent, stub git-ignored - which is what
# can be checked truthfully offline.
#
# Usage: files/scripts/test-nix-overlay-generate
#

SCRIPT_DIR="${0:A:h}"
GEN="${SCRIPT_DIR}/nix-overlay-generate"
REPO_ROOT="${SCRIPT_DIR:h:h}"
EXAMPLE="${REPO_ROOT}/files/config/user_data.example.yaml"
TEMPLATE="${REPO_ROOT}/templates/overlay/flake.nix"
typeset -i PASS=0 FAIL=0

# Both end in `return 0`: `(( PASS++ ))` yields the value BEFORE the increment,
# so the first call returns 1 and an `&& ok || bad` chain would run both arms.
ok()   { print -r -- "  ok   $1"; (( PASS++ )); return 0 }
bad()  { print -r -u2 -- "  FAIL $1"; (( FAIL++ )); return 0 }
check() { [[ "$2" == "$3" ]] && ok "$1" || { bad "$1"; print -r -u2 -- "       expected: $3"; print -r -u2 -- "       actual:   $2" } }
contains() { [[ "$2" == *"$3"* ]] && ok "$1" || { bad "$1"; print -r -u2 -- "       missing: $3" } }
excludes() { [[ "$2" != *"$3"* ]] && ok "$1" || bad "$1 (unexpected: $3)" }
exists() { [[ -e "$2" ]] && ok "$1" || bad "$1 (no such path: $2)" }

BASE="$(mktemp -d)"
trap 'rm -rf "${BASE}"' EXIT

# run_gen — the real script, sandboxed to an --out under BASE. Sets OUT and RC
# rather than printing: a `$(run_gen)` would run the function in a subshell, and
# the exit status it recorded there would never reach the assertion here.
typeset -i RC=0
OUT=""
run_gen() {
  OUT="$("${GEN}" "$@" 2>&1)"
  RC=$?
}

# run_gen_at <script> <args...> — run_gen against a COPY of the script rather
# than ${GEN}. Same OUT/RC contract, for the cases whose subject is the checkout
# the script sits in.
run_gen_at() {
  local script="$1"
  shift
  OUT="$("${script}" "$@" 2>&1)"
  RC=$?
}

# mk_fake_checkout <dir> <profile>... — the three directories the generator reads
# next to itself, populated from the tracked ones plus a stub profile per name.
# That is a complete checkout as far as it is concerned. Never REPO_ROOT: the
# cases using it are about what the script writes into the checkout it finds.
mk_fake_checkout() {
  local dir="$1"
  shift
  mkdir -p "${dir}/files/scripts" "${dir}/templates/overlay" "${dir}/profiles"
  cp "${GEN}" "${dir}/files/scripts/"
  cp "${REPO_ROOT}/templates/overlay/flake.nix" "${dir}/templates/overlay/flake.nix"
  cp "${REPO_ROOT}/templates/overlay/.gitignore" "${dir}/templates/overlay/.gitignore"
  local p
  for p in "$@"; do print -r -- '{ }' > "${dir}/profiles/${p}.nix"; done
}

# out <name> — a fresh, empty overlay directory path (not created; the script
# creates it, and half these cases are about what it does when it does not
# exist).
out() {
  OUTDIR="${BASE}/$1"
  rm -rf "${OUTDIR}"
  print -r -- "${OUTDIR}"
}

flake_of() { print -r -- "$(< "$1/flake.nix")" }

# `stat -c` is GNU, `stat -f` is BSD, and macOS is a platform the script under
# test explicitly supports - so a suite that only knows the GNU spelling cannot
# run where the feature is aimed. Both arms read the same thing; if neither
# works the output is empty and the assertion fails loudly rather than passing.
file_mode() { stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1" }
# The same discriminator both writers use - setup-wsl-nix.ps1 matches
# `#\s*flakelab-url:` and nix-overlay-generate matches `# flakelab-url:`. Counting a
# bare `flakelab-url:` instead would also count the prose above the anchor, which
# is exactly the false positive that would let a template with NO anchor pass.
markers_in() { grep -c '#[[:space:]]*flakelab-url:' "$1" }

print -r -- "test-nix-overlay-generate"

# ---------------------------------------------------------------------------
# 1. The shipped template is substitutable at all
# ---------------------------------------------------------------------------
# Two writers rewrite the flakelab input line by this marker - this script and
# setup-wsl-nix.ps1's New-OverlaySkeleton. Losing it, or growing a second one,
# breaks both, and then nothing points a scaffold at a flakelab that exists. That
# matters because the DEFAULT does not: the `%FLAKELAB_PATH%` literal it replaced
# was unresolvable by construction (nix read it as a relative path and looked
# for a directory of that name inside the store copy), and the mirror named in
# its place is not published yet. The anchor is what keeps "point this at
# something real" a one-line rewrite either way.
print -r -- "the shipped templates/overlay/flake.nix carries the substitution anchor"
check "exactly one flakelab-url: anchor line" "$(markers_in "${TEMPLATE}")" "1"
excludes "and no %FLAKELAB_PATH% literal is left" "$(< "${TEMPLATE}")" '%FLAKELAB_PATH%'
contains "the anchor line is the input URL"   "$(< "${TEMPLATE}")" 'inputs.flakelab.url = "github:tyclab/flakelab"; # flakelab-url:'

# ---------------------------------------------------------------------------
# 2. A bare scaffold: no config, no flags
# ---------------------------------------------------------------------------
print -r -- "a bare scaffold is the template with the input URL resolved"
o="$(out bare)"
run_gen --out "${o}"
check "exits clean" "${RC}" "0"
exists "flake.nix is written"      "${o}/flake.nix"
exists ".gitignore is written"     "${o}/.gitignore"
exists "the ssh key dir is kept"   "${o}/files/config/shared/ssh/keys/.gitkeep"
exists "the secrets stub is there" "${o}/files/config/shared/secrets/secrets.env"
f="$(flake_of "${o}")"
excludes "no placeholder survives"          "${f}" '%FLAKELAB_PATH%'
contains "the input points at this checkout" "${f}" "inputs.flakelab.url = \"path:${REPO_ROOT}\";"
check    "the anchor survives for the next writer" "$(markers_in "${o}/flake.nix")" "1"
contains "the hand-edit placeholders are kept" "${f}" 'username = "CHANGEME";'
check "the .gitignore is the template's, verbatim" \
  "$(< "${o}/.gitignore")" "$(< "${REPO_ROOT}/templates/overlay/.gitignore")"

# ---------------------------------------------------------------------------
# 2b. Store mode refuses to default the flakelab input
# ---------------------------------------------------------------------------
# `flakelab overlay-gen` execs this script out of the flake source in the nix
# store, so ${0:A:h:h:h} is a store path. Defaulting the input to `path:<that>`
# would write an immutable, garbage-collectable ref into the overlay and pin the
# operator to a frozen snapshot. The script must refuse instead - and must still
# work when the ref is supplied. NIX_STORE points the check at a throwaway
# prefix so this runs without writing into the real store.
print -r -- "running from the store refuses to default the flakelab input"
STORE_FAKE="${BASE}/fakestore"
mk_fake_checkout "${STORE_FAKE}/src" example
STORE_GEN="${STORE_FAKE}/src/files/scripts/nix-overlay-generate"

o="$(out storedefault)"
OUT="$(NIX_STORE="${STORE_FAKE}" "${STORE_GEN}" --out "${o}" 2>&1)"; RC=$?
check    "it exits 1"                        "${RC}" "1"
contains "and names the flag to pass"        "${OUT}" "--flakelab-ref"
contains "and says why there is no default"  "${OUT}" "running from the nix store"
[[ ! -e "${o}/flake.nix" ]] && ok "no overlay is written" || bad "no overlay is written"

o="$(out storeslash)"
OUT="$(NIX_STORE="${STORE_FAKE}/" "${STORE_GEN}" --out "${o}" 2>&1)"; RC=$?
check "a trailing slash on NIX_STORE does not bypass it" "${RC}" "1"

print -r -- "running from the store works with an explicit --flakelab-ref"
o="$(out storeref)"
OUT="$(NIX_STORE="${STORE_FAKE}" "${STORE_GEN}" --out "${o}" \
  --flakelab-ref 'github:tyclab/flakelab' 2>&1)"; RC=$?
check    "it exits clean"                   "${RC}" "0"
f="$(flake_of "${o}")"
contains "the input is the ref that was passed" "${f}" 'inputs.flakelab.url = "github:tyclab/flakelab";'
excludes "and no store path leaks in"           "${f}" "${STORE_FAKE}"

# ---------------------------------------------------------------------------
# 3. The secrets contract
# ---------------------------------------------------------------------------
# The generator's whole relationship with secrets: it creates an empty, private,
# git-ignored file and stops. Anything else would put a token in a git repo the
# adopter is about to push, or in the world-readable nix store.
print -r -- "the secrets stub is empty, private and git-ignored"
check "it is zero bytes"      "$(wc -c < "${o}/files/config/shared/secrets/secrets.env")" "0"
check "and owner-only"        "$(file_mode "${o}/files/config/shared/secrets/secrets.env")" "600"
contains "the overlay .gitignore names it" "$(< "${o}/.gitignore")" "secrets.env"

# ---------------------------------------------------------------------------
# 4. Generation from the shipped example config
# ---------------------------------------------------------------------------
print -r -- "the shipped user_data.example.yaml generates a filled-in overlay"
o="$(out fromexample)"
run_gen --out "${o}" --config "${EXAMPLE}"
check "exits clean" "${RC}" "0"
f="$(flake_of "${o}")"
excludes "nothing is left to hand-edit" "${f}" "CHANGEME"
check    "the anchor survives"          "$(markers_in "${o}/flake.nix")" "1"

# Every option nix/options.nix declares WITHOUT a default has to be emitted even
# when the config is silent about it, or mkSystem aborts. This is that list.
print -r -- "every option with no default is emitted"
contains "username"        "${f}" 'username = "tycuser";'
contains "gitName"         "${f}" 'gitName = "Your Name";'
contains "gitEmail"        "${f}" 'gitEmail = "you@example.com";'
contains "locale"          "${f}" 'locale = "de_DE.UTF-8";'
contains "windowsUsername" "${f}" 'windowsUsername = "WindowsUser";'
contains "repoPath"        "${f}" "repoPath = \"${o}\";"
contains "backupAutostart" "${f}" 'backupAutostart = false;'
contains "gitEditor"       "${f}" 'gitEditor = "code";'
contains "cloneExclude keeps flakelab out of ~/git" "${f}" '"flakelab"'
contains "cloneExclude keeps the overlay out too" "${f}" '"fromexample"'

print -r -- "lists and maps come across"
contains "the profile"    "${f}" 'profiles = [ "example" ];'
# The comment above that list is the one place the generated overlay states what
# selecting a profile does. setup-wsl-nix.ps1's New-OverlayFlakeText emits the
# same two lines by hand; nothing drives PowerShell here, so this pins one writer
# and the other stays a manual match.
contains "and the comment states the mechanism" "${f}" \
  'Selecting a profile is the only thing that'
contains "naming what it installs" "${f}" 'installs its gitlabGroups and profileCliTools.'
contains "the personal group" "${f}" 'gitlabGroups = [ "family-recipes" ];'
contains "the ssh identity"   "${f}" 'sshKeys = [ "id_ed25519" ];'
contains "an alias"           "${f}" 'k = "kiro-cli chat";'
contains "and the second one" "${f}" 'kk = "kiro-cli chat --trust-all-tools";'
contains "a non-secret endpoint" "${f}" 'HASS_URL = "http://homeassistant.example.lan:8123";'
# `PROXMOX_API_URL: 'https://...' # base URL, no /api2/json` - the trailing
# comment is not part of the value, and a value carrying one would be a URL nix
# happily accepts and nothing on the box can reach.
contains "an inline comment is not part of the value" "${f}" 'PROXMOX_API_URL = "https://pve.example.lan:8006";'
excludes "so no comment text leaks into a value" "${f}" 'no /api2/json"'

# ---------------------------------------------------------------------------
# 5. No secret from the config reaches the flake
# ---------------------------------------------------------------------------
# The nix store is world-readable and the overlay is a git repo about to be
# pushed. custom_env_vars is split by NAME, exactly as setup-wsl-nix.ps1 splits
# it, and the secret half is dropped rather than written anywhere.
print -r -- "no secret from the config reaches the flake"
for k in GITLAB_TOKEN GH_TOKEN HASS_TOKEN PROXMOX_TOKEN_ID PROXMOX_TOKEN_SECRET \
         SYNOLOGY_PASSWORD SYNOLOGY_DEVICE_ID GRAFANA_SERVICE_ACCOUNT_TOKEN WHATSAPP_API_KEY; do
  excludes "${k} is not in the flake" "${f}" "${k}"
done
excludes "nor is a token VALUE from the config" "${f}" 'your-gitlab-personal-access-token'
contains "and the run says which ones it dropped" "${OUT}" "GITLAB_TOKEN"
contains "saying where they belong instead"       "${OUT}" ".config/tyc/secrets.env"
check "the stub it wrote is still empty" \
  "$(wc -c < "${o}/files/config/shared/secrets/secrets.env")" "0"

# ---------------------------------------------------------------------------
# 6. Regenerating the same input twice changes nothing
# ---------------------------------------------------------------------------
print -r -- "a second --force run reproduces the first byte for byte"
first="${f}"
run_gen --out "${o}" --config "${EXAMPLE}" --force
check "the second run is clean"       "${RC}" "0"
check "and the flake is unchanged"    "$(flake_of "${o}")" "${first}"

# ---------------------------------------------------------------------------
# 7. An existing overlay is kept unless --force says otherwise
# ---------------------------------------------------------------------------
print -r -- "an existing flake.nix is kept without --force"
o="$(out keep)"
run_gen --out "${o}" --config "${EXAMPLE}"
print -r -- '# hand-edited' > "${o}/flake.nix"
run_gen --out "${o}" --config "${EXAMPLE}"
check    "the run still exits clean" "${RC}" "0"
check    "the hand edit survives"    "$(flake_of "${o}")" "# hand-edited"
contains "and it says so"            "${OUT}" "keeping existing flake.nix"
run_gen --out "${o}" --config "${EXAMPLE}" --force
contains "--force overwrites it" "$(flake_of "${o}")" 'username = "tycuser";'

# The one file --force must NOT touch: it is the only thing in the overlay that
# can already hold real tokens, and no regeneration is worth losing them.
print -r -- "--force never overwrites a secrets.env that already has content"
print -r -- 'GITLAB_TOKEN="already-here"' > "${o}/files/config/shared/secrets/secrets.env"
run_gen --out "${o}" --config "${EXAMPLE}" --force
check "the operator's file survives" \
  "$(< "${o}/files/config/shared/secrets/secrets.env")" 'GITLAB_TOKEN="already-here"'

# ---------------------------------------------------------------------------
# 8. --dry-run writes nothing
# ---------------------------------------------------------------------------
print -r -- "--dry-run writes nothing"
o="$(out dry)"
run_gen --out "${o}" --config "${EXAMPLE}" --dry-run
check    "it exits clean"          "${RC}" "0"
contains "it says what it would do" "${OUT}" "flake.nix"
[[ -e "${o}/flake.nix" ]] && bad "no flake.nix is created" || ok "no flake.nix is created"

# ---------------------------------------------------------------------------
# 9. Flags without a config, and flags over a config
# ---------------------------------------------------------------------------
print -r -- "value flags alone generate an overlay"
o="$(out flags)"
run_gen --out "${o}" --user ada --git-name 'Ada Lovelace' --git-email ada@example.com \
  --profiles example --flakelab-ref 'github:tyclab/flakelab'
check "exits clean" "${RC}" "0"
f="$(flake_of "${o}")"
contains "the username is the flag's"   "${f}" 'username = "ada";'
contains "the git identity too"         "${f}" 'gitName = "Ada Lovelace";'
contains "--flakelab-ref is honoured"     "${f}" 'inputs.flakelab.url = "github:tyclab/flakelab";'
contains "an unset locale falls back"   "${f}" 'locale = "en_US.UTF-8";'
contains "an unset editor means null"   "${f}" 'gitEditor = null;'
contains "an unset autostart means false" "${f}" 'backupAutostart = false;'
# Off Windows there is no C:\Users\<name> to read, and the option is required.
contains "windowsUsername falls back to the Linux user" "${f}" 'windowsUsername = "ada";'
contains "and the flake says why"       "${f}" 'non-Windows run falls back'

print -r -- "a flag overrides the config value it names"
o="$(out override)"
run_gen --out "${o}" --config "${EXAMPLE}" --user grace --locale en_GB.UTF-8 --profiles example
f="$(flake_of "${o}")"
contains "the flag wins for username"  "${f}" 'username = "grace";'
contains "and for locale"              "${f}" 'locale = "en_GB.UTF-8";'
contains "and for profiles"            "${f}" 'profiles = [ "example" ];'
contains "unnamed keys still come from the config" "${f}" 'gitEmail = "you@example.com";'

# --profiles REPLACES the config's list rather than adding to it, which takes two
# known profiles to see and the shipped checkout has one. A copy of the script
# plus templates/overlay/ and a two-entry profiles/ is a complete checkout as far
# as it is concerned (same construction as the write-over-the-checkout case).
TWO="${BASE}/twocheckout"
TWO_GEN="${TWO}/files/scripts/nix-overlay-generate"
mk_fake_checkout "${TWO}" p-one p-two
print -r -- '{ gitlabGroups = [ "group-one" ]; }' > "${TWO}/profiles/p-one.nix"
print -r -- '{ gitlabGroups = [ "group-two" ]; }' > "${TWO}/profiles/p-two.nix"
cat > "${BASE}/twoprofiles.yaml" <<'YAML'
user: two
gitfullname: Two Person
gitmail: two@example.com
profiles:
  - p-one
YAML
o="$(out twoprofiles)"
run_gen_at "${TWO_GEN}" --out "${o}" --config "${BASE}/twoprofiles.yaml" --profiles p-two
check    "it generates"                    "${RC}" "0"
f="$(flake_of "${o}")"
contains "the flag's profile is selected"  "${f}" 'profiles = [ "p-two" ];'
excludes "and the config's is gone"        "${f}" '"p-one"'

# A config naming two profiles must emit BOTH. `_nix_list` has a separate
# one-element arm, so a list that collapsed to its first entry would still look
# right in every single-profile case above - and the box would silently lose one
# profile's groups and CLI tools.
print -r -- "a config listing two profiles emits both"
cat > "${BASE}/bothprofiles.yaml" <<'YAML'
user: two
gitfullname: Two Person
gitmail: two@example.com
profiles:
  - p-one
  - p-two
YAML
o="$(out bothprofiles)"
run_gen_at "${TWO_GEN}" --out "${o}" --config "${BASE}/bothprofiles.yaml"
check    "it generates"            "${RC}" "0"
f="$(flake_of "${o}")"
contains "both are in the list"    "${f}" $'profiles = [\n          "p-one"\n          "p-two"\n        ];'

# ---------------------------------------------------------------------------
# 10. Nix string escaping
# ---------------------------------------------------------------------------
# `${` is nix antiquotation: an alias like `echo ${FOO}` written raw turns the
# rest of the flake into an interpolation and the eval error names no file the
# adopter wrote. Backslash goes first or the escapes added after it double.
print -r -- "values that mean something to nix are escaped"
cat > "${BASE}/escape.yaml" <<'YAML'
user: esc
gitfullname: 'Ada # Lovelace'
gitmail: esc@example.com
profiles:
  - example
custom_aliases:
  - name: shout
    command: echo ${FOO} "quoted" back\slash
YAML
o="$(out escape)"
run_gen --out "${o}" --config "${BASE}/escape.yaml"
check "exits clean" "${RC}" "0"
f="$(flake_of "${o}")"
contains 'antiquotation is escaped'  "${f}" 'echo \${FOO}'
contains 'a quote is escaped'        "${f}" '\"quoted\"'
contains 'a backslash is doubled'    "${f}" 'back\\slash'
# A quoted scalar's closing quote is the LAST one on the line, so a '#' inside
# it is part of the value and not the start of a comment.
contains 'a # inside a quoted scalar survives' "${f}" 'gitName = "Ada # Lovelace";'

# ---------------------------------------------------------------------------
# 11. repos: — the list-of-maps form
# ---------------------------------------------------------------------------
print -r -- "repos: entries become { relPath; url; }"
cat > "${BASE}/repos.yaml" <<'YAML'
user: rep
gitfullname: Rep Person
gitmail: rep@example.com
profiles:
  - example
repos:
  - rel_path: ''
    url: git@gitlab.com:example-group/example-repo.git
  - rel_path: vendor
    url: git@gitlab.com:someone/other.git
YAML
o="$(out repos)"
run_gen --out "${o}" --config "${BASE}/repos.yaml"
f="$(flake_of "${o}")"
contains "the first entry"  "${f}" '{ relPath = ""; url = "git@gitlab.com:example-group/example-repo.git"; }'
contains "the second entry" "${f}" '{ relPath = "vendor"; url = "git@gitlab.com:someone/other.git"; }'

# ---------------------------------------------------------------------------
# 12. Refusals
# ---------------------------------------------------------------------------
# Each of these is a wrong overlay that would fail much later and much worse:
# a profile name nothing declares aborts inside profiles/merge.nix, a missing
# git identity makes every repo on the box commit as a placeholder, and writing
# over the checkout destroys the flake the overlay imports.
print -r -- "wrong input is refused up front"
o="$(out unknownprofile)"
run_gen --out "${o}" --user u --git-name N --git-email n@example.com --profiles notaprofile
check    "an unknown profile fails"   "${RC}" "1"
contains "naming the bad one"         "${OUT}" "notaprofile"
contains "and listing the real ones"  "${OUT}" "example"
[[ -e "${o}/flake.nix" ]] && bad "and writes no flake" || ok "and writes no flake"

# A config with everything BUT the Linux username: the .ps1 throws on this too,
# and mkSystem's own message for it names a store path rather than the file the
# adopter has open.
cat > "${BASE}/nouser.yaml" <<'YAML'
gitfullname: Nameless Person
gitmail: nameless@example.com
profiles:
  - example
YAML
o="$(out nouser)"
run_gen --out "${o}" --config "${BASE}/nouser.yaml"
check    "a config with no user: fails" "${RC}" "1"
contains "saying there is no default"   "${OUT}" "no sane default"
[[ -e "${o}/flake.nix" ]] && bad "and writes no flake" || ok "and writes no flake"

o="$(out noidentity)"
run_gen --out "${o}" --user u
check    "a missing git identity fails" "${RC}" "1"
contains "and says why it matters"      "${OUT}" "placeholder"

o="$(out dashed)"
run_gen --out "${o}" --user 'not-allowed' --git-name N --git-email n@example.com
check    "a dashed username fails" "${RC}" "1"
contains "naming the rule"         "${OUT}" "dash"

# Aimed at a THROWAWAY checkout, never at REPO_ROOT: this case exists because
# the guard might one day regress, and the run it is asserting about is exactly
# the one that would then scribble a secrets stub and the shared/ dirs into the
# working tree. A copy of the script plus the two directories it reads next to
# itself is a complete checkout as far as it is concerned.
FAKE="${BASE}/fakecheckout"
mk_fake_checkout "${FAKE}" example
run_gen_at "${FAKE}/files/scripts/nix-overlay-generate" --out "${FAKE}" \
  --user u --git-name N --git-email n@example.com --profiles example
check    "writing over the flakelab checkout is refused" "${RC}" "1"
contains "and says where to point it instead"          "${OUT}" "--out at a NEW directory"
[[ -e "${FAKE}/files/config" ]] && bad "and writes nothing into it" || ok "and writes nothing into it"

run_gen --out "$(out nosuchconfig)" --config "${BASE}/does-not-exist.yaml"
check    "a missing config fails"  "${RC}" "1"
contains "naming the file"         "${OUT}" "does-not-exist.yaml"

run_gen --out "$(out badflag)" --frobnicate
check    "an unknown flag fails"   "${RC}" "1"
contains "naming it"               "${OUT}" "frobnicate"

# ---------------------------------------------------------------------------
# 13. No profiles AND no groups is refused, not warned about
# ---------------------------------------------------------------------------
# The failure this repo has already been bitten by: with no profile selected,
# profiles/ contributes nothing - no profile packages, no group clones - and the build
# still succeeds. There is no legitimate reason to generate that overlay, so it
# is an error. A config that names groups but no profile still only warns: the
# box does get clones, and a fork wanting none of the profiles is legitimate.
print -r -- "an overlay that would install nothing is refused"
cat > "${BASE}/noprofiles.yaml" <<'YAML'
user: bare
gitfullname: Bare Person
gitmail: bare@example.com
YAML
o="$(out noprofiles)"
run_gen --out "${o}" --config "${BASE}/noprofiles.yaml"
check    "it fails"                  "${RC}" "1"
contains "saying what would happen"  "${OUT}" "no profile packages and clone no repos"
contains "and what to add"           "${OUT}" "example"
contains "and where wslkube hides it" "${OUT}" "variables.yaml"
[[ -e "${o}/flake.nix" ]] && bad "no flake.nix is left behind" || ok "no flake.nix is left behind"

print -r -- "groups without a profile is still only a warning"
cat > "${BASE}/groupsonly.yaml" <<'YAML'
user: bare
gitfullname: Bare Person
gitmail: bare@example.com
gitlab_groups:
  - somegroup
YAML
o="$(out groupsonly)"
run_gen --out "${o}" --config "${BASE}/groupsonly.yaml"
check    "it still generates"        "${RC}" "0"
contains "with a warning"            "${OUT}" "no profiles selected"
contains "and an empty list in the flake" "$(flake_of "${o}")" 'profiles = [ ];'
contains "and the group survives"    "$(flake_of "${o}")" 'gitlabGroups = [ "somegroup" ];'

# ---------------------------------------------------------------------------
# 14. A key written in the other shape is coerced, not dropped
# ---------------------------------------------------------------------------
# The .ps1's Get-UserDataList wraps a scalar into a one-element list, and the
# [string] cast it puts on sshkeyautoadd joins a list on spaces. Reading only
# the array this parser classified a block into instead would make an inline
# `gitlab_groups: mygroup` vanish from the overlay with NOTHING said - the same
# silent-drop failure the profile validation refuses. Same file, same overlay,
# whichever generator wrote it.
print -r -- "a key written in the other shape is still read"
cat > "${BASE}/shapes.yaml" <<'YAML'
user: shape
gitfullname: Shape Person
gitmail: shape@example.com
profiles: example
gitlab_groups: mygroup
sshkeyautoadd:
  - id_ed25519
  - id_rsa
YAML
o="$(out shapes)"
run_gen --out "${o}" --config "${BASE}/shapes.yaml"
check    "it exits clean" "${RC}" "0"
f="$(flake_of "${o}")"
contains "an inline profiles: scalar is a one-element list" "${f}" 'profiles = [ "example" ];'
contains "an inline gitlab_groups: scalar survives"         "${f}" 'gitlabGroups = [ "mygroup" ];'
contains "a block-list sshkeyautoadd is flattened to words" "${f}" 'sshKeys = ['
contains "keeping the git identity first"                   "${f}" '"id_ed25519"'
contains "and the second key"                               "${f}" '"id_rsa"'
excludes "no warning about a profile-less box"              "${OUT}" "no profiles selected"

# ---------------------------------------------------------------------------
# 15. An inline comment starts at the FIRST ' #', not the last
# ---------------------------------------------------------------------------
# The .ps1 strips leftmost (`-replace '\s+#.*$'`). Stripping from the LAST one
# instead leaves `# first` inside the value, and a sessionVariable is what GATES
# an MCP server - a URL with a comment welded to it fails at first call, not at
# eval.
print -r -- "an inline comment starts at the first ' #'"
cat > "${BASE}/comments.yaml" <<'YAML'
user: cmt
gitfullname: Cmt Person
gitmail: cmt@example.com
profiles:
  - example
custom_env_vars:
  HASS_URL: http://a.example # first # second
  GRAFANA_URL: https://g.example/#/dash
YAML
o="$(out comments)"
run_gen --out "${o}" --config "${BASE}/comments.yaml"
f="$(flake_of "${o}")"
contains "the whole comment is stripped" "${f}" 'HASS_URL = "http://a.example";'
excludes "not just its tail"             "${f}" '# first'
# No whitespace in front of it, so it is a URL fragment and not a comment.
contains "a bare '#' inside a value survives" "${f}" 'GRAFANA_URL = "https://g.example/#/dash";'

# ---------------------------------------------------------------------------
# 16. team:/teams: are read as profiles:
# ---------------------------------------------------------------------------
# profiles/merge.nix still honours the older name, and a wslkube config carried
# over from that era uses it. Dropping it silently is the no-profiles failure
# above with no warning attached, because the key WAS in the file.
print -r -- "a wslkube-era teams: block is read as profiles:"
cat > "${BASE}/teams.yaml" <<'YAML'
user: legacy
gitfullname: Legacy Person
gitmail: legacy@example.com
teams:
  - example
YAML
o="$(out teams)"
run_gen --out "${o}" --config "${BASE}/teams.yaml"
contains "the profile is selected" "$(flake_of "${o}")" 'profiles = [ "example" ];'
excludes "and no no-profiles warning is printed" "${OUT}" "no profiles selected"

# ---------------------------------------------------------------------------
# 17. A wslkube checkout: variables.yaml is layered under user_data.yaml
# ---------------------------------------------------------------------------
# wslkube splits its config the way Ansible loads it - shared defaults in
# variables.yaml, per-host overrides in files/config/user_data.yaml. Reading
# only the second misses gitlab_groups, clone_exclude, claude_plugins and the
# marketplace, and the overlay comes out selecting nothing: green build, no
# profile packages, empty ~/git, nothing said. main_playbook.yaml is part of the fixture
# because auto-detection keys on it too - a lone variables.yaml three levels up
# is not evidence of a wslkube checkout.
print -r -- "a wslkube checkout is read as two layered files"
# NOT ${BASE}/wslkube: out() rm -rf's ${BASE}/<name>, and `out wslkube`
# below would delete this fixture out from under the case using it.
WK="${BASE}/wk-src"
mkdir -p "${WK}/files/config"
print -r -- '# stub' > "${WK}/main_playbook.yaml"
cat > "${WK}/variables.yaml" <<'YAML'
gitlab_groups:
  - example-group
  - family-recipes
clone_exclude:
  - wslkube
claude_plugin_marketplace:
  name: 'Example-tools'
  url: 'git@example.com:group/plugins.git'
claude_plugins:
  - agents
  - skills
kiro_plugin_repo: 'git@example.com:group/kiro-plugin.git'
userlocale: de_DE.UTF-8
YAML
cat > "${WK}/files/config/user_data.yaml" <<'YAML'
user: tycorc
gitfullname: Wslkube Person
gitmail: wk@example.com
claude_mcp_plugins:
  - mcp-whatsapp
YAML
o="$(out wslkube)"
run_gen --out "${o}" --config "${WK}/files/config/user_data.yaml"
f="$(flake_of "${o}")"
check    "it generates"                     "${RC}" "0"
contains "it says it layered them"          "${OUT}" "layering ${WK}/variables.yaml"
# The whole point: neither key is in user_data.yaml.
contains "profiles are DERIVED from the groups" "${OUT}" "profiles derived from gitlab_groups"
contains "example, from example-group"      "${f}" 'profiles = [ "example" ];'
# family-recipes is claimed by no profile, so it stays; example-group is already
# unioned in by profiles/merge.nix and listing it again would be a duplicate.
contains "only the unclaimed group is personal" "${f}" 'gitlabGroups = [ "family-recipes" ];'
contains "clone_exclude is unioned in"      "${f}" '"wslkube"'
contains "and the overlay itself still excluded" "${f}" '"flakelab"'
contains "the marketplace comes across"     "${f}" 'name = "Example-tools";'
contains "as the canonical PLURAL option"   "${f}" 'claudePluginMarketplaces = ['
excludes "not the legacy singular"          "${f}" 'claudePluginMarketplace ='
# claude_plugins is in variables.yaml, claude_mcp_plugins in user_data.yaml -
# mkSystem takes one list, so the two concatenate rather than one winning.
contains "always-on plugins from variables.yaml" "${f}" '"agents"'
contains "opt-in MCP plugins from user_data.yaml" "${f}" '"mcp-whatsapp"'
contains "kiro_plugin_repo, which wslkube hardcodes in tasks/" "${f}" 'kiroPluginRepo = "git@example.com:group/kiro-plugin.git";'
# whatsapp_mcp_dir is in neither file, and wslkube keeps it in a task file too.
contains "an enabled mcp-whatsapp with no dir warns" "${OUT}" "whatsapp_mcp_dir is unset"
excludes "and no whatsappMcpDir is invented" "${f}" 'whatsappMcpDir'

# ---------------------------------------------------------------------------
# 18. user_data.yaml wins over variables.yaml - in either shape
# ---------------------------------------------------------------------------
# Ansible's precedence. The shape change is the interesting half: the parser
# files a block list and a scalar in DIFFERENT arrays, so an override written
# inline would leave the overridden list in place for _as_list to find and the
# value that lost would silently win.
print -r -- "user_data.yaml overrides variables.yaml, across shapes"
cat > "${WK}/files/config/user_data.yaml" <<'YAML'
user: tycorc
gitfullname: Wslkube Person
gitmail: wk@example.com
userlocale: en_GB.UTF-8
gitlab_groups: family-recipes
YAML
o="$(out wslkube-override)"
run_gen --out "${o}" --config "${WK}/files/config/user_data.yaml"
f="$(flake_of "${o}")"
check    "it generates"                  "${RC}" "0"
contains "the scalar override wins"      "${f}" 'locale = "en_GB.UTF-8";'
contains "and so does the inline list"   "${f}" 'gitlabGroups = [ "family-recipes" ];'
excludes "the overridden block list is gone" "${f}" '"example-group"'
contains "so no profile is derived"      "${OUT}" "no profiles selected"

# ---------------------------------------------------------------------------
# 19. --wslkube names the checkout when the config was copied out
# ---------------------------------------------------------------------------
# Auto-detection needs the config to still sit at <root>/files/config/. A copy
# anywhere else is the case the flag is for.
print -r -- "--wslkube finds variables.yaml for a config copied out of the tree"
cp "${WK}/files/config/user_data.yaml" "${BASE}/copied.yaml"
o="$(out copied-nowk)"
run_gen --out "${o}" --config "${BASE}/copied.yaml"
excludes "without the flag nothing is layered" "${OUT}" "layering"
o="$(out copied-wk)"
run_gen --out "${o}" --config "${BASE}/copied.yaml" --wslkube "${WK}"
check    "with it the run succeeds"      "${RC}" "0"
contains "and variables.yaml is layered" "${OUT}" "layering ${WK}/variables.yaml"
contains "so clone_exclude comes across" "$(flake_of "${o}")" '"wslkube"'
run_gen --out "$(out nowk)" --config "${BASE}/copied.yaml" --wslkube "${BASE}/not-a-checkout"
check    "a --wslkube that is not one fails" "${RC}" "1"

# ---------------------------------------------------------------------------
# 20. Explicit --gitlab-groups does NOT infer profiles
# ---------------------------------------------------------------------------
# Derivation is for a MIGRATED config, which has no profile concept to state.
# A group named on the command line with no --profiles is an explicit request,
# and inferring profiles from it would be the surprising reading.
print -r -- "a command-line group is not turned into a profile"
o="$(out flaggroups)"
run_gen --out "${o}" --user u --git-name N --git-email n@example.com \
  --gitlab-groups example-group
f="$(flake_of "${o}")"
check    "it generates"                 "${RC}" "0"
excludes "nothing is derived"           "${OUT}" "profiles derived"
contains "profiles stay empty"          "${f}" 'profiles = [ ];'
contains "and the group stays personal" "${f}" 'gitlabGroups = [ "example-group" ];'

# ---------------------------------------------------------------------------
# 21. state_root / state_transcripts pass through only when set
# ---------------------------------------------------------------------------
# state_root and state_transcripts are emitted only when set: both options have a
# default, so an absent key must leave the overlay on it.
print -r -- "state_root and state_transcripts pass through only when set"
cat > "${BASE}/state.yaml" <<'YAML'
user: bare
gitfullname: Bare Person
gitmail: bare@example.com
profiles:
  - example
YAML
o="$(out state)"
run_gen --out "${o}" --config "${BASE}/state.yaml"
check "exits clean" "${RC}" "0"
f="$(flake_of "${o}")"
excludes "no stateRoot line when unset"        "${f}" 'stateRoot'
excludes "no stateTranscripts line when unset" "${f}" 'stateTranscripts'

cat > "${BASE}/state.yaml" <<'YAML'
user: bare
gitfullname: Bare Person
gitmail: bare@example.com
profiles:
  - example
state_root: /mnt/d/sync/flakelab-state
state_transcripts: true
YAML
o="$(out stateset)"
run_gen --out "${o}" --config "${BASE}/state.yaml"
check "exits clean" "${RC}" "0"
f="$(flake_of "${o}")"
contains "stateRoot from the config"        "${f}" 'stateRoot = "/mnt/d/sync/flakelab-state";'
contains "stateTranscripts from the config" "${f}" 'stateTranscripts = true;'

o="$(out stateflag)"
run_gen --out "${o}" --config "${BASE}/state.yaml" --state-root /mnt/e/other --state-transcripts false
check "exits clean" "${RC}" "0"
f="$(flake_of "${o}")"
contains "the flag wins over the config"    "${f}" 'stateRoot = "/mnt/e/other";'
contains "and so does the transcripts flag" "${f}" 'stateTranscripts = false;'

# ---------------------------------------------------------------------------
# 22. repos: alone is a selection - the GitHub-only adopter
# ---------------------------------------------------------------------------
# gitlab_groups is not the only way a box gets repositories, and an adopter with
# no GitLab at all has none: they name their clones under `repos:`. Refusing
# that config - which the profiles/groups check did, because it ran before
# repos was ever read - locked out exactly the audience the README invites.
print -r -- "repos: alone generates, without a profile or a group"
cat > "${BASE}/reposonly.yaml" <<'YAML'
user: bare
gitfullname: Bare Person
gitmail: bare@example.com
repos:
  - rel_path: tools/alpha
    url: https://github.com/example/alpha.git
  - rel_path: tools/beta
    url: https://github.com/example/beta.git
YAML
o="$(out reposonly)"
run_gen --out "${o}" --config "${BASE}/reposonly.yaml"
check    "it generates"              "${RC}" "0"
f="$(flake_of "${o}")"
contains "the first repo is emitted" "${f}" 'relPath = "tools/alpha"; url = "https://github.com/example/alpha.git";'
contains "and the second"            "${f}" 'relPath = "tools/beta"; url = "https://github.com/example/beta.git";'
contains "profiles stay empty"       "${f}" 'profiles = [ ];'
excludes "nothing claims it would clone nothing" "${OUT}" "clone no repos"
contains "the profile warning says the repos are still cloned" \
  "${OUT}" "'repos:' entries are still cloned"

# A `repos:` block whose entries carry no url emits NOTHING, so counting raw
# entries instead of usable ones would let the empty overlay back through.
print -r -- "url-less repos entries do not count as a selection"
cat > "${BASE}/reposnourl.yaml" <<'YAML'
user: bare
gitfullname: Bare Person
gitmail: bare@example.com
repos:
  - rel_path: tools/alpha
YAML
o="$(out reposnourl)"
run_gen --out "${o}" --config "${BASE}/reposnourl.yaml"
check    "it fails"                  "${RC}" "1"
contains "for the same reason"       "${OUT}" "no profiles, no gitlab_groups and no repos"

# ---------------------------------------------------------------------------
# 23. Flow-style lists are lists, not strings
# ---------------------------------------------------------------------------
# `profiles: [example]` is valid YAML and a shape a hand-written config reaches
# for. Read as a SCALAR it reached the overlay as the literal string
# "[example]": an unknown profile at best, and for gitlab_groups a group name
# nobody can clone, written into a green overlay with nothing said.
print -r -- "flow-style profiles: and gitlab_groups: parse as lists"
cat > "${BASE}/flow.yaml" <<'YAML'
user: bare
gitfullname: Bare Person
gitmail: bare@example.com
profiles: [example]
gitlab_groups: [alpha, "beta"]
YAML
o="$(out flow)"
run_gen --out "${o}" --config "${BASE}/flow.yaml"
check    "it generates"            "${RC}" "0"
f="$(flake_of "${o}")"
contains "the profile is selected" "${f}" 'profiles = [ "example" ];'
excludes "not as a literal string" "${f}" '"[example]"'
contains "both groups survive"     "${f}" '"alpha"'
contains "the quoted one too"      "${f}" '"beta"'
excludes "and no bracket rides in" "${f}" '"[alpha'

# `[]` is how a config says "none of these", and it must not come back as the
# two-character string that reads as one entry.
print -r -- "an empty flow list is empty, not a one-entry list"
cat > "${BASE}/flowempty.yaml" <<'YAML'
user: bare
gitfullname: Bare Person
gitmail: bare@example.com
profiles: []
gitlab_groups:
  - somegroup
YAML
o="$(out flowempty)"
run_gen --out "${o}" --config "${BASE}/flowempty.yaml"
check    "it generates"            "${RC}" "0"
f="$(flake_of "${o}")"
contains "profiles are empty"      "${f}" 'profiles = [ ];'
excludes "not a literal []"        "${f}" '"[]"'
contains "and the group survives"  "${f}" 'gitlabGroups = [ "somegroup" ];'

# ---------------------------------------------------------------------------
# 24. A checkout path with a space still produces a usable flake URL
# ---------------------------------------------------------------------------
# `path:` is a URL. A raw space in it makes nix's URL parse fail, and nix then
# reads the WHOLE string - scheme included - as a relative filesystem path, so
# every rebuild from the generated overlay dies on a path with "path:" inside
# it. C:\Users\First Last\git\ is the ordinary Windows layout, so this is the
# default experience, not a corner.
#
# The acceptance check is `nix flake metadata` on the result, and it is run BY
# HAND (see the MR that added this case): there is no nix in the `nix flake
# check` sandbox this suite runs in, and a case that skipped there would be the
# silent green flake.nix's suiteCheck bans skip lines to prevent. What is
# asserted here is the URL the generator writes.
print -r -- "a checkout under a path with a space encodes the space"
SPACED="${BASE}/with space/flakelab"
mkdir -p "${SPACED}/files/scripts"
cp "${GEN}" "${SPACED}/files/scripts/"
cp -r "${REPO_ROOT}/templates" "${SPACED}/templates"
cp -r "${REPO_ROOT}/profiles" "${SPACED}/profiles"
cat > "${BASE}/spaced.yaml" <<'YAML'
user: bare
gitfullname: Bare Person
gitmail: bare@example.com
profiles: [example]
YAML
o="$(out spaced)"
OUT="$("${SPACED}/files/scripts/nix-overlay-generate" --out "${o}" --config "${BASE}/spaced.yaml" 2>&1)"; RC=$?
check    "it generates"                "${RC}" "0"
f="$(flake_of "${o}")"
contains "the space is percent-encoded" "${f}" "path:${BASE}/with%20space/flakelab"
excludes "and no raw space is left in the URL" "${f}" "path:${BASE}/with space"

# ---------------------------------------------------------------------------
print -r -- ""
print -r -- "${PASS} passed, ${FAIL} failed"
(( FAIL == 0 ))
