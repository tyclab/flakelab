  touch "${BINFMT}/${handler}"
  out="$(interop_section)"
  contains "${handler} is accepted" "${out}" "[ OK ] WSLInterop handler registered"
  lacks "${handler} is not reported missing" "${out}" "handler missing"
  rm -f "${BINFMT}/${handler}"
done
touch "${BINFMT}/WSLInterop"

print -r -- "WSL interop: socket presence is separate from registry and execution health"
