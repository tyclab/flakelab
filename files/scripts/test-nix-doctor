contains "requires host evidence"        "${out}" "outside any sandbox"
contains "preserves WSL protection"      "${out}" "Do not replace WSL's handler or disable its protection"
lacks    "does not prescribe shutdown"   "${out}" "wsl --shutdown"
lacks    "does not claim only one fix"   "${out}" "The only fix"

