#!/usr/bin/env zsh

set -uo pipefail
setopt extended_glob

#
# Offline suite for nix-doctor's reading of the flakelab input and of which AI CLIs
# it holds the box to: the real script against a throwaway overlay whose flake.lock
# locks that input in each shape nix writes, with HOME a fresh directory and every
# tool that would reach the running box, an agent or the network left off PATH.
# Only the "flakelab input" and "AI CLIs" sections are asserted; the rest of the
# run finds nothing and is not looked at.
#
# Usage: files/scripts/test-nix-doctor
#

SCRIPT_DIR="${0:A:h}"
DOCTOR="${SCRIPT_DIR}/nix-doctor"
typeset -i PASS=0 FAIL=0

ok()       { print -r -- "  ok   $1"; (( PASS++ )); return 0 }
bad()      { print -r -u2 -- "  FAIL $1"; (( FAIL++ )); return 0 }
contains() { [[ "$2" == *"$3"* ]] && ok "$1" || { bad "$1"; print -r -u2 -- "       missing: $3"; print -r -u2 -- "       in:      $2" } }
lacks()    { [[ "$2" != *"$3"* ]] && ok "$1" || { bad "$1"; print -r -u2 -- "       present: $3"; print -r -u2 -- "       in:      $2" } }

BASE="$(mktemp -d)"
trap 'rm -rf "${BASE}"' EXIT

TOOLS="${BASE}/tools"
mkdir -p "${TOOLS}"
for f in ${^path}/*(N-*); do
  case "${f:t}" in
    systemctl|loginctl|ssh|ssh-add|glab|gh|bw|claude|kiro-cli|codex|flakelab-switch-result|*.exe|wslpath|xdg-open) continue ;;
  esac
  [[ -e "${TOOLS}/${f:t}" ]] || ln -s "${f}" "${TOOLS}/${f:t}"
done
mkdir -p "${BASE}/home" "${BASE}/overlay"

# input_line <locked fields>: the doctor's finding for a lock whose flakelab input
# is locked as given, colours stripped. No lock at all when the argument is empty.
input_line() {
  rm -f "${BASE}/overlay/flake.lock"
  [[ -n "$1" ]] && print -r -- "{\"nodes\":{\"root\":{\"inputs\":{\"flakelab\":\"flakelab\"}},\"flakelab\":{\"locked\":{$1}}},\"root\":\"root\",\"version\":7}" > "${BASE}/overlay/flake.lock"
  local out
  out="$(env -i PATH="${TOOLS}" HOME="${BASE}/home" FLAKELAB_TARGET=other \
    FLAKELAB_REPO_ROOT="${BASE}/overlay" zsh "${DOCTOR}" 2>&1 < /dev/null)"
  out="${out//$'\e'\[[0-9;]#m/}"
  local -a lines=("${(@f)out}")
  local -i i=${lines[(i)*==> flakelab input]}
  print -r -- "${lines[i+1]:-}"
}

# ai_clis [<FLAKELAB_AI_CLIS>]: the doctor's "AI CLIs" section, colours stripped,
# with the variable exported as given, or unset when no argument is passed.
ai_clis() {
  local -a env=(PATH="${TOOLS}" HOME="${BASE}/home" FLAKELAB_TARGET=other)
  (( $# )) && env+=(FLAKELAB_AI_CLIS="$1")
  local out
  out="$(env -i "${env[@]}" zsh "${DOCTOR}" 2>&1 < /dev/null)"
  out="${out//$'\e'\[[0-9;]#m/}"
  out="${out#*==> AI CLIs$'\n'}"
  print -r -- "${out%%$'\n'==> *}"
}

# accounts_section: the doctor's Accounts section for the store as staged.
accounts_section() {
  local out
  out="$(env -i PATH="${TOOLS}" HOME="${BASE}/home" FLAKELAB_TARGET=other zsh "${DOCTOR}" 2>&1 < /dev/null)"
  out="${out//$'\e'\[[0-9;]#m/}"
  out="${out#*==> Accounts$'\n'}"
  print -r -- "${out%%$'\n'==> *}"
}

print -r -- "test-nix-doctor"

print -r -- "a path: input is a local override"
contains "it warns"      "$(input_line '"type":"path","path":"/srv/flakelab"')" "[WARN] LOCAL flakelab override: path /srv/flakelab"

# nix locks every git+<transport>: input as type `git`; the url says which.
print -r -- "a git+file: input is a local override"
contains "it warns"      "$(input_line '"type":"git","url":"file:///srv/flakelab","rev":"abc"')" "[WARN] LOCAL flakelab override: git+file /srv/flakelab"

print -r -- "a remote git input is published"
contains "it passes"     "$(input_line '"type":"git","url":"https://gitlab.com/grp/flakelab.git","rev":"abc"')" "[ OK ] published flakelab (git https://gitlab.com/grp/flakelab.git)"
contains "over ssh too"  "$(input_line '"type":"git","url":"ssh://git@gitlab.com/grp/flakelab","rev":"abc"')" "[ OK ] published flakelab (git ssh://git@gitlab.com/grp/flakelab)"

print -r -- "a forge input is published"
contains "github"        "$(input_line '"type":"github","owner":"tyclab","repo":"flakelab","rev":"abc"')" "[ OK ] published flakelab (github tyclab/flakelab)"
contains "sourcehut"     "$(input_line '"type":"sourcehut","owner":"~tyc","repo":"flakelab","rev":"abc"')" "[ OK ] published flakelab (sourcehut ~tyc/flakelab)"

print -r -- "no lock is not read as any input"
contains "it warns"      "$(input_line '')" "[WARN] could not read the flakelab input from the lock"

print -r -- "the AI CLIs checked are the ones the overlay installs"
contains "all three"           "$(ai_clis 'kiro-cli claude codex')" "[FAIL] Codex CLI not installed"
contains "kiro-cli among them" "$(ai_clis 'kiro-cli claude codex')" "[FAIL] kiro-cli not installed"
contains "claude among them"   "$(ai_clis 'kiro-cli claude codex')" "[FAIL] Claude Code not installed"
lacks    "one switched off"    "$(ai_clis 'kiro-cli claude')" "Codex CLI"
contains "only codex"          "$(ai_clis codex)" "[FAIL] Codex CLI not installed"
lacks    "not kiro-cli then"   "$(ai_clis codex)" "kiro-cli"
lacks    "nor claude"          "$(ai_clis codex)" "Claude Code"
contains "none"                "$(ai_clis '')" "[ OK ] no AI CLI installed by this overlay"
contains "unset is none"       "$(ai_clis)" "[ OK ] no AI CLI installed by this overlay"


print -r -- "accounts: no store"
contains "says so"      "$(accounts_section)" "[ OK ] no stored logins"

print -r -- "accounts: a private store with private logins"
AC="${BASE}/home/.local/state/flakelab/accounts"
mkdir -p "${AC}/1"
chmod 700 "${AC}"
print -r -- '{"version":1}' > "${AC}/accounts.json"; chmod 600 "${AC}/accounts.json"
print -r -- '{}' > "${AC}/1/credentials.json"; chmod 600 "${AC}/1/credentials.json"
contains "the store passes"   "$(accounts_section)" "[ OK ] store is owner-only"
contains "the files pass"     "$(accounts_section)" "[ OK ] stored logins are owner-only (0600)"
contains "no timer is a note" "$(accounts_section)" "[ OK ] note: no auto-switch timer"

print -r -- "accounts: loose modes and a quarantine"
chmod 755 "${AC}"
chmod 644 "${AC}/1/credentials.json"
print -r -- '{"quarantine":{"3":{"reason":"invalid_grant"}}}' > "${AC}/usage.json"
contains "a 755 store warns"        "$(accounts_section)" "[WARN] store is mode 755, expected 700"
contains "a 644 login warns"        "$(accounts_section)" "[WARN] 1 stored login file(s) are not 0600"
contains "with the chmod"           "$(accounts_section)" "chmod 600 ${AC}/1/credentials.json"
contains "a quarantined entry warns" "$(accounts_section)" "[WARN] quarantined entries: 3 (invalid_grant)"

print -r -- ""
print -r -- "${PASS} passed, ${FAIL} failed"
(( FAIL == 0 ))
