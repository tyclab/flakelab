#!/usr/bin/env zsh

set -uo pipefail
setopt extended_glob

#
# Offline suite for nix-doctor's reading of the flakelab input and of which AI CLIs
# it holds the box to: the real script against a throwaway overlay whose flake.lock
# locks that input in each shape nix writes, with HOME a fresh directory and every
# tool that would reach the running box, an agent or the network left off PATH.
# Only the "flakelab input" and "AI CLIs" sections are asserted; the rest of the
# run finds nothing and is not looked at.
#
# Usage: files/scripts/test-nix-doctor
#

SCRIPT_DIR="${0:A:h}"
DOCTOR="${SCRIPT_DIR}/nix-doctor"
typeset -i PASS=0 FAIL=0

ok()       { print -r -- "  ok   $1"; (( PASS++ )); return 0 }
bad()      { print -r -u2 -- "  FAIL $1"; (( FAIL++ )); return 0 }
contains() { [[ "$2" == *"$3"* ]] && ok "$1" || { bad "$1"; print -r -u2 -- "       missing: $3"; print -r -u2 -- "       in:      $2" } }
lacks()    { [[ "$2" != *"$3"* ]] && ok "$1" || { bad "$1"; print -r -u2 -- "       present: $3"; print -r -u2 -- "       in:      $2" } }

BASE="$(mktemp -d)"
trap 'rm -rf "${BASE}"' EXIT

TOOLS="${BASE}/tools"
mkdir -p "${TOOLS}"
for f in ${^path}/*(N-*); do
  case "${f:t}" in
    systemctl|loginctl|ssh|ssh-add|glab|gh|bw|claude|codex|flakelab-switch-result|*.exe|wslpath|xdg-open) continue ;;
  esac
  [[ -e "${TOOLS}/${f:t}" ]] || ln -s "${f}" "${TOOLS}/${f:t}"
done
mkdir -p "${BASE}/home" "${BASE}/overlay"

# section <name> <VAR=value>...: the doctor's section <name>, colours stripped, from
# a run with only that environment. NixOS's /etc/zshenv puts the system profile,
# systemctl with it, on the PATH of every zsh it starts unless it has run already;
# each run says it has.
section() {
  local name="$1" out
  shift
  out="$(env -i __ETC_ZSHENV_SOURCED=1 "$@" zsh "${DOCTOR}" 2>&1 < /dev/null)"
  out="${out//$'\e'\[[0-9;]#m/}"
  out="${out#*==> ${name}$'\n'}"
  print -r -- "${out%%$'\n'==> *}"
}

# input_line <locked fields>: the doctor's finding for a lock whose flakelab input
# is locked as given. No lock at all when the argument is empty.
input_line() {
  rm -f "${BASE}/overlay/flake.lock"
  [[ -n "$1" ]] && print -r -- "{\"nodes\":{\"root\":{\"inputs\":{\"flakelab\":\"flakelab\"}},\"flakelab\":{\"locked\":{$1}}},\"root\":\"root\",\"version\":7}" > "${BASE}/overlay/flake.lock"
  local -a lines=("${(@f)$(section 'flakelab input' PATH="${TOOLS}" HOME="${BASE}/home" FLAKELAB_TARGET=other FLAKELAB_REPO_ROOT="${BASE}/overlay")}")
  print -r -- "${lines[1]:-}"
}

# ai_clis [<FLAKELAB_AI_CLIS>]: the doctor's "AI CLIs" section, with the variable
# exported as given, or unset when no argument is passed.
ai_clis() {
  local -a env=(PATH="${TOOLS}" HOME="${BASE}/home" FLAKELAB_TARGET=other)
  (( $# )) && env+=(FLAKELAB_AI_CLIS="$1")
  section 'AI CLIs' "${env[@]}"
}

# switcher_section [<systemctl exit status>] [VAR=value...]: the doctor's Switcher
# section with tycswap stubbed on PATH (FAKE_TYCSWAP_LIST its list --json answer,
# FAKE_TYCSWAP_ERR a failure); with a numeric first argument, under a systemctl
# that exits as given.
switcher_section() {
  local tools="${TOOLS}"
  if [[ "${1:-}" == <-> ]]; then stub systemctl "$1"; ln -sf "${TOOLS}/tycswap" "${UMT}/tycswap"; tools="${UMT}"; shift; fi
  section Switcher PATH="${tools}" HOME="${BASE}/home" FLAKELAB_TARGET=other FLAKELAB_INSTALL_TYCSWAP=true "$@"
}
cat > "${TOOLS}/tycswap" <<'STUB'
#!/usr/bin/env zsh
case "$1" in
  --version) print -r -- "tycswap v0.3.0" ;;
  list) [[ -n "${FAKE_TYCSWAP_ERR:-}" ]] && { print -ru2 -- "${FAKE_TYCSWAP_ERR}"; exit 1 }
        # No default inside ${:-}: zsh ends the word at the first }, which a JSON default has.
        [[ -n "${FAKE_TYCSWAP_LIST:-}" ]] && print -r -- "${FAKE_TYCSWAP_LIST}" || print -r -- '{"schemaVersion":1,"activeAccountNumber":null,"accounts":[]}' ;;
  *) exit 2 ;;
esac
STUB
chmod +x "${TOOLS}/tycswap"
NOTYCSWAP="${BASE}/notycswap"; mkdir -p "${NOTYCSWAP}"
for f in "${TOOLS}"/*(N); do [[ "${f:t}" == tycswap ]] || ln -s "${f}" "${NOTYCSWAP}/${f:t}"; done

# cgroup_section <target> [<PID 1 cgroup line> [<PID 1 comm>]]: the doctor's "systemd
# cgroup" section against the fake tree under ${CGT}, the record at ${CGREC} and the
# booted system under ${BASE}/booted. No cgroup file at all when the line is empty;
# PID 1 is systemd unless a comm is given.
CGT="${BASE}/cgroup" CGREC="${BASE}/run/init-cgroup"
mkdir -p "${CGT}" "${BASE}/run" "${BASE}/proc/1" "${BASE}/booted"
cgroup_section() {
  rm -f "${BASE}/proc/1/cgroup"
  [[ -n "${2:-}" ]] && print -r -- "$2" > "${BASE}/proc/1/cgroup"
  print -r -- "${3:-systemd}" > "${BASE}/proc/1/comm"
  section 'systemd cgroup' PATH="${TOOLS}" HOME="${BASE}/home" FLAKELAB_TARGET="$1" \
    FLAKELAB_PROC_ROOT="${BASE}/proc" FLAKELAB_CGROUP_ROOT="${CGT}" \
    FLAKELAB_INIT_CGROUP_RECORD="${CGREC}" FLAKELAB_BOOTED_SYSTEM="${BASE}/booted"
}

# stub <name> <exit status>: a <name> in ${UMT}, the tools beside it, that exits as
# given whatever it is asked (`systemctl --user show-environment` included).
UMT="${BASE}/tools-um"
mkdir -p "${UMT}"
for f in "${TOOLS}"/*(N); do ln -s "${f:A}" "${UMT}/${f:t}"; done
stub() {
  print -r -- "#!/bin/sh"$'\n'"exit $2" > "${UMT}/$1"
  chmod +x "${UMT}/$1"
}

# ssh_section <systemctl exit status> [<ssh-add exit status>]: the doctor's SSH
# section under that systemctl, with no agent in the environment, or with the second
# argument a socket on which `ssh-add -l` exits as given.
ssh_section() {
  stub systemctl "$1"
  local -a env=(PATH="${UMT}" HOME="${BASE}/home" FLAKELAB_TARGET=other)
  rm -f "${UMT}/ssh-add"
  if (( $# > 1 )); then
    stub ssh-add "$2"
    env+=(SSH_AUTH_SOCK="${BASE}/agent.sock")
  fi
  section SSH "${env[@]}"
}

print -r -- "test-nix-doctor"

print -r -- "a path: input is a local override"
contains "it warns"      "$(input_line '"type":"path","path":"/srv/flakelab"')" "[WARN] LOCAL flakelab override: path /srv/flakelab"

# nix locks every git+<transport>: input as type `git`; the url says which.
print -r -- "a git+file: input is a local override"
contains "it warns"      "$(input_line '"type":"git","url":"file:///srv/flakelab","rev":"abc"')" "[WARN] LOCAL flakelab override: git+file /srv/flakelab"

print -r -- "a remote git input is published"
contains "it passes"     "$(input_line '"type":"git","url":"https://gitlab.com/grp/flakelab.git","rev":"abc"')" "[ OK ] published flakelab (git https://gitlab.com/grp/flakelab.git)"
contains "over ssh too"  "$(input_line '"type":"git","url":"ssh://git@gitlab.com/grp/flakelab","rev":"abc"')" "[ OK ] published flakelab (git ssh://git@gitlab.com/grp/flakelab)"

print -r -- "a forge input is published"
contains "github"        "$(input_line '"type":"github","owner":"tyclab","repo":"flakelab","rev":"abc"')" "[ OK ] published flakelab (github tyclab/flakelab)"
contains "sourcehut"     "$(input_line '"type":"sourcehut","owner":"~tyc","repo":"flakelab","rev":"abc"')" "[ OK ] published flakelab (sourcehut ~tyc/flakelab)"

print -r -- "no lock is not read as any input"
contains "it warns"      "$(input_line '')" "[WARN] could not read the flakelab input from the lock"

print -r -- "the AI CLIs checked are the ones the overlay installs"
out="$(ai_clis 'claude codex')"
contains "both"                "${out}" "[FAIL] Codex CLI not installed"
contains "claude among them"   "${out}" "[FAIL] Claude Code not installed"
lacks    "one switched off"    "$(ai_clis claude)" "Codex CLI"
out="$(ai_clis codex)"
contains "only codex"          "${out}" "[FAIL] Codex CLI not installed"
lacks    "not claude then"     "${out}" "Claude Code"
contains "none"                "$(ai_clis '')" "[ OK ] no AI CLI installed by this overlay"
contains "unset is none"       "$(ai_clis)" "[ OK ] no AI CLI installed by this overlay"


print -r -- "a usage error exits 2, not 1 like a failed check"
rc=0
env -i __ETC_ZSHENV_SOURCED=1 PATH="${TOOLS}" HOME="${BASE}/home" zsh "${DOCTOR}" --strct > /dev/null 2>&1 || rc=$?
[[ "${rc}" == 2 ]] && ok "an unknown option exits 2" || bad "an unknown option exits 2 (got ${rc})"

print -r -- "activation: a skip-healthcheck marker left behind warns"
MARKER="${BASE}/home/.local/state/flakelab/skip-healthcheck"
mkdir -p "${MARKER:h}"
touch "${MARKER}"
out="$(section Activation PATH="${TOOLS}" HOME="${BASE}/home" FLAKELAB_TARGET=other)"
contains "names the file"        "${out}" "[WARN] the activation health check is skipped: ${MARKER} exists"
contains "and how to remove it"  "${out}" "rm ${MARKER}"
rm -f "${MARKER}"
lacks "without the marker, nothing" "$(section Activation PATH="${TOOLS}" HOME="${BASE}/home" FLAKELAB_TARGET=other)" "health check is skipped"

print -r -- "switcher: not installed by this overlay"
contains "says so" "$(section Switcher PATH="${TOOLS}" HOME="${BASE}/home" FLAKELAB_TARGET=other FLAKELAB_INSTALL_TYCSWAP=false)" "[ OK ] no switcher installed by this overlay"

print -r -- "switcher: the wrapper variable absent (a checkout run)"
contains "is a note, not a verdict" "$(section Switcher PATH="${TOOLS}" HOME="${BASE}/home" FLAKELAB_TARGET=other)" "[ OK ] note: not run through the wrapper; the switcher is not checked"

print -r -- "switcher: the binary under its old name"
OLDNAME="${BASE}/oldname"; mkdir -p "${OLDNAME}"
for f in "${NOTYCSWAP}"/*(N); do ln -s "${f}" "${OLDNAME}/${f:t}"; done
print -rl -- '#!/usr/bin/env zsh' 'case "$1" in --version) print -r -- "cswap 0.2.0" ;; list) print -r -- "{\"schemaVersion\":1,\"activeAccountNumber\":null,\"accounts\":[]}" ;; *) exit 2 ;; esac' > "${OLDNAME}/cswap"
chmod +x "${OLDNAME}/cswap"
out="$(section Switcher PATH="${OLDNAME}" HOME="${BASE}/home" FLAKELAB_TARGET=other FLAKELAB_INSTALL_TYCSWAP=true)"
contains "is found"                "${out}" "[ OK ] cswap 0.2.0"
lacks    "and not reported missing" "${out}" "not on PATH"

print -r -- "switcher: installed but not on PATH"
out="$(section Switcher PATH="${NOTYCSWAP}" HOME="${BASE}/home" FLAKELAB_TARGET=other FLAKELAB_INSTALL_TYCSWAP=true)"
contains "fails"          "${out}" "[FAIL] tycswap not on PATH"
contains "with the fix"   "${out}" "flakelab update installs it"

print -r -- "switcher: no store"
out="$(switcher_section)"
contains "names the binary" "${out}" "[ OK ] tycswap v0.3.0"
contains "and the empty store" "${out}" "[ OK ] no stored logins (tycswap add starts the store)"
contains "no timer is a note" "${out}" "[ OK ] note: no auto-switch timer"

print -r -- "switcher: an old cswap store beside no tycswap store"
mkdir -p "${BASE}/home/.local/share/claude-swap"
contains "hints at tycswap migrate" "$(switcher_section)" "tycswap migrate copies it once"
rm -rf "${BASE}/home/.local/share/claude-swap"

print -r -- "switcher: a private store, an empty roster"
CS="${BASE}/home/.local/share/tycswap"
mkdir -p "${CS}/credentials" "${CS}/codex/credentials"
chmod 700 "${CS}"
print -r -- 'enc' > "${CS}/credentials/account_1.enc"; chmod 600 "${CS}/credentials/account_1.enc"
out="$(switcher_section)"
contains "the store passes"      "${out}" "[ OK ] store is owner-only"
contains "the files pass"        "${out}" "[ OK ] stored credentials are owner-only (0600)"
contains "an empty roster reads" "${out}" "[ OK ] 0 stored login(s); active: none"

print -r -- "switcher: a roster with an active login"
out="$(switcher_section FAKE_TYCSWAP_LIST='{"schemaVersion":1,"activeAccountNumber":2,"accounts":[{"number":1,"email":"a@example.com","active":false},{"number":2,"email":"b@example.com","active":true}]}')"
contains "counts and names it" "${out}" "[ OK ] 2 stored login(s); active: b@example.com"

print -r -- "switcher: loose modes and a failing list"
chmod 755 "${CS}"
chmod 644 "${CS}/credentials/account_1.enc"
out="$(switcher_section FAKE_TYCSWAP_ERR='Error: sequence.json is not valid JSON')"
contains "a 755 store warns"   "${out}" "[WARN] store is mode 755, expected 700"
contains "a 644 file warns"    "${out}" "[WARN] 1 stored credential file(s) are not 0600"
contains "with the chmod"      "${out}" "chmod 600 ${CS}/credentials/account_1.enc"
contains "a failing list warns with tycswap's last line" "${out}" "[WARN] tycswap list --json failed: Error: sequence.json is not valid JSON"
chmod 700 "${CS}"; chmod 600 "${CS}/credentials/account_1.enc"

print -r -- "switcher: the retired store warns"
mkdir -p "${BASE}/home/.local/state/flakelab/accounts/1"
out="$(switcher_section)"
contains "names it"          "${out}" "[WARN] the retired flakelab accounts store is still here: ${BASE}/home/.local/state/flakelab/accounts"
contains "and the way out"   "${out}" "Migrating from flakelab accounts"
rm -rf "${BASE}/home/.local/state/flakelab/accounts"
lacks "gone, no warning" "$(switcher_section)" "retired flakelab accounts store"

print -r -- "switcher: the timer"
out="$(switcher_section 1 FLAKELAB_TYCSWAP_AUTOSWITCH=true)"
contains "no user manager is a warning"    "${out}" "[WARN] no auto-switch timer can run or be listed"
contains "that names the user manager"     "${out}" "no user manager answers, so no user unit runs: systemctl status user@"
out="$(switcher_section 0 FLAKELAB_TYCSWAP_AUTOSWITCH=true)"
contains "a manager with no timer warns"   "${out}" "[WARN] flakelab.tycswapAutoSwitchInterval is set but no timer is scheduled"
out="$(switcher_section 0)"
contains "without an interval it is a note" "${out}" "[ OK ] note: no auto-switch timer (flakelab.tycswapAutoSwitchInterval schedules tycswap auto --once)"
# A systemctl that answers list-timers with FAKE_TIMERS: the scheduled branch.
print -rl -- '#!/bin/sh' 'case "$*" in *list-timers*) printf "%s\n" "${FAKE_TIMERS:-}" ;; esac' 'exit 0' > "${UMT}/systemctl"
chmod +x "${UMT}/systemctl"; ln -sf "${TOOLS}/tycswap" "${UMT}/tycswap"
out="$(section Switcher PATH="${UMT}" HOME="${BASE}/home" FLAKELAB_TARGET=other FLAKELAB_INSTALL_TYCSWAP=true FLAKELAB_TYCSWAP_AUTOSWITCH=true FAKE_TIMERS='flakelab-tycswap-autoswitch.timer  loaded active waiting')"
contains "a scheduled timer passes" "${out}" "[ OK ] auto-switch timer scheduled (flakelab-tycswap-autoswitch.timer)"

print -r -- "systemd cgroup: another target"
contains "no WSL, nothing to check" "$(cgroup_section other)" "[ OK ] target other: systemd starts at the top of its own cgroup tree"

print -r -- "systemd cgroup: at the top of the tree"
contains "it passes"      "$(cgroup_section wsl '0::/init.scope')" "[ OK ] systemd runs in /, which its users can enter"

print -r -- "systemd cgroup: under a cgroup only root may enter, on a system without the boot step"
mkdir -p "${CGT}/agent/init.scope"; chmod 700 "${CGT}/agent"
out="$(cgroup_section wsl '0::/agent/init.scope')"
contains "it fails"       "${out}" "[FAIL] systemd runs under /agent, which only root may enter"
contains "names the update" "${out}" "the running system predates the boot step that moves it"

print -r -- "systemd cgroup: the booted system has the step and it recorded nothing"
print -r -- "exec /nix/store/x-flakelab-wsl-init-cgroup/bin/flakelab-wsl-init-cgroup" > "${BASE}/booted/activate"
out="$(cgroup_section wsl '0::/agent/init.scope')"
contains "points at the kernel log" "${out}" "the boot step ran and recorded nothing"
lacks    "not as a predating system" "${out}" "predates"

print -r -- "systemd cgroup: the move was refused"
print -rl -- result=failed from=/agent to=/flakelab-x/init.scope "reason=moving PID 1 to /flakelab-x/init.scope: operation not permitted" > "${CGREC}"
contains "the refusal is named" "$(cgroup_section wsl '0::/agent/init.scope')" "could not: moving PID 1 to /flakelab-x/init.scope: operation not permitted"

print -r -- "systemd cgroup: the move was skipped"
print -rl -- result=skipped from=/agent to= "reason=cannot read the mode of /agent" > "${CGREC}"
contains "the skip is named" "$(cgroup_section wsl '0::/agent/init.scope')" "this boot's move did not run: cannot read the mode of /agent"

print -r -- "systemd cgroup: moved, and under the locked cgroup all the same"
print -rl -- result=moved from=/agent to=/flakelab-x/init.scope > "${CGREC}"
out="$(cgroup_section wsl '0::/agent/init.scope')"
contains "it fails"       "${out}" "[FAIL] systemd runs under /agent"
contains "says where it went" "${out}" "this boot moved the distro to /flakelab-x/init.scope, and systemd runs under /agent all the same"

print -r -- "systemd cgroup: moved out at boot"
mkdir -p "${CGT}/flakelab-x/init.scope"; chmod 755 "${CGT}/flakelab-x"
contains "it passes, saying from where" "$(cgroup_section wsl '0::/flakelab-x/init.scope')" "[ OK ] systemd runs in /flakelab-x, moved there at boot out of /agent"

print -r -- "systemd cgroup: a move recorded to somewhere else is not claimed"
mkdir -p "${CGT}/wsl/distro/init.scope"; chmod 755 "${CGT}/wsl" "${CGT}/wsl/distro"
contains "it passes plainly" "$(cgroup_section wsl '0::/wsl/distro/init.scope')" "[ OK ] systemd runs in /wsl/distro, which its users can enter"

print -r -- "systemd cgroup: an open cgroup of WSL's own"
rm -f "${CGREC}"
contains "it passes"      "$(cgroup_section wsl '0::/wsl/distro/init.scope')" "[ OK ] systemd runs in /wsl/distro, which its users can enter"

print -r -- "systemd cgroup: nothing to read"
contains "it warns"       "$(cgroup_section wsl '')" "[WARN] cannot read the cgroup systemd runs in"
contains "a missing directory warns" "$(cgroup_section wsl '0::/gone/init.scope')" "[WARN] cannot read the mode of /gone"

print -r -- "ssh: no agent because no user manager answers"
none="$(ssh_section 1)" one="$(ssh_section 0)"
contains "names the user manager" "${none}" "no user manager answers, so no user unit runs: systemctl status user@"
lacks    "not while one answers"  "${one}" "no user manager answers"
contains "the agent hint stays"   "${one}" "systemctl --user status ssh-agent.service"
lacks    "no agent unit to restart without a manager" "${none}" "ssh-agent.service"

print -r -- "ssh: a stale socket because no user manager answers"
out="$(ssh_section 1 2)"
contains "names the user manager" "${out}" "no user manager answers, so no user unit runs: systemctl status user@"
lacks    "not the agent unit"     "${out}" "ssh-agent.service"

print -r -- "ssh: a stale socket under a user manager"
out="$(ssh_section 0 2)"
contains "restarts the agent"     "${out}" "systemctl --user restart ssh-agent.service"
lacks    "no user manager finding" "${out}" "no user manager answers"

print -r -- "systemd cgroup: PID 1 is not systemd"
out="$(cgroup_section wsl '0::/' init)"
contains "it fails, naming PID 1 and its cgroup" "${out}" "[FAIL] PID 1 is init, not systemd (cgroup /)"
contains "names the wsl.conf switch" "${out}" "/etc/wsl.conf needs [boot] systemd=true"
contains "and the restart"        "${out}" "'wsl --shutdown' from a Windows terminal"
lacks    "no cgroup verdict"      "${out}" "systemd runs in"

print -r -- ""
print -r -- "${PASS} passed, ${FAIL} failed"
(( FAIL == 0 ))
