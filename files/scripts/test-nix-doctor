#!/usr/bin/env zsh

set -uo pipefail
setopt extended_glob

#
# Offline suite for nix-doctor's reading of the flakelab input: the real script
# against a throwaway overlay whose flake.lock locks that input in each shape nix
# writes, with HOME a fresh directory and every tool that would reach the running
# box, an agent or the network left off PATH. Only the "flakelab input" section is
# asserted; the rest of the run finds nothing and is not looked at.
#
# Usage: files/scripts/test-nix-doctor
#

SCRIPT_DIR="${0:A:h}"
DOCTOR="${SCRIPT_DIR}/nix-doctor"
typeset -i PASS=0 FAIL=0

ok()       { print -r -- "  ok   $1"; (( PASS++ )); return 0 }
bad()      { print -r -u2 -- "  FAIL $1"; (( FAIL++ )); return 0 }
contains() { [[ "$2" == *"$3"* ]] && ok "$1" || { bad "$1"; print -r -u2 -- "       missing: $3"; print -r -u2 -- "       in:      $2" } }

BASE="$(mktemp -d)"
trap 'rm -rf "${BASE}"' EXIT

TOOLS="${BASE}/tools"
mkdir -p "${TOOLS}"
for f in ${^path}/*(N-*); do
  case "${f:t}" in
    systemctl|loginctl|ssh|ssh-add|glab|gh|bw|claude|kiro-cli|flakelab-switch-result|*.exe|wslpath|xdg-open) continue ;;
  esac
  [[ -e "${TOOLS}/${f:t}" ]] || ln -s "${f}" "${TOOLS}/${f:t}"
done
mkdir -p "${BASE}/home" "${BASE}/overlay"

# input_line <locked fields>: the doctor's finding for a lock whose flakelab input
# is locked as given, colours stripped. No lock at all when the argument is empty.
input_line() {
  rm -f "${BASE}/overlay/flake.lock"
  [[ -n "$1" ]] && print -r -- "{\"nodes\":{\"root\":{\"inputs\":{\"flakelab\":\"flakelab\"}},\"flakelab\":{\"locked\":{$1}}},\"root\":\"root\",\"version\":7}" > "${BASE}/overlay/flake.lock"
  local out
  out="$(env -i PATH="${TOOLS}" HOME="${BASE}/home" FLAKELAB_TARGET=other \
    FLAKELAB_REPO_ROOT="${BASE}/overlay" zsh "${DOCTOR}" 2>&1 < /dev/null)"
  out="${out//$'\e'\[[0-9;]#m/}"
  local -a lines=("${(@f)out}")
  local -i i=${lines[(i)*==> flakelab input]}
  print -r -- "${lines[i+1]:-}"
}

print -r -- "test-nix-doctor"

print -r -- "a path: input is a local override"
contains "it warns"      "$(input_line '"type":"path","path":"/srv/flakelab"')" "[WARN] LOCAL flakelab override: path /srv/flakelab"

# nix locks every git+<transport>: input as type `git`; the url says which.
print -r -- "a git+file: input is a local override"
contains "it warns"      "$(input_line '"type":"git","url":"file:///srv/flakelab","rev":"abc"')" "[WARN] LOCAL flakelab override: git+file /srv/flakelab"

print -r -- "a remote git input is published"
contains "it passes"     "$(input_line '"type":"git","url":"https://gitlab.com/grp/flakelab.git","rev":"abc"')" "[ OK ] published flakelab (git https://gitlab.com/grp/flakelab.git)"
contains "over ssh too"  "$(input_line '"type":"git","url":"ssh://git@gitlab.com/grp/flakelab","rev":"abc"')" "[ OK ] published flakelab (git ssh://git@gitlab.com/grp/flakelab)"

print -r -- "a forge input is published"
contains "github"        "$(input_line '"type":"github","owner":"tyclab","repo":"flakelab","rev":"abc"')" "[ OK ] published flakelab (github tyclab/flakelab)"
contains "sourcehut"     "$(input_line '"type":"sourcehut","owner":"~tyc","repo":"flakelab","rev":"abc"')" "[ OK ] published flakelab (sourcehut ~tyc/flakelab)"

print -r -- "no lock is not read as any input"
contains "it warns"      "$(input_line '')" "[WARN] could not read the flakelab input from the lock"

print -r -- ""
print -r -- "${PASS} passed, ${FAIL} failed"
(( FAIL == 0 ))
