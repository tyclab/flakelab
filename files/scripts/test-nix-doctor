#!/usr/bin/env zsh

set -uo pipefail
setopt extended_glob

#
# Offline suite for nix-doctor's reading of the flakelab input and of which AI CLIs
# it holds the box to: the real script against a throwaway overlay whose flake.lock
# locks that input in each shape nix writes, with HOME a fresh directory and every
# tool that would reach the running box, an agent or the network left off PATH.
# Only the "flakelab input" and "AI CLIs" sections are asserted; the rest of the
# run finds nothing and is not looked at.
#
# Usage: files/scripts/test-nix-doctor
#

SCRIPT_DIR="${0:A:h}"
DOCTOR="${SCRIPT_DIR}/nix-doctor"
typeset -i PASS=0 FAIL=0

ok()       { print -r -- "  ok   $1"; (( PASS++ )); return 0 }
bad()      { print -r -u2 -- "  FAIL $1"; (( FAIL++ )); return 0 }
contains() { [[ "$2" == *"$3"* ]] && ok "$1" || { bad "$1"; print -r -u2 -- "       missing: $3"; print -r -u2 -- "       in:      $2" } }
lacks()    { [[ "$2" != *"$3"* ]] && ok "$1" || { bad "$1"; print -r -u2 -- "       present: $3"; print -r -u2 -- "       in:      $2" } }
check()    { [[ "$2" == "$3" ]] && ok "$1" || { bad "$1"; print -r -u2 -- "       want: $3"; print -r -u2 -- "       got:  $2" } }

BASE="$(mktemp -d)"
trap 'rm -rf "${BASE}"' EXIT

TOOLS="${BASE}/tools"
mkdir -p "${TOOLS}"
for f in ${^path}/*(N-*); do
  case "${f:t}" in
    systemctl|loginctl|ssh|ssh-add|glab|gh|bw|claude|codex|tycswap|cswap|session-archive|flakelab-switch-result|flakelab-nix-access-tokens|*.exe|wslpath|xdg-open) continue ;;
  esac
  [[ -e "${TOOLS}/${f:t}" ]] || ln -s "${f}" "${TOOLS}/${f:t}"
done
mkdir -p "${BASE}/home" "${BASE}/overlay"

# section <name> <VAR=value>...: the doctor's section <name>, from a run with only
# that environment; piped, so without colour. NixOS's /etc/zshenv puts the system
# profile, systemctl with it, on the PATH of every zsh it starts unless it has run
# already; each run says it has.
section() {
  local name="$1" out
  shift
  out="$(env -i __ETC_ZSHENV_SOURCED=1 "$@" zsh "${SECTION_DOCTOR:-${DOCTOR}}" 2>&1 < /dev/null)"
  out="${out#*==> ${name}$'\n'}"
  print -r -- "${out%%$'\n'==> *}"
}

# input_section <locked fields> [<flake.nix text>]: the doctor's "flakelab input"
# section for a lock whose flakelab input is locked as given (no lock when empty),
# beside that flake.nix (none when omitted).
input_section() {
  rm -f "${BASE}/overlay/flake.lock" "${BASE}/overlay/flake.nix"
  [[ -n "$1" ]] && print -r -- "{\"nodes\":{\"root\":{\"inputs\":{\"flakelab\":\"flakelab\"}},\"flakelab\":{\"locked\":{$1}}},\"root\":\"root\",\"version\":7}" > "${BASE}/overlay/flake.lock"
  [[ -n "${2:-}" ]] && print -r -- "$2" > "${BASE}/overlay/flake.nix"
  section 'flakelab input' PATH="${TOOLS}" HOME="${BASE}/home" FLAKELAB_TARGET=other FLAKELAB_REPO_ROOT="${BASE}/overlay"
}
input_line() {
  local -a lines=("${(@f)$(input_section "$@")}")
  print -r -- "${lines[1]:-}"
}

# g <git args>: git with an identity and no host hooks or signing, for fixtures.
g() { git -c user.name=t -c user.email=t@example.invalid -c commit.gpgsign=false -c core.hooksPath=/dev/null "$@" }
# checkout <name>: a git checkout under ${BASE} with one commit and a clean worktree.
checkout() {
  local d="${BASE}/$1"
  mkdir -p "${d}"
  print -r -- '{ }' > "${d}/flake.nix"
  g -C "${d}" init -q -b main
  g -C "${d}" add -A
  g -C "${d}" commit -q -m init
  print -r -- "${d}"
}

# ai_clis [<FLAKELAB_AI_CLIS>]: the doctor's "AI CLIs" section, with the variable
# exported as given, or unset when no argument is passed.
ai_clis() {
  local -a env=(PATH="${TOOLS}" HOME="${BASE}/home" FLAKELAB_TARGET=other)
  (( $# )) && env+=(FLAKELAB_AI_CLIS="$1")
  section 'AI CLIs' "${env[@]}"
}

# native_home <name>: a HOME under ${BASE} holding a native ~/.local/bin/claude.
native_home() {
  local h="${BASE}/$1"
  mkdir -p "${h}/.local/bin"
  print -rl -- '#!/bin/sh' 'echo 1.2.3' > "${h}/.local/bin/claude"
  chmod +x "${h}/.local/bin/claude"
  print -r -- "${h}"
}
# claude_section <home> [VAR=value...]: the "AI CLIs" section with only claude
# installed and Remote Control off; a later argument wins.
claude_section() {
  local home="$1"
  shift
  section 'AI CLIs' PATH="${TOOLS}" HOME="${home}" FLAKELAB_TARGET=other FLAKELAB_AI_CLIS=claude \
    FLAKELAB_SOPS_RENDER=0 FLAKELAB_CLAUDE_REMOTE_CONTROL=false "$@"
}

# switcher_section [<systemctl exit status>] [VAR=value...]: the doctor's Switcher
# section with tycswap stubbed on PATH (FAKE_TYCSWAP_LIST its list --json answer,
# FAKE_TYCSWAP_ERR a failure); with a numeric first argument, under a systemctl
# that exits as given.
switcher_section() {
  local tools="${TOOLS}"
  if [[ "${1:-}" == <-> ]]; then stub systemctl "$1"; ln -sf "${TOOLS}/tycswap" "${UMT}/tycswap"; tools="${UMT}"; shift; fi
  section Switcher PATH="${tools}" HOME="${BASE}/home" FLAKELAB_TARGET=other FLAKELAB_INSTALL_TYCSWAP=true "$@"
}
cat > "${TOOLS}/tycswap" <<'STUB'
#!/usr/bin/env zsh
case "$1" in
  --version) print -r -- "tycswap v0.3.0" ;;
  list) [[ -n "${FAKE_TYCSWAP_ERR:-}" ]] && { print -ru2 -- "${FAKE_TYCSWAP_ERR}"; exit 1 }
        # No default inside ${:-}: zsh ends the word at the first }, which a JSON default has.
        [[ -n "${FAKE_TYCSWAP_LIST:-}" ]] && print -r -- "${FAKE_TYCSWAP_LIST}" || print -r -- '{"schemaVersion":1,"activeAccountNumber":null,"accounts":[]}' ;;
  *) exit 2 ;;
esac
STUB
chmod +x "${TOOLS}/tycswap"
NOTYCSWAP="${BASE}/notycswap"; mkdir -p "${NOTYCSWAP}"
for f in "${TOOLS}"/*(N); do [[ "${f:t}" == tycswap ]] || ln -s "${f}" "${NOTYCSWAP}/${f:t}"; done

# cgroup_section <target> [<PID 1 cgroup line> [<PID 1 comm>]]: the doctor's "systemd
# cgroup" section against the fake tree under ${CGT}, the record at ${CGREC} and the
# booted system under ${BASE}/booted. No cgroup file at all when the line is empty;
# PID 1 is systemd unless a comm is given.
CGT="${BASE}/cgroup" CGREC="${BASE}/run/init-cgroup"
mkdir -p "${CGT}" "${BASE}/run" "${BASE}/proc/1" "${BASE}/booted"
cgroup_section() {
  rm -f "${BASE}/proc/1/cgroup"
  [[ -n "${2:-}" ]] && print -r -- "$2" > "${BASE}/proc/1/cgroup"
  print -r -- "${3:-systemd}" > "${BASE}/proc/1/comm"
  section 'systemd cgroup' PATH="${TOOLS}" HOME="${BASE}/home" FLAKELAB_TARGET="$1" \
    FLAKELAB_PROC_ROOT="${BASE}/proc" FLAKELAB_CGROUP_ROOT="${CGT}" \
    FLAKELAB_INIT_CGROUP_RECORD="${CGREC}" FLAKELAB_BOOTED_SYSTEM="${BASE}/booted"
}

BINFMT="${BASE}/binfmt"
mkdir -p "${BINFMT}"
interop_section() {
  section 'WSL interop' PATH="${TOOLS}" HOME="${BASE}/home" FLAKELAB_TARGET=wsl \
    FLAKELAB_BINFMT_ROOT="${BINFMT}" "$@"
}

# stub <name> <exit status>: a <name> in ${UMT}, the tools beside it, that exits as
# given whatever it is asked (`systemctl --user show-environment` included).
UMT="${BASE}/tools-um"
mkdir -p "${UMT}"
for f in "${TOOLS}"/*(N); do ln -s "${f:A}" "${UMT}/${f:t}"; done
stub() {
  print -r -- "#!/bin/sh"$'\n'"exit $2" > "${UMT}/$1"
  chmod +x "${UMT}/$1"
}

# ssh_section <systemctl exit status> [<ssh-add exit status>]: the doctor's SSH
# section under that systemctl, with no agent in the environment, or with the second
# argument a socket on which `ssh-add -l` exits as given.
ssh_section() {
  stub systemctl "$1"
  local -a env=(PATH="${UMT}" HOME="${BASE}/home" FLAKELAB_TARGET=other)
  rm -f "${UMT}/ssh-add"
  if (( $# > 1 )); then
    stub ssh-add "$2"
    env+=(SSH_AUTH_SOCK="${BASE}/agent.sock")
  fi
  section SSH "${env[@]}"
}

print -r -- "test-nix-doctor"

print -r -- "a published input passes"
contains "a remote git url"  "$(input_line '"type":"git","url":"https://gitlab.com/grp/flakelab.git","rev":"abc"')" "[ OK ] published flakelab (git https://gitlab.com/grp/flakelab.git)"
contains "over ssh too"      "$(input_line '"type":"git","url":"ssh://git@gitlab.com/grp/flakelab","rev":"abc"')" "[ OK ] published flakelab (git ssh://git@gitlab.com/grp/flakelab)"
contains "github"            "$(input_line '"type":"github","owner":"tyclab","repo":"flakelab","rev":"abc"')" "[ OK ] published flakelab (github tyclab/flakelab)"
contains "sourcehut"         "$(input_line '"type":"sourcehut","owner":"~you","repo":"flakelab","rev":"abc"')" "[ OK ] published flakelab (sourcehut ~you/flakelab)"

print -r -- "a local override is legitimate: a clean path: checkout passes"
co="$(checkout path-co)"
out="$(input_section "\"type\":\"path\",\"path\":\"${co}\"")"
contains "it names the override"  "${out}" "[ OK ] LOCAL flakelab override: path:${co}"
lacks    "with no warning"        "${out}" "[WARN]"
lacks    "nor the blanket claim"  "${out}" "never reach this box"

print -r -- "a path: override at a path that is gone warns"
out="$(input_section '"type":"path","path":"/srv/no-such-flakelab"')"
contains "it names the path"      "${out}" "[WARN] LOCAL flakelab override points at a path that does not exist: /srv/no-such-flakelab"

print -r -- "an untracked file, a build's result link say, is no change"
print -r -- edit > "${co}/result"
lacks    "no warning"             "$(input_section "\"type\":\"path\",\"path\":\"${co}\"")" "[WARN]"
rm -f "${co}/result"

print -r -- "a dirty path: checkout warns that the build takes the worktree"
print -r -- '{ edited = true; }' > "${co}/flake.nix"
out="$(input_section "\"type\":\"path\",\"path\":\"${co}\"")"
contains "it names the checkout"  "${out}" "[WARN] the flakelab checkout has uncommitted changes: ${co}"
contains "and what path: does"    "${out}" "a path: input builds the worktree as it stands"
g -C "${co}" checkout -q -- flake.nix

print -r -- "reading a checkout does not rewrite its index"
touch "${co}/flake.nix"
idx="$(stat -c %y "${co}/.git/index")"
input_section "\"type\":\"path\",\"path\":\"${co}\"" > /dev/null
check    "the index is untouched" "$(stat -c %y "${co}/.git/index")" "${idx}"

print -r -- "a checkout behind its tracking ref warns, read as last fetched"
g init -q --bare -b main "${BASE}/remote.git"
g -C "${co}" remote add origin "${BASE}/remote.git"
g -C "${co}" push -q -u origin main
g clone -q "${BASE}/remote.git" "${BASE}/elsewhere-co"
print -r -- ahead > "${BASE}/elsewhere-co/ahead"
g -C "${BASE}/elsewhere-co" add -A
g -C "${BASE}/elsewhere-co" commit -q -m ahead
g -C "${BASE}/elsewhere-co" push -q origin main
lacks    "the doctor fetches nothing" "$(input_section "\"type\":\"path\",\"path\":\"${co}\"")" "behind"
g -C "${co}" fetch -q origin
out="$(input_section "\"type\":\"path\",\"path\":\"${co}\"")"
contains "it counts the commits"  "${out}" "[WARN] the flakelab checkout is 1 commit(s) behind origin/main"
contains "with the pull"          "${out}" "git -C ${co} pull --rebase, then flakelab update"

# nix locks every git+<transport>: input as type `git`; the url says which.
print -r -- "a git+file: checkout passes clean and warns dirty"
co="$(checkout gitfile-co)"
out="$(input_section "\"type\":\"git\",\"url\":\"file://${co}\",\"rev\":\"abc\"")"
contains "it names the override"  "${out}" "[ OK ] LOCAL flakelab override: git+file:${co}"
lacks    "with no warning"        "${out}" "[WARN]"
print -r -- '{ edited = true; }' > "${co}/flake.nix"
out="$(input_section "\"type\":\"git\",\"url\":\"file://${co}\",\"rev\":\"abc\"")"
contains "dirty, it warns"        "${out}" "[WARN] the flakelab checkout has uncommitted changes: ${co}"
contains "that the lock pins a commit" "${out}" "builds the commit its lock pins, and Nix will not re-lock a dirty tree"

print -r -- "no lock beside a path: input is the generated overlay's normal state"
co="$(checkout 'spaced co')"
out="$(input_section '' "{"$'\n'"  inputs.flakelab.url = \"path:${co// /%20}\";"$'\n'"  outputs = _: { };"$'\n'"}")"
contains "it says so"             "${out}" "[ OK ] no flake.lock: flake.nix names a path: input"
contains "and checks the decoded path" "${out}" "[ OK ] LOCAL flakelab override: path:${co}"
lacks    "with no warning"        "${out}" "[WARN]"

print -r -- "no lock and no path: input is unknown"
contains "a commented-out path: line does not count" "$(input_line '' $'{\n  # inputs.flakelab.url = "path:/srv/x";\n  inputs.flakelab.url = "github:tyclab/flakelab";\n}')" "[WARN] no flake.lock at ${BASE}/overlay/flake.lock"
contains "it warns" "$(input_line '' '{ inputs.flakelab.url = "github:tyclab/flakelab"; }')" "[WARN] no flake.lock at ${BASE}/overlay/flake.lock"
contains "with nothing beside it too" "$(input_line '')" "[WARN] no flake.lock at ${BASE}/overlay/flake.lock"

print -r -- "a lock it cannot place is reported, never called published"
print -r -- '{"nodes":{"root":{"inputs":{}}},"root":"root","version":7}' > "${BASE}/overlay/flake.lock"
out="$(section 'flakelab input' PATH="${TOOLS}" HOME="${BASE}/home" FLAKELAB_TARGET=other FLAKELAB_REPO_ROOT="${BASE}/overlay")"
contains "no flakelab input"      "${out}" "[WARN] the lock at ${BASE}/overlay/flake.lock names no flakelab input"
contains "an unknown type"        "$(input_line '"type":"mercurial"')" "[WARN] unrecognised flakelab input type 'mercurial'"
contains "no repo root"           "$(section 'flakelab input' PATH="${TOOLS}" HOME="${BASE}/home" FLAKELAB_TARGET=other)" "[WARN] FLAKELAB_REPO_ROOT is unset"
rm -f "${BASE}/overlay/flake.lock"

print -r -- "the AI CLIs checked are the ones the overlay installs"
out="$(ai_clis 'claude codex')"
contains "both"                "${out}" "[FAIL] Codex CLI not installed"
contains "claude among them"   "${out}" "[FAIL] Claude Code is not installed natively at ~/.local/bin/claude"
lacks    "no channel unexported" "${out}" "bash -s"
contains "the reinstall keeps the channel" "$(section 'AI CLIs' PATH="${TOOLS}" HOME="${BASE}/home" FLAKELAB_TARGET=other FLAKELAB_AI_CLIS=claude FLAKELAB_CLAUDE_UPDATE_CHANNEL=latest)" "curl -fsSL https://claude.ai/install.sh | bash -s latest"
lacks    "one switched off"    "$(ai_clis claude)" "Codex CLI"
out="$(ai_clis codex)"
contains "only codex"          "${out}" "[FAIL] Codex CLI not installed"
lacks    "not claude then"     "${out}" "Claude Code"
lacks    "nor its blockers"    "${out}" "update blockers"
contains "none"                "$(ai_clis '')" "[ OK ] no AI CLI installed by this overlay"
contains "unset is none"       "$(ai_clis)" "[ OK ] no AI CLI installed by this overlay"

print -r -- "claude: the native install passes"
h="$(native_home claude-clean)"
out="$(claude_section "${h}")"
contains "it names the native binary" "${out}" "[ OK ] claude present (native, ~/.local/bin/claude — 1.2.3)"
contains "no competitor"              "${out}" "[ OK ] no competing claude in ~/.npm-global/bin"
contains "no blocker"                 "${out}" "[ OK ] no update blockers set (CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC)"
lacks    "nothing else"               "${out}" "[WARN]"

print -r -- "claude: an npm-global copy shadows it, is named and left alone"
mkdir -p "${h}/.npm-global/bin"
print -rl -- '#!/bin/sh' 'echo npm' > "${h}/.npm-global/bin/claude"
chmod +x "${h}/.npm-global/bin/claude"
out="$(claude_section "${h}")"
contains "it warns, naming it"        "${out}" "[WARN] a competing claude executable exists: ${h}/.npm-global/bin/claude"
contains "and why it matters"         "${out}" "comes first on PATH, so it shadows the native, self-updating one"
contains "with the uninstall"         "${out}" "npm -g uninstall @anthropic-ai/claude-code   (nothing is removed here)"
lacks    "no failure"                 "${out}" "[FAIL]"
[[ -x "${h}/.npm-global/bin/claude" ]] && ok "the npm copy is still there" || bad "the npm copy is still there"
rm -rf "${h}/.npm-global"

print -r -- "blockers: NONESSENTIAL_TRAFFIC is always one, never with its value"
out="$(claude_section "${h}" CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=sentinel-2)"
contains "it warns with its cost"     "${out}" "[WARN] CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC is set in the environment: it disables Claude Code's self-updater"
contains "where to unset it"          "${out}" "a shell profile, the secrets file, or the overlay's sessionVariables"
lacks    "no value"                   "${out}" "sentinel-2"
lacks    "no failure"                 "${out}" "[FAIL]"
contains "empty is unset"             "$(claude_section "${h}" CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=)" "[ OK ] no update blockers set"

print -r -- "blockers: GROWTHBOOK counts only with Remote Control on"
out="$(claude_section "${h}" DISABLE_GROWTHBOOK=1)"
contains "off, set deliberately, it is no finding" "${out}" "[ OK ] no update blockers set (CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC)"
out="$(claude_section "${h}" FLAKELAB_CLAUDE_REMOTE_CONTROL=true DISABLE_GROWTHBOOK=sentinel-1)"
contains "on, it warns"               "${out}" "[WARN] DISABLE_GROWTHBOOK is set in the environment: it turns off the feature-flag fetch, so Remote Control (claudeRemoteControl) is unavailable"
lacks    "not the updater"            "${out}" "self-updater"
lacks    "no value"                   "${out}" "sentinel-1"
out="$(claude_section "${h}" FLAKELAB_CLAUDE_REMOTE_CONTROL=true DO_NOT_TRACK=1 DISABLE_TELEMETRY=1)"
contains "TELEMETRY and DO_NOT_TRACK leave Remote Control up" "${out}" "[ OK ] no update blockers set (CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC, DISABLE_GROWTHBOOK)"

print -r -- "blockers: settings.json env counts too"
mkdir -p "${h}/.claude"
print -r -- '{"env":{"CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC":"1","DISABLE_GROWTHBOOK":"1","DO_NOT_TRACK":"1"}}' > "${h}/.claude/settings.json"
out="$(claude_section "${h}")"
contains "it names the file"          "${out}" "[WARN] CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC is set in ${h}/.claude/settings.json env"
contains "and the remedy"             "${out}" "delete it from .env there"
lacks    "Remote Control off, GROWTHBOOK is none" "${out}" "DISABLE_GROWTHBOOK is set"
out="$(claude_section "${h}" FLAKELAB_CLAUDE_REMOTE_CONTROL=true)"
contains "on, it is"                  "${out}" "[WARN] DISABLE_GROWTHBOOK is set in ${h}/.claude/settings.json env"
contains "which an update removes"    "${out}" "flakelab update removes it again"
lacks    "DO_NOT_TRACK is none"       "${out}" "DO_NOT_TRACK is set"
contains "from Claude Code's shell too" "$(claude_section "${h}" CLAUDECODE=1)" "[WARN] CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC is set in ${h}/.claude/settings.json env"
rm -rf "${h}/.claude"

print -r -- "blockers: from Claude Code's shell its NONESSENTIAL_TRAFFIC is not the session's"
out="$(claude_section "${h}" CLAUDECODE=1 CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1)"
contains "it says it is not read"     "${out}" "[ OK ] CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC is not read from the environment in Claude Code's shell"
lacks    "nor reported"               "${out}" "is set in the environment"
contains "GROWTHBOOK still is"       "$(claude_section "${h}" FLAKELAB_CLAUDE_REMOTE_CONTROL=true CLAUDECODE=1 DISABLE_GROWTHBOOK=1)" "[WARN] DISABLE_GROWTHBOOK is set in the environment"
mkdir -p "${h}/.config/flakelab"
print -r -- "export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC='sentinel-3'" > "${h}/.config/flakelab/secrets.env"
out="$(claude_section "${h}" CLAUDECODE=1 CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1)"
contains "secrets.env assigning it is" "${out}" "[WARN] CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC is assigned in ${h}/.config/flakelab/secrets.env, which the shell sources"
lacks    "never its value"            "${out}" "sentinel-3"
for line in 'CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=""' 'CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=' \
            "export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=''" '# CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1' 'OTHER_KEY=1'; do
  print -r -- "${line}" > "${h}/.config/flakelab/secrets.env"
  lacks "${line} assigns nothing" "$(claude_section "${h}" CLAUDECODE=1 CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1)" "which the shell sources"
done

# The render path is fixed in the script, so these run a copy whose render is a
# file under ${BASE}, its lib/ beside it.
mkdir -p "${BASE}/render-doctor"
ln -s "${DOCTOR:A:h}/lib" "${BASE}/render-doctor/lib"
sed "s|^SOPS_RENDER=\"/run/secrets/flakelab-env\"\$|SOPS_RENDER=\"${BASE}/render\"|" "${DOCTOR}" > "${BASE}/render-doctor/nix-doctor"
check "the copy reads the stand-in render" "$(grep -cxF "SOPS_RENDER=\"${BASE}/render\"" "${BASE}/render-doctor/nix-doctor")" "1"
SECTION_DOCTOR="${BASE}/render-doctor/nix-doctor"
print -r -- "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1" > "${h}/.config/flakelab/secrets.env"
print -r -- "OTHER_KEY=1" > "${BASE}/render"
print -r -- "blockers: the shell's one secrets file is the render on an enrolled box"
contains "un-enrolled, a stale render is not read" "$(claude_section "${h}" CLAUDECODE=1 CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1)" "is assigned in ${h}/.config/flakelab/secrets.env"
lacks    "enrolled, secrets.env is not" "$(claude_section "${h}" FLAKELAB_SOPS_RENDER=1 CLAUDECODE=1 CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1)" "which the shell sources"
lacks    "outside the wrapper a render on disk counts" "$(claude_section "${h}" FLAKELAB_SOPS_RENDER= CLAUDECODE=1 CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1)" "which the shell sources"
print -r -- "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1" > "${BASE}/render"
contains "enrolled, the render is"    "$(claude_section "${h}" FLAKELAB_SOPS_RENDER=1 CLAUDECODE=1 CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1)" "is assigned in ${BASE}/render"
unset SECTION_DOCTOR
rm -rf "${BASE}/render" "${BASE}/render-doctor" "${h}/.config"

print -r -- "blockers: any claude on the box reads them, a hand-installed one too"
contains "with no AI CLI installed" "$(section 'AI CLIs' PATH="${TOOLS}" HOME="${h}" FLAKELAB_TARGET=other FLAKELAB_AI_CLIS= CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1)" "[WARN] CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC is set in the environment"


print -r -- "a usage error exits 2, not 1 like a failed check"
rc=0
env -i __ETC_ZSHENV_SOURCED=1 PATH="${TOOLS}" HOME="${BASE}/home" zsh "${DOCTOR}" --strct > /dev/null 2>&1 || rc=$?
[[ "${rc}" == 2 ]] && ok "an unknown option exits 2" || bad "an unknown option exits 2 (got ${rc})"

print -r -- "WSL interop: missing registry remains a failure with host verification guidance"
out="$(interop_section)"
contains "fails for the missing registry" "${out}" "[FAIL] binfmt_misc register is not visible"
contains "requires host evidence"        "${out}" "outside any sandbox"
lacks    "does not prescribe shutdown"   "${out}" "wsl --shutdown"

print -r -- "WSL interop: missing handler remains a failure without an unconditional shutdown remedy"
