  out="$(interop_section WSL_INTEROP="${socket_path}")"
  contains "missing or nonsocket path warns" "${out}" "[WARN] inherited WSL_INTEROP socket is missing or not a socket"
  contains "a registered handler still passes" "${out}" "[ OK ] WSLInterop handler registered"
