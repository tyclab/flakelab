# The Windows tray: nix-tycswap-tray stubbed on PATH answers status with
# FAKE_TRAY_OUT and exits FAKE_TRAY_RC; only the wsl target reads it.
cat > "${TOOLS}/nix-tycswap-tray" <<'STUB'
#!/usr/bin/env zsh
[[ "$1" == status ]] || exit 2
print -r -- "${FAKE_TRAY_OUT}"
exit "${FAKE_TRAY_RC:-0}"
STUB
chmod +x "${TOOLS}/nix-tycswap-tray"
NOTRAY="${BASE}/notray"; mkdir -p "${NOTRAY}"
for f in "${TOOLS}"/*(N); do [[ "${f:t}" == nix-tycswap-tray ]] || ln -s "${f}" "${NOTRAY}/${f:t}"; done
print -r -- "the Windows tray"
out="$(switcher_section FLAKELAB_TARGET=wsl FLAKELAB_TYCSWAP_APP_PORT=7337 FAKE_TRAY_OUT=$'tray: exe: tycswap 0.8.2 at C:\\x\\tycswap.exe\ntray: task: io.github.tyclab.tycswap.remote starts the distro and the tray at logon\ntray: run key: none (the task is the only start)\ntray: running: pid 7 since 2026-10-30 17:09:33')"
contains "a clean status is three OK lines: the exe" "${out}" "[ OK ] tray exe: tycswap 0.8.2"
contains "the task"                                   "${out}" "[ OK ] tray task: io.github.tyclab.tycswap.remote"
contains "the tray"                                   "${out}" "[ OK ] tray running: pid 7"
lacks    "and no hint"                                "${out}" "flakelab tray   #"
out="$(switcher_section FLAKELAB_TARGET=wsl FLAKELAB_TYCSWAP_APP_PORT=7337 FAKE_TRAY_RC=1 FAKE_TRAY_OUT=$'tray: exe: tycswap 0.8.2 at C:\\x\\tycswap.exe\ntray: off: register the logon task io.github.tyclab.tycswap.remote (it is not registered)\ntray: off: start the tray (none running)')"
contains "an off line is a warning"                   "${out}" "[WARN] tray: register the logon task io.github.tyclab.tycswap.remote"
contains "each of them"                               "${out}" "[WARN] tray: start the tray (none running)"
check    "two independent tray findings are two warnings" "$(print -r -- "${out}" | grep -c '\[WARN\]')" "2"
contains "and the hint names the fix"                 "${out}" "flakelab tray   # installs the pinned exe"
out="$(switcher_section FLAKELAB_TARGET=wsl FLAKELAB_TYCSWAP_APP_PORT=7337 FAKE_TRAY_RC=1 FAKE_TRAY_OUT='powershell.exe not found - is /mnt/c mounted?')"
contains "a line that is not a tray fact is a warning too" "${out}" "[WARN] tray: powershell.exe not found"
out="$(switcher_section FLAKELAB_TARGET=wsl FLAKELAB_TYCSWAP_APP_PORT=7337 FAKE_TRAY_RC=1 FAKE_TRAY_OUT=$'WSLInterop handler is missing\nCheck Windows executable access from a host terminal\nReview known-issues.md')"
check    "one multiline failure is one warning" "$(print -r -- "${out}" | grep -c '\[WARN\]')" "1"
contains "the first line names the failure" "${out}" "[WARN] tray: WSLInterop handler is missing"
contains "the first follow-up stays visible" "${out}" "Check Windows executable access from a host terminal"
contains "the second follow-up stays visible" "${out}" "Review known-issues.md"
lacks    "the first follow-up is not another warning" "${out}" "[WARN] tray: Check Windows executable access"
lacks    "the second follow-up is not another warning" "${out}" "[WARN] tray: Review known-issues.md"
for tray_output in '' 'tray: running: pid 7'; do
  out="$(switcher_section FLAKELAB_TARGET=wsl FLAKELAB_TYCSWAP_APP_PORT=7337 FAKE_TRAY_RC=7 FAKE_TRAY_OUT="${tray_output}")"
  contains "a failed status cannot disappear behind empty or OK output" "${out}" "[WARN] tray status failed (exit 7)"
  check "the status failure is counted once" "$(print -r -- "${out}" | grep -c '\[WARN\]')" "1"
done
out="$(section Switcher PATH="${NOTRAY}" HOME="${BASE}/home" FLAKELAB_TARGET=wsl FLAKELAB_INSTALL_TYCSWAP=true FLAKELAB_TYCSWAP_APP_PORT=7337)"
contains "no nix-tycswap-tray on PATH warns"          "${out}" "[WARN] tycswapAppPort is set, but nix-tycswap-tray is not on PATH"
out="$(switcher_section FLAKELAB_TYCSWAP_APP_PORT=7337 FAKE_TRAY_OUT='tray: off: start the tray (none running)' FAKE_TRAY_RC=1)"
contains "another target is a note"                   "${out}" "[ OK ] note: tycswapAppPort is set, but only the wsl target has a Windows tray"
lacks    "and never runs the status"                  "${out}" "[WARN] tray"
out="$(switcher_section)"
lacks    "no port: no tray line at all"               "${out}" "tray"

# dashboard_section <systemctl show answer> [<cmdline word>...]: the doctor's
# Dashboard section under a systemctl whose `show flakelab-web.service` prints the
# answer, with /proc faked so that PID 4242's cmdline is the given words (none: no
# process to read).
PROCT="${BASE}/proc-web"
dashboard_section() {
  print -rl -- '#!/bin/sh' 'case "$*" in *"show flakelab-web.service"*) printf "%s\n" "${FAKE_WEB_SHOW:-}"; exit "${FAKE_WEB_SHOW_RC:-0}" ;; esac' 'exit 0' > "${UMT}/systemctl"
  chmod +x "${UMT}/systemctl"
  rm -rf "${PROCT}"; mkdir -p "${PROCT}/4242"
  (( $# > 1 )) && printf '%s\0' "${@:2}" > "${PROCT}/4242/cmdline"
  section Dashboard PATH="${UMT}" HOME="${BASE}/home" FLAKELAB_TARGET=other FLAKELAB_PROC_ROOT="${PROCT}" FAKE_WEB_SHOW="$1" FAKE_WEB_SHOW_RC="${FAKE_WEB_SHOW_RC:-0}"
}
WEB_HERE="${DOCTOR:A:h}/lib/web.py"

print -r -- "dashboard: no unit"
contains "is a note" "$(dashboard_section $'LoadState=not-found\nActiveState=inactive\nMainPID=0')" "[ OK ] note: no dashboard unit (flakelab.web.enable runs flakelab-web)"
out="$(FAKE_WEB_SHOW_RC=1 dashboard_section $'LoadState=not-found\nActiveState=inactive\nMainPID=0')"
contains "systemd's nonzero not-found result is still a note" "${out}" "[ OK ] note: no dashboard unit"
lacks "not-found adds no warning" "${out}" "[WARN]"

print -r -- "dashboard: failed or incomplete inspection is never a missing-unit success"
for web_show in '' $'LoadState=loaded\nActiveState=active\nMainPID=4242'; do
  out="$(FAKE_WEB_SHOW_RC=1 dashboard_section "${web_show}" python3 "${WEB_HERE}")"
  contains "failed inspection warns even with partial output" "${out}" "[WARN] cannot inspect flakelab-web.service"
  lacks "failed inspection does not claim no unit" "${out}" "[ OK ] note: no dashboard unit"
  lacks "failed inspection does not claim current code" "${out}" "[ OK ] dashboard runs this generation"
done
for web_show in '' $'ActiveState=active\nMainPID=4242'; do
  out="$(dashboard_section "${web_show}" python3 "${WEB_HERE}")"
  contains "successful but incomplete inspection warns" "${out}" "[WARN] cannot inspect flakelab-web.service"
  lacks "incomplete inspection does not claim no unit" "${out}" "[ OK ] note: no dashboard unit"
done

print -r -- "dashboard: the unit is loaded but down"
out="$(dashboard_section $'LoadState=loaded\nActiveState=failed\nMainPID=0')"
contains "warns"                 "${out}" "[WARN] flakelab-web.service is loaded but not active"
contains "names the status line" "${out}" "systemctl --user status flakelab-web.service"

print -r -- "dashboard: running this generation's web.py"
contains "passes" "$(dashboard_section $'LoadState=loaded\nActiveState=active\nMainPID=4242' python3 "${WEB_HERE}")" "[ OK ] dashboard runs this generation's code (flakelab-web.service)"

print -r -- "dashboard: running a previous generation's web.py"
out="$(dashboard_section $'LoadState=loaded\nActiveState=active\nMainPID=4242' python3 /nix/store/00000000000000000000000000000000-scripts/lib/web.py)"
contains "warns"             "${out}" "[WARN] the dashboard runs a previous generation's code; activation never restarts it"
contains "names the restart" "${out}" "systemctl --user restart flakelab-web.service"
contains "explains the active-terminal impact" "${out}" "disconnects browser terminals; reopen them from the dashboard"

print -r -- "dashboard: a process that cannot be read"
contains "warns, naming the pid" "$(dashboard_section $'LoadState=loaded\nActiveState=active\nMainPID=4242')" "[WARN] the dashboard's process (4242) cannot be read"

print -r -- "dashboard: no user manager"
stub systemctl 1
contains "is a note" "$(section Dashboard PATH="${UMT}" HOME="${BASE}/home" FLAKELAB_TARGET=other)" "[ OK ] note: no user manager, so no dashboard unit to check"

# native_mcp <config JSON>: the whole doctor run with FLAKELAB_MCP_CONFIG naming that
# configuration.
native_mcp() {
  print -r -- "$1" > "${BASE}/mcp-config.json"
  env -i __ETC_ZSHENV_SOURCED=1 PATH="${TOOLS}" HOME="${BASE}/home" FLAKELAB_TARGET=other FLAKELAB_MCP_CONFIG="${BASE}/mcp-config.json" zsh "${DOCTOR}" 2>&1 < /dev/null
}

print -r -- "native MCP: no native server declared"
out="$(native_mcp '{"servers": {}, "nativeServers": {}}')"
lacks "no section for an empty check" "${out}" "==> Native MCP clients"
lacks "and no pass for it"            "${out}" "native MCP files and credentials agree"

print -r -- "native MCP: a declared server that fails the check"
out="$(native_mcp '{"servers": {}, "nativeServers": {"hub": {"url": "http://hub.invalid/mcp", "tokenEnv": "HUB_TOKEN"}}}')"
contains "the section is there" "${out}" "==> Native MCP clients"
contains "and it fails"         "${out}" "[FAIL] native MCP configuration or credentials need attention"

print -r -- "systemd cgroup: another target"
contains "no WSL, nothing to check" "$(cgroup_section other)" "[ OK ] target other: systemd starts at the top of its own cgroup tree"

print -r -- "systemd cgroup: at the top of the tree"
contains "it passes"      "$(cgroup_section wsl '0::/init.scope')" "[ OK ] systemd runs in /, which its users can enter"

print -r -- "systemd cgroup: under a cgroup only root may enter, on a system without the boot step"
mkdir -p "${CGT}/agent/init.scope"; chmod 700 "${CGT}/agent"
out="$(cgroup_section wsl '0::/agent/init.scope')"
contains "it fails"       "${out}" "[FAIL] systemd runs under /agent, which only root may enter"
contains "names the update" "${out}" "the running system predates the boot step that moves it"

print -r -- "systemd cgroup: the booted system has the step and it recorded nothing"
print -r -- "exec /nix/store/x-flakelab-wsl-init-cgroup/bin/flakelab-wsl-init-cgroup" > "${BASE}/booted/activate"
out="$(cgroup_section wsl '0::/agent/init.scope')"
contains "points at the kernel log" "${out}" "the boot step ran and recorded nothing"
lacks    "not as a predating system" "${out}" "predates"

print -r -- "systemd cgroup: the move was refused"
print -rl -- result=failed from=/agent to=/flakelab-x/init.scope "reason=moving PID 1 to /flakelab-x/init.scope: operation not permitted" > "${CGREC}"
contains "the refusal is named" "$(cgroup_section wsl '0::/agent/init.scope')" "could not: moving PID 1 to /flakelab-x/init.scope: operation not permitted"

print -r -- "systemd cgroup: the move was skipped"
print -rl -- result=skipped from=/agent to= "reason=cannot read the mode of /agent" > "${CGREC}"
contains "the skip is named" "$(cgroup_section wsl '0::/agent/init.scope')" "this boot's move did not run: cannot read the mode of /agent"

print -r -- "systemd cgroup: moved, and under the locked cgroup all the same"
print -rl -- result=moved from=/agent to=/flakelab-x/init.scope > "${CGREC}"
out="$(cgroup_section wsl '0::/agent/init.scope')"
contains "it fails"       "${out}" "[FAIL] systemd runs under /agent"
contains "says where it went" "${out}" "this boot moved the distro to /flakelab-x/init.scope, and systemd runs under /agent all the same"

print -r -- "systemd cgroup: moved out at boot"
mkdir -p "${CGT}/flakelab-x/init.scope"; chmod 755 "${CGT}/flakelab-x"
contains "it passes, saying from where" "$(cgroup_section wsl '0::/flakelab-x/init.scope')" "[ OK ] systemd runs in /flakelab-x, moved there at boot out of /agent"

print -r -- "systemd cgroup: a move recorded to somewhere else is not claimed"
mkdir -p "${CGT}/wsl/distro/init.scope"; chmod 755 "${CGT}/wsl" "${CGT}/wsl/distro"
contains "it passes plainly" "$(cgroup_section wsl '0::/wsl/distro/init.scope')" "[ OK ] systemd runs in /wsl/distro, which its users can enter"

print -r -- "systemd cgroup: an open cgroup of WSL's own"
rm -f "${CGREC}"
contains "it passes"      "$(cgroup_section wsl '0::/wsl/distro/init.scope')" "[ OK ] systemd runs in /wsl/distro, which its users can enter"

print -r -- "systemd cgroup: nothing to read"
contains "it warns"       "$(cgroup_section wsl '')" "[WARN] cannot read the cgroup systemd runs in"
contains "a missing directory warns" "$(cgroup_section wsl '0::/gone/init.scope')" "[WARN] cannot read the mode of /gone"

print -r -- "ssh: no agent because no user manager answers"
none="$(ssh_section 1)" one="$(ssh_section 0)"
contains "names the user manager" "${none}" "no user manager answers, so no user unit runs: systemctl status user@"
lacks    "not while one answers"  "${one}" "no user manager answers"
contains "the agent hint stays"   "${one}" "systemctl --user status ssh-agent.service"
lacks    "no agent unit to restart without a manager" "${none}" "ssh-agent.service"

print -r -- "ssh: a stale socket because no user manager answers"
out="$(ssh_section 1 2)"
contains "names the user manager" "${out}" "no user manager answers, so no user unit runs: systemctl status user@"
lacks    "not the agent unit"     "${out}" "ssh-agent.service"

print -r -- "ssh: a stale socket under a user manager"
out="$(ssh_section 0 2)"
contains "restarts the agent"     "${out}" "systemctl --user restart ssh-agent.service"
lacks    "no user manager finding" "${out}" "no user manager answers"

print -r -- "systemd cgroup: PID 1 is not systemd"
out="$(cgroup_section wsl '0::/' init)"
contains "it fails, naming PID 1 and its cgroup" "${out}" "[FAIL] PID 1 is init, not systemd (cgroup /)"
contains "names the wsl.conf switch" "${out}" "/etc/wsl.conf needs [boot] systemd=true"
contains "and the restart"        "${out}" "'wsl --shutdown' from a Windows terminal"
lacks    "no cgroup verdict"      "${out}" "systemd runs in"

# shared_state <state root>: the doctor's "Shared state" section against the held list under ${BASE}/home.
shared_state() { section 'Shared state' PATH="${TOOLS}" HOME="${BASE}/home" FLAKELAB_TARGET=other FLAKELAB_STATE_ROOT="$1" }
GATE="${BASE}/home/.local/state/flakelab/state-gate"
SROOT="${BASE}/state"
mkdir -p "${GATE}" "${SROOT}/claude/projects/slug/sess/subagents/workflows/wf_1"
{
  print -r -- '{"kind":"transcript","file":"top.jsonl"}'
  print -r -- '{"kind":"transcript","file":"agent-a1.jsonl"}'
  print -r -- '{"kind":"transcript","file":"journal.jsonl"}'
  print -r -- '{"kind":"transcript","file":"never.jsonl"}'
} > "${GATE}/held.jsonl"
: > "${SROOT}/claude/projects/slug/top.jsonl"
: > "${SROOT}/claude/projects/slug/sess/subagents/agent-a1.jsonl"
: > "${SROOT}/claude/projects/slug/sess/subagents/workflows/wf_1/journal.jsonl"

print -r -- "shared state: a held file is never synced only when the state root has no copy at any depth"
out="$(shared_state "${SROOT}")"
contains "counts the held findings"                 "${out}" "[WARN] 4 secret finding(s) held back from the state root"
contains "a file with no copy anywhere is named"    "${out}" "held back whole, never synced: never.jsonl"
lacks    "a session transcript with a copy is not"  "${out}" "never synced: top.jsonl"
lacks    "a subagent transcript with a copy is not" "${out}" "never synced: agent-a1.jsonl"
lacks    "a workflow journal with a copy is not"    "${out}" "never synced: journal.jsonl"
rm -rf "${GATE}" "${SROOT}"

# archive_section [VAR=value...]: the doctor's "Session archive" section with areas and a schedule configured
# and a session-archive on PATH whose `status --json` prints FAKE_SA_STATUS and exits FAKE_SA_RC.
SA_TOOLS="${BASE}/sa-tools"
mkdir -p "${SA_TOOLS}"
cat > "${SA_TOOLS}/session-archive" <<'STUB'
#!/usr/bin/env zsh
[[ "$*" == "status --json" ]] || exit 2
print -r -- "${FAKE_SA_STATUS:-}"
exit "${FAKE_SA_RC:-0}"
STUB
chmod +x "${SA_TOOLS}/session-archive"
SA_AREAS='{"work":{"description":"d","library":"/srv/cards","projects":["p"]}}'
archive_section() {
  section 'Session archive' PATH="${SA_TOOLS}:${TOOLS}" HOME="${BASE}/home" FLAKELAB_TARGET=other SESSION_ARCHIVE_AREAS="${SA_AREAS}" \
    SESSION_ARCHIVE_SCHEDULED=true "$@"
}
# archive_status [<jq edit>]: a healthy status --json answer, its last run <hours> (1) ago, edited as given.
archive_status() {
  jq -cn --arg t "$(date -u -d "${2:-1} hours ago" +%Y-%m-%dT%H:%M:%S+00:00)" \
    '{last_run: $t, last_result: "ok", eligible: 3, held: 0, review: 0, last_run_usd: 0.42, run_sessions: 20, root_ok: true, owner_ok: true} | '"${1:-.}"
}

print -r -- "session archive: test_doctor_section_warns_on_held_sessions"
out="$(archive_section FAKE_SA_STATUS="$(archive_status '.held = 2')")"
contains "held sessions warn with their count" "${out}" "[WARN] 2 held"
check    "and nothing else does"               "$(print -r -- "${out}" | grep -c '\[WARN\]')" "1"

print -r -- "session archive: a recent run with nothing held, in review or backed up passes"
out="$(archive_section FAKE_SA_STATUS="$(archive_status)")"
contains "the run, its result and cost" "${out}" "[ OK ] last run 1 h ago (ok, 0.42 USD)"
contains "the counts"                   "${out}" "[ OK ] 3 eligible (20 per run), none held, none waiting for review"
contains "the root"                     "${out}" "[ OK ] archive root reachable"
lacks    "no warning"                   "${out}" "[WARN]"

print -r -- "session archive: each finding is its own warning"
out="$(archive_section FAKE_SA_STATUS="$(archive_status '.review = 1')")"
contains "review names the count"   "${out}" "[WARN] 1 session(s) waiting for review"
contains "and the command"          "${out}" "flakelab session-archive review"
contains "a run 50 h ago is stale"  "$(archive_section FAKE_SA_STATUS="$(archive_status . 50)")" "[WARN] the session archive last ran 50 h ago, over 48 h"
lacks    "47 h is not"              "$(archive_section FAKE_SA_STATUS="$(archive_status . 47)")" "[WARN]"
contains "no run at all warns"      "$(archive_section FAKE_SA_STATUS="$(archive_status '.last_run = null | .last_result = null')")" "[WARN] the session archive has never run"
contains "an unreadable time warns" "$(archive_section FAKE_SA_STATUS="$(archive_status '.last_run = "yesterday-ish"')")" "[WARN] cannot read the time of the session archive's last run"
contains "a backlog over twice a run warns" "$(archive_section FAKE_SA_STATUS="$(archive_status '.eligible = 41')")" "[WARN] 41 sessions eligible, more than twice the 20 a run takes"
lacks    "twice a run does not"     "$(archive_section FAKE_SA_STATUS="$(archive_status '.eligible = 40')")" "[WARN]"
out="$(archive_section FAKE_SA_STATUS="$(archive_status '.eligible = null')")"
lacks    "no counted backlog yet is no finding" "${out}" "[WARN]"
contains "and the counts say so"     "${out}" "[ OK ] none held, none waiting for review; no backlog count until a full run finishes"
lacks    "never printed as null"     "${out}" "null"
out="$(archive_section FAKE_SA_STATUS="$(archive_status '.eligible = null | .held = 1')")"
check    "held still warns, alone"   "$(print -r -- "${out}" | grep -c '\[WARN\]')" "1"
lacks    "with no all-clear"         "${out}" "none held"
contains "an unreachable root warns" "$(archive_section FAKE_SA_STATUS="$(archive_status '.root_ok = false')")" "[WARN] the archive root (flakelab.sessionArchiveRoot) is unreachable"
contains "another box's claim warns" "$(archive_section FAKE_SA_STATUS="$(archive_status '.owner_ok = false')")" "[WARN] the archive root or a library is claimed by another box"
out="$(archive_section FAKE_SA_STATUS="$(archive_status '.root_ok = null | .owner_ok = null')")"
lacks    "an unchecked root is no finding" "${out}" "[WARN]"
lacks    "nor called reachable"            "${out}" "archive root reachable"
out="$(archive_section FAKE_SA_STATUS="$(archive_status '.held = 1 | .review = 2 | .root_ok = false')")"
check    "three findings, three warnings" "$(print -r -- "${out}" | grep -c '\[WARN\]')" "3"
lacks    "and no all-clear for the counts" "${out}" "none held"
out="$(archive_section FAKE_SA_STATUS="$(archive_status '.held = 2 | .root_ok = false | .last_result = "error\nTraceback"')")"
contains "a multi-line result does not hide the held count" "${out}" "[WARN] 2 held"
contains "nor the root"                   "${out}" "[WARN] the archive root (flakelab.sessionArchiveRoot) is unreachable"
contains "and reads as one line"          "${out}" "[ OK ] last run 1 h ago (error Traceback, 0.42 USD)"

print -r -- "session archive: a last run that ended in failure warns; ok, capped and one in progress do not"
for saCase in model_unavailable root_unreachable library_unreachable error; do
  out="$(archive_section FAKE_SA_STATUS="$(archive_status ".last_result = \"${saCase}\"")")"
  contains "${saCase}: the failed run's result warns" "${out}" "[WARN] the session archive's last run ended ${saCase}"
  check    "${saCase}: and nothing else does"         "$(print -r -- "${out}" | grep -c '\[WARN\]')" "1"
done
for saCase in '"ok"' '"capped"' null; do
  lacks "${saCase}: no warning" "$(archive_section FAKE_SA_STATUS="$(archive_status ".last_result = ${saCase}")")" "[WARN]"
done

print -r -- "session archive: with no schedule the run's age is a note, the other findings stay"
out="$(archive_section SESSION_ARCHIVE_SCHEDULED=false FAKE_SA_STATUS="$(archive_status . 50)")"
contains "a run 50 h ago is shown"        "${out}" "[ OK ] note: last run 50 h ago (ok, 0.42 USD); no schedule (flakelab.sessionArchiveSchedule), so its age is not checked"
lacks    "and not warned about"           "${out}" "[WARN]"
out="$(archive_section SESSION_ARCHIVE_SCHEDULED=false FAKE_SA_STATUS="$(archive_status '.last_run = null | .last_result = null | .held = 2')")"
contains "no run at all is a note"        "${out}" "[ OK ] note: the session archive has never run; no schedule"
check    "held still warns, alone"        "$(print -r -- "${out}" | grep -c '\[WARN\]')" "1"
contains "it is the held count"           "${out}" "[WARN] 2 held"
contains "the wrapper variable absent reads as no schedule" "$(section 'Session archive' PATH="${SA_TOOLS}:${TOOLS}" HOME="${BASE}/home" FLAKELAB_TARGET=other SESSION_ARCHIVE_AREAS="${SA_AREAS}" FAKE_SA_STATUS="$(archive_status . 50)")" "[ OK ] note: last run 50 h ago"

print -r -- "session archive: an answer it cannot use warns"
contains "a failing status"   "$(archive_section FAKE_SA_RC=1)" "[WARN] session-archive status --json gave no usable answer"
contains "a stub's silence"   "$(archive_section)" "[WARN] session-archive status --json gave no usable answer"
contains "a missing count"    "$(archive_section FAKE_SA_STATUS="$(archive_status 'del(.held)')")" "[WARN] session-archive status --json gave no usable answer"
contains "no session-archive" "$(section 'Session archive' PATH="${TOOLS}" HOME="${BASE}/home" FLAKELAB_TARGET=other SESSION_ARCHIVE_AREAS="${SA_AREAS}")" "[WARN] session-archive is not on PATH"

print -r -- "session archive: no area configured is a note, and the archive is not asked"
for areas in unset '' '{}'; do
  local -a env=(PATH="${SA_TOOLS}:${TOOLS}" HOME="${BASE}/home" FLAKELAB_TARGET=other FAKE_SA_RC=1)
  [[ "${areas}" == unset ]] || env+=(SESSION_ARCHIVE_AREAS="${areas}")
  out="$(section 'Session archive' "${env[@]}")"
  contains "${areas:-empty}: a note" "${out}" "[ OK ] note: no session-archive area configured (flakelab.sessionArchiveAreas)"
  lacks    "${areas:-empty}: no warning" "${out}" "[WARN]"
done

print -r -- "secrets: the old ~/.config/tyc is named with the move, its absence is not"
secrets() { section Secrets PATH="${TOOLS}" HOME="${BASE}/home" FLAKELAB_TARGET=other }
mkdir -p "${BASE}/home/.config/tyc"
: > "${BASE}/home/.config/tyc/secrets.env"
out="$(secrets)"
contains "the old directory warns"    "${out}" "[WARN] ~/.config/tyc is the old secrets directory"
contains "and prints the move"        "${out}" "mv -n ~/.config/tyc/*(DN) ~/.config/flakelab/"
rm -f "${BASE}/home/.config/tyc/secrets.env"
out="$(secrets)"
contains "an empty one warns too"     "${out}" "[WARN] ~/.config/tyc is the old secrets directory"
contains "and needs only the rmdir"   "${out}" "         rmdir ~/.config/tyc"
lacks    "with no mv to fail on"      "${out}" "mv -n ~/.config/tyc"
rm -rf "${BASE}/home/.config/tyc"
lacks    "no old directory, no warning" "$(secrets)" "~/.config/tyc"
rm -rf "${BASE}/home/.config"

print -r -- "nix token: report render state and permissions without revealing the token"
TOKEN_TOOLS="${BASE}/token-tools"
TOKEN_CONF="${BASE}/token-conf"
TOKEN_FILE="${BASE}/access-tokens.conf"
mkdir -p "${TOKEN_TOOLS}" "${TOKEN_CONF}"
cat > "${TOKEN_TOOLS}/flakelab-nix-access-tokens" <<'STUB'
#!/usr/bin/env zsh
[[ "$1" == --status ]] || exit 2
print -r -- "${FAKE_NIX_TOKEN_STATE:-current}"
STUB
cat > "${TOKEN_TOOLS}/nix" <<'STUB'
#!/usr/bin/env zsh
[[ "${FAKE_NIX_EMPTY:-0}" == 1 ]] || print -r -- 'github.com=fixture_do_not_print'
exit 0
STUB
chmod +x "${TOKEN_TOOLS}"/*
print -r -- 'extra-access-tokens = github.com=fixture_do_not_print' > "${TOKEN_FILE}"
chmod 600 "${TOKEN_FILE}"
token_section() {
  section 'Nix GitHub token' PATH="${TOKEN_TOOLS}:${TOOLS}" HOME="${BASE}/home" FLAKELAB_TARGET=other \
    FLAKELAB_NIX_TOKENS_FILE="${TOKEN_FILE}" NIX_CONF_DIR="${TOKEN_CONF}" "$@"
}
out="$(token_section)"
contains "missing include is named" "${out}" "token render is not configured"
lacks "another configured token is not ruled out" "${out}" "fetches GitHub anonymously"
print -r -- "!include ${TOKEN_FILE}" > "${TOKEN_CONF}/nix.conf"
out="$(token_section)"
contains "matching render is reported" "${out}" "rendered GitHub token matches"
contains "effective Nix configuration is checked" "${out}" "nix reads a github.com access token"
lacks "the token is never printed" "${out}" "fixture_do_not_print"
contains "rotation is reported" "$(token_section FAKE_NIX_TOKEN_STATE=stale)" "rotated after the last render"
contains "withdrawal is reported" "$(token_section FAKE_NIX_TOKEN_STATE=withdrawn)" "no longer holds"
contains "an effective override is reported" "$(token_section FAKE_NIX_EMPTY=1)" "nix reads no github.com access token"
chmod 644 "${TOKEN_FILE}"
contains "readable token file is a failure" "$(token_section)" "[FAIL] ${TOKEN_FILE} is mode 644"
rm -rf "${TOKEN_TOOLS}" "${TOKEN_CONF}" "${TOKEN_FILE}"

# on_tty <redirect> [<VAR=value>...]: a whole doctor run on a pseudo-terminal
# (util-linux script) with TERM=xterm and that environment, <redirect> (`> file`,
# `2> file` or empty) applied inside it; prints what reached the terminal.
on_tty() {
  local redirect="$1" out
  shift
  local -a cmd=(env -i __ETC_ZSHENV_SOURCED=1 PATH="${TOOLS}" HOME="${BASE}/home" FLAKELAB_TARGET=other TERM=xterm "$@" zsh "${DOCTOR}")
  out="$(script -qec "${(j: :)${(q)cmd[@]}} ${redirect}" /dev/null < /dev/null 2>&1)"
  print -r -- "${out//$'\r'/}"
}

print -r -- "colour: only when stdout and stderr are both a terminal, and never with NO_COLOR or TERM=dumb"
out="$(env -i __ETC_ZSHENV_SOURCED=1 PATH="${TOOLS}" HOME="${BASE}/home" FLAKELAB_TARGET=other TERM=xterm zsh "${DOCTOR}" 2>&1 < /dev/null)"
lacks    "a piped run writes no escape codes"            "${out}" $'\e'
out="$(on_tty '')"
contains "a terminal still gets the green OK tag"        "${out}" $'\e[32m[ OK ]'
contains "and the yellow WARN tag on stderr"             "${out}" $'\e[33m[WARN]'
lacks    "NO_COLOR=1 turns it off at a terminal"         "$(on_tty '' NO_COLOR=1)" $'\e'
contains "an empty NO_COLOR does not"                    "$(on_tty '' NO_COLOR=)" $'\e[32m[ OK ]'
lacks    "TERM=dumb turns it off"                        "$(on_tty '' TERM=dumb)" $'\e'
on_tty "> ${(q)BASE}/tty-stdout" > /dev/null
lacks    "stdout to a file gets none, stderr a terminal" "$(< "${BASE}/tty-stdout")" $'\e'
on_tty "2> ${(q)BASE}/tty-stderr" > /dev/null
lacks    "stderr to a file gets none, stdout a terminal" "$(< "${BASE}/tty-stderr")" $'\e'
rm -f "${BASE}/tty-stdout" "${BASE}/tty-stderr"

# Piped, the colours are empty and the --strict line starts with "--": print -P
# must not take it for options.
print -r -- "--strict says it counted the warnings, piped"
out="$(env -i __ETC_ZSHENV_SOURCED=1 PATH="${TOOLS}" HOME="${BASE}/home" FLAKELAB_TARGET=other zsh "${DOCTOR}" --strict 2>&1 < /dev/null)"
contains "the count is printed"          "${out}" "warning(s) counted as failures"
lacks    "print reads no option from it" "${out}" "bad option"

print -r -- ""
print -r -- "${PASS} passed, ${FAIL} failed"
(( FAIL == 0 ))
