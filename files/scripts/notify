#!/usr/bin/env zsh

set -uo pipefail

# notify: a push when an agent session waits on you (remote-sessions.md), to an ntfy topic (NTFY_URL, NTFY_TOKEN)
# and a JSON webhook (NOTIFY_WEBHOOK_URL), whichever are set. One the env lacks comes, at use time, from the first
# readable of $FLAKELAB_SECRETS_ENV, the sops render, ~/.config/tyc/secrets.env. A hook run never fails its caller
# (exit 0, a line on stderr); by hand: 2 unconfigured, 1 a post failed. Titles are ASCII, ntfy's header rule.
MODE=auto
TITLE=""
MESSAGE=""
PRIORITY=""
TAGS=""
DRY_RUN=false
CODEX_JSON=""

usage() {
  cat <<'USAGE'
Usage: flakelab notify                       (a Claude Code Notification hook: JSON on stdin)
       flakelab notify --codex JSON          (Codex's notify hook: the JSON it appends)
       flakelab notify --title T --message M [--priority 1-5] [--tags a,b]
       flakelab notify --dry-run ...         print the request, send nothing

Posts to the ntfy topic NTFY_URL (NTFY_TOKEN for a protected one) and the
JSON webhook NOTIFY_WEBHOOK_URL (Home Assistant's /api/webhook/<id>), whichever
are set. One the environment lacks is read at use time from the sops render
/run/secrets/tyc-env or ~/.config/tyc/secrets.env. A hook run exits 0 whatever
happens; by hand, 2 unconfigured, 1 when a post fails.
USAGE
}

note() { print -ru2 -- "notify: $*" }

while (( $# > 0 )); do
  case $1 in
    --codex) MODE=codex; CODEX_JSON="${2:-}"; shift ;;
    --title) TITLE="${2:-}"; shift ;;
    --message) MESSAGE="${2:-}"; shift ;;
    --priority) PRIORITY="${2:-}"; shift ;;
    --tags) TAGS="${2:-}"; shift ;;
    --dry-run) DRY_RUN=true ;;
    --help|-h) usage; exit 0 ;;
    *) print -ru2 -- "notify: unknown option: $1"; usage >&2; exit 2 ;;
  esac
  shift
done
[[ -n "$TITLE" || -n "$MESSAGE" ]] && [[ "$MODE" == auto ]] && MODE=manual
[[ -z "$PRIORITY" || "$PRIORITY" == <1-5> ]] || { print -ru2 -- "notify: --priority takes 1 to 5"; exit 2 }


# Per target: sopsKeyFiles keeps the webhook URL out of the env while the ntfy pair may be in it. The pair moves
# together, so a topic from the env never gets the file's token.
if [[ -z "${NTFY_URL:-}" || -z "${NOTIFY_WEBHOOK_URL:-}" ]]; then
  for f in "${FLAKELAB_SECRETS_ENV:-}" "${FLAKELAB_SECRETS_RENDER:-/run/secrets/tyc-env}" "${HOME}/.config/tyc/secrets.env"; do
    [[ -r "$f" ]] || continue
    # Sourced in a subshell, CRs stripped (a CRLF render puts one in every value): only the three values come out.
    eval "from=($( ( unset NTFY_URL NTFY_TOKEN NOTIFY_WEBHOOK_URL; set -a; source =(tr -d '\r' < "$f") >/dev/null 2>&1
      print -r -- "${(qq)NTFY_URL:-} ${(qq)NTFY_TOKEN:-} ${(qq)NOTIFY_WEBHOOK_URL:-}" ) 2>/dev/null ))"
    [[ -n "${NTFY_URL:-}" ]] || { NTFY_URL="${from[1]:-}"; NTFY_TOKEN="${from[2]:-}" }
    [[ -n "${NOTIFY_WEBHOOK_URL:-}" ]] || NOTIFY_WEBHOOK_URL="${from[3]:-}"
    break
  done
fi
NTFY_URL="${NTFY_URL:-}"
NTFY_TOKEN="${NTFY_TOKEN:-}"
NOTIFY_WEBHOOK_URL="${NOTIFY_WEBHOOK_URL:-}"


ascii() { print -rn -- "$1" | LC_ALL=C tr -c '[:print:]\n' '?' }
short() { local s="$1"; s="${s//$'\n'/ }"; (( ${#s} > 200 )) && s="${s[1,197]}..."; print -r -- "$s" }

HOOK=false
case "$MODE" in
  manual)
    [[ -n "$MESSAGE" ]] || { print -ru2 -- "notify: --message is required"; exit 2 }
    TITLE="${TITLE:-flakelab}"; PRIORITY="${PRIORITY:-3}"
    ;;
  codex)
    HOOK=true
    doc="$(print -r -- "$CODEX_JSON" | jq -c . 2>/dev/null)" || doc='{}'
    cwd="$(print -r -- "$doc" | jq -r '.cwd // empty')"
    kind="$(print -r -- "$doc" | jq -r '.type // "turn-complete"')"
    tid="$(print -r -- "$doc" | jq -r '."thread-id" // ."turn-id" // empty')"
    last="$(print -r -- "$doc" | jq -r '."last-assistant-message" // empty')"
    TITLE="$(ascii "codex - ${${cwd:t}:-codex}")"
    MESSAGE="${kind}${last:+: $(short "$last")}"
    [[ -n "$cwd" ]] && MESSAGE+=$'\n'"in ${cwd}"
    [[ -n "$tid" ]] && MESSAGE+=$'\n'"codex resume ${tid}"
    PRIORITY="${PRIORITY:-3}"; TAGS="${TAGS:-robot}"
    ;;
  auto)
    # Hooks pipe JSON in; on a terminal show usage instead of waiting on cat.
    [[ -t 0 ]] && { usage >&2; exit 2 }
    HOOK=true
    input="$(cat 2>/dev/null)"
    doc="$(print -r -- "$input" | jq -c . 2>/dev/null)" || doc=""
    if [[ -n "$doc" && "$(print -r -- "$doc" | jq -r '.hook_event_name // empty')" != "" ]]; then
      cwd="$(print -r -- "$doc" | jq -r '.cwd // empty')"
      kind="$(print -r -- "$doc" | jq -r '.notification_type // .hook_event_name')"
      sid="$(print -r -- "$doc" | jq -r '.session_id // empty')"
      msg="$(print -r -- "$doc" | jq -r '.message // empty')"
      TITLE="$(ascii "claude - ${${cwd:t}:-claude}")"
      MESSAGE="${kind}${msg:+: $(short "$msg")}"
      [[ -n "$cwd" ]] && MESSAGE+=$'\n'"in ${cwd}"
      [[ -n "$sid" ]] && MESSAGE+=$'\n'"flakelab sessions --attach ${sid}"
      case "$kind" in
        permission_prompt) PRIORITY="${PRIORITY:-4}"; TAGS="${TAGS:-question}" ;;
        quota_auto_resume_*) PRIORITY="${PRIORITY:-3}"; TAGS="${TAGS:-hourglass}" ;;
        *) PRIORITY="${PRIORITY:-3}"; TAGS="${TAGS:-robot}" ;;
      esac
    elif [[ -n "$input" ]]; then
      TITLE="${TITLE:-flakelab}"; MESSAGE="$input"; PRIORITY="${PRIORITY:-3}"
    else
      note "nothing to send (no hook input on stdin, no --message)"
      exit 0
    fi
    ;;
esac

# A topic with no token is one anyone who guesses its name can read: a hook
# tells it the tool and the event, never a path, a session id or what the
# model said. The webhook's URL is its secret, so it gets them all.
ntfy_title="$TITLE" ntfy_body="$MESSAGE"
if $HOOK && [[ -z "$NTFY_TOKEN" ]]; then
  ntfy_title="${TITLE%% - *}"
  ntfy_body="${MESSAGE%%$'\n'*}"; ntfy_body="${ntfy_body%%: *}"
fi


if [[ -z "$NTFY_URL" && -z "$NOTIFY_WEBHOOK_URL" ]]; then
  note "NTFY_URL and NOTIFY_WEBHOOK_URL are not set (the sops render or ~/.config/tyc/secrets.env); nothing sent"
  $HOOK && exit 0 || exit 2
fi

# jq, so quotes, newlines and non-ASCII stay valid JSON; the message goes on stdin, not argv.
[[ -n "$NOTIFY_WEBHOOK_URL" ]] && json="$(print -rn -- "$MESSAGE" | jq -cRs --arg t "$TITLE" --arg p "$PRIORITY" --arg g "$TAGS" \
  '{title: $t, message: ., priority: ($p | tonumber), tags: ($g | split(",") | map(select(. != "")))}')"

# Both URLs are credentials (a webhook id, an open topic's name), so neither is ever printed.
if $DRY_RUN; then
  if [[ -n "$NTFY_URL" ]]; then
    print -r -- "POST <NTFY_URL>"
    print -r -- "Title: ${ntfy_title}"
    print -r -- "Priority: ${PRIORITY}"
    [[ -n "$TAGS" ]] && print -r -- "Tags: ${TAGS}"
    [[ -n "$NTFY_TOKEN" ]] && print -r -- "Authorization: Bearer ****"
    print -r -- ""
    print -r -- "$ntfy_body"
  fi
  if [[ -n "$NOTIFY_WEBHOOK_URL" ]]; then
    [[ -n "$NTFY_URL" ]] && print -r -- ""
    print -r -- "POST <NOTIFY_WEBHOOK_URL>"
    print -r -- "Content-Type: application/json"
    print -r -- ""
    print -r -- "$json"
  fi
  exit 0
fi

# post VAR [curl args] < body. The URL reaches curl as a config file (=() makes
# it 0600), never on a command line, where /proc shows it to every user.
typeset -a failed=()
post() {
  local code
  code="$(curl -sS -m 10 -o /dev/null -w '%{http_code}' -K =(print -r -- "url = \"${(P)1}\"") -X POST "${@:2}" --data-binary @- 2>/dev/null)" || code=000
  [[ "$code" == 2* ]] || failed+=("post to <$1> failed (HTTP ${code})")
}

if [[ -n "$NTFY_URL" ]]; then
  # Every header goes to curl in a private file (mktemp makes it 0600): the
  # token never sits on a command line either.
  HDRF="$(mktemp)" || { note "cannot make a temp file"; $HOOK && exit 0 || exit 1 }
  {
    print -r -- "Title: ${ntfy_title}"
    print -r -- "Priority: ${PRIORITY}"
    [[ -n "$TAGS" ]] && print -r -- "Tags: ${TAGS}"
    [[ -n "$NTFY_TOKEN" ]] && print -r -- "Authorization: Bearer ${NTFY_TOKEN}"
  } > "$HDRF"
  print -rn -- "$ntfy_body" | post NTFY_URL -H @"$HDRF"
  rm -f -- "$HDRF"
fi
[[ -n "$NOTIFY_WEBHOOK_URL" ]] && print -r -- "$json" | post NOTIFY_WEBHOOK_URL -H 'Content-Type: application/json'

(( ${#failed} == 0 )) && exit 0
note "${(j:; :)failed}"
$HOOK && exit 0 || exit 1
