contains "one question for the whole group"        "${OUT}" "[1/1]"
excludes "and no second one"                       "${OUT}" "[2/"
contains "listing every record under it"           "${OUT}" "3 record"
contains "with the record's human date"            "${OUT}" "$(date -d @1000 '+%Y-%m-%d %H:%M')"
contains "the pasted block reads as one command"   "${OUT}" " ⏎ "
contains "and the keys are explained once"         "${OUT}" "history keys are the zsh history epoch"
excludes "the live history lost every flagged record" \
  "$(< "${FIX_HOME}/.zsh_history")" "hunter2-secret"
contains "keeping the clean one"                   "$(< "${FIX_HOME}/.zsh_history")" "ls"
check    "and the held list is empty"              "$(grep -c . "${FIX_HELD}")" "0"

print -r -- "a held entry written before previews is still reviewable"
state_fixture gate-review-legacy-entry
secret_history

run_backup --force
check "the backup exits clean" "${RC}" "0"
# What the gate wrote before it stored a preview.
