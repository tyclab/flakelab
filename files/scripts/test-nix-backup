# The scanner flattens a match it found across a line break, so its Secret is
# literal NOWHERE in the record and masking cannot remove it.
print -r -- "a finding the scanner saw across a line break is never previewed"
state_fixture gate-preview-span
FAKE_SPAN="aaa-part-one bbb-part-two"
{
  print -r -- ": 1000:0;export TOKEN=aaa-part-one"
  print -r -- "bbb-part-two"
  rec 2000 0 "ls"
} > "${FIX_HOME}/.zsh_history"

run_backup --force
check    "the backup exits clean"                  "${RC}" "0"
check    "the record is held"                      "$(grep_c_held)" "1"
held="$(< "${FIX_HELD}")"
excludes "no half of the secret is in the held list" "${held}" "aaa-part-one"
excludes "nor the other half"                        "${held}" "bbb-part-two"
check    "and the preview is empty"                "$(jq -r '.preview' "${FIX_HELD}")" ""

ANSWERS="s"
run_backup --review-secrets
check    "the review exits clean"                  "${RC}" "0"
contains "it falls back to the redacted match"     "${OUT}" "export TOKEN=***"
excludes "with no half-secret on screen"           "${OUT}" "aaa-part-one"

print -r -- "and the same when the break is a CRLF"
state_fixture gate-preview-span-crlf
FAKE_SPAN="ccc-part-one  ddd-part-two"
{
  printf ': 1000:0;export TOKEN=ccc-part-one\r\n'
  printf 'ddd-part-two\n'
  rec 2000 0 "ls"
} > "${FIX_HOME}/.zsh_history"

run_backup --force
check    "the backup exits clean"                  "${RC}" "0"
check    "the record is held"                      "$(grep_c_held)" "1"
held="$(< "${FIX_HELD}")"
excludes "no half of the secret is in the held list" "${held}" "ccc-part-one"
excludes "nor the other half"                        "${held}" "ddd-part-two"
check    "and the preview is empty"                "$(jq -r '.preview' "${FIX_HELD}")" ""

# Half the secret in each record, and a half cannot be masked out of the record
# that holds it: the preview is only ever built for a finding that fits inside
# ONE record.
print -r -- "a finding straddling two records is previewed in neither"
state_fixture gate-preview-straddle
FAKE_SPAN="part-a : 2000:0;echo part-b"
{
  rec 1000 0 "export TOKEN=part-a"
  rec 2000 0 "echo part-b"
} > "${FIX_HOME}/.zsh_history"

run_backup --force
check    "the backup exits clean"                  "${RC}" "0"
check    "both records are held"                   "$(grep_c_held)" "2"
check    "and neither carries a preview"           "$(jq -r '.preview' "${FIX_HELD}" | sort -u)" ""
held="$(< "${FIX_HELD}")"
excludes "no half of the secret is in the held list" "${held}" "part-a"
excludes "nor the other half"                        "${held}" "part-b"

# One record, two findings: each entry carries the WHOLE record, so masking only
# its own secret would print the other one in the clear.
print -r -- "two secrets on one record never expose each other"
state_fixture gate-preview-two-secrets
FAKE_SECRET="alpha-token-one"
FAKE_SECRET2="beta-token-two"
{
  rec 1000 0 "deploy --key alpha-token-one --other beta-token-two"
  rec 2000 0 "ls"
} > "${FIX_HOME}/.zsh_history"

run_backup --force
check    "the backup exits clean"                  "${RC}" "0"
check    "the record is held once per finding"     "$(grep_c_held)" "2"
held="$(< "${FIX_HELD}")"
excludes "the first secret is nowhere in the held list" "${held}" "alpha-token-one"
excludes "and neither is the second"                    "${held}" "beta-token-two"
contains "both are masked in the preview"          "${held}" "deploy --key *** --other ***"

ANSWERS="ss"
run_backup --review-secrets
check    "the review exits clean"                  "${RC}" "0"
excludes "the prompt shows neither secret"         "${OUT}" "alpha-token-one"
excludes "nor the other"                           "${OUT}" "beta-token-two"

