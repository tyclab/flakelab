print -r -- '{"n":1}{"n":2}{"n":3}' > "${SLUG_HOME}/new.jsonl"
run_restore
check "a larger local transcript survives a restore" \
  "$(< "${SLUG_HOME}/new.jsonl")" '{"n":1}{"n":2}{"n":3}'

# Grow-only is `<=`: on a tie neither side is provably newer.
print -r -- "a transcript the size of the synced copy is left alone"
