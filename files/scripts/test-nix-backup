#!/usr/bin/env zsh

set -uo pipefail

# Offline suite for nix-backup: the real script against a throwaway backup root,
# home and state root (FLAKELAB_BACKUP_ROOT / FLAKELAB_HOME_DIR / FLAKELAB_STATE_ROOT).
#
# Usage: files/scripts/test-nix-backup

SCRIPT_DIR="${0:A:h}"
BACKUP="${SCRIPT_DIR}/nix-backup"
typeset -i PASS=0 FAIL=0

# Both end in `return 0`: `(( PASS++ ))` yields the value BEFORE the increment,
# so the first call would return 1 and an `&& ok || bad` chain run both arms.
ok()   { print -r -- "  ok   $1"; (( PASS++ )); return 0 }
bad()  { print -r -u2 -- "  FAIL $1"; (( FAIL++ )); return 0 }
check() { [[ "$2" == "$3" ]] && ok "$1" || { bad "$1"; print -r -u2 -- "       expected: $3"; print -r -u2 -- "       actual:   $2" } }
contains() { [[ "$2" == *"$3"* ]] && ok "$1" || { bad "$1"; print -r -u2 -- "       missing: $3" } }
excludes() { [[ "$2" != *"$3"* ]] && ok "$1" || bad "$1 (unexpected: $3)" }
exists()   { [[ -e "$2" ]] && ok "$1" || bad "$1" }
is_file()  { [[ -f "$2" ]] && ok "$1" || bad "$1" }
is_link()  { [[ -L "$2" ]] && ok "$1" || bad "$1" }
absent()   { [[ ! -e "$2" ]] && ok "$1" || bad "$1" }
same()     { cmp -s "$2" "$3" && ok "$1" || bad "$1" }
# <label> <dir> <glob>: the glob matches something / nothing.
has_match() { local -a m=("$2"/${~3}(N)); (( ${#m} > 0 )) && ok "$1" || bad "$1" }
no_match()  { local -a m=("$2"/${~3}(N)); (( ${#m} == 0 )) && ok "$1" || bad "$1" }
no_scratch() { [[ -z "$(cd "$2" && find . -name '*.flakelab-tmp.*')" ]] && ok "$1" || bad "$1" }

BASE="$(mktemp -d)"
trap 'rm -rf "${BASE}"' EXIT

# ---------------------------------------------------------------------------
# The secret gate's scanner, faked
# ---------------------------------------------------------------------------
# A `gitleaks` of our own, first on PATH for EVERY scenario, so no assertion
# depends on a third party's regexes:
#   FAKE_GITLEAKS_SECRET=<literal>  every line containing it is one finding (rule fake-rule)
#   FAKE_GITLEAKS_SECRET2=<literal> a SECOND literal, found the same way
#   FAKE_GITLEAKS_SPAN=<literal>    one finding per adjacent line PAIR whose join
#                                   contains it — the reported Secret is then the
#                                   flattened form, literal nowhere in the file
#   FAKE_GITLEAKS_BROKEN=1          exit 2 and write nothing
#   FAKE_GITLEAKS_RELPATH=1         report basenames instead of the staged paths
if ! command -v jq > /dev/null 2>&1; then
  print -r -u2 -- "  FAIL jq is required to run this suite"
  exit 1
fi

mkdir -p "${BASE}/bin"
cat > "${BASE}/bin/gitleaks" <<'FAKE_GITLEAKS'
#!/usr/bin/env zsh
# Test double for gitleaks — see test-nix-backup.
set -uo pipefail
target=""
report=""
while (( $# > 0 )); do
  case "$1" in
    --report-path|-r)   report="${2:-}"; shift ;;
    --report-format|-f) shift ;;
    --config|-c)        shift ;;
    --log-level|-l)     shift ;;
    --exit-code)        shift ;;
    dir|file|directory) ;;
    -*)                 ;;
    *)                  target="$1" ;;
  esac
  shift
done
if [[ "${FAKE_GITLEAKS_BROKEN:-}" == 1 ]]; then
  print -r -u2 -- "fake gitleaks: scanner failed"
  exit 2
fi
[[ -n "${report}" ]] || report=/dev/stdout
typeset -a needles=()
[[ -n "${FAKE_GITLEAKS_SECRET:-}" ]]  && needles+=("${FAKE_GITLEAKS_SECRET}")
[[ -n "${FAKE_GITLEAKS_SECRET2:-}" ]] && needles+=("${FAKE_GITLEAKS_SECRET2}")
span="${FAKE_GITLEAKS_SPAN:-}"
typeset -a findings=()
if (( ${#needles} > 0 )) && [[ -n "${target}" ]]; then
  # (D): the merged history is staged under a dotted name.
  for f in ${target}/**/*(ND.); do
    n=0
    # `|| [[ -n ... ]]`: a last line without a newline is what a live transcript looks like.
    while IFS= read -r line || [[ -n "${line}" ]]; do
      n=$(( n + 1 ))
      for s in "${needles[@]}"; do
        [[ "${line}" == *"${s}"* ]] || continue
        reported="${f}"
        [[ "${FAKE_GITLEAKS_RELPATH:-}" == 1 ]] && reported="${f:t}"
        findings+=("$(jq -c -n --arg f "${reported}" --argjson n "${n}" \
          --arg m "${line}" --arg s "${s}" \
          '{Description:"fake secret",StartLine:$n,EndLine:$n,File:$f,RuleID:"fake-rule",Match:$m,Secret:$s}')")
      done
    done < "${f}"
  done
fi
# A match the real scanner reports across a line break: Match and Secret are
# flattened with gsub("[\n\r]"; " "), so neither is literal in the file.
if [[ -n "${span}" && -n "${target}" ]]; then
  for f in ${target}/**/*(ND.); do
    typeset -a fl=("${(@f)$(< "${f}")}")
    for (( i = 1; i < ${#fl}; i++ )); do
      pair="${fl[i]} ${fl[i+1]}"
      pair="${pair//[$'\r']/ }"
      [[ "${pair}" == *"${span}"* ]] || continue
      reported="${f}"
      [[ "${FAKE_GITLEAKS_RELPATH:-}" == 1 ]] && reported="${f:t}"
      findings+=("$(jq -c -n --arg f "${reported}" --argjson a "${i}" --argjson b "$(( i + 1 ))" \
        --arg m "${pair}" --arg s "${span}" \
        '{Description:"fake secret",StartLine:$a,EndLine:$b,File:$f,RuleID:"fake-rule",Match:$m,Secret:$s}')")
    done
  done
fi
{
  print -rn -- "["
  first=1
  for j in "${findings[@]}"; do
    (( first )) || print -rn -- ","
    print -rn -- "${j}"
    first=0
  done
  print -rn -- "]"
} > "${report}"
exit 0
FAKE_GITLEAKS
chmod +x "${BASE}/bin/gitleaks"

# Per-scenario knobs, reset by fixture: STATE/TRANSCRIPTS feed FLAKELAB_STATE_*,
# FAKE_* steer the scanner, ANSWERS feeds FLAKELAB_GATE_ANSWERS, NO_GITLEAKS
# runs on a PATH without any gitleaks.
STATE=""
TRANSCRIPTS=""
FAKE_SECRET=""
FAKE_SECRET2=""
FAKE_SPAN=""
FAKE_BROKEN=""
FAKE_RELPATH=""
ANSWERS=""
NO_GITLEAKS=""

# A PATH on which `gitleaks` cannot be resolved while everything else still can:
# every directory carrying one is replaced by a shadow of symlinks to its other entries.
NOGL_BIN="${BASE}/no-gitleaks"
nogl_path() {
  local -a parts=()
  local d f
  mkdir -p "${NOGL_BIN}"
  for d in ${(s.:.)PATH}; do
    if [[ -x "${d}/gitleaks" ]]; then
      for f in "${d}"/*(N); do
        [[ "${f:t}" == gitleaks ]] && continue
        [[ -e "${NOGL_BIN}/${f:t}" ]] || ln -s "${f}" "${NOGL_BIN}/${f:t}" 2> /dev/null
      done
      continue
    fi
    parts+=("${d}")
  done
  print -r -- "${NOGL_BIN}:${(j.:.)parts}"
}

# fixture <name>: a fresh backup root + home pair. FIX_STATE is NOT created —
# a scenario that wants it creates it, one that wants its parent missing does not.
fixture() {
  local name="$1"
  FIX_ROOT="${BASE}/${name}/config"
  FIX_HOME="${BASE}/${name}/home"
  FIX_STATE="${BASE}/${name}/state"
  FIX_SHELL="${FIX_ROOT}/instances/TestDistro/shell"
  FIX_MERGED="${FIX_ROOT}/shared/shell/.zsh_history_merged"
  FIX_HELD="${FIX_HOME}/.local/state/flakelab/state-gate/held.jsonl"
  FIX_DECISIONS="${FIX_STATE}/.flakelab-state-gate/decisions.jsonl"
  STATE=""
  TRANSCRIPTS=""
  FAKE_SECRET=""
  FAKE_SECRET2=""
  FAKE_SPAN=""
  FAKE_BROKEN=""
  FAKE_RELPATH=""
  ANSWERS=""
  NO_GITLEAKS=""
  rm -rf "${BASE}/${name}"
  mkdir -p "${FIX_SHELL}" "${FIX_ROOT}/shared/shell" "${FIX_HOME}"
}
# ... with the state root created and selected.
state_fixture() {
  fixture "$1"
  mkdir -p "${FIX_STATE}"
  STATE="${FIX_STATE}"
}
# ... plus one memory directory on each side (MEM_STATE / MEM_HOME).
memory_fixture() {
  state_fixture "$1"
  MEM_STATE="${FIX_STATE}/claude/projects/some-slug/memory"
  MEM_HOME="${FIX_HOME}/.claude/projects/some-slug/memory"
  mkdir -p "${MEM_STATE}" "${MEM_HOME}"
}
# ... plus transcripts on, one project slug in the home (SLUG_HOME) and its
# state-root twin named but not created (SLUG_STATE).
transcript_fixture() {
  state_fixture "$1"
  SLUG_HOME="${FIX_HOME}/.claude/projects/some-slug"
  SLUG_STATE="${FIX_STATE}/claude/projects/some-slug"
  mkdir -p "${SLUG_HOME}"
  TRANSCRIPTS=1
}

# run_backup / run_restore: the real script, sandboxed; set OUT and RC. stdin is
# /dev/null so prompts are reached only through the seams, under a terminal or not.
#
# RUN_WSL_NAME / RUN_INSTANCE: the two halves of the DISTRO_NAME fallback chain
# (WSL_DISTRO_NAME, then FLAKELAB_INSTANCE). Every existing case here leaves
# both at their default — WSL_DISTRO_NAME=TestDistro, FLAKELAB_INSTANCE unset —
# which is the exact env this suite always ran under; the instance-identity
# cases below are the only ones that override them, and reset both afterward.
RUN_WSL_NAME="TestDistro"
RUN_INSTANCE=""
typeset -i RC=0
OUT=""
run_backup() {
  local run_path="${BASE}/bin:${PATH}"
  [[ -n "${NO_GITLEAKS}" ]] && run_path="$(nogl_path)"
  OUT="$(FLAKELAB_BACKUP_ROOT="${FIX_ROOT}" FLAKELAB_HOME_DIR="${FIX_HOME}" \
    FLAKELAB_STATE_ROOT="${STATE}" FLAKELAB_STATE_TRANSCRIPTS="${TRANSCRIPTS}" \
    PATH="${run_path}" \
    FAKE_GITLEAKS_SECRET="${FAKE_SECRET}" FAKE_GITLEAKS_BROKEN="${FAKE_BROKEN}" \
    FAKE_GITLEAKS_SECRET2="${FAKE_SECRET2}" FAKE_GITLEAKS_SPAN="${FAKE_SPAN}" \
    FAKE_GITLEAKS_RELPATH="${FAKE_RELPATH}" \
    FLAKELAB_GATE_ANSWERS="${ANSWERS}" \
    WSL_DISTRO_NAME="${RUN_WSL_NAME}" FLAKELAB_INSTANCE="${RUN_INSTANCE}" \
    "${BACKUP}" "$@" < /dev/null 2>&1)"
  RC=$?
}
run_restore() { run_backup --restore "$@" }

# A history record as zsh writes it: `: <epoch>:<elapsed>;<command>`.
rec() { print -r -- ": $1:$2;$3" }

# Lines in the held list, 0 when it does not exist yet.
grep_c_held() {
  [[ -f "${FIX_HELD}" ]] || { print -r -- 0; return 0 }
  grep -c . "${FIX_HELD}"
  return 0
}

# The identity the script computes for a fake-rule finding: rule:sha256(secret).
fingerprint() { print -r -- "fake-rule:$(print -rn -- "$1" | sha256sum | cut -d' ' -f1)" }

# A live history holding one secret record and one clean one, and the scanner set to find it.
secret_history() {
  FAKE_SECRET="hunter2-secret"
  {
    rec 1000 0 "export TOKEN=hunter2-secret"
    rec 2000 0 "ls"
  } > "${FIX_HOME}/.zsh_history"
}
# A live transcript (LIVE) holding a secret LONGER than `[REDACTED:fake-rule]`,
# so redacting shrinks the synced copy and grow-only cannot pass by accident.
secret_transcript() {
  FAKE_SECRET="hunter2-secret-and-a-good-deal-more"
  LIVE="${SLUG_HOME}/abc.jsonl"
  rec 1000 0 "ls" > "${FIX_HOME}/.zsh_history"
  print -r -- '{"type":"user","text":"token hunter2-secret-and-a-good-deal-more here"}' > "${LIVE}"
}
# The other machine ruled <decision> on <secret>; only the decision travelled.
foreign_decision() {
  mkdir -p "${FIX_DECISIONS:h}"
  jq -c -n --arg f "$(fingerprint "$2")" --arg d "$1" \
    '{fingerprint:$f,decision:$d,epoch:2,host:"other-box"}' > "${FIX_DECISIONS}"
}

print -r -- "test-nix-backup"

# ---------------------------------------------------------------------------
# Instance identity: WSL_DISTRO_NAME, then FLAKELAB_INSTANCE, then "unknown"
# ---------------------------------------------------------------------------
print -r -- "FLAKELAB_INSTANCE names the instance when WSL_DISTRO_NAME is unset"
fixture instance-fallback
RUN_WSL_NAME=""
RUN_INSTANCE="vmbox"
run_backup --dry-run
RUN_WSL_NAME="TestDistro"
RUN_INSTANCE=""
contains "the payload path uses FLAKELAB_INSTANCE" "${OUT}" "instances/vmbox"
excludes "not the TestDistro every other case runs under" "${OUT}" "instances/TestDistro"
check    "the run exits clean"                     "${RC}"  "0"

print -r -- "WSL_DISTRO_NAME wins when both are set"
fixture instance-precedence
RUN_WSL_NAME="TestDistro"
RUN_INSTANCE="vmbox"
run_backup --dry-run
RUN_INSTANCE=""
contains "the payload path uses WSL_DISTRO_NAME" "${OUT}" "instances/TestDistro"
excludes "not FLAKELAB_INSTANCE"                  "${OUT}" "instances/vmbox"
check    "the run exits clean"                    "${RC}"  "0"

print -r -- "restore merges instead of overwriting"
fixture additive
rec 1000 0 "from-the-backup" > "${FIX_MERGED}"
rec 2000 0 "typed-since-the-backup" > "${FIX_HOME}/.zsh_history"

run_restore
out="${OUT}"
live="$(< "${FIX_HOME}/.zsh_history")"
contains "keeps the command typed since the last backup" "${live}" "typed-since-the-backup"
contains "brings in the command from the backup"         "${live}" "from-the-backup"
check    "restore exits clean"                           "${RC}"   "0"
contains "says the history was merged, not copied"       "${out}"  "merged with existing"

# The slow command gets the EARLIER timestamp and comes second: read as its own
# record it sorts to the front, read as a continuation line it stays welded behind.
print -r -- "non-zero elapsed times stay their own records"
fixture elapsed
{
  rec 3000 0  "later-quick-command"
  rec 1000 42 "earlier-slow-command"
} > "${FIX_MERGED}"
: > "${FIX_HOME}/.zsh_history"

run_restore
live="$(< "${FIX_HOME}/.zsh_history")"
contains "keeps the slow command's own header" "${live}" ": 1000:42;earlier-slow-command"
check    "and sorts it by its own timestamp"   "${${(f)live}[1]}" ": 1000:42;earlier-slow-command"

print -r -- "multi-line commands survive"
fixture multiline
{
  rec 1000 0 "first"
  rec 2000 0 'for f in *; do\'
  print -r -- '  echo "$f"\'
  print -r -- 'done'
  rec 3000 0 "last"
} > "${FIX_MERGED}"
: > "${FIX_HOME}/.zsh_history"

run_restore
live="$(< "${FIX_HOME}/.zsh_history")"
contains "the body stays under its header" "${live}" ': 2000:0;for f in *; do\
  echo "$f"\
done'

print -r -- "orphaned continuation lines are dropped"
fixture orphans
{
  print -r -- "orphan-body-with-no-header"
  rec 1000 0 "real-command"
} > "${FIX_MERGED}"
: > "${FIX_HOME}/.zsh_history"

run_restore
live="$(< "${FIX_HOME}/.zsh_history")"
contains "the real command survives"      "${live}" "real-command"
excludes "the orphaned body is not kept"  "${live}" "orphan-body-with-no-header"

print -r -- "a second restore changes nothing"
fixture stable
{
  rec 1000 0 "alpha"
  rec 1000 0 "beta-same-timestamp"
  rec 900  7 "earlier-but-slower"
} > "${FIX_MERGED}"
: > "${FIX_HOME}/.zsh_history"

run_restore
first="$(< "${FIX_HOME}/.zsh_history")"
run_restore
second="$(< "${FIX_HOME}/.zsh_history")"
check "the second run reproduces the first byte for byte" "${second}" "${first}"
contains "entries sharing a timestamp both survive" "${first}" "beta-same-timestamp"

print -r -- "the restored history is 0600"
check "mode" "$(stat -c '%a' "${FIX_HOME}/.zsh_history")" "600"

print -r -- "--dry-run leaves the home file alone"
fixture dryrun
rec 1000 0 "from-the-backup" > "${FIX_MERGED}"
rec 2000 0 "live-only" > "${FIX_HOME}/.zsh_history"
before="$(< "${FIX_HOME}/.zsh_history")"
run_restore --dry-run
out="${OUT}"
check    "the home file is untouched" "$(< "${FIX_HOME}/.zsh_history")" "${before}"
contains "it says what it would do"   "${out}" "Would merge"

print -r -- "backup merges the instance history into the shared payload"
fixture backup
rec 1000 0 "already-in-the-payload" > "${FIX_MERGED}"
rec 2000 0 "new-on-this-machine"    > "${FIX_HOME}/.zsh_history"

run_backup --force
merged="$(< "${FIX_MERGED}")"
contains "the older payload entry survives" "${merged}" "already-in-the-payload"
contains "the new entry is folded in"       "${merged}" "new-on-this-machine"

print -r -- "restored kubeconfigs come back with credential modes"
fixture kube
mkdir -p "${FIX_ROOT}/instances/TestDistro/kube"
print -r -- "apiVersion: v1"  > "${FIX_ROOT}/instances/TestDistro/kube/config"
print -r -- "apiVersion: v1"  > "${FIX_ROOT}/instances/TestDistro/kube/kubeconfig_prod"
print -r -- "-----BEGIN-----" > "${FIX_ROOT}/instances/TestDistro/kube/cert-prod.pem"

run_restore
check "the run is clean"          "${RC}" "0"
check "~/.kube is 700"            "$(stat -c '%a' "${FIX_HOME}/.kube")"                 "700"
check "config is 600"             "$(stat -c '%a' "${FIX_HOME}/.kube/config")"          "600"
check "the extra kubeconfig is 600" "$(stat -c '%a' "${FIX_HOME}/.kube/kubeconfig_prod")" "600"
check "the client cert is 600"    "$(stat -c '%a' "${FIX_HOME}/.kube/cert-prod.pem")"   "600"

print -r -- "--dry-run does not create ~/.kube"
fixture kubedry
mkdir -p "${FIX_ROOT}/instances/TestDistro/kube"
print -r -- "apiVersion: v1" > "${FIX_ROOT}/instances/TestDistro/kube/config"

run_restore --dry-run
absent "no ~/.kube was created" "${FIX_HOME}/.kube"

print -r -- "a restore with scripts under ~/.claude reaches its summary"
fixture claude
mkdir -p "${FIX_ROOT}/instances/TestDistro/claude" "${FIX_HOME}/.claude"
print -r -- '{}' > "${FIX_ROOT}/instances/TestDistro/claude/settings.json"
print -r -- '#!/usr/bin/env bash' > "${FIX_HOME}/.claude/hook.sh"
chmod 644 "${FIX_HOME}/.claude/hook.sh"

run_restore
out="${OUT}"
contains "the summary is printed"        "${out}" "Restore complete"
check    "and the exit status is clean"  "${RC}"  "0"
check    "the hook came back executable" "$(stat -c '%a' "${FIX_HOME}/.claude/hook.sh")" "755"

# settings.local.json, not settings.json: the latter is activation-owned and keeps local without failing.
print -r -- "an unattended restore that keeps a differing file fails"
fixture notty
mkdir -p "${FIX_ROOT}/instances/TestDistro/claude" "${FIX_HOME}/.claude"
print -r -- '{"from":"backup"}' > "${FIX_ROOT}/instances/TestDistro/claude/settings.local.json"
print -r -- '{"from":"home"}'   > "${FIX_HOME}/.claude/settings.local.json"

run_restore
check    "the run reports failure"           "${RC}"  "1"
contains "and says nobody could be asked"    "${OUT}" "no TTY to confirm"
check    "the existing file is kept, not clobbered" \
  "$(< "${FIX_HOME}/.claude/settings.local.json")" '{"from":"home"}'

run_restore --force
check    "--force takes the incoming copy"   "${RC}"  "0"
check    "and the home file is the backup's" \
  "$(< "${FIX_HOME}/.claude/settings.local.json")" '{"from":"backup"}'

print -r -- "a tree containing a symlink restores and verifies"
fixture symlink
mkdir -p "${FIX_ROOT}/instances/TestDistro/k9s/config"
print -r -- "skin: dracula" > "${FIX_ROOT}/instances/TestDistro/k9s/config/config.yaml"
ln -sf config.yaml "${FIX_ROOT}/instances/TestDistro/k9s/config/alias.yaml"

run_restore
check    "the restore exits clean"         "${RC}"  "0"
excludes "nothing is reported missing"     "${OUT}" "Verify missing"
excludes "and nothing mismatched"          "${OUT}" "Verify mismatch"
is_link  "the symlink arrived as a symlink" "${FIX_HOME}/.config/k9s/alias.yaml"

print -r -- "a restore never deletes local files the backup lacks"
fixture additive-dirs
mkdir -p "${FIX_ROOT}/instances/TestDistro/claude/projects/some-slug/memory" \
         "${FIX_HOME}/.claude/projects/some-slug/memory"
print -r -- "local only" > "${FIX_HOME}/.claude/projects/some-slug/memory/local.md"

run_restore
is_file "the local file survives an empty source directory" "${FIX_HOME}/.claude/projects/some-slug/memory/local.md"
check "the restore still exits clean" "${RC}" "0"

# CLAUDE.md, not settings.json: the latter is activation-owned and never reaches the conflict branch.
print -r -- "a conflicting file without a TTY"
fixture conflicts
mkdir -p "${FIX_ROOT}/instances/TestDistro/claude" "${FIX_HOME}/.claude"
print -r -- "from the backup" > "${FIX_ROOT}/instances/TestDistro/claude/CLAUDE.md"
print -r -- "rewritten here"  > "${FIX_HOME}/.claude/CLAUDE.md"

run_restore
check    "fails the run by default"        "${RC}"  "1"
contains "and says why"                    "${OUT}" "no TTY to confirm"

run_restore --skip-conflicts
check    "exits clean with --skip-conflicts"    "${RC}"  "0"
contains "warns that it kept the local copy"    "${OUT}" "--skip-conflicts"
contains "and lists it in the summary"          "${OUT}" "Kept 1 existing file"
live="$(< "${FIX_HOME}/.claude/CLAUDE.md")"
contains "the local copy is the one still there" "${live}" "rewritten here"
contains "and the kept list is written for the caller" \
  "$(< "${FIX_ROOT}/.last-restore-kept")" ".claude/CLAUDE.md"

print -r -- "an activation-owned file keeps the local copy on its own"
fixture activation-owned
mkdir -p "${FIX_ROOT}/instances/TestDistro/claude/plugins" "${FIX_HOME}/.claude/plugins"
print -r -- '{"from":"the other box"}' > "${FIX_ROOT}/instances/TestDistro/claude/plugins/installed_plugins.json"
print -r -- '{"from":"this box"}'      > "${FIX_HOME}/.claude/plugins/installed_plugins.json"

run_restore
check    "the restore exits clean without --skip-conflicts" "${RC}"  "0"
contains "and says it kept the local copy"                  "${OUT}" "keeping local"
live="$(< "${FIX_HOME}/.claude/plugins/installed_plugins.json")"
contains "this box's list is untouched" "${live}" "this box"
excludes "it is not counted as a skipped conflict" \
  "$(< "${FIX_ROOT}/.last-restore-kept")" "installed_plugins.json"

run_restore --force
check "--force still overrides activation ownership" \
  "$(< "${FIX_HOME}/.claude/plugins/installed_plugins.json")" '{"from":"the other box"}'

# ===========================================================================
# Shared state root (FLAKELAB_STATE_ROOT)
# ===========================================================================

print -r -- "with a state root, the merged history lives there and seeds from the payload"
state_fixture state-history
rec 1000 0 "from-the-old-payload-merge" > "${FIX_MERGED}"
rec 2000 0 "typed-on-this-box"          > "${FIX_HOME}/.zsh_history"

run_backup --force
merged="$(< "${FIX_STATE}/shell/.zsh_history_merged")"
check    "the run exits clean"                          "${RC}" "0"
contains "the payload's old merge is folded in"         "${merged}" "from-the-old-payload-merge"
contains "and so is what this box typed"                "${merged}" "typed-on-this-box"
excludes "the payload's merged copy is not rewritten"   "$(< "${FIX_MERGED}")" "typed-on-this-box"
contains "the summary names the state root"             "${OUT}" "State:    ${FIX_STATE}"

# The payload's merge is an input, not a fallback: `--restore --from` repoints it
# at another repo's payload, which a populated state root would otherwise never read.
print -r -- "a restore with a state root reads the merged history from there"
state_fixture state-restore
mkdir -p "${FIX_STATE}/shell"
rec 1000 0 "only-in-the-state-root"    > "${FIX_STATE}/shell/.zsh_history_merged"
rec 1500 0 "also-in-the-payload-merge" > "${FIX_MERGED}"
: > "${FIX_HOME}/.zsh_history"

run_restore
live="$(< "${FIX_HOME}/.zsh_history")"
check    "the restore exits clean"                 "${RC}" "0"
contains "the state-root entry arrives"            "${live}" "only-in-the-state-root"
contains "the payload's merge is folded in too"    "${live}" "also-in-the-payload-merge"

print -r -- "history conflict copies are merged and then removed"
state_fixture state-conflict
mkdir -p "${FIX_STATE}/shell"
rec 1000 0 "in-the-merged-file"   > "${FIX_STATE}/shell/.zsh_history_merged"
rec 1100 0 "only-in-the-conflict" > "${FIX_STATE}/shell/.zsh_history_merged_OTHERBOX_Jan-09-003137-2026_Conflict"
rec 1200 0 "only-in-syncthing"    > "${FIX_STATE}/shell/.zsh_history_merged.sync-conflict-20260109-003137-ABCDEF"
rec 2000 0 "typed-here"           > "${FIX_HOME}/.zsh_history"

run_backup --force
merged="$(< "${FIX_STATE}/shell/.zsh_history_merged")"
check    "the run exits clean"                          "${RC}" "0"
contains "the first conflict copy's command survives"   "${merged}" "only-in-the-conflict"
contains "and the second's"                             "${merged}" "only-in-syncthing"
contains "and the live entry"                           "${merged}" "typed-here"
absent   "the folded conflict copy is removed" "${FIX_STATE}/shell/.zsh_history_merged_OTHERBOX_Jan-09-003137-2026_Conflict"
absent   "and so is the other one"             "${FIX_STATE}/shell/.zsh_history_merged.sync-conflict-20260109-003137-ABCDEF"
# "conflict cop" alone also matches "Could not remove folded history conflict copy".
contains "the removal is logged" "${OUT}" "Removed folded history conflict copy"

print -r -- "a restore also reads a history conflict copy, without removing it"
state_fixture state-conflict-restore
mkdir -p "${FIX_STATE}/shell"
rec 1000 0 "in-the-merged-file"   > "${FIX_STATE}/shell/.zsh_history_merged"
rec 1100 0 "only-in-the-conflict" > "${FIX_STATE}/shell/.zsh_history_merged_OTHERBOX_Jan-09-003137-2026_Conflict"
: > "${FIX_HOME}/.zsh_history"

run_restore
live="$(< "${FIX_HOME}/.zsh_history")"
check    "the restore exits clean"                 "${RC}" "0"
contains "the conflict copy's command arrives"     "${live}" "only-in-the-conflict"
exists   "the conflict copy is still there" "${FIX_STATE}/shell/.zsh_history_merged_OTHERBOX_Jan-09-003137-2026_Conflict"

