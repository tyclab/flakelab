check    "and the held list is empty afterwards"   "$(grep -c . "${FIX_HELD}")" "0"

print -r -- "a pasted block with one secret is one question with readable previews"
state_fixture gate-review-preview
FAKE_SECRET="hunter2-secret"
{
  rec 1000 0 'curl -H auth:hunter2-secret example.invalid \'
  print -r -- '  --output /dev/null'
  rec 1001 0 "export TOKEN=hunter2-secret"
  rec 1002 0 "echo hunter2-secret"
  rec 2000 0 "ls"
} > "${FIX_HOME}/.zsh_history"

run_backup --force
check "the backup exits clean"      "${RC}" "0"
check "all three records are held"  "$(grep -c . "${FIX_HELD}")" "3"
check "each one carries a preview"  \
  "$(jq -s '[.[] | select((.preview // "") != "")] | length' "${FIX_HELD}")" "3"
held="$(< "${FIX_HELD}")"
contains "masking the secret"                      "${held}" "export TOKEN=***"
contains "and joining the continuation line"       "${held}" " ⏎ "
excludes "the held list never carries the secret"  "${held}" "hunter2-secret"

ANSWERS="d"
run_backup --review-secrets
