print -r -- "a history record holding a secret is held back from the state root"
state_fixture gate-history
secret_history

run_backup --force
merged="$(< "${FIX_STATE}/shell/.zsh_history_merged")"
check    "a held finding is not a failure"        "${RC}" "0"
contains "the clean record still syncs"           "${merged}" "ls"
excludes "the secret never reaches the state root" "${merged}" "hunter2-secret"
contains "and the run says so"                    "${OUT}" "held back"
contains "the summary points at the review flag"  "${OUT}" "--review-secrets"
is_file  "a held entry was recorded"              "${FIX_HELD}"
held="$(< "${FIX_HELD}")"
check    "one entry"                              "$(print -r -- "${held}" | grep -c .)" "1"
contains "and it is a history finding"            "${held}" '"kind":"history"'
excludes "the held list never holds the secret"   "${held}" "hunter2"
contains "the local history is left alone"        "$(< "${FIX_HOME}/.zsh_history")" "hunter2-secret"

print -r -- "a multi-line record is held as a unit"
state_fixture gate-history-multiline
FAKE_SECRET="hunter2-secret"
{
  rec 1000 0 'cat <<EOF\'
  print -r -- 'TOKEN=hunter2-secret'
  rec 2000 0 "ls"
} > "${FIX_HOME}/.zsh_history"

run_backup --force
merged="$(< "${FIX_STATE}/shell/.zsh_history_merged")"
check    "the run exits clean"                    "${RC}" "0"
excludes "the flagged continuation line is gone"  "${merged}" "hunter2-secret"
excludes "and so is the header above it"          "${merged}" "cat <<EOF"
contains "the untouched record still syncs"       "${merged}" "ls"

print -r -- "a finding the operator allowed syncs unredacted"
state_fixture gate-history-allow
mkdir -p "${FIX_STATE}/.flakelab-state-gate"
FAKE_SECRET="hunter2-secret"
jq -c -n --arg f "$(fingerprint hunter2-secret)" \
  '{fingerprint:$f,decision:"allow",epoch:1}' > "${FIX_DECISIONS}"
rec 1000 0 "export TOKEN=hunter2-secret" > "${FIX_HOME}/.zsh_history"

run_backup --force
check    "the run exits clean"                    "${RC}" "0"
contains "the allowed record reaches the state root" \
  "$(< "${FIX_STATE}/shell/.zsh_history_merged")" "hunter2-secret"
excludes "and nothing is reported held"           "${OUT}" "held back"

print -r -- "a transcript secret is redacted in the synced copy only"
transcript_fixture gate-transcript
secret_transcript

run_backup --force
synced="${SLUG_STATE}/abc.jsonl"
check    "the run exits clean"                    "${RC}" "0"
is_file  "the transcript is synced"               "${synced}"
contains "with the secret replaced"               "$(< "${synced}")" "[REDACTED:fake-rule]"
excludes "and the secret gone"                    "$(< "${synced}")" "hunter2-secret"
contains "the synced line is still valid JSON"    "$(jq -r '.type' "${synced}")" "user"
contains "the local transcript keeps its text"    "$(< "${LIVE}")" "hunter2-secret"
contains "the redaction is held for review"       "$(< "${FIX_HELD}")" '"kind":"transcript"'
contains "the held entry names the LIVE transcript" "$(< "${FIX_HELD}")" "\"path\":\"${LIVE}\""
(( $(wc -c < "${synced}") < $(wc -c < "${LIVE}") )) \
  && ok "the redaction shrank the file, so grow-only cannot pass by accident" \
  || bad "the redaction shrank the file, so grow-only cannot pass by accident"
contains "and the warn says a copy was written" "${OUT}" "of abc.jsonl (redacted)"

cp "${synced}" "${BASE}/gate-transcript.before"
synced_bytes="$(wc -c < "${synced}")"
run_backup --force
check    "the second run exits clean"             "${RC}" "0"
same     "the synced copy is byte-identical"      "${BASE}/gate-transcript.before" "${synced}"
excludes "and nothing was copied again"           "${OUT}" "Synced transcript"
contains "the warn says the synced copy was left as it was" \
  "${OUT}" "(redacted; synced copy unchanged)"

# Grow-only compares the CANDIDATE against the synced copy: a clean line
# appended locally must move exactly its own bytes from the smaller redacted base.
clean_line='{"type":"user","text":"nothing to see"}'
print -r -- "${clean_line}" >> "${LIVE}"
run_backup --force
check    "the third run exits clean"              "${RC}" "0"
check    "the synced copy grew by exactly the appended line" \
  "$(wc -c < "${synced}")" "$(( synced_bytes + ${#clean_line} + 1 ))"
contains "and it was copied this time"            "${OUT}" "Synced transcript"

print -r -- "a redaction that would break the JSON holds the whole file"
transcript_fixture gate-transcript-invalid
FAKE_SECRET='x","'
rec 1000 0 "ls" > "${FIX_HOME}/.zsh_history"
print -r -- '{"a":"x","b":"c"}' > "${SLUG_HOME}/abc.jsonl"

run_backup --force
check "the run exits clean" "${RC}" "0"
absent "the file does not reach the state root" "${SLUG_STATE}/abc.jsonl"
contains "and the run says it was held" "${OUT}" "held back"

print -r -- "a scanner that cannot run is a failure, not a silent write"
transcript_fixture gate-broken
FAKE_BROKEN=1
rec 1000 0 "export TOKEN=hunter2-secret" > "${FIX_HOME}/.zsh_history"
print -r -- '{"type":"user"}' > "${SLUG_HOME}/abc.jsonl"

run_backup --force
check    "the run reports failure"                "${RC}" "1"
contains "and names the gate"                     "${OUT}" "Secret gate"
absent   "no unscanned history in the state root" "${FIX_STATE}/shell/.zsh_history_merged"
absent   "no unscanned transcript either"         "${SLUG_STATE}/abc.jsonl"
is_file  "the payload copy is untouched by the gate" "${FIX_SHELL}/.zsh_history"

print -r -- "--review-secrets deletes a record from every local source"
state_fixture gate-review-delete
secret_history
rec 1000 0 "export TOKEN=hunter2-secret" > "${FIX_MERGED}"

run_backup --force
check "the backup exits clean" "${RC}" "0"

ANSWERS="d"
run_backup --review-secrets
check    "the review exits clean"                 "${RC}" "0"
excludes "the live history lost the record"       "$(< "${FIX_HOME}/.zsh_history")" "hunter2-secret"
contains "and kept the clean one"                 "$(< "${FIX_HOME}/.zsh_history")" "ls"
excludes "the payload instance copy lost it too"  "$(< "${FIX_SHELL}/.zsh_history")" "hunter2-secret"
excludes "and the pre-state-root merged file"     "$(< "${FIX_MERGED}")" "hunter2-secret"
scrub="${FIX_HOME}/.local/state/flakelab/state-gate/pre-scrub"
has_match "pre-scrub copies were kept" "${scrub}" '*'
is_file   "a decision was persisted to the state root" "${FIX_DECISIONS}"
decisions="$(< "${FIX_DECISIONS}")"
contains "recording the fingerprint"              "${decisions}" "$(fingerprint hunter2-secret)"
contains "with the delete decision"               "${decisions}" '"decision":"delete"'
excludes "and never the secret"                   "${decisions}" "hunter2"

run_backup --force
check    "a later backup exits clean"             "${RC}" "0"
excludes "and has nothing left to hold"           "${OUT}" "held back"

print -r -- "one answer settles every record carrying the same secret"
state_fixture gate-review-same-secret
FAKE_SECRET="hunter2-secret"
{
  rec 1000 0 "export TOKEN=hunter2-secret"
  rec 1500 0 "curl -H auth:hunter2-secret example.invalid"
  rec 2000 0 "ls"
} > "${FIX_HOME}/.zsh_history"

run_backup --force
check "the backup exits clean" "${RC}" "0"
check "both records are held"  "$(grep -c . "${FIX_HELD}")" "2"

