#!/usr/bin/env zsh

set -uo pipefail

#
# gitchecker — report which clones on this host are out of date
#
# Per repo: dirty state, every local branch vs its upstream, gone upstreams, detached HEAD, stashes, open MRs/PRs.
# A linked worktree is its own row with its own tree and HEAD; what its repository shares (refs, stashes, the
# forge project) is fetched, queried and reported once, on the main clone's row.
# Only STRICTLY BEHIND branches fast-forward (not checked out: `git fetch . <up>:<branch>`); a dirty tree asks first
# (--ff-dirty), --no-ff only reports. Never stashes, rebases or checks out.
# Any network failure aborts the run rather than print a stale "current"; no origin, an unknown forge or a project
# the forge says is gone is a skip.
# --json prints one document on stdout, abort included; --repo narrows the sweep to named repos.
#
# Usage:
#   gitchecker [--repos-dir DIR]... [--repo PATH]... [--max-jobs N]
#              [--max-depth N] [--dirty-only] [--quiet] [--json] [DIR...]
#
# Exit status:
#   0  every repo current
#   1  at least one repo needs attention
#   2  preflight failure, network or forge failure, or usage error
#

# Sibling lookup: works from the nix store copy the wrapper runs and from the repo.
GITSCAN_PROG=gitchecker
source "${0:A:h}/lib/gitscan.zsh" || exit 2
# The y/N questions, asked the one way every flakelab command asks them.
source "${0:A:h}/lib/prompt.zsh" || exit 2

typeset -a ROOTS=() REPO_ARGS=()
MAX_JOBS=8
MAX_DEPTH=6
DIRTY_ONLY=0
FF=1
FF_DIRTY=0
QUIET=0
JSON=0

usage() {
  cat <<'EOF'
gitchecker — is anything on this host out of date?

Usage: gitchecker [options] [repos-dir...]

Finds every git clone under each root and reports, per repo: uncommitted and
untracked changes, each local branch's ahead/behind/diverged state against its
upstream, branches whose remote branch was deleted (gone), detached HEAD,
branches with no upstream, stashed work, and open MRs/PRs on the forge.

A linked worktree is a row of its own: its changes, its HEAD and the branch it
holds. The rest of what its repository shares (the other branches, the stash
list, the open MRs) is fetched and reported once, on the main clone's row, or
on the first worktree's when the main clone is out of scope. A .git that git
cannot open (an empty directory, a worktree whose git dir was removed) is
listed as skipped and named.

It changes one thing: a branch strictly behind its upstream is fast-forwarded
(a checked-out one with a dirty tree only when asked: yes at the terminal, or
--ff-dirty), unless --no-ff. It never stashes, rebases or checks anything out.
`gitcleaner` is the half that removes what this one reports; `clone-repos` is
the half that updates it.

Every run fetches and queries the forge, and a network or forge failure aborts
the run rather than printing a stale "current"; a repo with no origin, on an
unknown forge, or whose project the forge says is gone is skipped and needs
attention. Needs git, jq and an authenticated glab — plus
gh when a scanned repo has a github.com remote.

Options:
  --repos-dir <path>  Root dir to scan (repeatable; default: ~/git)
  --repo <path>       Scan exactly this repo (repeatable; skips root discovery)
  --max-jobs <N>      Parallel workers (default: 8)
  --max-depth <N>     Max search depth for nested repos (default: 6)
  --dirty-only        Only list repos that need attention
  --no-ff             Report only; do not fast-forward anything
  --ff-dirty          Also try the fast-forward when the working tree is dirty
                      (git still refuses if it would overwrite a change).
                      Without it, an interactive run asks and a piped one skips
  --quiet             Suppress per-repo rows; print the summary only
  --json              One JSON document on stdout instead of the report
  -h, --help          Show this help

Examples:
  gitchecker                             scan ~/git
  gitchecker ~/git /mnt/c/Users/me/git   several trees in one run
  gitchecker --dirty-only                only the repos needing work
  gitchecker --repo . --json             just this clone, for a script

Exit: 0 all current, 1 attention needed (an open MR counts), 2 failure
EOF
}

die() { gitscan_die "$@" }
# _need "$@": a flag last on the line, without its value, is a usage error (exit 2), not set -u's exit 1.
_need() { (( $# > 1 )) || { print -r -u2 -- "$1 needs a value"; usage >&2; exit 2 } }

while (( $# > 0 )); do
  case $1 in
    --repos-dir)  _need "$@"; ROOTS+=("$2"); shift ;;
    --repo)       _need "$@"; REPO_ARGS+=("$2"); shift ;;
    --max-jobs)   _need "$@"; MAX_JOBS="$2"; shift ;;
    --max-depth)  _need "$@"; MAX_DEPTH="$2"; shift ;;
    --dirty-only) DIRTY_ONLY=1 ;;
    --no-ff)      FF=0 ;;
    --ff-dirty)   FF_DIRTY=1 ;;
    --quiet)      QUIET=1 ;;
    --json)       JSON=1 ;;
    -h|--help)    usage; exit 0 ;;
    -*)           print -r -u2 -- "Unknown option: $1"; usage >&2; exit 2 ;;
    *)            ROOTS+=("$1") ;;
  esac
  shift
done

# --repo names repos outright, so root discovery is skipped rather than run and filtered.
if (( ${#REPO_ARGS[@]} == 0 && ${#ROOTS[@]} == 0 )); then
  ROOTS=("${HOME}/git")
fi

# --json is a parser contract; decided before preflight so even a preflight death obeys it.
(( JSON )) && { QUIET=1; GITSCAN_DIE_JSON=1 }

gitscan_preflight
typeset -a ABS_ROOTS=()
if (( ${#ROOTS[@]} > 0 )); then
  gitscan_abs_roots "${ROOTS[@]}"
  ABS_ROOTS=("${GITSCAN_ABS_ROOTS[@]}")
fi
gitscan_timeouts
gitscan_colors
(( JSON )) && { C_RESET=""; C_RED=""; C_GREEN=""; C_YELLOW=""; C_CYAN=""; C_DIM="" }

WORKDIR="$(mktemp -d)"
ABORT_FILE="${WORKDIR}/abort"
trap 'rm -rf "${WORKDIR}"' EXIT

gitscan_ssh_mux "${WORKDIR}"

# A worktree (.git is a file) gets its own row: it has its own HEAD and dirty state. Its
# repository is grouped below, so the state worktrees share is read once.
typeset -a GITDIRS=() GITDIR_ROOTS=()
if (( ${#ABS_ROOTS[@]} > 0 )); then
  gitscan_discover "${MAX_DEPTH}" "${ABS_ROOTS[@]}"
  GITDIRS=("${GITSCAN_GITDIRS[@]}"); GITDIR_ROOTS=("${GITSCAN_GITDIR_ROOTS[@]}")
fi
# A named repo that is not one is a usage error, not an empty result: a caller
# that mistyped a path must not be told the tree is clean.
for repo_arg in "${REPO_ARGS[@]}"; do
  [[ -e "${repo_arg:A}/.git" ]] || die "not a git repo: ${repo_arg}"
  GITDIRS+=("${repo_arg:A}/.git")
  GITDIR_ROOTS+=("${repo_arg:A:h}")
done

if (( ${#GITDIRS[@]} == 0 )); then
  if (( JSON )); then
    jq -n --argjson roots "$(print -rn -- "${(F)ABS_ROOTS}" | jq -R -s 'split("\n") | map(select(length > 0))')" \
      '{ok: true, aborted: null, roots: $roots, scanned: 0, repositories: 0, current: 0, attention: 0, open_requests: 0, repos: []}'
  else
    print -r -- "No git repos found under: ${(j:, :)ABS_ROOTS}"
  fi
  exit 0
fi

gitscan_require_gh "${GITDIRS[@]}"

# repository_of <gitdir>: the absolute git dir the checkout's repository keeps its refs in,
# on stdout. rc 1, with the reason on stdout, for a .git git cannot open.
repository_of() {
  local gitdir="$1" repo="${1:h}" target top common
  if [[ -f "${gitdir}" ]]; then
    target="$(<"${gitdir}")"
    target="${${target%%$'\n'*}#gitdir: }"
    [[ -n "${target}" && "${target}" != /* ]] && target="${repo}/${target}"
    if [[ -n "${target}" && ! -d "${target}" ]]; then
      print -r -- "broken worktree: its git dir ${target} is gone"
      return 1
    fi
  fi
  # git passes over a .git it cannot read and answers for the repository around it,
  # so a top level that is not this directory means this .git is not a repository.
  if ! top="$(git -C "${repo}" rev-parse --path-format=absolute --show-toplevel 2>/dev/null)" \
      || [[ "${top:A}" != "${repo:A}" ]] \
      || ! common="$(git -C "${repo}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"; then
    print -r -- "not a git repository"
    return 1
  fi
  print -r -- "${common:A}"
}

# Checkouts grouped by repository. Worktrees share one ref store, one stash list and one
# forge project: checked once per checkout, every worktree printed all of the repository's
# branches, stashes and MRs again, counted each MR again, and parallel fetches into one
# store fast-forwarded a branch on one row and refused it on another. The main clone
# (.git is a directory) leads its group: its row carries the shared state.
typeset -A REPO_MEMBERS=() BAD_REASON=()
typeset -a REPO_KEYS=()
typeset -i REPO_COUNT=0
for (( i = 1; i <= ${#GITDIRS[@]}; i++ )); do
  if ! key="$(repository_of "${GITDIRS[i]}")"; then
    BAD_REASON[$i]="${key}"
    key="unreadable:${i}"
  fi
  if (( ! ${+REPO_MEMBERS[$key]} )); then
    REPO_KEYS+=("${key}")
    REPO_MEMBERS[$key]="${i}"
    [[ "${key}" == unreadable:* ]] || (( REPO_COUNT++ ))
  elif [[ -d "${GITDIRS[i]}" ]]; then
    REPO_MEMBERS[$key]="${i} ${REPO_MEMBERS[$key]}"
  else
    REPO_MEMBERS[$key]+=" ${i}"
  fi
done

# The `p` flag makes the join separator a real tab; without it zsh joins on a literal `\t`.
emit() {
  local rec="$1"; shift
  print -r -- "${(pj:\t:)@}" >> "${rec}"
}

# Strip TAB/newline from forge-supplied text so it cannot break the record format.
sanitize() {
  local s="${1//$'\t'/ }"
  print -r -- "${s//$'\n'/ }"
}

# Abort the whole run on the first hard failure. A half-scanned tree rendered as
# a report reads as "everything else is fine", which is exactly the lie this
# script exists to prevent.
abort_run() {
  local repo="$1" reason="$2" detail="$3"
  [[ -e "${ABORT_FILE}" ]] && return
  {
    print -r -- "${repo}"
    print -r -- "${reason}"
    print -r -- "$(sanitize "${detail}")"
  } > "${ABORT_FILE}"
}

# check_branch <branch>: one local branch against its upstream, fast-forwarded when strictly
# behind. Called from check_checkout and works on its locals (zsh scoping is dynamic): repo,
# rec, head_branch, dirty, marks, branch_rows, attention. rc 1 when the run must abort.
check_branch() {
  local branch="$1" upstream counts label br_state
  local -i ahead=0 behind=0

  if ! upstream="$(git -C "${repo}" rev-parse --abbrev-ref --symbolic-full-name "${branch}@{upstream}" 2>/dev/null)"; then
    # No upstream at all, or one the prune just removed.
    if [[ "$(git -C "${repo}" for-each-ref --format='%(upstream:track)' "refs/heads/${branch}" 2>/dev/null)" == *gone* ]]; then
      marks+=("${C_RED}gone: ${branch}${C_RESET}")
      br_state=gone
    elif [[ "${branch}" == "${head_branch}" ]]; then
      marks+=("${C_CYAN}no upstream${C_RESET}")
      br_state=no-upstream
    else
      marks+=("${C_CYAN}no upstream: ${branch}${C_RESET}")
      br_state=no-upstream
    fi
    branch_rows+=("${branch}		0	0	${br_state}")
    attention=1
    return 0
  fi

  # A swallowed rev-list would normalise to 0/0, i.e. a false "current".
  if ! counts="$(git -C "${repo}" rev-list --count --left-right "${upstream}...${branch}" 2>/dev/null)"; then
    abort_run "${repo}" "upstream comparison failed for ${branch}" "rev-list ${upstream}...${branch}"
    return 1
  fi
  behind="${counts%%[[:space:]]*}"
  ahead="${counts##*[[:space:]]}"

  # In-sync branches are recorded but never marked: the report prints only what
  # needs attention, while a machine reader wants the whole branch inventory.
  if (( ahead == 0 && behind == 0 )); then
    branch_rows+=("${branch}	${upstream}	0	0	synced")
    return 0
  fi

  # attention is set per outcome below: a branch this run fast-forwards ends in sync.
  label=""
  [[ "${branch}" != "${head_branch}" ]] && label="${branch}: "
  if (( ahead > 0 && behind > 0 )); then
    # Both directions means the upstream was rewritten, not routine drift.
    marks+=("${C_RED}${label}diverged ↑${ahead}↓${behind}${C_RESET}")
    br_state=diverged
    attention=1
  elif (( ahead > 0 )); then
    marks+=("${C_YELLOW}${label}↑${ahead}${C_RESET}")
    br_state=ahead
    attention=1
  else
    # Strictly behind: the one state that fast-forwards.
    br_state=behind
    if (( FF )); then
      local ff_allow=false
      (( FF_DIRTY )) && ff_allow=true
      if gitscan_ff_branch "${repo}" "${branch}" "${upstream}" "${head_branch}" "${dirty}" "${ff_allow}"; then
        marks+=("${C_GREEN}${label}fast-forwarded ↓${behind}${C_RESET}")
        branch_rows+=("${branch}	${upstream}	0	0	fast-forwarded")
        return 0
      fi
      marks+=("${C_YELLOW}${label}↓${behind} (not fast-forwarded: ${GITSCAN_FF_OUT%%$'\n'*})${C_RESET}")
      # Asked after the scan: this runs as a background job with stdin on /dev/null.
      (( dirty > 0 && ! FF_DIRTY )) && [[ "${branch}" == "${head_branch}" ]] &&
        emit "${rec}" ASK "${branch}" "${upstream}" "${behind}" "${dirty}"
      attention=1
    else
      marks+=("${C_YELLOW}${label}↓${behind}${C_RESET}")
      attention=1
    fi
  fi
  branch_rows+=("${branch}	${upstream}	${ahead}	${behind}	${br_state}")
  return 0
}

# rec_path <index>: the record file of GITDIRS[index]; zero-padded so a glob reads them in scan order.
rec_path() { print -r -- "${WORKDIR}/rec.$(printf '%04d' "$1")" }

# check_checkout <index> <shared> <repository>: one checkout's record. shared=1 is the row that
# carries what its repository's checkouts share: every local branch not checked out in another
# scanned checkout, the stash list and the open MRs. Every other row holds only what is its
# own: its tree, its HEAD and the branch HEAD is on. Reads skip_reason, forge_rows and
# other_heads from check_repository. rc 1 when the run must abort.
check_checkout() {
  local idx="$1" shared="$2" repository="$3"
  local gitdir="${GITDIRS[idx]}" root="${GITDIR_ROOTS[idx]}"
  local repo="${gitdir:h}" rec="$(rec_path "${idx}")"
  local rel="${repo#${root}/}"
  [[ "${rel}" == "${repo}" ]] && rel="${repo:t}"
  local line head_branch branch m row
  local -i tracked=0 untracked=0 dirty=0 stashes=0 attention=0
  typeset -a marks=() branch_rows=() branches=()

  while IFS= read -r line || [[ -n "${line}" ]]; do
    [[ -z "${line}" ]] && continue
    if [[ "${line}" == '??'* ]]; then
      (( untracked++ ))
    else
      (( tracked++ ))
    fi
  done < <(git -C "${repo}" status --porcelain=v1 2>/dev/null)
  (( dirty = tracked + untracked ))
  if (( dirty > 0 )); then
    marks+=("${C_RED}✗ ${dirty} dirty${C_RESET}")
    attention=1
  fi

  if ! head_branch="$(git -C "${repo}" symbolic-ref --short -q HEAD 2>/dev/null)"; then
    head_branch="(detached)"
    marks+=("${C_RED}detached HEAD${C_RESET}")
    attention=1
  fi

  # Every local branch, not just HEAD's — a feature branch must not hide the fact
  # that main has fallen behind. A branch another scanned checkout holds is on its row.
  if (( shared )); then
    branches=("${(@f)$(git -C "${repo}" for-each-ref --format='%(refname:short)' refs/heads/ 2>/dev/null)}")
  elif [[ "${head_branch}" != "(detached)" ]]; then
    branches=("${head_branch}")
  fi
  for branch in "${branches[@]}"; do
    [[ -z "${branch}" ]] && continue
    (( shared )) && (( ${+other_heads[${branch}]} )) && continue
    check_branch "${branch}" || return 1
  done

  # Stashes — parked work is work that has not landed. One list per repository.
  if (( shared )); then
    stashes="$(git -C "${repo}" stash list 2>/dev/null | wc -l)"
    if (( stashes > 0 )); then
      marks+=("${C_YELLOW}${stashes} stashed${C_RESET}")
      attention=1
    fi
  fi

  # Open MRs count as attention: work that has not landed is work this repo is waiting on.
  # A skip is the repository's, so every one of its rows carries it: none was compared
  # against the forge.
  if [[ -n "${skip_reason}" ]]; then
    marks+=("${C_CYAN}skipped: ${skip_reason}${C_RESET}")
    attention=1
  elif (( shared && ${#forge_rows[@]} > 0 )); then
    attention=1
  fi

  emit "${rec}" ROOT "${root}"
  emit "${rec}" REL "${rel}"
  emit "${rec}" PATH "${repo}"
  emit "${rec}" REPOSITORY "${repository}"
  emit "${rec}" SHARED "${shared}"
  emit "${rec}" BRANCH "${head_branch}"
  emit "${rec}" TRACKED "${tracked}"
  emit "${rec}" UNTRACKED "${untracked}"
  emit "${rec}" STASHES "${stashes}"
  [[ "${head_branch}" == "(detached)" ]] && emit "${rec}" DETACHED 1
  [[ -n "${skip_reason}" ]] && emit "${rec}" SKIP "${skip_reason}"
  for m in "${marks[@]}"; do
    emit "${rec}" MARK "${m}"
  done
  for row in "${branch_rows[@]}"; do
    print -r -- "BR	${row}" >> "${rec}"
  done
  if (( shared )); then
    [[ -z "${skip_reason}" ]] && emit "${rec}" PROJECT "${forge_line}"
    for row in "${forge_rows[@]}"; do
      print -r -- "FORGE	${row}" >> "${rec}"
    done
  fi
  if (( attention )); then
    emit "${rec}" STATE ATTENTION
  else
    emit "${rec}" STATE CURRENT
  fi
  return 0
}

# check_unreadable <index>: the record of a .git git cannot open. Nothing in it can be
# read, so it is named and skipped: attention, never current, never a detached HEAD.
check_unreadable() {
  local idx="$1"
  local gitdir="${GITDIRS[idx]}" root="${GITDIR_ROOTS[idx]}"
  local repo="${gitdir:h}" rec="$(rec_path "${idx}")"
  local rel="${repo#${root}/}"
  [[ "${rel}" == "${repo}" ]] && rel="${repo:t}"
  emit "${rec}" ROOT "${root}"
  emit "${rec}" REL "${rel}"
  emit "${rec}" PATH "${repo}"
  emit "${rec}" REPOSITORY ""
  emit "${rec}" SHARED 0
  emit "${rec}" BRANCH ""
  emit "${rec}" TRACKED 0
  emit "${rec}" UNTRACKED 0
  emit "${rec}" STASHES 0
  emit "${rec}" SKIP "${BAD_REASON[$idx]}"
  emit "${rec}" MARK "${C_CYAN}skipped: ${BAD_REASON[$idx]}${C_RESET}"
  emit "${rec}" STATE ATTENTION
}

# check_repository <key> <index>...: one repository and its scanned checkouts, the one
# carrying shared state first. The fetch and the forge query run once here; every
# checkout then reads the refs that fetch wrote, in sequence, so no two workers ever
# write the same ref store.
check_repository() {
  local key="$1"; shift
  local owner="$1" idx head
  local repo="${GITDIRS[owner]:h}"
  local remote_url forge_line forge project jq_prog sigil forge_out parsed
  local iid title source draft skip_reason=""
  typeset -a forge_rows=()
  typeset -A other_heads=()

  [[ -e "${ABORT_FILE}" ]] && return

  if [[ "${key}" == unreadable:* ]]; then
    check_unreadable "${owner}"
    return
  fi

  # Resolve the forge BEFORE any network call. A missing origin remote, or one
  # on a host this script does not integrate with, is a property of this single
  # repo — not evidence the rest of the sweep is unsound — so it is skipped
  # rather than aborting the run.
  #
  # The ordering is the fix, not a tidy-up: such a repo would otherwise fail the
  # fetch below and abort the entire sweep before its URL was ever looked at.
  # One unsupported forge anywhere under a scanned root took down the whole
  # report and every other repo went unexamined.
  remote_url="$(git -C "${repo}" config --get remote.origin.url 2>/dev/null)"
  if [[ -z "${remote_url}" ]]; then
    skip_reason="no origin remote"
  elif ! forge_line="$(gitscan_forge_of "${remote_url}")"; then
    skip_reason="unsupported remote host"
  fi

  # Refresh remote-tracking refs. This writes only .git/refs/remotes/*, so
  # ahead/behind is accurate without touching the index or working tree.
  # gitnet_retry absorbs a single transient and names a timeout kill; a
  # persistent network failure still aborts the sweep — a partial report is never
  # printed as though it were complete. A project the forge says is gone is this
  # repo's own state: skipped as attention, never "current", and the sweep goes on.
  #
  # Skipped repos are not fetched at all: there is no forge to compare them
  # against, so a fetch could only produce the abort we just decided this repo
  # does not deserve.
  if [[ -z "${skip_reason}" ]] && ! gitnet_retry git -C "${repo}" fetch --prune; then
    if [[ "${GITNET_WHY}" != "timed out" ]] && gitscan_remote_gone "${GITNET_OUT}"; then
      skip_reason="remote gone (no such project, or this login cannot see it)"
    else
      abort_run "${repo}" "git fetch --prune failed (after retry, ${GITNET_WHY})" "${GITNET_OUT}"
      return
    fi
  fi

  # Open MRs/PRs, once per repository. The skip decision was taken above, before
  # the fetch. A forge-API failure below, by contrast, is a transient that puts
  # every other repo's result in doubt too, and rightly aborts.
  if [[ -z "${skip_reason}" ]]; then
    IFS=$'\t' read -r forge project <<< "${forge_line}"

    # @tsv, not string interpolation: it escapes tabs and newlines inside a title
    # instead of emitting them raw, which would shift every later field and split
    # one MR into two bogus rows.
    # gitnet_retry on the forge call, matching the fetch path: at four-figure
    # repo counts the API throttles, and a single transient must not discard an
    # otherwise complete sweep.
    if [[ "${forge}" == gitlab ]]; then
      jq_prog='.[] | [.iid, .title, .source_branch, .draft] | @tsv'
      sigil="!"
    else
      jq_prog='.[] | [.number, .title, .headRefName, .isDraft] | @tsv'
      sigil="#"
    fi
    # Paged, not capped at the first hundred: under-reporting open MRs is the
    # quiet version of the failure this script exists to prevent.
    if ! gitscan_open_requests "${forge}" "${project}"; then
      abort_run "${repo}" "${GITSCAN_FORGE_WHY}" "${GITSCAN_FORGE_JSON}"
      return
    fi
    forge_out="${GITSCAN_FORGE_JSON}"

    # An empty body is a legitimate "no open MRs"; malformed JSON is not, and must
    # not degrade into the same answer — gitscan_jq keeps those apart.
    if ! gitscan_jq "${forge_out}" "${jq_prog}"; then
      abort_run "${repo}" "could not parse ${forge} response" "${GITSCAN_JQ_ERR}"
      return
    fi
    parsed="${GITSCAN_JQ_OUT}"
    if [[ -n "${parsed}" ]]; then
      while IFS=$'\t' read -r iid title source draft; do
        [[ -z "${iid}" ]] && continue
        # The draft flag is its own field, not a title prefix, so a parser gets a boolean.
        [[ "${draft}" == true ]] || draft=false
        forge_rows+=("${sigil}${iid}	$(sanitize "${title}")	$(sanitize "${source}")	${draft}")
      done <<< "${parsed}"
    fi
  fi

  # The branch each other checkout holds is reported on that checkout's row only.
  for idx in "${@:2}"; do
    head="$(git -C "${GITDIRS[idx]:h}" symbolic-ref --short -q HEAD 2>/dev/null)" &&
      other_heads[${head}]=1
  done

  for idx in "$@"; do
    [[ -e "${ABORT_FILE}" ]] && return
    check_checkout "${idx}" "$(( idx == owner ))" "${key}" || return
  done
}

# Stop the run as soon as a worker records a failure, rather than after the
# slowest repo finishes.
check_abort() {
  [[ -e "${ABORT_FILE}" ]] || return 0
  local repo reason detail
  { read -r repo; read -r reason; read -r detail } < "${ABORT_FILE}"
  local pid
  for pid in ${${(f)"$(jobs -p 2>/dev/null)"}}; do
    kill "${pid}" 2>/dev/null
  done
  wait 2>/dev/null
  print -r -u2 -- ""
  print -r -u2 -- "gitchecker: ${reason} — aborting"
  print -r -u2 -- "  repo: ${repo}"
  [[ -n "${detail}" ]] && print -r -u2 -- "  ${detail}"
  # Diagnostics stay on stderr; stdout must still be one parseable document.
  (( JSON )) && jq -n --arg repo "${repo}" --arg reason "${reason}" --arg detail "${detail}" \
    '{ok: false, aborted: {repo: $repo, reason: $reason, detail: $detail}, repos: []}'
  exit 2
}

typeset -a job_pids=()
for key in "${REPO_KEYS[@]}"; do
  check_repository "${key}" ${=REPO_MEMBERS[$key]} &
  job_pids+=($!)
  # zsh parses `wait -n` as a job spec and exits 127; waiting on the oldest child bounds concurrency.
  if (( ${#job_pids[@]} >= MAX_JOBS )); then
    wait "${job_pids[1]}" 2>/dev/null || true
    job_pids=("${job_pids[@]:1}")
    check_abort
  fi
done
wait
check_abort

typeset -i CURRENT=0 ATTENTION=0 FORGE_COUNT=0

# field <record-file> <key> — first value for a single-valued key.
field() {
  local rec="$1" key="$2" k v
  while IFS=$'\t' read -r k v; do
    [[ "${k}" == "${key}" ]] && { print -r -- "${v}"; return 0 }
  done < "${rec}"
  return 1
}

# Asks the dirty-tree questions the workers could not, in the foreground, only of a person at a terminal.
ask_dirty_behind() {
  local rec k kind b up behind dirty repo new_mark ok
  local -a asks lines recs=("${WORKDIR}"/rec.*(N))
  local -i j
  # One grep over every record, not one per repo: most runs have nothing to ask.
  (( ${#recs} )) || return 0
  recs=("${(@f)$(grep -l $'^ASK\t' "${recs[@]}" 2>/dev/null)}")
  for rec in "${recs[@]}"; do
    [[ -n "${rec}" ]] || continue
    asks=("${(@f)$(grep $'^ASK\t' "${rec}")}")
    for k in "${asks[@]}"; do
      [[ -n "${k}" ]] || continue
      IFS=$'\t' read -r kind b up behind dirty <<< "${k}"
      repo="$(field "${rec}" PATH)"
      # The path under its root, as the report groups it: two clones can share
      # a basename, and the answer moves one of them.
      prompt_confirm "$(field "${rec}" REL): ${b} is ${behind} behind and the tree is dirty — fast-forward anyway?" || continue
      ok=false
      if gitscan_ff_branch "${repo}" "${b}" "${up}" "${b}" "${dirty}" true; then
        ok=true
        new_mark="${C_GREEN}fast-forwarded ↓${behind}${C_RESET}"
      else
        new_mark="${C_YELLOW}↓${behind} (not fast-forwarded: ${GITSCAN_FF_OUT%%$'\n'*})${C_RESET}"
      fi
      lines=("${(@f)$(<"${rec}")}")
      for (( j = 1; j <= ${#lines}; j++ )); do
        [[ "${lines[j]}" == "MARK	${C_YELLOW}↓${behind} (not fast-forwarded:"* ]] && lines[j]="MARK	${new_mark}"
        $ok && [[ "${lines[j]}" == "BR	${b}	"* ]] && lines[j]="BR	${b}	${up}	0	0	fast-forwarded"
      done
      print -rl -- "${lines[@]}" > "${rec}"
    done
  done
}
(( ! JSON )) && prompt_tty && ask_dirty_behind

render() {
  # Every local is declared once, here: re-running `local` on a name already
  # declared in this scope makes zsh print it instead of declaring it.
  local rec state root rel branch group status_col k v iid title source project rest
  local prev_root="" prev_group=""
  typeset -a visible=() marks=()
  typeset -A seen_mr=()
  typeset -i width=0

  # First pass: tally every repo, and collect the ones the filters keep.
  for rec in "${WORKDIR}"/rec.*(N); do
    state="$(field "${rec}" STATE)"
    if [[ "${state}" == CURRENT ]]; then
      (( CURRENT++ ))
    else
      (( ATTENTION++ ))
    fi
    # Per project: two clones of one project list the same MRs, and they are counted once.
    project="$(field "${rec}" PROJECT)"
    while IFS=$'\t' read -r k iid rest; do
      [[ "${k}" == FORGE ]] && seen_mr[${project}:${iid}]=1
    done < "${rec}"
    # --quiet is the summary alone; --dirty-only keeps the rows that need work.
    (( QUIET )) && continue
    [[ "${state}" == CURRENT ]] && (( DIRTY_ONLY )) && continue
    visible+=("${rec}")
  done
  FORGE_COUNT=${#seen_mr}

  # Column width from the visible rows only, so a filtered run stays tight.
  for rec in "${visible[@]}"; do
    rel="$(field "${rec}" REL)"
    (( ${#rel:t} > width )) && width=${#rel:t}
  done
  (( width < 8 )) && width=8

  print -r -- ""
  for rec in "${visible[@]}"; do
    root="$(field "${rec}" ROOT)"
    rel="$(field "${rec}" REL)"
    branch="$(field "${rec}" BRANCH)"

    if [[ "${root}" != "${prev_root}" ]]; then
      [[ -n "${prev_root}" ]] && print -r -- ""
      print -r -- "${root}"
      prev_root="${root}"
      prev_group=""
    fi

    # `:h` yields "." for a repo sitting directly under its root — that is no
    # group, not a group named ".".
    group="${rel:h}"
    [[ "${group}" == "${rel}" || "${group}" == "." ]] && group=""
    if [[ "${group}" != "${prev_group}" ]]; then
      print -r -- ""
      [[ -n "${group}" ]] && print -r -- "  ${C_DIM}${group}/${C_RESET}"
      prev_group="${group}"
    fi

    marks=()
    while IFS=$'\t' read -r k v; do
      [[ "${k}" == MARK ]] && marks+=("${v}")
    done < "${rec}"
    status_col="${C_GREEN}✓ current${C_RESET}"
    (( ${#marks[@]} > 0 )) && status_col="${(j: :)marks}"

    printf '    %-*s  %s%-18s%s  %s\n' \
      "${width}" "${rel:t}" "${C_DIM}" "${branch}" "${C_RESET}" "${status_col}"

    # Forge rows, indented under their repo.
    while IFS=$'\t' read -r k iid title source draft; do
      [[ "${k}" == FORGE ]] || continue
      [[ "${draft}" == true ]] && title="DRAFT: ${title}"
      printf '      %s%-5s%s %s  %s%s%s\n' \
        "${C_CYAN}" "${iid}" "${C_RESET}" "${title}" "${C_DIM}" "${source}" "${C_RESET}"
    done < "${rec}"
  done
}

# rows_json <record-file> <key> <jq object body> — the record's rows for one key
# as a JSON array. jq does the splitting and the escaping: a title with a quote,
# a backslash or a UTF-8 arrow in it must not be able to produce a document the
# caller cannot parse.
rows_json() {
  local rec="$1" key="$2" body="$3"
  grep $'^'"${key}"$'\t' "${rec}" 2>/dev/null \
    | cut -f2- \
    | jq -R -s --arg key "${key}" "split(\"\n\") | map(select(length > 0)) | map(split(\"\t\")) | map(${body})"
}

# One document whatever happened: a caller telling "clean" from "died" by empty stdout gets it wrong once.
render_json() {
  local rec f
  local -i idx=0
  for rec in "${WORKDIR}"/rec.*(N); do
    (( idx++ ))
    jq -n \
      --arg path "$(field "${rec}" PATH)" \
      --arg repository "$(field "${rec}" REPOSITORY)" \
      --argjson shared_state "$([[ "$(field "${rec}" SHARED)" == 1 ]] && print -n true || print -n false)" \
      --arg root "$(field "${rec}" ROOT)" \
      --arg rel "$(field "${rec}" REL)" \
      --arg branch "$(field "${rec}" BRANCH)" \
      --arg state "$([[ "$(field "${rec}" STATE)" == CURRENT ]] && print -n current || print -n attention)" \
      --argjson tracked "$(field "${rec}" TRACKED)" \
      --argjson untracked "$(field "${rec}" UNTRACKED)" \
      --argjson stashes "$(field "${rec}" STASHES)" \
      --argjson detached "$([[ -n "$(field "${rec}" DETACHED)" ]] && print -n true || print -n false)" \
      --arg skipped "$(field "${rec}" SKIP)" \
      --argjson branches "$(rows_json "${rec}" BR '{name: .[0], upstream: (if .[1] == "" then null else .[1] end), ahead: (.[2] | tonumber), behind: (.[3] | tonumber), state: .[4]}')" \
      --argjson open_requests "$(rows_json "${rec}" FORGE '{id: .[0], title: .[1], source_branch: .[2], draft: (.[3] == "true")}')" \
      '{path: $path, root: $root, rel: $rel, branch: $branch, state: $state,
        repository: (if $repository == "" then null else $repository end),
        shared_state: $shared_state,
        skipped: (if $skipped == "" then null else $skipped end),
        dirty: {tracked: $tracked, untracked: $untracked},
        detached: $detached, stashes: $stashes,
        branches: $branches, open_requests: $open_requests}' \
      > "${WORKDIR}/json.$(printf '%04d' ${idx})"
  done

  jq -s \
    --argjson roots "$(print -rn -- "${(F)ABS_ROOTS}" | jq -R -s 'split("\n") | map(select(length > 0))')" \
    --argjson scanned "${#GITDIRS[@]}" \
    --argjson repositories "${REPO_COUNT}" \
    --argjson current "${CURRENT}" \
    --argjson attention "${ATTENTION}" \
    --argjson open_requests "${FORGE_COUNT}" \
    '{ok: true, aborted: null, roots: $roots, scanned: $scanned, repositories: $repositories, current: $current,
      attention: $attention, open_requests: $open_requests, repos: .}' \
    "${WORKDIR}"/json.*(N)
}

if (( JSON )); then
  # render() is still what tallies the counters, and --json forced --quiet, so
  # it prints nothing here.
  render
  render_json
  (( ATTENTION > 0 )) && exit 1
  exit 0
fi

render

print -r -- ""
# Rows are checkouts; with worktrees in scope the repositories behind them are fewer.
scanned="${#GITDIRS[@]} repos"
(( REPO_COUNT != ${#GITDIRS[@]} )) && scanned="${#GITDIRS[@]} checkouts of ${REPO_COUNT} repos"
print -r -- "Scanned ${scanned} in ${#ABS_ROOTS[@]} roots: ${CURRENT} current, ${ATTENTION} need attention, ${FORGE_COUNT} open MRs"

(( ATTENTION > 0 )) && exit 1
exit 0
