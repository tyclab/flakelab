#!/usr/bin/env zsh

set -uo pipefail

# Menus build an argument vector for the real router. Each command still owns
# validation, prompts, platform checks, and the environment of its wrapper.
source "${0:A:h}/lib/prompt.zsh" || exit 1
[[ -n "${FLAKELAB_ROUTER:-}" ]] || { print -ru2 -- "flakelab-menu: open it with flakelab in a terminal"; exit 2 }

typeset -a offered=(${=FLAKELAB_MENU_COMMANDS:-}) descriptions=("${(@f)FLAKELAB_MENU_DESCRIPTIONS}")
typeset -A description
for (( i = 1; i <= ${#offered}; i++ )); do description[${offered[i]}]="${descriptions[i]}"; done

# One row per action: fixed arguments | label | fields | behavior. Fields with
# = take one literal value; @ takes a positional value. ! asks before showing
# options. A / before a field label marks a path. stdin= supplies a file on
# stdin. --= appends arguments after --.
typeset -A actions
actions[sessions]='|list the running sessions
--start|start a new session||native
--attach|attach to a running session||native
--recent|recently stopped sessions, with the command to resume each
--save|save the running list
--resume|the resume commands from the last save
--open|reopen the last save in Windows Terminal tabs|@=/Snapshot_file|wsl
--json|list running sessions as JSON
--start claude|start a Claude session with options|@=/Directory --prompt=Task --prompt-file=/Brief_file --model=Model --effort=Effort --name=Window_name --detach --=Native_argument
--start codex|start a Codex session with options|@=/Directory --prompt=Task --prompt-file=/Brief_file --model=Model --effort=Effort --name=Window_name --detach --trust --=Native_argument
--wait|wait for a completed Claude turn|!@=Session_ID --timeout=Seconds
--read|read a Claude terminal|!@=Session_ID
--close|close finished sessions|!@=Session_or_window @=Another_session_or_window --force --archive
--attach|attach to a specific window or session|!@=Window_or_session
--recent|list sessions from the last N hours|!@=Hours
--save|save the running list to a file|!@=/Snapshot_file
--resume|print resume commands from a file|!@=/Snapshot_file
--autosave|take a recovery snapshot
--restore-tab|restore this Windows Terminal pane||wsl
--restore-tab|set this pane’s saved title|!--name=Tab_title|wsl
--restore-tab|clear this pane’s saved title|!--name=|wsl'
actions[update]='|rebuild this distro||rebuild
--all|rebuild this distro and run the clone sweep||rebuild-all'
actions[update-all]='|rebuild, then run the clone sweep||rebuild-all'
actions[doctor]='|run every check
--quiet|only what is wrong
--strict|treat warnings as failures|--quiet'
actions[backup]='|back up now
--dry-run|preview a backup
--restore|restore into the home directory|--from=/Payload_directory --instance=Source_instance --keep=Snapshots_to_retain --force --skip-conflicts --dry-run|restore
--state-only|sync the state root|--dry-run --revisit-keeps
--review-secrets|review findings held back by the secret gate
--fetch-session|fetch an archived Claude session|!@=Session_ID
--state-gc|list orphaned project directories in the state root|--force --dry-run
|backup options|--dry-run --force --keep=Snapshots_to_retain --revisit-keeps'
actions[clone]='|clone and refresh the configured repositories||clone'
actions[tycsnap]='|restore this Windows Terminal pane
|set this pane’s saved title|!--name=Tab_title
|clear this pane’s saved title|!--name='
actions[notify]='|send a notification|!--message=Message --title=Title --priority=Priority_1_to_5 --tags=Comma_separated_tags --dry-run'
actions[web]='|serve the dashboard|--bind=Bind_address --port=Port --token-file=/Token_file --terminal-socket=/Terminal_socket --logo=/Logo_file
--print-token|show the dashboard token|--token-file=/Token_file
--rotate-token|rotate the dashboard token|--token-file=/Token_file'
actions[mcp]='status|list configured MCP accounts
doctor|check the native MCP configuration|--live
login|sign in to MCP accounts|@=Account --fresh
connect|connect an account over stdio|!@=Account
import-codex|import existing Codex grants'
actions[tray]='status|check the installed Windows tray
sync|install or update the Windows tray|--dry-run'
actions[provision]='status|show provisioning status|--repo=/Flakelab_checkout --=PowerShell_argument
generate|generate an overlay|--repo=/Flakelab_checkout --=PowerShell_argument
init|initialize the overlay|--repo=/Flakelab_checkout --=PowerShell_argument
bootstrap|bootstrap the Windows distro|--repo=/Flakelab_checkout --foreground --=PowerShell_argument
provision|provision the Windows distro|--repo=/Flakelab_checkout --foreground --=PowerShell_argument
|other provisioning command|!@=Command --repo=/Flakelab_checkout --foreground --=PowerShell_argument'
actions[overlay-gen]='|generate a private overlay|!--out=/Output_directory --config=/Configuration_file --flakelab-ref=Flake_reference --dry-run --force --user=Username --target=Target --git-name=Git_name --git-email=Email --locale=Locale --windows-username=Windows_username --git-editor=Git_editor --backup-autostart=Boolean --profiles=Profiles --gitlab-groups=Groups --ssh-keys=Key_names --repo-path=/Repository_directory --overlay-url=Remote_URL --state-root=/State_directory --state-transcripts=Boolean'
actions[build-distro]='|build a throwaway WSL distro|--name=Distro_name --flake=Flake_reference --base=/Base_tarball --reinstall --no-verify'
actions[test-provision]='|test provisioning in a throwaway distro|--tarball=/Tarball --keep'
actions[distro-name]='|print the WSL distro name'
actions[activate-hooks]='|install configured repository hooks|!--repos-dir=/Repositories_directory'
actions[clone-repos]='|clone or refresh repositories from a list|!--repos-dir=/Repositories_directory !--key-file=/SSH_key_file !stdin=/Repository_list_file --max-jobs=Parallel_jobs'
actions[stale-repos]='|report archived or deletion-scheduled clones|!--repos-dir=/Repositories_directory --group=GitLab_group --member'
actions[glab-projects]='|list projects in a GitLab group|!--group=GitLab_group --member --no-archived --per-page=Page_size'

# Collect one value exactly as typed. Option/positional arguments are never
# passed through a shell parser. Preserve their ordering even if the operator
# selects the working directory or a pass-through argument last.
add_field() {
  local field="${1#!}" key hint
  if [[ "$field" != *=* ]]; then args+=("$field"); return 0; fi
  key="${field%%=*}"; hint="${field#*=}"; hint="${hint//_/ }"
  if [[ -z "$hint" ]]; then args+=("$key" ""); return 0; fi
  if [[ "$hint" == /* ]]; then prompt_input "${hint#/}" || return 1
  else prompt_input "$hint" "" literal || return 1
  fi
  case "$key" in
    stdin) [[ -n "$PROMPT_TEXT" ]] || return 1; input_file="$PROMPT_TEXT" ;;
    @) positional+=("$PROMPT_TEXT") ;;
    --) forwarded+=("$PROMPT_TEXT") ;;
    *) args+=("$key" "$PROMPT_TEXT") ;;
  esac
}

# Run through the same router and the same per-command PATH as a typed command.
run() {
  local router="$FLAKELAB_ROUTER" zsh_bin="${commands[zsh]:-zsh}"
  [[ -z "${FLAKELAB_CALLER_PATH:-}" ]] || PATH="$FLAKELAB_CALLER_PATH"
  unset FLAKELAB_CALLER_PATH FLAKELAB_ROUTER FLAKELAB_MENU_COMMANDS FLAKELAB_MENU_DESCRIPTIONS
  if [[ -n "$input_file" ]]; then
    exec "$zsh_bin" "$router" "$@" < "$input_file"
  else
    exec "$zsh_bin" "$router" "$@"
  fi
  exit $?
}

choose_fields() {
  local field label key hint
  local -a available=() labels=() saved_counts=()
  for field in "$@"; do
    if [[ "$field" == '!'* ]]; then
      add_field "$field" || return 1
      continue
    fi
    available+=("$field")
    key="${field%%=*}"; hint="${field#*=}"; hint="${hint//_/ }"
    hint="${hint#/}"
    if [[ "$field" != *=* ]]; then label="$key"
    elif [[ "$key" == @ ]]; then label="$hint"
    else label="$key <$hint>"
    fi
    labels+=("$label")
  done
  (( ${#available} )) || return 0
  while true; do
    local -a preview=("${words[@]}" "${positional[@]}" "${args[@]}")
    (( ${#forwarded} )) && preview+=(-- "${forwarded[@]}")
    local invocation="flakelab ${(j: :)${(@q-)preview}}"
    [[ -z "$input_file" ]] || invocation+=" < ${(q-)input_file}"
    local -a menu=("Run $invocation" "${labels[@]}")
    (( ${#saved_counts} )) && menu+=('Undo last option')
    prompt_choose "flakelab ${(j: :)words}" "${menu[@]}" || return 1
    (( PROMPT_INDEX == 1 )) && return 0
    if (( PROMPT_INDEX > ${#available} + 1 )); then
      local -a counts=(${=saved_counts[-1]})
      saved_counts[-1]=()
      positional=( "${(@)positional[1,${counts[1]}]}" )
      args=( "${(@)args[1,${counts[2]}]}" )
      forwarded=( "${(@)forwarded[1,${counts[3]}]}" )
      continue
    fi
    field="${available[PROMPT_INDEX-1]}"
    saved_counts+=("${#positional} ${#args} ${#forwarded}")
    add_field "$field" || saved_counts[-1]=()
  done
}

choose_action() {
  local cmd="$1" row fixed label fields behavior
  local -a rows=() labels=()
  for row in "${(@f)actions[$cmd]}"; do
    IFS='|' read -r fixed label fields behavior <<<"$row"
    [[ "$behavior" == wsl && ( -z "${WSL_DISTRO_NAME:-}" || "${FLAKELAB_TARGET:-wsl}" != wsl ) ]] && continue
    rows+=("$row"); labels+=("${fixed:+$fixed  }$label")
  done
  while true; do
    if (( ${#rows} == 1 )); then PROMPT_INDEX=1
    else prompt_choose "flakelab ${cmd}" "${labels[@]}" || return 1
    fi
    IFS='|' read -r fixed label fields behavior <<<"${rows[PROMPT_INDEX]}"
    local -a words=("$cmd" ${=fixed}) positional=() args=() forwarded=()
    local input_file=""
    choose_fields ${=fields} || { (( ${#rows} == 1 )) && return 1; continue; }
    words+=("${positional[@]}" "${args[@]}")
    (( ${#forwarded} )) && words+=(-- "${forwarded[@]}")
    local question=''
    case "$behavior" in
      rebuild) question='Rebuild this distro now?' ;;
      rebuild-all) question='Rebuild this distro, then run the clone sweep?' ;;
      restore) question='Restore the backup into your home directory?' ;;
      clone) question='Clone what is missing, then fetch and rebase every configured repo?' ;;
    esac
    if [[ -n "$question" ]] && ! prompt_confirm "$question"; then
      (( ${#rows} == 1 )) && return 1
      continue
    fi
    if [[ -n "$input_file" ]]; then
      print -ru2 -- "→ flakelab ${(j: :)${(@q-)words}} < ${(q-)input_file}"
    elif [[ "$behavior" != native ]]; then
      prompt_ran flakelab "${words[@]}"
    fi
    run "${words[@]}"
  done
}

# Order frequently used tools first. Availability and descriptions come from
# the router, including checkout-only differences and WSL target gates.
typeset -a names=(sessions update update-all doctor backup)
typeset -a labels=() visible_names=()
for cmd in "${offered[@]}"; do (( ${names[(Ie)$cmd]} )) || names+=("$cmd"); done
for cmd in "${names[@]}"; do
  (( ${offered[(Ie)$cmd]} )) || continue
  visible_names+=("$cmd"); labels+=("$(printf '%-13s %s' "$cmd" "${description[$cmd]}")")
done
visible_names+=(help); labels+=('help          command list and help for each command')
while true; do
  prompt_choose flakelab "${labels[@]}" || exit 130
  cmd="${visible_names[PROMPT_INDEX]}"
  if [[ "$cmd" == help ]]; then
    prompt_choose 'Help for' 'All commands' "${offered[@]}" || continue
    input_file=""
    if (( PROMPT_INDEX == 1 )); then prompt_ran flakelab --help; run --help; fi
    cmd="${offered[PROMPT_INDEX-1]}"; prompt_ran flakelab "$cmd" --help; run "$cmd" --help
  fi
  choose_action "$cmd"
done
