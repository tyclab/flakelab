#!/usr/bin/env zsh

set -uo pipefail

# Offline suite for the flakelab router: the real script against a throwaway dispatch
# dir of stub wrappers, so no case depends on nix/cli.nix having built anything.
# Covers the target gate only; the rest of the router is tested by hand.

SCRIPT_DIR="${0:A:h}"
ROUTER="${SCRIPT_DIR}/flakelab"
typeset -i PASS=0 FAIL=0

# Both end in `return 0`: `(( PASS++ ))` yields the pre-increment value, so an
# `&& ok || bad` chain would run both arms on the first call.
ok()       { print -r -- "  ok   $1"; (( PASS++ )); return 0 }
bad()      { print -r -u2 -- "  FAIL $1"; (( FAIL++ )); return 0 }
check()    { [[ "$2" == "$3" ]] && ok "$1" || { bad "$1"; print -r -u2 -- "       expected: $3"; print -r -u2 -- "       actual:   $2" } }
contains() { [[ "$2" == *"$3"* ]] && ok "$1" || { bad "$1"; print -r -u2 -- "       missing: $3" } }
excludes() { [[ "$2" != *"$3"* ]] && ok "$1" || bad "$1 (unexpected: $3)" }

BASE="$(mktemp -d)"
trap 'rm -rf "${BASE}"' EXIT

# One stub executable per wrapper name, each naming itself so a dispatch is
# distinguishable from a gate refusal.
DISPATCH="${BASE}/dispatch/bin"
mkdir -p "${DISPATCH}"

typeset -a WRAPPERS=(
  nix-update nix-update-all nix-doctor nix-backup claude-sessions accounts notify web nix-clone-repos
  nix-provision nix-overlay-generate build-dev-wsl-nix test-provision-nix
  get_current_wsl_distro_name clone-repos activate-hooks report-stale-repos
  glab-group-projects
)
for w in "${WRAPPERS[@]}"; do
  cat > "${DISPATCH}/${w}" <<STUB
#!/usr/bin/env zsh
print -r -- "ran:${w}\${*:+ \$*}"
print -r -- "env: router=\${FLAKELAB_ROUTER:-unset} caller=\${FLAKELAB_CALLER_PATH:-unset} path=\${PATH}"
STUB
  chmod +x "${DISPATCH}/${w}"
done
# The menu as the gate sees it: a stand-in naming itself and what it was handed.
cat > "${DISPATCH}/flakelab-menu" <<'STUB'
#!/usr/bin/env zsh
print -r -- "ran:flakelab-menu router=${FLAKELAB_ROUTER:-unset} menu=${FLAKELAB_MENU_COMMANDS:-unset}"
STUB
chmod +x "${DISPATCH}/flakelab-menu"
# The real menu behind the wrapper nix/scripts.nix writes (the caller's PATH
# kept aside, pins in front), beside the same command stand-ins.
MENUDISPATCH="${BASE}/menudispatch/bin"
mkdir -p "${MENUDISPATCH}"
cp "${DISPATCH}"/*(.) "${MENUDISPATCH}/"
cat > "${MENUDISPATCH}/flakelab-menu" <<STUB
#!/usr/bin/env zsh
export FLAKELAB_CALLER_PATH="\$PATH"
export PATH="/menu-pins:\$PATH"
exec zsh ${(q)SCRIPT_DIR}/flakelab-menu "\$@"
STUB
chmod +x "${MENUDISPATCH}/flakelab-menu"

# Mirrored, not sourced: the router's arrays are not meant to be sourced by anything.
typeset -a ORDER=(
  update update-all doctor backup sessions accounts notify web clone provision overlay-gen build-distro
  test-provision distro-name clone-repos activate-hooks stale-repos
  glab-projects
)
typeset -a WSL_ONLY=( provision build-distro test-provision distro-name )

# run_router <target|""> <args...> — sets OUT and RC; an empty target leaves the env
# var genuinely unset, which is what checkout mode looks like.
typeset -i RC=0
OUT=""
run_router() {
  local target="$1"
  shift
  if [[ -n "${target}" ]]; then
    OUT="$(FLAKELAB_DISPATCH_DIR="${DISPATCH}" FLAKELAB_TARGET="${target}" "${ROUTER}" "$@" 2>&1)"
  else
    OUT="$(FLAKELAB_DISPATCH_DIR="${DISPATCH}" "${ROUTER}" "$@" 2>&1)"
  fi
  RC=$?
}

# Anchored on the two-space prefix the listing printf writes, so the usage line above
# the list can never count.
count_listed() {
  local -i n=0
  local c
  for c in "${ORDER[@]}"; do
    print -r -- "$OUT" | grep -qE "^  ${c}[[:space:]]" && (( n++ ))
  done
  print -r -- "$n"
}

print -r -- "no FLAKELAB_TARGET (checkout mode): every verb available"
run_router "" --help
check "--help lists all 18 commands" "$(count_listed)" "18"
check "--help exits 0" "${RC}" "0"

run_router "" build-distro
contains "build-distro dispatches with no target set" "${OUT}" "ran:build-dev-wsl-nix"
check "build-distro exits 0 with no target set" "${RC}" "0"

print -r -- ""
print -r -- "FLAKELAB_TARGET=proxmox-vm: the four wsl-only verbs are gated"
run_router "proxmox-vm" --help
check "--help lists 14 commands (18 minus the four wsl-only verbs)" "$(count_listed)" "14"
for c in "${WSL_ONLY[@]}"; do
  excludes "--help does not list '${c}' on proxmox-vm" "${OUT}" $'\n'"  ${c} "
done

run_router "proxmox-vm" build-distro
check "build-distro exits 2 on proxmox-vm" "${RC}" "2"
contains "build-distro's refusal names the command and the required target" \
  "${OUT}" "build-distro: not available on target proxmox-vm (wsl only)"

run_router "proxmox-vm" update
contains "update still dispatches on proxmox-vm" "${OUT}" "ran:nix-update"
check "update exits 0 on proxmox-vm" "${RC}" "0"

run_router "proxmox-vm" "build-distr"
check "a typo near a hidden verb exits 2" "${RC}" "2"
contains "a typo near a hidden verb is reported unknown" "${OUT}" "unknown command: build-distr"
excludes "a typo near a hidden verb does NOT suggest it" "${OUT}" "did you mean 'build-distro'"

print -r -- ""
print -r -- "a bare flakelab: the list anywhere, the menu at a terminal"
# at_tty <keys> <words...> — the command on a pseudo-terminal (util-linux
# `script`), <keys> typed ahead as printf reads them; OUT is the screen with
# the escape codes stripped, RC the command's status.
at_tty() {
  local keys="$1"; shift
  OUT="$(printf "$keys" | TERM=xterm timeout 30 script -qec "${(j: :)${(q)@}}" /dev/null 2>&1)"; RC=$?
  OUT="$(print -r -- "${OUT//$'\r'/}" | sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g')"
}
WSLENV=(env FLAKELAB_DISPATCH_DIR="${DISPATCH}" FLAKELAB_TARGET=wsl)
MENUENV=(env -u WSL_DISTRO_NAME FLAKELAB_DISPATCH_DIR="${MENUDISPATCH}" FLAKELAB_TARGET=wsl)

run_router wsl
check "no terminal: a bare flakelab exits 0" "${RC}" "0"
contains "and prints the list" "${OUT}" "Commands:"
excludes "and opens no menu" "${OUT}" "ran:flakelab-menu"
contains "the list says a terminal gets a menu" "${OUT}" "At a terminal a bare flakelab opens a menu"

at_tty "" "${WSLENV[@]}" zsh "${ROUTER}"
contains "at a terminal a bare flakelab opens the menu" "${OUT}" "ran:flakelab-menu"
contains "handing it the router's own path" "${OUT}" "router=${ROUTER}"
contains "and the commands this target offers" "${OUT}" "menu=update update-all doctor backup sessions accounts notify web clone provision"
at_tty "" env FLAKELAB_DISPATCH_DIR="${DISPATCH}" FLAKELAB_TARGET=proxmox-vm zsh "${ROUTER}"
excludes "a target's gated verbs are not offered" "${OUT}" " provision"
at_tty "" "${WSLENV[@]}" FLAKELAB_NO_PROMPT=1 zsh "${ROUTER}"
contains "FLAKELAB_NO_PROMPT=1 gets the list at a terminal" "${OUT}" "Commands:"
excludes "and no menu" "${OUT}" "ran:flakelab-menu"
at_tty "" "${WSLENV[@]}" TERM=dumb zsh "${ROUTER}"
excludes "a dumb terminal gets no menu" "${OUT}" "ran:flakelab-menu"
at_tty "" "${WSLENV[@]}" zsh -c "zsh ${(q)ROUTER} | cat"
contains "piped stdout gets the list" "${OUT}" "Commands:"
excludes "and no menu" "${OUT}" "ran:flakelab-menu"

print -r -- ""
print -r -- "the menu: a command, an action, and it runs as typed"
at_tty 'sess\r\r' "${MENUENV[@]}" zsh "${ROUTER}"
contains "sessions, then its first action, runs flakelab sessions" "${OUT}" "ran:claude-sessions"
contains "printing the command it amounts to" "${OUT}" "→ flakelab sessions"
excludes "the Windows Terminal action is offered on WSL only" "${OUT}" "reopen the last save"
contains "the command runs with the caller's PATH, not the menu's" "${OUT}" "caller=unset path="
excludes "no pin of the menu's is left on it" "${OUT}" "/menu-pins"
contains "and without the hand-over variables" "${OUT}" "router=unset"
at_tty 'sess\r\e\e' "${MENUENV[@]}" WSL_DISTRO_NAME=x zsh "${ROUTER}"
contains "on WSL the tabs action is there" "${OUT}" "reopen the last save in Windows Terminal tabs"
check "Esc backs out and Esc at the top leaves with 130" "${RC}" "130"
at_tty 'doc\r\e[B\r' "${MENUENV[@]}" zsh "${ROUTER}"
contains "doctor's second action passes its flag" "${OUT}" "ran:nix-doctor --quiet"
contains "and prints it" "${OUT}" "→ flakelab doctor --quiet"
at_tty 'acc\rswitch the\r' "${MENUENV[@]}" zsh "${ROUTER}"
contains "an action the command completes runs without its argument" "${OUT}" "ran:accounts switch"
excludes "and leaves the full command to the command" "${OUT}" "→ flakelab accounts switch"
at_tty 'update\rn\e' "${MENUENV[@]}" zsh "${ROUTER}"
excludes "a declined rebuild runs nothing" "${OUT}" "ran:nix-update"
check "and Esc then leaves with 130" "${RC}" "130"
at_tty 'update\ry' "${MENUENV[@]}" zsh "${ROUTER}"
contains "a confirmed rebuild runs update" "${OUT}" "ran:nix-update"
at_tty 'help\r' "${MENUENV[@]}" zsh "${ROUTER}"
contains "help prints the list" "${OUT}" "Commands:"
at_tty '\e' "${MENUENV[@]}" zsh "${ROUTER}"
check "Esc at the top exits 130" "${RC}" "130"
at_tty '\e' "${MENUENV[@]}" zsh "${ROUTER}"
excludes "the menu offers no plumbing" "${OUT}" "clone-repos"
excludes "no interop-wiping builder" "${OUT}" "build-distro"
excludes "and none of the commands a person does not run by hand" "${OUT}" "notify"

print -r -- ""
print -r -- "lib/prompt.zsh"
PLIB="${SCRIPT_DIR}/lib/prompt.zsh"
# pick <keys> <script> — a few lines of zsh against the library at a terminal.
pick() { at_tty "$1" zsh -c "source ${(q)PLIB}; $2" }
CHOOSE='prompt_choose Pick "alpha one" "beta two" "gamma three" "delta four"; print -r -- "rc=$? idx=$PROMPT_INDEX"; stty -a'
pick '\e[B\e[B\r' "${CHOOSE}"
contains "arrows move, Enter picks" "${OUT}" "rc=0 idx=3"
contains "the answer is left on screen" "${OUT}" "? Pick › gamma three"
contains "the terminal is back in canonical mode" "${OUT}" " icanon"
contains "with echo" "${OUT}" " echo "
pick 'ta\r' "${CHOOSE}"
contains "typing filters, case-insensitive substring" "${OUT}" "rc=0 idx=2"
pick 'GAM\r' "${CHOOSE}"
contains "in any case" "${OUT}" "rc=0 idx=3"
pick 'zzz\x7f\x7f\x7fdel\r' "${CHOOSE}"
contains "Backspace edits the filter" "${OUT}" "rc=0 idx=4"
pick '\e[B\e[B\e[B\e[B\e[B\e[A\r' "${CHOOSE}"
contains "the arrows stop at the ends" "${OUT}" "rc=0 idx=3"
pick 'zzz\r\e' "${CHOOSE}"
contains "Enter on no match picks nothing" "${OUT}" "rc=1 idx="
pick '\e' "${CHOOSE}"
contains "Esc cancels" "${OUT}" "rc=1 idx="
contains "and says so" "${OUT}" "? Pick › cancelled"
contains "and restores the terminal" "${OUT}" " icanon"
pick '\e\e' "${CHOOSE}; ${CHOOSE}"
check "a second Esc cancels the list after it" "$(print -r -- "${OUT}" | grep -c 'rc=1 idx=')" "2"
pick '\ex' "${CHOOSE}"
contains "an Alt chord cancels too" "${OUT}" "rc=1 idx="
INPUT='prompt_input Where "/some/default"; print -r -- "rc=$? text=[$PROMPT_TEXT]"'
pick '\r' "${INPUT}"
contains "Enter keeps the default" "${OUT}" "rc=0 text=[/some/default]"
pick '/more\r' "${INPUT}"
contains "typing extends it" "${OUT}" "rc=0 text=[/some/default/more]"
pick '\x01\x0b~/x\r' "${INPUT}"
contains "a leading ~ is the home directory" "${OUT}" "rc=0 text=[${HOME}/x]"
KEYS='prompt_keys "Delete?" "y/N/a/q"; print -r -- "key=[$PROMPT_KEY]"'
pick 'A' "${KEYS}"
contains "a key is read without Enter, lowercased" "${OUT}" "key=[a]"
contains "the choices are shown as ever" "${OUT}" "[y/N/a/q]"
pick '\r' "${KEYS}"
contains "Enter is the capital default" "${OUT}" "key=[n]"
pick 'z' "${KEYS}"
contains "and so is any other key" "${OUT}" "key=[n]"
CONFIRM='prompt_confirm "Sure?"; print -r -- "rc=$?"'
pick 'y' "${CONFIRM}"
contains "confirm: y is yes" "${OUT}" "rc=0"
pick '\r' "${CONFIRM}"
contains "confirm: Enter is no" "${OUT}" "rc=1"
RAN='prompt_ran flakelab sessions --start claude "/a b"'
pick '' "${RAN}"
contains "the command is printed with its quoting" "${OUT}" "→ flakelab sessions --start claude '/a b'"
OUT="$(zsh -c "source ${(q)PLIB}; prompt_tty && print yes || print no" </dev/null 2>&1)"
check "no terminal, no prompt" "${OUT}" "no"
pick '' 'prompt_tty && print yes || print no'
contains "a terminal prompts" "${OUT}" "yes"
at_tty '' env FLAKELAB_NO_PROMPT=1 zsh -c "source ${(q)PLIB}; prompt_tty && print yes || print no"
contains "unless FLAKELAB_NO_PROMPT=1" "${OUT}" "no"

print -r -- ""
print -r -- "${PASS} passed, ${FAIL} failed"
(( FAIL == 0 ))
