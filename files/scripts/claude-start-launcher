#!/usr/bin/env bash
# tycswap-start-launcher
# Rendered by claude.nix with a pinned interpreter and realpath. Keep the
# installer's ~/.local/bin/claude link intact, including across self-updates.

set -- "$("@realpath@" -e -- "$HOME/.local/bin/claude" 2>/dev/null)" "$@"
if [[ -z "$1" || ! -x "$1" || -d "$1" ]]; then
  printf '%s\n' 'claude: native executable missing at ~/.local/bin/claude; run flakelab update.' >&2
  exit 127
fi
if [[ "$1" -ef "$0" ]]; then
  printf '%s\n' 'claude: ~/.local/bin/claude points to this launcher; remove that incorrect link and run flakelab update.' >&2
  exit 126
fi

model_choice() {
  local answer
  # fd 3 carries the prompt. A failing picker gets one launcher diagnostic.
  if answer=$("@python@" -I "@picker@" 3>&2 2>/dev/null); then
    printf '%s' "$answer"
  else
    printf '%s\n' 'claude: model picker failed; starting with the configured model.' >&2
  fi
}

# Keep the preexec marker in this shell only, including for the query.
export -n FLAKELAB_CLAUDE_PROMPT_PID
if command -v tycswap >/dev/null 2>&1; then
  if [[ $# == 1 && ${FLAKELAB_CLAUDE_PROMPT_PID:-} == "$PPID" && -t 0 && -t 1 && -t 2 &&
        ! -v CI && ! -v CLAUDECODE && ! -v CODEX_THREAD_ID &&
        ! -v TYCSWAP_NO_PROMPT && ! -v FLAKELAB_NO_PROMPT ]]; then
    case "$(model_choice)" in
      mythos) exec tycswap start --mythos ;;
      fable) set -- "$@" --model fable ;;
      opus) set -- "$@" --model opus ;;
      cancel) exit 130 ;;
    esac
  fi
  exec tycswap start -- "$@"
fi
exec "$@"
