#!/usr/bin/env zsh

set -uo pipefail

# session-archive: archive agent sessions and write their summary cards. The work is lib/session_archive/, python3's
# standard library; nix/scripts.nix pins python3, flock and jq. Exit codes: 0 ok, 1 failure, 2 usage error.

lib="${0:A:h}/lib"
export SESSION_ARCHIVE_LIB="$lib"
export PYTHONDONTWRITEBYTECODE=1
exec python3 "$lib/session_archive/cli.py" "$@"
