#!/usr/bin/env zsh

set -uo pipefail

# web: dashboard for agent sessions and stored logins (lib/web.py, stdlib only) on 127.0.0.1:8321 by default. Every API
# call but /api/health needs the bearer token (0600 file). Bind to the WireGuard address for a phone, never a public
# interface. --terminal-socket fronts ttyd, which has no credential of its own, behind a cookie issued against the token.
# It shells out to tycswap and claude-sessions, so their locks and refusals hold; it never touches a tool's token file.

SCRIPT_DIR="${0:A:h}"
BIND="${FLAKELAB_WEB_BIND:-127.0.0.1}"
PORT="${FLAKELAB_WEB_PORT:-8321}"
TOKEN_FILE="${FLAKELAB_WEB_TOKEN_FILE:-${HOME}/.local/state/flakelab/web/token}"
TERMINAL_SOCKET="${FLAKELAB_WEB_TERMINAL_SOCKET:-}"
LOGO="${FLAKELAB_WEB_LOGO:-}"
PRINT_TOKEN=false
ROTATE_TOKEN=false

usage() {
  cat <<'USAGE'
Usage: flakelab web [--bind ADDR] [--port N] [--token-file FILE] [--terminal-socket PATH] [--logo FILE]
       flakelab web --print-token
       flakelab web --rotate-token

Serves the dashboard on ADDR:N (127.0.0.1:8321), every API call but
/api/health behind the bearer token in FILE (~/.local/state/flakelab/web/token,
made on first start), and with --terminal-socket the ttyd terminal listening
there, behind a session the API issues against the token. --logo FILE (svg,
png, ico, jpg, webp) is the page's heading mark and tab icon, served at /logo.
Bind to the WireGuard address for a phone; never to a public interface.
--rotate-token writes a new token: a running server follows at once and every
terminal session ends.
USAGE
}

while (( $# > 0 )); do
  case $1 in
    --bind) BIND="${2:-}"; shift ;;
    --port) PORT="${2:-}"; shift ;;
    --token-file) TOKEN_FILE="${2:-}"; shift ;;
    --terminal-socket) TERMINAL_SOCKET="${2:-}"; shift ;;
    --logo) LOGO="${2:-}"; shift ;;
    --print-token) PRINT_TOKEN=true ;;
    --rotate-token) ROTATE_TOKEN=true ;;
    --help|-h) usage; exit 0 ;;
    *) print -ru2 -- "web: unknown option: $1"; usage >&2; exit 2 ;;
  esac
  shift
done
[[ "$PORT" == <1-65535> ]] || { print -ru2 -- "web: --port takes 1 to 65535"; exit 2 }
[[ -n "$BIND" ]] || { print -ru2 -- "web: --bind needs an address"; exit 2 }
[[ -z "$LOGO" || -r "$LOGO" ]] || { print -ru2 -- "web: --logo ${LOGO} is not readable"; exit 2 }
# Early word for spellings that need no lookup; the server checks the resolved address too.
case "$BIND" in
  0.0.0.0|::|'*'|0) print -ru2 -- "web: refusing to bind every interface; name the WireGuard address"; exit 2 ;;
esac

if $PRINT_TOKEN; then
  [[ -r "$TOKEN_FILE" ]] || { print -ru2 -- "web: no token yet (${TOKEN_FILE}); it is made on the first start"; exit 1 }
  cat -- "$TOKEN_FILE"
  exit 0
fi

command -v python3 >/dev/null 2>&1 || { print -ru2 -- "web: python3 is not on PATH"; exit 1 }
export PYTHONDONTWRITEBYTECODE=1   # no __pycache__ beside lib/web.py

if $ROTATE_TOKEN; then
  # Temp and rename: the server reads the file on every check, so a running one follows and terminal sessions end.
  (umask 077; mkdir -p -- "${TOKEN_FILE:h}") || { print -ru2 -- "web: cannot make ${TOKEN_FILE:h}"; exit 1 }
  chmod 700 -- "${TOKEN_FILE:h}" 2>/dev/null
  (umask 077; python3 -c 'import secrets; print(secrets.token_urlsafe(32))' > "${TOKEN_FILE}.tmp.$$") &&
    mv -f -- "${TOKEN_FILE}.tmp.$$" "$TOKEN_FILE" || { rm -f -- "${TOKEN_FILE}.tmp.$$"; print -ru2 -- "web: cannot write ${TOKEN_FILE}"; exit 1 }
  print -ru2 -- "web: token rotated (${TOKEN_FILE}); the page needs the new one, every terminal session is over"
  exit 0
fi

export FLAKELAB_WEB_BIND="$BIND" FLAKELAB_WEB_PORT="$PORT" FLAKELAB_WEB_TOKEN_FILE="$TOKEN_FILE" FLAKELAB_WEB_TERMINAL_SOCKET="$TERMINAL_SOCKET" FLAKELAB_WEB_LOGO="$LOGO"
export FLAKELAB_WEB_STATIC="${FLAKELAB_WEB_STATIC:-${SCRIPT_DIR:h}/config/web}"
export FLAKELAB_WEB_TYCSWAP="${FLAKELAB_WEB_TYCSWAP:-tycswap}"
export FLAKELAB_WEB_SESSIONS="${FLAKELAB_WEB_SESSIONS:-${SCRIPT_DIR}/claude-sessions}"
exec python3 "${SCRIPT_DIR}/lib/web.py"
