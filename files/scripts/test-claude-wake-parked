#!/usr/bin/env zsh
# Offline tests for claude-wake-parked: stub tmux panes and a stub tycswap status.
emulate -L zsh
setopt pipefail
SCRIPT_DIR="${0:A:h}"
CMD="${SCRIPT_DIR}/claude-wake-parked"
BASE="$(mktemp -d)"
trap 'rm -rf "$BASE"' EXIT
typeset -i PASS=0 FAIL=0
ok()       { print -r -- "  ok   $1"; (( PASS++ )); return 0 }
bad()      { print -r -- "  FAIL $1"; (( FAIL++ )); return 0 }
check()    { [[ "$2" == "$3" ]] && ok "$1" || { bad "$1"; print -r -u2 -- "       expected: $3"; print -r -u2 -- "       actual:   $2" } }
contains() { [[ "$2" == *"$3"* ]] && ok "$1" || { bad "$1"; print -r -u2 -- "       missing: $3"; print -r -u2 -- "       in: $2" } }
excludes() { [[ "$2" != *"$3"* ]] && ok "$1" || bad "$1 (unexpected: $3)" }

STUBS="${BASE}/bin" PANES="${BASE}/panes"
mkdir -p "$STUBS" "$PANES"
export TMUX_LOG="${BASE}/tmux.log" PANE_DIR="$PANES" STATUS_JSON="${BASE}/status.json" FLAKELAB_WAKE_STATE="${BASE}/state"
export FLAKELAB_WAKE_SETTLE=0
# The stub pane shows typed text in its input box (line 3 of a screen) unless <pane>.swallow exists.
cat > "${STUBS}/tmux" <<'STUB'
#!/usr/bin/env zsh
case "$1" in
  list-panes) cat "${PANE_DIR}/list" ;;
  capture-pane)
    n="${@[-1]#%}"
    if [[ -r "${PANE_DIR}/${n}.typed" ]]; then
      awk -v t="$(<"${PANE_DIR}/${n}.typed")" 'NR == 3 { print "❯ " t; next } { print }' "${PANE_DIR}/${n}"
    else
      cat "${PANE_DIR}/${n}"
    fi ;;
  send-keys)
    print -r -- "$*" >> "${TMUX_LOG}"
    n="${3#%}"
    if [[ "$4" == -l ]]; then
      [[ -e "${PANE_DIR}/${n}.swallow" ]] || print -r -- "$5" > "${PANE_DIR}/${n}.typed"
    else
      rm -f "${PANE_DIR}/${n}.typed"
    fi ;;
  *) exit 1 ;;
esac
STUB
cat > "${STUBS}/tycswap" <<'STUB'
#!/usr/bin/env zsh
case "$1 $2" in
  "status --json") [[ -r "${STATUS_JSON}" ]] && cat "${STATUS_JSON}" || exit 1 ;;
  "config list") print -r -- "autoswitch.fiveHourThreshold    90"; print -r -- "autoswitch.sevenDayThreshold    97             (default)"; print -r -- "autoswitch.modelThreshold       95             (default)" ;;
  *) exit 1 ;;
esac
STUB
chmod +x "${STUBS}"/*
export PATH="${STUBS}:${PATH}"

# The reset times as tycswap prints them; their fraction differs from fetch to fetch.
R5="2026-11-16T05:29:59.564684+00:00" R7="2026-11-18T22:59:59.866924+00:00" RF="2026-11-18T22:59:59.867090+00:00"
status() { # five-hour pct, seven-day pct, fable pct
  print -r -- "{\"active\":{\"number\":7,\"usageStatus\":\"ok\",\"usage\":{\"fiveHour\":{\"pct\":$1,\"resetsAt\":\"$R5\"},\"sevenDay\":{\"pct\":$2,\"resetsAt\":\"$R7\"},\"scoped\":[{\"name\":\"Fable\",\"pct\":$3,\"resetsAt\":\"$RF\"}]}}}" > "$STATUS_JSON"
}
RULE='────────────────────────────────'
screen() { # file, input line, footer lines...
  local f="$1" input="$2"; shift 2
  print -rl -- "● Done with the step." "$RULE lane ─" "$input" "$RULE" "$@" "  ⏵⏵ auto mode on" > "${PANES}/$f"
}
PARKED=("  ⚠ Usage limit reached · limit resets 3am" "    Continuing automatically at 3am · Esc to cancel")
screen 1 $'❯\xc2\xa0' "${PARKED[@]}"
screen 2 "❯ please also check the logs" "${PARKED[@]}"
screen 3 "❯ " "✻ Thinking… (12s · esc to interrupt)" "${PARKED[@]}"
screen 4 "❯ " "${PARKED[@]}"
screen 5 "❯ " "  ⎿  You've hit your Fable limit · resets Nov 18, 10pm" "${PARKED[@]}"
screen 6 "❯ "
screen 7 $'❯ \e[2mTry "fix lint errors"\e[0m' "${PARKED[@]}"
# A finished session whose last reply only talks about a limit.
print -rl -- "● The lane stopped because you hit your 5-hour limit; nothing is merged." "  Usage limit reached earlier, waiting for your go." "$RULE lane ─" "❯ " "$RULE" "  ⏵⏵ auto mode on" > "${PANES}/8"
screen 9 $'❯ /model \e[2m[model]\e[0m' "${PARKED[@]}"
screen 10 "❯ " "${PARKED[@]}"
# A question dialog drawn where the input box sits.
print -rl -- "● Which one?" "$RULE" "" "$RULE" "  Enter to select · ↑/↓ to navigate · Esc to cancel" "${PARKED[@]}" > "${PANES}/11"
# Something taller than an input box between the last two rules.
print -rl -- "● Done." "$RULE" "" "" "" "$RULE" "${PARKED[@]}" > "${PANES}/12"
screen 13 "❯ " "${PARKED[@]}"
: > "${PANES}/13.swallow"
# The banner as the last line of the conversation, above the input box.
print -rl -- "● Working on it." "  ⎿  You've hit your 5-hour limit · resets 3:40am (Europe/Berlin)" "$RULE lane ─" "❯ " "$RULE" "  ⏵⏵ auto mode on" > "${PANES}/14"
print -rl -- "%1 0 claude" "%2 0 claude" "%3 0 claude" "%4 0 codex" "%5 0 2.1.325" "%6 0 claude" "%7 0 claude" \
  "%8 0 claude" "%9 0 claude" "%10 1 claude" "%11 0 claude" "%12 0 claude" "%13 0 claude" "%14 0 claude" > "${PANES}/list"
run() { OUT="$("$CMD" 2>&1)"; RC=$?; SENT="$(cat "$TMUX_LOG" 2>/dev/null)"; }

print -r -- "the live account has 5-hour and weekly room, Fable spent"
status 4 88 100
run
check "exits 0" "$RC" "0"
contains "a session parked on its usage limit is told to go on (Claude Code's no-break space after the prompt is empty)" "$SENT" "send-keys -t %1 -l flakelab: the shared login is on an account with room now (account 7)"
contains "followed by Enter" "$SENT" "send-keys -t %1 Enter"
excludes "never into typed text" "$SENT" "-t %2 "
excludes "never into a session at work" "$SENT" "-t %3 "
excludes "never into a Codex pane" "$SENT" "-t %4 "
excludes "a Fable-limit session waits while the account has no Fable" "$SENT" "-t %5 "
excludes "a session that is not parked is left alone" "$SENT" "-t %6 "
contains "a dim placeholder counts as an empty input box" "$SENT" "send-keys -t %7 -l"
excludes "a reply that only mentions a limit is no banner" "$SENT" "-t %8 "
excludes "typed text before a dim hint is typed text" "$SENT" "-t %9 "
excludes "never into a pane in copy mode" "$SENT" "-t %10 "
excludes "never into a question dialog" "$SENT" "-t %11 "
excludes "never where more than an input line sits between the rules" "$SENT" "-t %12 "
contains "a pane that does not show the line is typed into" "$SENT" "send-keys -t %13 -l"
excludes "but gets no Enter" "$SENT" "send-keys -t %13 Enter"
contains "and is reported" "$OUT" "not submitted in %13"
contains "a banner at the end of the conversation counts" "$SENT" "send-keys -t %14 -l"
contains "each wake is reported" "$OUT" "woke %1 (account 7"

print -r -- "once per pane, account and window"
: > "$TMUX_LOG"
run
excludes "a second run wakes nobody again" "$SENT" "Enter"
R5="2026-11-16T05:30:00.120000+00:00" R7="2026-11-18T22:59:59.101010+00:00" RF="2026-11-18T23:00:00.000001+00:00"
status 4 88 100
: > "$TMUX_LOG"
run
excludes "nor does a new fetch of the same window, whose reset time differs by a fraction" "$SENT" "Enter"

print -r -- "Fable room on the live account"
status 4 88 50
: > "$TMUX_LOG"
run
contains "a Fable-limit session is woken once the account has Fable" "$SENT" "send-keys -t %5 -l"
excludes "the others keep their earlier wake" "$SENT" "-t %1 "

print -r -- "a new window"
R5="2026-11-16T10:29:59.564684+00:00"
status 4 88 100
: > "$TMUX_LOG"
run
contains "wakes a still parked session again" "$SENT" "send-keys -t %1 -l"

print -r -- "no room"
rm -rf "$FLAKELAB_WAKE_STATE"
status 92 50 10
: > "$TMUX_LOG"
run
check "the live account above its 5-hour bar wakes nobody" "$SENT" ""
status 10 97 10
run
check "the live account at its weekly bar wakes nobody" "$SENT" ""

print -r -- "usage that is not known is not room"
print -r -- '{"active":{"number":7,"usageStatus":"ok","usage":null}}' > "$STATUS_JSON"
run
check "no usage wakes nobody" "$SENT" ""
print -r -- '{"active":{"number":7,"usageStatus":"ok","usage":{"fiveHour":{"pct":4,"resetsAt":"'"$R5"'"}}}}' > "$STATUS_JSON"
run
check "no weekly figure wakes nobody" "$SENT" ""
print -r -- '{"active":{"number":7,"usageStatus":"error","usage":{"fiveHour":{"pct":4,"resetsAt":"'"$R5"'"},"sevenDay":{"pct":50,"resetsAt":"'"$R7"'"}}}}' > "$STATUS_JSON"
run
check "a failed fetch wakes nobody" "$SENT" ""
print -r -- '{"active":{"number":7,"usageStatus":"ok","usage":{"sevenDay":{"pct":50,"resetsAt":"'"$R7"'"}}}}' > "$STATUS_JSON"
run
contains "an account without a 5-hour window has room" "$SENT" "send-keys -t %1 -l"

print -r -- "tycswap cannot answer"
rm -f "$STATUS_JSON"
: > "$TMUX_LOG"
run
check "exits 0" "$RC" "0"
check "and touches nothing" "$SENT" ""

print -r -- ""
print -r -- "${PASS} passed, ${FAIL} failed"
(( FAIL == 0 ))
