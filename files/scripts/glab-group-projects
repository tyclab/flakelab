#!/usr/bin/env zsh

set -uo pipefail

# List every project in a GitLab group as NDJSON, one object per line, filtering
# left to the caller's jq. Archived and deletion-scheduled projects are included by
# default: report-stale-repos selects exactly those out of this same stream.

GROUP=""
MEMBER=0
NO_ARCHIVED=0
PER_PAGE=100

while (( $# > 0 )); do
  case $1 in
    --group)
      GROUP="$2"; shift ;;
    --member)
      MEMBER=1 ;;
    --no-archived)
      NO_ARCHIVED=1 ;;
    --per-page)
      PER_PAGE="$2"; shift ;;
    --help|-h)
      echo "Usage: flakelab glab-projects --group <path> [--member] [--no-archived] [--per-page N]"
      echo "Emits one project JSON object per line, across all pages."
      echo "  --no-archived  let GitLab drop archived projects (archived=false)"
      exit 0 ;;
    *)
      print -r -- "Unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done

if [[ -z "${GROUP}" ]]; then
  echo "Error: --group is required" >&2
  exit 2
fi
# GitLab caps per_page at 100 and silently returns 100 for anything larger.
if (( PER_PAGE < 1 || PER_PAGE > 100 )); then
  echo "Error: --per-page must be between 1 and 100 (GitLab's maximum)" >&2
  exit 2
fi

# glab's own page walker, so there is no hand-rolled page loop to truncate a group.
# The group path is a path segment, so a subgroup's "/" must be percent-encoded.
typeset GROUP_ENC="${GROUP//\//%2F}"
typeset QUERY="groups/${GROUP_ENC}/projects?include_subgroups=true&per_page=${PER_PAGE}"
if (( MEMBER )); then
  QUERY="${QUERY}&membership=true"
fi
if (( NO_ARCHIVED )); then
  QUERY="${QUERY}&archived=false"
fi

ERR_FILE="$(mktemp)"
# stderr stays a separate file from the payload: glab writes update notices there,
# and merging them into the stream makes valid JSON unparsable.
OUT_FILE="$(mktemp)"
# INT/TERM too: the EXIT trap does not fire on a signal, leaving both files behind.
trap 'rm -f "${ERR_FILE}" "${OUT_FILE}"' EXIT INT TERM

# One stalled request must not abort a whole clone sweep: a timeout, a reset or
# a TLS handshake that never completes gets two more tries, a status error none.
typeset -i attempt=1
while ! glab api --paginate --output ndjson "${QUERY}" > "${OUT_FILE}" 2>"${ERR_FILE}"; do
  if (( attempt >= 3 )) || ! grep -qiE 'timeout|timed out|TLS handshake|connection reset|unexpected EOF|no such host|temporary failure|network is unreachable' "${ERR_FILE}"; then
    print -r -- "Error: glab api groups/${GROUP}/projects failed: $(tr '\n' ' ' < "${ERR_FILE}")" >&2
    exit 1
  fi
  print -r -- "WARNING: glab api groups/${GROUP}/projects: $(tr '\n' ' ' < "${ERR_FILE}" | tr -s ' ')— retrying (${attempt}/3)" >&2
  sleep "${attempt}"
  (( attempt++ ))
done

typeset -i emitted=0
emitted=$(grep -c . < "${OUT_FILE}")
cat "${OUT_FILE}"

# A configured group yielding nothing is usually a wrong path or a permissions gap,
# which the caller cannot tell from an empty group. Still exit 0: one unreachable
# group must not abort the whole clone.
if (( emitted == 0 )); then
  print -r -- "WARNING: ${GROUP} returned 0 projects — check the group path, your membership, and that the group is not empty." >&2
fi
