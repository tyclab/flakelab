  "$(print -r -- "${OUT}" | jq -r '.repos[0].parked[] | select(.name == "wt-dirty") | .action')" "blocked"
check "and names the blocker" \
  "$(print -r -- "${OUT}" | jq -r '.repos[0].parked[] | select(.name == "wt-dirty") | .blocker')" \
