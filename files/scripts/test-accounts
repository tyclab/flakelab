unset FAKE_CURL_DOWN FLAKELAB_NOW

# ---------------------------------------------------------------------------
print -r -- ""
print -r -- "the engine: one rule per fixture"
ENGINE="${SCRIPT_DIR}/lib/accounts-auto.jq"
# engine <jq edits>: the base document (bob active at 5h 90% / 7d 50%,
# alice a candidate at 5h 20% / 7d 60%, carol disabled, a codex entry) with
# the edits applied, through the engine; DEC and EVS hold the results.
BASE_DOC='{"pass": "decide", "tool": "claude", "now": 1000,
 "settings": {"sessionThreshold": 85, "weekThreshold": 97, "modelThreshold": 95, "cooldownS": 300, "hysteresisPct": 10, "unhealthyTicks": 3, "idleHoldS": 1800, "strategy": "soonest-reset", "modelWindows": "all"},
 "roster": {"active": {"claude": 2}, "accounts": {"1": {"tool": "claude"}, "2": {"tool": "claude"}, "3": {"tool": "claude", "disabled": true}, "4": {"tool": "codex"}}},
 "usage": {"entries": {
    "2": {"fetchedAt": 990, "nextPollAt": 1170, "windows": [{"label": "5h", "class": "session", "pct": 90, "resetsAtEpoch": 5000}, {"label": "7d", "class": "week", "pct": 50, "resetsAtEpoch": 90000}]},
    "1": {"fetchedAt": 990, "nextPollAt": 1290, "windows": [{"label": "5h", "class": "session", "pct": 20, "resetsAtEpoch": 4000}, {"label": "7d", "class": "week", "pct": 60, "resetsAtEpoch": 80000}]}},
   "quarantine": {}},
 "state": {"lastSwitchAt": null, "lastSwitchTo": null, "unhealthyTicks": {}, "idleHoldSince": {}},
 "live": {}, "activeTokenExpired": false, "liveUnmanaged": false}'
engine() {
  local doc
  doc="$(print -r -- "$BASE_DOC" | jq "${1:-.}" | jq -L "${SCRIPT_DIR}/lib" -f "${ENGINE}")" || { DEC="engine failed"; EVS=""; STATE=""; return 1 }
  DEC="$(print -r -- "$doc" | jq -c '.decision')"
  EVS="$(print -r -- "$doc" | jq -c '.events')"
  STATE="$(print -r -- "$doc" | jq -c '.state')"
  FETCH="$(print -r -- "$doc" | jq -c '.fetch')"
}
dec() { print -r -- "$DEC" | jq -r "$1" }

engine
check "proactive on the session window" "$(dec '[.action, .trigger, .axis] | join(" ")')" "switch proactive session"
check "with the one qualifying candidate" "$(dec '.candidates | join(",")')" "1"
check "and a poll event first" "$(print -r -- "$EVS" | jq -r '.[0].event')" "poll"
check "a known active entry resets the unhealthy count" "$(print -r -- "$STATE" | jq -r '.unhealthyTicks.claude')" "0"

engine '.usage.entries["2"].windows[0].pct = 84'
check "under every bar: no switch" "$(dec '[.action, .reason] | join(" ")')" "none below-threshold"
check "and the detail names the window closest to its bar" "$(dec '.detail')" "session 84% < 85%"

engine '.settings.sessionThreshold = 100 | .usage.entries["2"].windows[0].pct = 99'
check "a bar at 100 never moves proactively" "$(dec '.reason')" "below-threshold"
engine '.settings.sessionThreshold = 100 | .usage.entries["2"].windows[0].pct = 100'
check "but the actual limit still does" "$(dec '[.action, .trigger] | join(" ")')" "switch at-limit"

engine '.usage.entries["2"].windows[1].pct = 98'
check "the week decides over the session window" "$(dec '.axis')" "week"

engine '.usage.entries["1"].windows[0].pct = 82'
check "hysteresis: a candidate not ten points better is no target" "$(dec '[.action, .reason] | join(" ")')" "blocked no-qualifying-candidate"
engine '.usage.entries["1"].windows[0].pct = 86'
check "landing: a candidate over the bar is no target" "$(dec '.action')" "blocked"
engine '.usage.entries["2"].windows[0].pct = 20 | .usage.entries["2"].windows += [{"label": "Fable", "class": "model", "pct": 96, "resetsAtEpoch": 90000}]'
check "a per-model week over its bar decides" "$(dec '[.trigger, .axis] | join(" ")')" "proactive model"
check "and a candidate whose plan has no such window is no target: it does not serve that model" "$(dec '[.action, .reason] | join(" ")')" "blocked no-qualifying-candidate"
check "the detail names the model" "$(dec '.detail')" "no candidate is under the model bar, better than the active entry by 10 points and with a window for fable, or its usage is unreadable this tick"
engine '.usage.entries["2"].windows[0].pct = 20 | .usage.entries["2"].windows += [{"label": "Fable", "class": "model", "pct": 96, "resetsAtEpoch": 90000}] | .usage.entries["1"].windows += [{"label": "Fable", "class": "model", "pct": 40, "resetsAtEpoch": 80000}]'
check "one with the window, under the bar and ten points better, is" "$(dec '[.action, (.candidates | join(","))] | join(" ")')" "switch 1"
engine '.usage.entries["2"].windows += [{"label": "Fable", "class": "model", "pct": 50, "resetsAtEpoch": 90000}]'
check "on the session axis too, a candidate without the active entry's model window is no proactive target" "$(dec '[.action, .axis, .reason] | join(" ")')" "blocked session no-qualifying-candidate"
engine '.settings.modelWindows = "opus" | .usage.entries["2"].windows += [{"label": "Fable", "class": "model", "pct": 50, "resetsAtEpoch": 90000}]'
check "unless modelWindows does not count that model" "$(dec '[.action, .trigger] | join(" ")')" "switch proactive"
engine '.usage.entries["2"].windows[0].pct = 100 | .usage.entries["2"].windows += [{"label": "Fable", "class": "model", "pct": 50, "resetsAtEpoch": 90000}]'
check "at the limit it still moves: any room beats a wall" "$(dec '[.action, .trigger] | join(" ")')" "switch at-limit"
engine '.usage.entries["2"].windows += [{"label": "Fable", "class": "model", "pct": 100, "resetsAtEpoch": 90000}]'
check "at a model's limit, a candidate without that model's window is no move: it serves the model no better and the rest worse" "$(dec '[.action, .axis, .reason] | join(" ")')" "blocked model no-qualifying-candidate"
check "and the detail says so" "$(dec '.detail')" "no candidate has room on the model axis and with a window for fable, or its usage is unreadable this tick"
engine '.usage.entries["2"].windows += [{"label": "Fable", "class": "model", "pct": 100, "resetsAtEpoch": 90000}] | .usage.entries["1"].windows += [{"label": "Fable", "class": "model", "pct": 40, "resetsAtEpoch": 80000}]'
check "one with the window and room on it is" "$(dec '[.action, .trigger, (.candidates | join(","))] | join(" ")')" "switch at-limit 1"
engine '.usage.entries["2"].windows[0].pct = 20 | .usage.entries["2"].windows += [{"label": "Fable", "class": "model", "pct": 96, "resetsAtEpoch": 90000}] | .usage.entries["1"].windows += [{"label": "Fable", "class": "model", "pct": 90, "resetsAtEpoch": 80000}]'
check "while one with that window under the bar but not ten points better does not" "$(dec '[.action, .reason] | join(" ")')" "blocked no-qualifying-candidate"
engine '.usage.entries["2"].windows[0].pct = 100 | .usage.entries["1"].windows[0].pct = 86'
check "at the limit both gates are off: any room beats a wall" "$(dec '[.trigger, (.candidates | join(","))] | join(" ")')" "at-limit 1"
engine '.usage.entries["2"].windows[0].pct = 100 | .usage.entries["1"].windows[0].pct = 100'
check "at the limit, a candidate at its own limit on that axis is no target: no trading places" "$(dec '.action')" "blocked"
engine '.usage.entries["2"].windows[0].pct = 100 | .usage.entries["1"].windows[1].pct = 100'
check "a spent week is never a target, even from a wall" "$(dec '[.action, .reason] | join(" ")')" "blocked all-exhausted"
check "and the earliest weekly renewal is named" "$(dec '.earliestResetAt')" "80000"

engine '.state.lastSwitchAt = 900'
check "cooldown stops a proactive move" "$(dec '[.action, .reason] | join(" ")')" "none cooldown"
check "and says how long is left" "$(dec '.detail')" "200s left"
engine '.state.lastSwitchAt = 900 | .usage.entries["2"].windows[0].pct = 100'
check "cooldown never stops an at-limit move" "$(dec '.trigger')" "at-limit"

engine '.usage.entries["2"].fetchedAt = 100 | .state.unhealthyTicks.claude = 2'
check "a live entry whose figure is merely stale is no failure: our own schedule aged it" "$(dec '[.action, .reason] | join(" ")')" "none active-usage-unknown"
check "and the count starts over" "$(print -r -- "$STATE" | jq -r '.unhealthyTicks.claude')" "0"
for e in http-429 http-503 http-000 network unparseable bad-response app-server-silent no-scratch 'app-server: boom' drifted; do
  engine '.usage.entries["2"].fetchedAt = 100 | .usage.entries["2"].lastError = "'"$e"'" | .state.unhealthyTicks.claude = 2'
  check "a failing usage read (${e}) is no failure of the login either" "$(dec '.action')" "none"
done
engine '.usage.entries["2"].fetchedAt = 100 | .usage.entries["2"].lastError = "unauthorized"'
check "a read that says the login is dead counts toward failover" "$(dec '[.reason, .detail] | join(" ")')" "active-usage-unknown 1/3 before failover: the live login's reads fail with unauthorized"
check "and the count is persisted" "$(print -r -- "$STATE" | jq -r '.unhealthyTicks.claude')" "1"
for e in http-401 http-403 invalid_grant no-credentials no-access-token refresh-failed seat-revoked expired no-profile; do
  engine '.usage.entries["2"].fetchedAt = 100 | .usage.entries["2"].lastError = "'"$e"'" | .state.unhealthyTicks.claude = 2'
  check "the third such tick (${e}) is a failover" "$(dec '[.action, .trigger] | join(" ")')" "switch failover"
done
engine '.usage.entries["2"].fetchedAt = 100 | .activeTokenExpired = true'
check "an expired token with no session is an idle hold, not a failure" "$(dec '.reason')" "active-idle"
check "the hold is timestamped" "$(print -r -- "$STATE" | jq -r '.idleHoldSince.claude')" "1000"
engine '.usage.entries["2"].fetchedAt = 100 | .usage.entries["2"].lastError = "expired" | .activeTokenExpired = true | .state.idleHoldSince.claude = -1000'
check "a hold older than thirty minutes resumes the count" "$(dec '[.reason, (.detail | test("1/3"))] | join(" ")')" "active-usage-unknown true"

engine '.roster.accounts["1"].disabled = true'
check "with every other entry disabled: no candidates" "$(dec '[.action, .reason] | join(" ")')" "blocked no-candidates"
engine '.usage.quarantine["1"] = {"reason": "invalid_grant"}'
check "a quarantined entry is no candidate" "$(dec '.reason')" "no-candidates"
engine '.live["1"] = true'
check "an entry with a live profile session is no candidate" "$(dec '.reason')" "no-candidates"
engine '.usage.entries["1"].fetchedAt = 100'
check "a candidate with stale usage cannot be compared" "$(dec '[.action, .reason] | join(" ")')" "blocked no-comparison"

engine '.roster.active.claude = null'
check "no active entry: nothing to do, with the hint" "$(dec '[.reason, .detail] | join(" ")')" "no-active run: flakelab accounts add claude"
engine '.roster.active.claude = null | .liveUnmanaged = true'
check "an unmanaged live login is named as such" "$(dec '.reason')" "unmanaged-active"

# Order: three candidates, carol enabled with an earlier weekly reset and
# less headroom, dave over the session bar with the earliest reset of all.
ORDER='.roster.accounts["3"].disabled = false | .roster.accounts["5"] = {"tool": "claude"}
  | .usage.entries["3"] = {"fetchedAt": 990, "windows": [{"label": "5h", "class": "session", "pct": 30, "resetsAtEpoch": 4500}, {"label": "7d", "class": "week", "pct": 70, "resetsAtEpoch": 70000}]}
  | .usage.entries["5"] = {"fetchedAt": 990, "windows": [{"label": "5h", "class": "session", "pct": 86, "resetsAtEpoch": 4600}, {"label": "7d", "class": "week", "pct": 10, "resetsAtEpoch": 60000}]}
  | .usage.entries["2"].windows[0].pct = 100'
engine "$ORDER"
check "soonest-reset orders by the earliest weekly renewal, an entry over a bar last" "$(dec '.candidates | join(",")')" "3,1,5"
engine "$ORDER | .settings.strategy = \"best\""
check "best orders by weekly headroom" "$(dec '.candidates | join(",")')" "5,1,3"

# Model windows count only when named.
MODEL='.usage.entries["2"].windows += [{"label": "Fable", "class": "model", "pct": 96, "resetsAtEpoch": 85000}] | .usage.entries["2"].windows[0].pct = 50'
engine "$MODEL"
check "a per-model week over its bar decides" "$(dec '[.trigger, .axis] | join(" ")')" "proactive model"
engine "$MODEL | .settings.modelWindows = \"Opus\""
check "a model window not named does not count" "$(dec '.reason')" "below-threshold"

# The plan pass.
engine '.pass = "plan" | .now = 1200'
check "near a bar, the due active entry; a candidate known within five minutes is not asked again" "$(print -r -- "$FETCH" | jq -c .)" "[2]"
engine '.pass = "plan" | .now = 1300'
check "near a bar, a candidate whose figure went stale is fetched with the active entry" "$(print -r -- "$FETCH" | jq -c .)" "[2,1]"
engine '.pass = "plan" | .usage.entries["1"].fetchedAt = 600'
check "near a bar but the active entry not yet due: the stale candidates alone" "$(print -r -- "$FETCH" | jq -c .)" "[1]"
engine '.pass = "plan" | .usage.entries["1"].fetchedAt = 600 | .usage.entries["1"].backoffUntil = 1500'
check "a candidate in backoff is never in the plan, escalation or not" "$(print -r -- "$FETCH" | jq -c .)" "[]"
engine '.pass = "plan" | .usage.entries["2"].windows[0].pct = 50 | .now = 1100'
check "far from every bar, only the due active entry" "$(print -r -- "$FETCH" | jq -c .)" "[]"
engine '.pass = "plan" | .usage.entries["2"].windows[0].pct = 50 | .now = 1300'
check "and one due candidate" "$(print -r -- "$FETCH" | jq -c .)" "[2,1]"
engine '.pass = "plan" | .usage.entries["2"].fetchedAt = 100 | .usage.entries["1"].fetchedAt = 100 | .now = 1100'
check "an unknown active entry is read at once, not at its planned turn, and escalates to every stale candidate" "$(print -r -- "$FETCH" | jq -c .)" "[2,1]"
engine '.pass = "plan" | .usage.entries["2"].fetchedAt = 100 | .usage.entries["2"].backoffUntil = 5000 | .usage.entries["1"].fetchedAt = 100 | .now = 1100'
check "unless it is in backoff" "$(print -r -- "$FETCH" | jq -c .)" "[1]"

