# ---------------------------------------------------------------------------
print -r -- ""
print -r -- "the Kiro adapter: rows in a SQLite store, swapped in one transaction"
KIRO_DB="${HOME}/.local/share/kiro-cli/data.sqlite3"
kiro_tables() {
  mkdir -p "${KIRO_DB:h}"
  sqlite3 "${KIRO_DB}" "CREATE TABLE IF NOT EXISTS auth_kv (key TEXT PRIMARY KEY, value TEXT NOT NULL); CREATE TABLE IF NOT EXISTS state (key TEXT PRIMARY KEY, value TEXT NOT NULL); INSERT OR REPLACE INTO state VALUES ('other.key', '\"kept\"');"
}
# kiro_login <start url> <region> <access token> <refresh token> [<expires_at>] [<row key>]
kiro_login() {
  local start="$1" region="$2" tok="$3" rt="$4" exp="${5:-2030-01-01T00:00:00Z}" key="${6:-kirocli:odic:token}" json
  kiro_tables
  json="{\"access_token\": \"${tok}\", \"expires_at\": \"${exp}\", \"refresh_token\": \"${rt}\", \"region\": \"${region}\"${start:+, \"start_url\": \"${start}\"}, \"oauth_flow\": \"DeviceCode\", \"scopes\": [\"codewhisperer:completions\"]}"
  sqlite3 "${KIRO_DB}" "DELETE FROM auth_kv WHERE key LIKE 'kirocli:%:token';
INSERT OR REPLACE INTO auth_kv VALUES ('${key}', '${json}');
INSERT OR REPLACE INTO auth_kv VALUES ('kirocli:odic:device-registration', '{\"client_id\": \"c-${region}\", \"client_secret\": \"s\"}');
INSERT OR REPLACE INTO state VALUES ('api.codewhisperer.profile', '{\"arn\": \"arn:aws:codewhisperer:${region}:123:profile/p-${rt#rt-}\", \"profileName\": \"p\"}');
INSERT OR REPLACE INTO state VALUES ('auth.idc.start-url', '\"${start}\"');
INSERT OR REPLACE INTO state VALUES ('auth.idc.region', '\"${region}\"');"
}
kiro_live_refresh() { sqlite3 "${KIRO_DB}" "SELECT value FROM auth_kv WHERE key LIKE 'kirocli:%:token'" | jq -r '.refresh_token' }
kiro_live_arn()     { sqlite3 "${KIRO_DB}" "SELECT value FROM state WHERE key = 'api.codewhisperer.profile'" | jq -r '.arn' }
# The kiro-cli stand-in: whoami prints FAKE_KIRO_WHOAMI and a plain trailer,
# exit FAKE_KIRO_WHOAMI_RC; anything else prints the environment it ran with.
cat > "${STUBS}/kiro-cli" <<'STUB'
#!/usr/bin/env zsh
# `login` copies the store FAKE_KIRO_LOGIN names into the data dir of the
# environment it runs in, as the device flow would; empty, it was abandoned.
if [[ "$1" == login ]]; then
  print -r -- "kiro-cli login: KIRO_HOME=${KIRO_HOME-unset} XDG_DATA_HOME=${XDG_DATA_HOME-unset} KIRO_API_KEY=${KIRO_API_KEY-unset} args=${*:2}" >> "${FAKE_LOGIN_LOG}"
  [[ -n "${FAKE_KIRO_LOGIN:-}" ]] || exit 1
  mkdir -p "${XDG_DATA_HOME:-${HOME}/.local/share}/kiro-cli" && cp "${FAKE_KIRO_LOGIN}" "${XDG_DATA_HOME:-${HOME}/.local/share}/kiro-cli/data.sqlite3" && exit 0
  exit 1
fi
if [[ "$1" == whoami ]]; then
  print -r -- "${FAKE_KIRO_WHOAMI:-{\}}"
  print -r -- "Profile: p (arn:...)"
  exit "${FAKE_KIRO_WHOAMI_RC:-0}"
fi
print -r -- "kiro-cli ran: KIRO_HOME=${KIRO_HOME-unset} XDG_DATA_HOME=${XDG_DATA_HOME-unset} KIRO_API_KEY=${KIRO_API_KEY-unset} args=$*"
STUB
chmod +x "${STUBS}/kiro-cli"

run add kiro
check "add kiro without a store exits 2" "${RC}" "2"
kiro_tables
KIRO_API_KEY=k-1 run add kiro
check "an API-key login with no token row is refused" "${RC}" "2"
contains "with the shell-variable hint" "${ERR}" "API key"
kiro_login https://view.awsapps.com/start us-east-1 acc-f rt-f
export FAKE_KIRO_WHOAMI='{"accountType": "BuilderId", "email": "frank@example.com", "region": "us-east-1"}'
run add kiro --alias frank
check "add kiro exits 0" "${RC}" "0"
check "the entry carries whoami's email and account type" "${OUT}" "Added kiro 6: frank@example.com [BuilderId] as frank"
check "the roster id is the start URL and the region (the email is the label: whoami is not there offline)" "$(jq -r '.accounts["6"].id' "${STORE}/accounts.json")" "https://view.awsapps.com/start|us-east-1"
check "the store holds the rows as JSON, private" "$(stat -c %a "${STORE}/6/token.json") $(jq -r '[(.auth_kv | keys | join(",")), (.state | keys | join(","))] | join(" / ")' "${STORE}/6/token.json")" "600 kirocli:odic:device-registration,kirocli:odic:token / api.codewhisperer.profile,auth.idc.region,auth.idc.start-url"
check "values are the stored text, verbatim" "$(jq -r '.state["auth.idc.region"]' "${STORE}/6/token.json")" '"us-east-1"'
kiro_login https://corp.awsapps.com/start eu-central-1 acc-g rt-g
export FAKE_KIRO_WHOAMI='{"accountType": "IamIdentityCenter", "email": "grace@example.com"}'
run add kiro --alias grace
check "a second kiro login is a second entry, active" "${OUT} $(jq -r '.active.kiro' "${STORE}/accounts.json")" "Added kiro 7: grace@example.com [IamIdentityCenter] as grace 7"
