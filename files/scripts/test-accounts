FAKE_KIRO_RUNNING=800 run switch grace --force
check "--force switches past the running session" "${RC}" "0"
contains "and prints the resume line for the locked session" "${OUT}" "kiro-cli chat --resume-id ${SID_KK}"
check "the token row is grace's" "$(kiro_live_refresh)" "rt-g"
FLAKELAB_ACCOUNTS_FAIL_AT=credentials run switch frank
check "a failed transaction exits 1" "${RC}" "1"
check "and the rows are as they were" "$(kiro_live_refresh) $(kiro_live_arn)" "rt-g arn:aws:codewhisperer:eu-central-1:123:profile/p-g"

