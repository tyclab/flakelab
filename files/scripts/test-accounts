#!/usr/bin/env zsh

set -uo pipefail

# Offline suite for accounts (files/scripts/accounts) and its Claude Code
# adapter (files/scripts/lib/accounts-claude.zsh): a fake HOME holding the
# files Claude Code keeps its login in, a pgrep stub for the running-session
# count, and the two seams the script exposes for the cases that cannot be
# staged with files alone (a short lock timeout, a forced write failure). No
# real claude, no network.
#
# Usage: files/scripts/test-accounts

SCRIPT_DIR="${0:A:h}"
CMD="${SCRIPT_DIR}/accounts"
typeset -i PASS=0 FAIL=0

ok()       { print -r -- "  ok   $1"; (( PASS++ )); return 0 }
bad()      { print -r -u2 -- "  FAIL $1"; (( FAIL++ )); return 0 }
check()    { [[ "$2" == "$3" ]] && ok "$1" || { bad "$1"; print -r -u2 -- "       expected: $3"; print -r -u2 -- "       actual:   $2" } }
contains() { [[ "$2" == *"$3"* ]] && ok "$1" || { bad "$1"; print -r -u2 -- "       missing: $3"; print -r -u2 -- "       in: $2" } }
excludes() { [[ "$2" != *"$3"* ]] && ok "$1" || bad "$1 (unexpected: $3)" }

BASE="$(mktemp -d)"
trap 'rm -rf "${BASE}"' EXIT
export HOME="${BASE}/home"
mkdir -p "${HOME}/.claude"
STORE="${HOME}/.local/state/flakelab/accounts"
unset FLAKELAB_ACCOUNTS_ROOT CLAUDE_CONFIG_DIR FLAKELAB_ACCOUNTS_FAIL_AT FLAKELAB_ACCOUNTS_LOCK_TIMEOUT

STUBS="${BASE}/bin"
mkdir -p "${STUBS}"
cat > "${STUBS}/pgrep" <<'STUB'
#!/usr/bin/env zsh
[[ "$1" == -x ]] || exit 1
case "$2" in
  claude) [[ -n "${FAKE_CLAUDE_RUNNING:-}" ]] || exit 1; print -l 100 200 ;;
  codex)  [[ -n "${FAKE_CODEX_RUNNING:-}" ]] || exit 1; print -l ${(s:,:)FAKE_CODEX_RUNNING} ;;
  *) exit 1 ;;
esac
STUB
# curl stand-in: answers the token and usage URLs from canned files under
# FAKE_CURL, records every request (URL, the bearer, the body), writes the
# response body and headers where -o and -D point, prints the status like
# -w '%{http_code}' would. The usage answer is picked by the bearer token so
# each entry gets its own figures: usage.<token>.json / .status / .headers.
cat > "${STUBS}/curl" <<'STUB'
#!/usr/bin/env zsh
typeset out="" hdr="" url="" data="" auth=""
while (( $# > 0 )); do
  case $1 in
    -o) out="$2"; shift ;;
    -D) hdr="$2"; shift ;;
    -w|-m|-X) shift ;;
    -d) data="$2"; shift ;;
    -H) [[ "$2" == Authorization:* ]] && auth="${2#Authorization: Bearer }"; shift ;;
    -sS) ;;
    *) url="$1" ;;
  esac
  shift
done
print -r -- "${url} ${auth} ${data}" >> "${FAKE_CURL}/requests.log"
[[ -n "${FAKE_CURL_DOWN:-}" ]] && exit 7
if [[ "$url" == */oauth/token ]]; then
  key="token"
else
  key="usage.${auth}"
  [[ -f "${FAKE_CURL}/${key}.status" ]] || key="usage"
fi
[[ -n "$out" ]] && cat "${FAKE_CURL}/${key}.json" > "$out" 2>/dev/null
[[ -n "$hdr" ]] && { cat "${FAKE_CURL}/${key}.headers" > "$hdr" 2>/dev/null || : > "$hdr" }
cat "${FAKE_CURL}/${key}.status" 2>/dev/null || print -n 200
STUB
export FAKE_CURL="${BASE}/curl"
mkdir -p "${FAKE_CURL}"
chmod +x "${STUBS}"/*
export PATH="${STUBS}:${PATH}"
export FLAKELAB_ACCOUNTS_NO_JITTER=1

# Claude Code's files for a login: the identity block beside keys the switch
# must leave alone, and the OAuth blob.
login() {
  local email="$1" uuid="$2" org="$3" token="$4"
  cat > "${HOME}/.claude.json" <<EOF
{
  "oauthAccount": {"emailAddress": "${email}", "accountUuid": "${uuid}", "organizationUuid": "org-${uuid}", "organizationName": "${org}"},
  "projects": {"/work": {"allowedTools": ["Bash"]}},
  "mcpServers": {"grafana": {"command": "x"}},
  "theme": "dark",
  "numStartups": 7
}
EOF
  print -r -- "{\"claudeAiOauth\": {\"accessToken\": \"${token}\", \"refreshToken\": \"rt-${token}\", \"expiresAt\": 1900000000000, \"scopes\": [\"user:inference\"]}}" > "${HOME}/.claude/.credentials.json"
  chmod 600 "${HOME}/.claude/.credentials.json"
}
live_token() { jq -r '.claudeAiOauth.accessToken' "${HOME}/.claude/.credentials.json" }
live_email() { jq -r '.oauthAccount.emailAddress' "${HOME}/.claude.json" }
active_id()  { jq -r '.active.claude' "${STORE}/accounts.json" }

run() { OUT="$("${CMD}" "$@" 2>"${BASE}/err" </dev/null)"; RC=$?; ERR="$(<"${BASE}/err")"; }
typeset -i RC=0
OUT=""
ERR=""

UUID_A=aaaaaaaa-0000-0000-0000-000000000001
UUID_B=bbbbbbbb-0000-0000-0000-000000000002
UUID_C=cccccccc-0000-0000-0000-000000000003

# ---------------------------------------------------------------------------
print -r -- "an empty store"
run
check "the bare listing exits 0" "${RC}" "0"
contains "an empty roster says where to start" "${ERR}" "flakelab accounts add <tool>"
run add
check "add without a tool exits 2" "${RC}" "2"
run add gemini
check "add with an unknown tool exits 2" "${RC}" "2"
run add kiro
check "add for a tool without an adapter exits 2" "${RC}" "2"
contains "and names the adapters present" "${ERR}" "present: claude, codex"
run add claude
check "add with no login exits 2" "${RC}" "2"
contains "and says to log in first" "${ERR}" "log in with the tool first"

# ---------------------------------------------------------------------------
print -r -- ""
print -r -- "add: the live login into the store"
login alice@example.com "${UUID_A}" personal tok-a1
run add claude --alias home
check "add exits 0" "${RC}" "0"
check "add reports the entry" "${OUT}" "Added claude 1: alice@example.com [personal] as home"
contains "add says the store is not yet in the backup" "${ERR}" "Not yet carried by flakelab backup"
check "the store is private" "$(stat -c %a "${STORE}")" "700"
check "the entry directory is private" "$(stat -c %a "${STORE}/1")" "700"
check "the stored credential is 0600" "$(stat -c %a "${STORE}/1/credentials.json")" "600"
check "the stored credential is the live one, verbatim" "$(jq -r '.claudeAiOauth.refreshToken' "${STORE}/1/credentials.json")" "rt-tok-a1"
check "the identity carries the theme for a later profile" "$(jq -r '.theme' "${STORE}/1/identity.json")" "dark"
check "the entry is active" "$(active_id)" "1"
check "the roster records the account id" "$(jq -r '.accounts["1"].id' "${STORE}/accounts.json")" "${UUID_A}"

# The same login again: refreshed in place, the id kept, the token updated.
login alice@example.com "${UUID_A}" personal tok-a2
run add claude
check "adding a stored login exits 0" "${RC}" "0"
check "and refreshes it in place" "${OUT}" "Refreshed claude 1: alice@example.com [personal]"
check "the stored credential moved to the new generation" "$(live_token)" "$(jq -r '.claudeAiOauth.accessToken' "${STORE}/1/credentials.json")"
check "next is untouched by a refresh" "$(jq -r '.next' "${STORE}/accounts.json")" "2"

# An API-key login is a different auth axis.
jq '.primaryApiKey = "sk-ant-api03-xyz"' "${HOME}/.claude.json" > "${BASE}/t" && mv "${BASE}/t" "${HOME}/.claude.json"
run add claude
check "an API-key login is refused" "${RC}" "2"
contains "and pointed at the shell variable" "${ERR}" "different auth axis"

# A second account, logged in by hand.
login bob@example.com "${UUID_B}" "Example GmbH" tok-b1
run add claude --alias work
check "a second login gets the next id" "${OUT}" "Added claude 2: bob@example.com [Example GmbH] as work"
check "and becomes active" "$(active_id)" "2"
run add claude --alias home
check "a taken alias is refused" "${RC}" "2"
run add claude --alias 42
check "an all-digit alias is refused" "${RC}" "2"

# ---------------------------------------------------------------------------
print -r -- ""
print -r -- "the listing"
run
check "the listing exits 0" "${RC}" "0"
row() { printf '%-7s %-4s %-12s %-32s %-16s %s' "$@" }
contains "the header" "${OUT}" "$(row TOOL ID ALIAS LABEL STATE USAGE)"
contains "entry 1, never fetched" "${OUT}" "$(row claude 1 home alice@example.com '' -)"
contains "entry 2 is active" "${OUT}" "$(row claude 2 work bob@example.com active -)"
run --json
check "--json exits 0" "${RC}" "0"
check "--json lists both entries" "$(print -r -- "$OUT" | jq '.accounts | length')" "2"
check "--json carries the active map" "$(print -r -- "$OUT" | jq -r '.active.claude')" "2"
check "--json entries carry their roster id" "$(print -r -- "$OUT" | jq -r '.accounts[0].id')" "1"
check "--json entries carry the tool's account id" "$(print -r -- "$OUT" | jq -r '.accounts[0].account')" "${UUID_A}"

# ---------------------------------------------------------------------------
print -r -- ""
print -r -- "switch: the transaction"
# Bob's token rotated while live: the switch must carry it into entry 2.
login bob@example.com "${UUID_B}" "Example GmbH" tok-b2
run switch home
check "switch by alias exits 0" "${RC}" "0"
check "switch reports the entry" "${OUT}" "Switched claude to 1 (home) alice@example.com"
check "the live credential is alice's" "$(live_token)" "tok-a2"
check "the live identity is alice's" "$(live_email)" "alice@example.com"
check "every other key of ~/.claude.json survives" "$(jq -c '[.projects, .mcpServers, .numStartups]' "${HOME}/.claude.json")" '[{"/work":{"allowedTools":["Bash"]}},{"grafana":{"command":"x"}},7]'
check "the live config is 0600" "$(stat -c %a "${HOME}/.claude.json")" "600"
check "the outgoing login's rotated token landed in its entry" "$(jq -r '.claudeAiOauth.accessToken' "${STORE}/2/credentials.json")" "tok-b2"
check "the roster's active moved" "$(active_id)" "1"
check "no lock directory is left behind" "$(ls -d "${HOME}"/.claude.lock "${HOME}"/.claude.json.lock 2>/dev/null | wc -l | tr -d ' ')" "0"
excludes "no running session, no restart line" "${OUT}" "running claude session"

FAKE_CLAUDE_RUNNING=1 run switch 2
check "switch by id exits 0" "${RC}" "0"
contains "running sessions are told they follow on their next message" "${OUT}" "2 running claude session(s) continue on the new account with their next message"
check "the live credential is bob's" "$(live_token)" "tok-b2"

before="$(stat -c %Y "${HOME}/.claude/.credentials.json")"
run switch work
check "switching to the active entry exits 0" "${RC}" "0"
check "and says so" "${OUT}" "Already on claude 2 (work) bob@example.com"
check "without touching the live credential" "$(stat -c %Y "${HOME}/.claude/.credentials.json")" "${before}"

run switch bob@example.com
check "switch by label exits 0 (already active)" "${RC}" "0"
run switch nobody
check "an unknown entry exits 1" "${RC}" "1"
run switch 1 2
check "two entries exit 2" "${RC}" "2"
run switch
check "no entry exits 2" "${RC}" "2"

# ---------------------------------------------------------------------------
print -r -- ""
print -r -- "switch --next: rotation in id order, disabled entries skipped"
run switch --next claude
check "--next exits 0" "${RC}" "0"
check "--next from 2 wraps to 1" "$(active_id)" "1"
run disable work
check "disable exits 0" "${RC}" "0"
contains "disable says it is still switchable by hand" "${OUT}" "still switchable by hand"
run switch --next claude
check "--next skips the disabled entry and stays on 1" "$(active_id)" "1"
contains "as a no-op" "${OUT}" "Already on claude 1"
run switch work
check "a disabled entry is still switchable by hand" "$(active_id)" "2"
run enable work
check "enable exits 0" "${RC}" "0"
run switch --next gemini
check "--next with an unknown tool exits 2" "${RC}" "2"

# ---------------------------------------------------------------------------
print -r -- ""
print -r -- "an unattributed live login is stashed, never lost"
login carol@example.com "${UUID_C}" personal tok-c1
run switch home
check "switch away from an unknown login exits 0" "${RC}" "0"
contains "and warns" "${ERR}" "the live claude login (carol@example.com) is in no entry; copied to ${STORE}/unclaimed/"
check "the stash holds carol's credential" "$(jq -r '.claudeAiOauth.accessToken' "${STORE}"/unclaimed/*-claude-${UUID_C}/credentials.json)" "tok-c1"
check "the stash is private" "$(stat -c %a "${STORE}"/unclaimed/*-claude-${UUID_C})" "700"
check "the live login is alice's" "$(live_email)" "alice@example.com"

# ---------------------------------------------------------------------------
print -r -- ""
print -r -- "Claude Code's lock: a held lock refuses, a stale one is taken over"
mkdir -p "${HOME}/.claude.lock"
FLAKELAB_ACCOUNTS_LOCK_TIMEOUT=1 run switch work
check "a fresh lock held by someone else refuses with exit 2" "${RC}" "2"
contains "and says why" "${ERR}" "refreshing its credentials"
check "nothing changed" "$(live_email)" "alice@example.com"
check "the roster did not move" "$(active_id)" "1"
[[ -d "${HOME}/.claude.lock" ]] && ok "the held lock is left alone" || bad "the held lock was removed"
touch -d '1 minute ago' "${HOME}/.claude.lock"
FLAKELAB_ACCOUNTS_LOCK_TIMEOUT=2 run switch work
check "a stale lock is taken over and the switch runs" "${RC}" "0"
check "the live login is bob's" "$(live_email)" "bob@example.com"
check "the taken-over lock is released" "$(ls -d "${HOME}"/.claude.lock 2>/dev/null | wc -l | tr -d ' ')" "0"

# ---------------------------------------------------------------------------
print -r -- ""
print -r -- "a failed write rolls the live login back"
FLAKELAB_ACCOUNTS_FAIL_AT=config run switch home
check "a failure after the credential write exits 1" "${RC}" "1"
contains "and says the previous login was restored" "${ERR}" "the previous login was restored"
check "the live credential is bob's again" "$(live_token)" "tok-b2"
check "the live identity is bob's again" "$(live_email)" "bob@example.com"
check "the roster still says 2" "$(active_id)" "2"
check "no temp file is left in ~/.claude" "$(ls "${HOME}/.claude" | grep -c flakelab-tmp)" "0"
check "no lock directory is left behind" "$(ls -d "${HOME}"/.claude.lock "${HOME}"/.claude.json.lock 2>/dev/null | wc -l | tr -d ' ')" "0"

# ---------------------------------------------------------------------------
print -r -- ""
print -r -- "alias"
run alias 1 --unset
check "alias --unset exits 0" "${RC}" "0"
check "the alias is gone" "$(jq -r '.accounts["1"].alias // "none"' "${STORE}/accounts.json")" "none"
run alias 1 home-2
check "alias exits 0" "${RC}" "0"
check "alias reports the name" "${OUT}" "Entry 1 is now 'home-2'"
run alias 1 work
check "a taken alias is refused" "${RC}" "2"
run alias 1 "bad name"
check "an alias with a space is refused" "${RC}" "2"
run alias home-2 --unset
run alias 1 home
check "an alias resolves an entry after a rename" "${RC}" "0"

# ---------------------------------------------------------------------------
print -r -- ""
print -r -- "status"
run status
check "status exits 0" "${RC}" "0"
check "status names the active entry" "$(print -r -- "$OUT" | head -1)" "claude: 2 (work) bob@example.com [Example GmbH]"
contains "and each other adapter's state" "${OUT}" "codex: no active entry"
run status --json
check "status --json says the live login matches" "$(print -r -- "$OUT" | jq -r '.claude.matches')" "true"
check "status --json names the active entry" "$(print -r -- "$OUT" | jq -r '.claude.active.alias')" "work"
check "status --json has an empty windows list in this phase" "$(print -r -- "$OUT" | jq -c '.claude.windows')" "[]"
login dave@example.com dddddddd-0000-0000-0000-000000000004 personal tok-d1
run status
contains "a login by hand is reported as drift" "${OUT}" "is recorded active, but the live login is dave@example.com"
contains "with the repair" "${OUT}" "flakelab accounts add claude"
run status --json
check "status --json says the live login does not match" "$(print -r -- "$OUT" | jq -r '.claude.matches')" "false"
login bob@example.com "${UUID_B}" "Example GmbH" tok-b2

# ---------------------------------------------------------------------------
print -r -- ""
print -r -- "remove"
run remove work
check "remove without --yes and without a terminal exits 2" "${RC}" "2"
[[ -d "${STORE}/2" ]] && ok "and removes nothing" || bad "the entry was removed without --yes"
run remove work --yes
check "remove --yes exits 0" "${RC}" "0"
check "remove reports the entry" "${OUT}" "Removed 2 (work) bob@example.com"
[[ -d "${STORE}/2" ]] && bad "the stored login is still there" || ok "the stored login is gone"
check "the active pointer is cleared" "$(jq -r '.active.claude' "${STORE}/accounts.json")" "null"
contains "and the caller is told the live login is now unlisted" "${ERR}" "no longer in the roster"
check "next is never reused" "$(jq -r '.next' "${STORE}/accounts.json")" "3"
run add claude
check "adding the live login again takes a fresh id" "${OUT}" "Added claude 3: bob@example.com [Example GmbH]"

# ---------------------------------------------------------------------------
print -r -- ""
print -r -- "guards"
CLAUDE_CONFIG_DIR="${BASE}/profile" run switch 1
contains "a pinned shell is told the default login is what moves" "${ERR}" "CLAUDE_CONFIG_DIR is set in this shell"
check "and the switch still runs on the default login" "$(live_email)" "alice@example.com"
print -r -- '{"version": 2}' > "${STORE}/accounts.json"
run
check "a roster of another version is refused" "${RC}" "2"
contains "and named" "${ERR}" "version 1 expected"
print -r -- 'not json' > "${STORE}/accounts.json"
run switch 1
check "a corrupt roster refuses rather than reading as empty" "${RC}" "2"
run --help
check "--help exits 0" "${RC}" "0"
run bogus
check "an unknown verb exits 2" "${RC}" "2"

# ---------------------------------------------------------------------------
print -r -- ""
print -r -- "usage: fetch, the cache, the poll plan"
# A fresh store: alice (1, home) and bob (2, work), bob live.
rm -rf "${STORE}"
login alice@example.com "${UUID_A}" personal tok-a
run add claude --alias home
login bob@example.com "${UUID_B}" "Example GmbH" tok-b
run add claude --alias work
export FLAKELAB_NOW=1758700000
usage_answer() {
  # usage_answer <token> <5h pct> <7d pct> [<model pct>] [<status>]
  local tok="$1" five="$2" seven="$3" model="${4:-}" code="${5:-200}" mentry=""
  [[ -n "$model" ]] && mentry="{\"kind\": \"weekly_scoped\", \"group\": \"weekly\", \"percent\": ${model}, \"resets_at\": \"2026-09-26T00:00:00Z\", \"scope\": {\"model\": {\"id\": null, \"display_name\": \"Fable\"}, \"surface\": null}},"
  cat > "${FAKE_CURL}/usage.${tok}.json" <<USAGEJSON
{"five_hour": {"utilization": ${five}, "resets_at": "2026-09-24T09:00:00.123456Z"},
 "seven_day": {"utilization": ${seven}, "resets_at": "2026-09-27T12:00:00Z"},
 "extra_usage": {"is_enabled": false},
 "limits": [{"kind": "session", "group": "session", "percent": ${five}, "scope": null},
            ${mentry}
            {"kind": "weekly_all", "group": "weekly", "percent": ${seven}, "scope": null}]}
USAGEJSON
  print -n -- "${code}" > "${FAKE_CURL}/usage.${tok}.status"
  : > "${FAKE_CURL}/usage.${tok}.headers"
}
usage_answer tok-a 62 91 40
usage_answer tok-b 10 20
: > "${FAKE_CURL}/requests.log"
run --fetch
check "--fetch exits 0" "${RC}" "0"
contains "--fetch reports the count" "${ERR}" "fetched 2 entries"
check "both entries were asked, the active one first" "$(cut -d' ' -f2 "${FAKE_CURL}/requests.log" | tr '\n' ' ')" "tok-b tok-a "
check "only the usage URL was called" "$(grep -c 'oauth/usage' "${FAKE_CURL}/requests.log")" "2"
check "the active entry's token is the live one" "$(head -1 "${FAKE_CURL}/requests.log" | cut -d' ' -f2)" "tok-b"
contains "the listing shows alice's windows" "${OUT}" "5h 62% · 7d 91% · Fable 40% (0s)"
contains "the listing shows bob's windows" "${OUT}" "5h 10% · 7d 20% (0s)"
check "the cache holds the windows with epoch resets" "$(jq -r '.entries["1"].windows[] | select(.label == "7d") | .resetsAtEpoch' "${STORE}/usage.json")" "$(date -u -d 2026-09-27T12:00:00Z +%s)"
check "a fractional reset stamp still parses" "$(jq -r '.entries["1"].windows[] | select(.label == "5h") | .resetsAtEpoch' "${STORE}/usage.json")" "$(date -u -d 2026-09-24T09:00:00Z +%s)"
check "the cache is 0600" "$(stat -c %a "${STORE}/usage.json")" "600"
check "a first fetch plans the active entry 3 minutes out" "$(jq -r '.entries["2"].intervalS' "${STORE}/usage.json")" "180"
check "and a candidate 5 minutes out" "$(jq -r '.entries["1"].intervalS' "${STORE}/usage.json")" "300"
check "the next poll is now plus the interval" "$(jq -r '.entries["2"].nextPollAt' "${STORE}/usage.json")" "$(( FLAKELAB_NOW + 180 ))"

run --json
check "--json carries the windows" "$(print -r -- "$OUT" | jq -r '.accounts[0].usage.windows | length')" "3"
check "--json carries the headroom by axis" "$(print -r -- "$OUT" | jq -c '.accounts[0].headroom | {session, week, model, weekly, binding, known}')" '{"session":38,"week":9,"model":60,"weekly":9,"binding":9,"known":true}'
run status --json
check "status --json carries the active entry's windows" "$(print -r -- "$OUT" | jq -r '.claude.windows | length')" "2"
check "status --json carries when they were fetched" "$(print -r -- "$OUT" | jq -r '.claude.fetchedAt')" "${FLAKELAB_NOW}"

# Not due: nothing is fetched again a minute later.
: > "${FAKE_CURL}/requests.log"
export FLAKELAB_NOW=$(( 1758700000 + 60 ))
run --fetch
check "an entry inside its plan is not fetched" "$(wc -l < "${FAKE_CURL}/requests.log" | tr -d ' ')" "0"
contains "the listing ages the figure" "${OUT}" "5h 10% · 7d 20% (1m)"
# Due, unmoved: the interval stretches by half toward the ceiling.
export FLAKELAB_NOW=$(( 1758700000 + 181 ))
run --fetch
check "the due active entry is fetched" "$(wc -l < "${FAKE_CURL}/requests.log" | tr -d ' ')" "1"
check "unmoved, the interval stretches" "$(jq -r '.entries["2"].intervalS' "${STORE}/usage.json")" "270"
# Moved a lot and close to the bar: urgent.
usage_answer tok-b 75 20
export FLAKELAB_NOW=$(( 1758700000 + 181 + 270 ))
run --fetch
check "moving into the escalation band, the active entry goes urgent" "$(jq -r '.entries["2"].intervalS' "${STORE}/usage.json")" "60"
# At its limit: parked at the reset that frees it.
usage_answer tok-b 100 20
export FLAKELAB_NOW=$(( 1758700000 + 181 + 270 + 60 ))
run --fetch
check "at the limit, the next poll is the reset that frees it" "$(jq -r '.entries["2"].nextPollAt' "${STORE}/usage.json")" "$(date -u -d 2026-09-24T09:00:00Z +%s)"
contains "and the listing says 100%" "${OUT}" "5h 100% · 7d 20%"

# Model windows: narrowed to a name that matches nothing, the model axis is null.
FLAKELAB_ACCOUNTS_MODEL_WINDOWS=Opus run --json
check "a model filter that matches nothing leaves the model axis null" "$(print -r -- "$OUT" | jq -r '.accounts[0].headroom.model')" "null"
FLAKELAB_ACCOUNTS_MODEL_WINDOWS=fable run --json
check "the model filter is case-insensitive" "$(print -r -- "$OUT" | jq -r '.accounts[0].headroom.model')" "60"

# ---------------------------------------------------------------------------
print -r -- ""
print -r -- "usage: a 429 backs off, a dead refresh token quarantines, a refresh persists first"
export FLAKELAB_NOW=$(( 1758700000 + 7200 ))
usage_answer tok-a 62 91 40 429
print -r -- $'Retry-After: 120\r' > "${FAKE_CURL}/usage.tok-a.headers"
run --fetch
contains "a 429 shows in the listing, the figure aged" "${OUT}" "5h 62% · 7d 91% · Fable 40% (1h) · http-429"
check "Retry-After is honoured" "$(jq -r '.entries["1"].nextPollAt' "${STORE}/usage.json")" "$(( FLAKELAB_NOW + 120 ))"
check "and the hour after a 429 is remembered" "$(jq -r '.entries["1"].recent429Until' "${STORE}/usage.json")" "$(( FLAKELAB_NOW + 3600 ))"
print -r -- $'Retry-After: 0\r' > "${FAKE_CURL}/usage.tok-a.headers"
export FLAKELAB_NOW=$(( 1758700000 + 7200 + 121 ))
run --fetch
check "Retry-After: 0 is the saturated edge, 5 minutes" "$(jq -r '.entries["1"].nextPollAt' "${STORE}/usage.json")" "$(( FLAKELAB_NOW + 300 ))"
# The binding window (7d, at 91%) moves four points, so the cadence would
# halve to 225 s; the hour after a 429 floors it at 6 minutes.
usage_answer tok-a 70 95 40
export FLAKELAB_NOW=$(( 1758700000 + 7200 + 121 + 300 ))
run --fetch
check "after the 429s the cadence floors at 6 minutes for the hour" "$(jq -r '.entries["1"].intervalS' "${STORE}/usage.json")" "360"
check "a success clears the failure count" "$(jq -r '.entries["1"].failures' "${STORE}/usage.json")" "0"

# Alice's stored token is expired: the fetch refreshes it first, persists the
# rotated refresh token, then asks with the new access token.
jq '.claudeAiOauth.expiresAt = 1' "${STORE}/1/credentials.json" > "${BASE}/t" && mv "${BASE}/t" "${STORE}/1/credentials.json"
print -r -- '{"access_token": "tok-a-new", "expires_in": 3600, "refresh_token": "rt-a-new", "scope": "user:inference user:profile"}' > "${FAKE_CURL}/token.json"
print -n 200 > "${FAKE_CURL}/token.status"
usage_answer tok-a-new 63 91 40
: > "${FAKE_CURL}/requests.log"
export FLAKELAB_NOW=$(( 1758700000 + 7200 + 121 + 300 + 361 ))
run --fetch
check "an expired inactive token is refreshed before the fetch" "$(head -1 "${FAKE_CURL}/requests.log" | cut -d' ' -f1)" "https://platform.claude.com/v1/oauth/token"
contains "the refresh sends the stored refresh token and the client id" "$(head -1 "${FAKE_CURL}/requests.log")" '"refresh_token":"rt-tok-a","client_id":"9d1c250a-e61b-44d9-88ed-5944d1962f5e"'
check "the fetch then uses the new access token" "$(sed -n 2p "${FAKE_CURL}/requests.log" | cut -d' ' -f2)" "tok-a-new"
check "the rotated refresh token is persisted" "$(jq -r '.claudeAiOauth.refreshToken' "${STORE}/1/credentials.json")" "rt-a-new"
check "with its new expiry" "$(jq -r '.claudeAiOauth.expiresAt' "${STORE}/1/credentials.json")" "$(( (FLAKELAB_NOW + 3600) * 1000 ))"
check "and the scopes" "$(jq -c '.claudeAiOauth.scopes' "${STORE}/1/credentials.json")" '["user:inference","user:profile"]'
contains "and the listing moved" "${OUT}" "5h 63% · 7d 91%"

# The active entry's token is never refreshed, expired or not.
jq '.claudeAiOauth.expiresAt = 1' "${HOME}/.claude/.credentials.json" > "${BASE}/t" && mv "${BASE}/t" "${HOME}/.claude/.credentials.json"
: > "${FAKE_CURL}/requests.log"
export FLAKELAB_NOW=$(( FLAKELAB_NOW + 7200 ))
run --fetch
excludes "the active entry's expired token is left to Claude Code" "$(<"${FAKE_CURL}/requests.log")" "rt-tok-b"

# A dead lineage: the refresh answers invalid_grant, the entry is quarantined
# and left alone until its credential changes.
jq '.claudeAiOauth.expiresAt = 1' "${STORE}/1/credentials.json" > "${BASE}/t" && mv "${BASE}/t" "${STORE}/1/credentials.json"
print -r -- '{"error": "invalid_grant", "error_description": "refresh token revoked"}' > "${FAKE_CURL}/token.json"
print -n 400 > "${FAKE_CURL}/token.status"
export FLAKELAB_NOW=$(( FLAKELAB_NOW + 7200 ))
run --fetch
contains "invalid_grant quarantines the entry" "${ERR}" "entry 1 is quarantined: its refresh token was refused (invalid_grant)"
contains "and the listing says so" "${OUT}" "quarantined (invalid_grant)"
check "the quarantine remembers the lineage" "$(jq -r '.quarantine["1"].fingerprint' "${STORE}/usage.json")" "sha256:$(print -rn rt-a-new | sha256sum | cut -d' ' -f1)"
: > "${FAKE_CURL}/requests.log"
export FLAKELAB_NOW=$(( FLAKELAB_NOW + 7200 ))
run --fetch
excludes "a quarantined entry is not polled" "$(<"${FAKE_CURL}/requests.log")" "tok-a"
# A fresh login lifts it.
login alice@example.com "${UUID_A}" personal tok-a-fresh
run add claude
contains "a refreshed credential lifts the quarantine" "${ERR}" "entry 1 left quarantine"
check "and the quarantine is gone" "$(jq -r '.quarantine["1"] // "none"' "${STORE}/usage.json")" "none"
login bob@example.com "${UUID_B}" "Example GmbH" tok-b
run switch work
check "bob is live again" "$(live_email)" "bob@example.com"

# The network down: a transient error, backed off, nothing quarantined. Bob
# is parked at the reset that frees his 5h window; the clock is moved past it
# by hand, the way the reset would.
jq '.entries["2"].nextPollAt = 0' "${STORE}/usage.json" > "${BASE}/t" && mv "${BASE}/t" "${STORE}/usage.json"
export FAKE_CURL_DOWN=1
export FLAKELAB_NOW=$(( FLAKELAB_NOW + 7200 ))
run --fetch
contains "a network failure shows as such" "${OUT}" "network"
check "and backs off 30 seconds the first time" "$(jq -r '.entries["2"].nextPollAt' "${STORE}/usage.json")" "$(( FLAKELAB_NOW + 30 ))"
unset FAKE_CURL_DOWN

# ---------------------------------------------------------------------------
print -r -- ""
print -r -- "switch --soonest and --best"
login carol@example.com "${UUID_C}" personal tok-c
run add claude --alias spare
login bob@example.com "${UUID_B}" "Example GmbH" tok-b
run switch work
export FLAKELAB_NOW=$(( FLAKELAB_NOW + 7200 ))
usage_answer tok-a-fresh 62 91 40
usage_answer tok-c 5 50
# carol's week resets later than alice's: alice is soonest, carol is best.
sed -i 's/2026-09-27T12:00:00Z/2026-09-28T12:00:00Z/' "${FAKE_CURL}/usage.tok-c.json"
run switch --soonest claude
check "--soonest exits 0" "${RC}" "0"
check "--soonest picks the entry whose week renews first" "$(active_id)" "1"
run switch work
run switch --best claude
check "--best picks the most weekly headroom" "$(active_id)" "3"
run switch work
# A spent week is never a target, whatever its session window says.
usage_answer tok-c 0 100
export FLAKELAB_NOW=$(( FLAKELAB_NOW + 7200 ))
run switch --best claude
check "--best skips a spent week" "$(active_id)" "1"
run switch work
usage_answer tok-a-fresh 0 100
export FLAKELAB_NOW=$(( FLAKELAB_NOW + 7200 ))
run switch --best claude
check "every candidate spent refuses with exit 2" "${RC}" "2"
contains "and says so" "${ERR}" "has spent its weekly budget"
rm -f "${FAKE_CURL}"/usage.tok-a-fresh.* "${FAKE_CURL}"/usage.tok-c.*
export FAKE_CURL_DOWN=1
export FLAKELAB_NOW=$(( FLAKELAB_NOW + 86400 ))
run switch --soonest claude
check "no known usage refuses with exit 2" "${RC}" "2"
contains "and points at --fetch" "${ERR}" "no claude candidate has known usage"
unset FAKE_CURL_DOWN FLAKELAB_NOW

# ---------------------------------------------------------------------------
print -r -- ""
print -r -- "the engine: one rule per fixture"
ENGINE="${SCRIPT_DIR}/lib/accounts-auto.jq"
# engine <jq edits>: the base document (bob active at 5h 90% / 7d 50%,
# alice a candidate at 5h 20% / 7d 60%, carol disabled, a codex entry) with
# the edits applied, through the engine; DEC and EVS hold the results.
BASE_DOC='{"pass": "decide", "tool": "claude", "now": 1000,
 "settings": {"sessionThreshold": 85, "weekThreshold": 97, "modelThreshold": 95, "cooldownS": 300, "hysteresisPct": 10, "unhealthyTicks": 3, "idleHoldS": 1800, "strategy": "soonest-reset", "modelWindows": "all"},
 "roster": {"active": {"claude": 2}, "accounts": {"1": {"tool": "claude"}, "2": {"tool": "claude"}, "3": {"tool": "claude", "disabled": true}, "4": {"tool": "codex"}}},
 "usage": {"entries": {
    "2": {"fetchedAt": 990, "nextPollAt": 1170, "windows": [{"label": "5h", "class": "session", "pct": 90, "resetsAtEpoch": 5000}, {"label": "7d", "class": "week", "pct": 50, "resetsAtEpoch": 90000}]},
    "1": {"fetchedAt": 990, "nextPollAt": 1290, "windows": [{"label": "5h", "class": "session", "pct": 20, "resetsAtEpoch": 4000}, {"label": "7d", "class": "week", "pct": 60, "resetsAtEpoch": 80000}]}},
   "quarantine": {}},
 "state": {"lastSwitchAt": null, "lastSwitchTo": null, "unhealthyTicks": {}, "idleHoldSince": {}},
 "live": {}, "activeTokenExpired": false, "liveUnmanaged": false}'
engine() {
  local doc
  doc="$(print -r -- "$BASE_DOC" | jq "${1:-.}" | jq -f "${ENGINE}")" || { DEC="engine failed"; EVS=""; STATE=""; return 1 }
  DEC="$(print -r -- "$doc" | jq -c '.decision')"
  EVS="$(print -r -- "$doc" | jq -c '.events')"
  STATE="$(print -r -- "$doc" | jq -c '.state')"
  FETCH="$(print -r -- "$doc" | jq -c '.fetch')"
}
dec() { print -r -- "$DEC" | jq -r "$1" }

engine
check "proactive on the session window" "$(dec '[.action, .trigger, .axis] | join(" ")')" "switch proactive session"
check "with the one qualifying candidate" "$(dec '.candidates | join(",")')" "1"
check "and a poll event first" "$(print -r -- "$EVS" | jq -r '.[0].event')" "poll"
check "a known active entry resets the unhealthy count" "$(print -r -- "$STATE" | jq -r '.unhealthyTicks.claude')" "0"

engine '.usage.entries["2"].windows[0].pct = 84'
check "under every bar: no switch" "$(dec '[.action, .reason] | join(" ")')" "none below-threshold"
check "and the detail names the window closest to its bar" "$(dec '.detail')" "session 84% < 85%"

engine '.settings.sessionThreshold = 100 | .usage.entries["2"].windows[0].pct = 99'
check "a bar at 100 never moves proactively" "$(dec '.reason')" "below-threshold"
engine '.settings.sessionThreshold = 100 | .usage.entries["2"].windows[0].pct = 100'
check "but the actual limit still does" "$(dec '[.action, .trigger] | join(" ")')" "switch at-limit"

engine '.usage.entries["2"].windows[1].pct = 98'
check "the week decides over the session window" "$(dec '.axis')" "week"

engine '.usage.entries["1"].windows[0].pct = 82'
check "hysteresis: a candidate not ten points better is no target" "$(dec '[.action, .reason] | join(" ")')" "blocked no-qualifying-candidate"
engine '.usage.entries["1"].windows[0].pct = 86'
check "landing: a candidate over the bar is no target" "$(dec '.action')" "blocked"
engine '.usage.entries["2"].windows[0].pct = 100 | .usage.entries["1"].windows[0].pct = 86'
check "at the limit both gates are off: any room beats a wall" "$(dec '[.trigger, (.candidates | join(","))] | join(" ")')" "at-limit 1"
engine '.usage.entries["2"].windows[0].pct = 100 | .usage.entries["1"].windows[1].pct = 100'
check "a spent week is never a target, even from a wall" "$(dec '[.action, .reason] | join(" ")')" "blocked all-exhausted"
check "and the earliest weekly renewal is named" "$(dec '.earliestResetAt')" "80000"

engine '.state.lastSwitchAt = 900'
check "cooldown stops a proactive move" "$(dec '[.action, .reason] | join(" ")')" "none cooldown"
check "and says how long is left" "$(dec '.detail')" "200s left"
engine '.state.lastSwitchAt = 900 | .usage.entries["2"].windows[0].pct = 100'
check "cooldown never stops an at-limit move" "$(dec '.trigger')" "at-limit"

engine '.usage.entries["2"].fetchedAt = 100'
check "an unknown active entry counts toward failover" "$(dec '[.reason, .detail] | join(" ")')" "active-usage-unknown 1/3 before failover"
check "and the count is persisted" "$(print -r -- "$STATE" | jq -r '.unhealthyTicks.claude')" "1"
engine '.usage.entries["2"].fetchedAt = 100 | .state.unhealthyTicks.claude = 2'
check "the third unknown tick is a failover" "$(dec '[.action, .trigger] | join(" ")')" "switch failover"
engine '.usage.entries["2"].fetchedAt = 100 | .activeTokenExpired = true'
check "an expired token with no session is an idle hold, not a failure" "$(dec '.reason')" "active-idle"
check "the hold is timestamped" "$(print -r -- "$STATE" | jq -r '.idleHoldSince.claude')" "1000"
engine '.usage.entries["2"].fetchedAt = 100 | .activeTokenExpired = true | .state.idleHoldSince.claude = -1000'
check "a hold older than thirty minutes resumes the count" "$(dec '.reason')" "active-usage-unknown"

engine '.roster.accounts["1"].disabled = true'
check "with every other entry disabled: no candidates" "$(dec '[.action, .reason] | join(" ")')" "blocked no-candidates"
engine '.usage.quarantine["1"] = {"reason": "invalid_grant"}'
check "a quarantined entry is no candidate" "$(dec '.reason')" "no-candidates"
engine '.live["1"] = true'
check "an entry with a live profile session is no candidate" "$(dec '.reason')" "no-candidates"
engine '.usage.entries["1"].fetchedAt = 100'
check "a candidate with stale usage cannot be compared" "$(dec '[.action, .reason] | join(" ")')" "blocked no-comparison"

engine '.roster.active.claude = null'
check "no active entry: nothing to do, with the hint" "$(dec '[.reason, .detail] | join(" ")')" "no-active run: flakelab accounts add claude"
engine '.roster.active.claude = null | .liveUnmanaged = true'
check "an unmanaged live login is named as such" "$(dec '.reason')" "unmanaged-active"

# Order: three candidates, carol enabled with an earlier weekly reset and
# less headroom, dave over the session bar with the earliest reset of all.
ORDER='.roster.accounts["3"].disabled = false | .roster.accounts["5"] = {"tool": "claude"}
  | .usage.entries["3"] = {"fetchedAt": 990, "windows": [{"label": "5h", "class": "session", "pct": 30, "resetsAtEpoch": 4500}, {"label": "7d", "class": "week", "pct": 70, "resetsAtEpoch": 70000}]}
  | .usage.entries["5"] = {"fetchedAt": 990, "windows": [{"label": "5h", "class": "session", "pct": 86, "resetsAtEpoch": 4600}, {"label": "7d", "class": "week", "pct": 10, "resetsAtEpoch": 60000}]}
  | .usage.entries["2"].windows[0].pct = 100'
engine "$ORDER"
check "soonest-reset orders by the earliest weekly renewal, an entry over a bar last" "$(dec '.candidates | join(",")')" "3,1,5"
engine "$ORDER | .settings.strategy = \"best\""
check "best orders by weekly headroom" "$(dec '.candidates | join(",")')" "5,1,3"

# Model windows count only when named.
MODEL='.usage.entries["2"].windows += [{"label": "Fable", "class": "model", "pct": 96, "resetsAtEpoch": 85000}] | .usage.entries["2"].windows[0].pct = 50'
engine "$MODEL"
check "a per-model week over its bar decides" "$(dec '[.trigger, .axis] | join(" ")')" "proactive model"
engine "$MODEL | .settings.modelWindows = \"Opus\""
check "a model window not named does not count" "$(dec '.reason')" "below-threshold"

# The plan pass.
engine '.pass = "plan" | .now = 1200'
check "near a bar, every candidate is fetched with the active entry" "$(print -r -- "$FETCH" | jq -c .)" "[2,1]"
engine '.pass = "plan"'
check "near a bar but the active entry not yet due: the candidates alone" "$(print -r -- "$FETCH" | jq -c .)" "[1]"
engine '.pass = "plan" | .usage.entries["2"].windows[0].pct = 50 | .now = 1100'
check "far from every bar, only the due active entry" "$(print -r -- "$FETCH" | jq -c .)" "[]"
engine '.pass = "plan" | .usage.entries["2"].windows[0].pct = 50 | .now = 1300'
check "and one due candidate" "$(print -r -- "$FETCH" | jq -c .)" "[2,1]"
engine '.pass = "plan" | .usage.entries["2"].fetchedAt = 100 | .now = 1100'
check "an unknown active entry escalates to every candidate" "$(print -r -- "$FETCH" | jq -c .)" "[1]"

# ---------------------------------------------------------------------------
print -r -- ""
print -r -- "auto --once: the engine through the store, the adapter and the switch"
rm -rf "${STORE}"
login alice@example.com "${UUID_A}" personal tok-a
run add claude --alias home
login bob@example.com "${UUID_B}" "Example GmbH" tok-b
run add claude --alias work
export FLAKELAB_NOW=1758800000
usage_answer tok-b 90 50
usage_answer tok-a 20 60
: > "${FAKE_CURL}/requests.log"
run auto --once --json
check "auto --once exits 0" "${RC}" "0"
check "the events are JSON lines with the tool and a stamp" "$(print -r -- "$OUT" | jq -r 'select(.event == "poll") | [.tool, .ts] | join(" ")')" "claude 2025-09-25T11:33:20Z"
check "a proactive switch happened" "$(print -r -- "$OUT" | jq -r 'select(.event == "switch") | [.from, .to, .trigger, .axis] | join(" ")')" "2 1 proactive session"
check "the live login is alice's" "$(live_email)" "alice@example.com"
check "the engine state records the switch" "$(jq -r '.lastSwitchAt' "${STORE}/auto.json")" "${FLAKELAB_NOW}"
check "the events went to the log too" "$(grep -c '"event"' "${STORE}/auto.log")" "2"
check "the log is private" "$(stat -c %a "${STORE}/auto.log")" "600"
check "the poll fetched the active entry and the candidate" "$(grep -c oauth/usage "${FAKE_CURL}/requests.log")" "2"

run auto --once --json
check "a tick with nothing to do exits 0" "${RC}" "0"
check "and says why, naming the window closest to its bar" "$(print -r -- "$OUT" | jq -r 'select(.event == "no-switch") | [.reason, .detail] | join(" ")')" "below-threshold week 60% < 97%"

# Alice hits the bar inside the cooldown: no move; then the cooldown passes.
usage_answer tok-a 90 60
usage_answer tok-b 30 50
export FLAKELAB_NOW=$(( 1758800000 + 200 ))
jq '.entries["1"].nextPollAt = 0 | .entries["2"].nextPollAt = 0' "${STORE}/usage.json" > "${BASE}/t" && mv "${BASE}/t" "${STORE}/usage.json"
run auto --once --json
check "inside the cooldown a proactive move waits" "$(print -r -- "$OUT" | jq -r 'select(.event == "no-switch") | .reason')" "cooldown"
export FLAKELAB_NOW=$(( 1758800000 + 400 ))
run auto --once --json --dry-run
check "--dry-run decides" "$(print -r -- "$OUT" | jq -r 'select(.event == "switch") | [.to, .dryRun] | join(" ")')" "2 true"
check "but changes nothing" "$(live_email)" "alice@example.com"
run auto --once
check "the human form exits 0" "${RC}" "0"
contains "and prints one line per event" "${OUT}" "claude  switch: 1 -> 2 [proactive on session]"
check "the switch is real" "$(live_email)" "bob@example.com"

# A dead candidate is quarantined on the way and the next one taken: carol's
# usage is known from a moment ago and a failed poll has her in backoff, so
# the tick does not fetch her; the freshen before the switch finds her
# refresh token refused.
login carol@example.com "${UUID_C}" personal tok-c
run add claude --alias spare
login bob@example.com "${UUID_B}" "Example GmbH" tok-b
run switch work
export FLAKELAB_NOW=$(( 1758800000 + 4000 ))
usage_answer tok-b 100 50
usage_answer tok-a 20 60
jq --argjson now "${FLAKELAB_NOW}" '.entries["3"] = {windows: [{label: "5h", class: "session", pct: 10, resetsAtEpoch: ($now + 3600)}, {label: "7d", class: "week", pct: 40, resetsAtEpoch: ($now + 86400)}],
  fetchedAt: ($now - 120), nextPollAt: ($now + 300), intervalS: 300, failures: 1, lastError: "http-500", backoffUntil: ($now + 30)}' \
  "${STORE}/usage.json" > "${BASE}/t" && mv "${BASE}/t" "${STORE}/usage.json"
jq '.claudeAiOauth.expiresAt = 1' "${STORE}/3/credentials.json" > "${BASE}/t" && mv "${BASE}/t" "${STORE}/3/credentials.json"
print -r -- '{"error": "invalid_grant"}' > "${FAKE_CURL}/token.json"
print -n 400 > "${FAKE_CURL}/token.status"
export FLAKELAB_ACCOUNTS_STRATEGY=best   # carol has the most weekly headroom: tried first
run auto --once --json
unset FLAKELAB_ACCOUNTS_STRATEGY
contains "carol's dead lineage is quarantined by the freshen" "${OUT}" '"event":"quarantine","entry":3,"reason":"invalid_grant"'
check "and alice is taken instead" "$(print -r -- "$OUT" | jq -r 'select(.event == "switch") | [.to, .trigger] | join(" ")')" "1 at-limit"
check "carol is quarantined in the cache" "$(jq -r '.quarantine["3"].reason' "${STORE}/usage.json")" "invalid_grant"

run auto --once --tool gemini
check "auto for an unknown tool exits 2" "${RC}" "2"
run auto --once --session-threshold 40
check "a threshold under 50 is refused" "${RC}" "2"
run auto --once --interval 5
check "an interval under 15 seconds is refused" "${RC}" "2"
unset FLAKELAB_NOW

# ---------------------------------------------------------------------------
print -r -- ""
print -r -- "profiles: run and env"
# The claude stand-in: `auth status` answers with FAKE_CLAUDE_AUTH_RC; anything
# else prints the environment run hands it and its arguments.
cat > "${STUBS}/claude" <<'STUB'
#!/usr/bin/env zsh
if [[ "$1" == auth && "$2" == status ]]; then exit "${FAKE_CLAUDE_AUTH_RC:-0}"; fi
print -r -- "claude ran: CLAUDE_CONFIG_DIR=${CLAUDE_CONFIG_DIR-unset} ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY-unset} ANTHROPIC_PROFILE=${ANTHROPIC_PROFILE-unset} args=$*"
STUB
chmod +x "${STUBS}/claude"
# The state: alice (1, home) is the live login, bob (2, work) is stored,
# carol (3, spare) is quarantined.
check "alice is the live login" "$(live_email)" "alice@example.com"
mkdir -p "${HOME}/.claude/skills"
print -r -- '{"model": "x"}' > "${HOME}/.claude/settings.json"
print -r -- '# rules' > "${HOME}/.claude/CLAUDE.md"
PROFILE="${STORE}/profiles/2"
export ANTHROPIC_API_KEY=sk-must-not-leak ANTHROPIC_PROFILE=other
run run work -- --version
check "run exits 0 through the stand-in" "${RC}" "0"
contains "run points the tool at the entry's profile" "${OUT}" "CLAUDE_CONFIG_DIR=${PROFILE} "
contains "and scrubs the auth-override variables" "${OUT}" "ANTHROPIC_API_KEY=unset ANTHROPIC_PROFILE=unset"
contains "and hands over the arguments after --" "${OUT}" "args=--version"
contains "the first run seeds the profile and says so" "${ERR}" "seeded the profile of entry 2 (work) bob@example.com at ${PROFILE}"
unset ANTHROPIC_API_KEY ANTHROPIC_PROFILE
check "the profile is private" "$(stat -c %a "${PROFILE}")" "700"
check "the profile holds bob's credential, private" "$(stat -c %a "${PROFILE}/.credentials.json") $(jq -r .claudeAiOauth.accessToken "${PROFILE}/.credentials.json")" "600 tok-b"
check "its config carries the identity, onboarding done, the theme and the MCP servers" \
  "$(jq -r '[.oauthAccount.accountUuid, (.hasCompletedOnboarding | tostring), .theme, (.mcpServers | keys | join(","))] | join(" ")' "${PROFILE}/.claude.json")" "${UUID_B} true dark grafana"
check "settings are a link into the real home" "$(readlink "${PROFILE}/settings.json")" "${HOME}/.claude/settings.json"
check "the transcripts are shared by default" "$(readlink "${PROFILE}/projects")" "${HOME}/.claude/projects"
[[ -d "${HOME}/.claude/projects" ]] && ok "a shared directory is created in the home first, so the link never dangles" || bad "the home has no projects/ for the link"
[[ -L "${PROFILE}/history.jsonl" && ! -e "${HOME}/.claude/history.jsonl" ]] && ok "a shared file links even before the home has one" || bad "history.jsonl was not linked"
[[ ! -e "${PROFILE}/sessions" && ! -L "${PROFILE}/.claude.json" && ! -L "${PROFILE}/.credentials.json" ]] && ok "the login and the session registry are the profile's own" || bad "a per-instance item was linked"
check "the manifest lists the links made" "$(jq -r '.links | join(" ")' "${PROFILE}/.flakelab-profile.json")" "settings.json keybindings.json CLAUDE.md skills/ commands/ agents/ projects/ history.jsonl"
check "and records the entry and the tool" "$(jq -r '[.tool, .entry, .shareHistory] | join(" ")' "${PROFILE}/.flakelab-profile.json")" "claude 2 true"

run env work
check "env exits 0" "${RC}" "0"
check "env prints the export and the unsets, for eval" "${OUT}" "export CLAUDE_CONFIG_DIR='${PROFILE}'
unset ANTHROPIC_API_KEY
unset ANTHROPIC_AUTH_TOKEN
unset CLAUDE_CODE_OAUTH_TOKEN
unset ANTHROPIC_PROFILE"
contains "env says what it pinned, on stderr" "${ERR}" "pinned to claude 2 (work) bob@example.com: ${PROFILE}"
excludes "a valid profile is reused, not reseeded" "${ERR}" "seeded"
run env work --shell fish
contains "the fish dialect exports" "${OUT}" "set -gx CLAUDE_CONFIG_DIR '${PROFILE}'"
contains "and unsets" "${OUT}" "set -e ANTHROPIC_API_KEY"
run env work --shell pwsh
contains "the pwsh dialect exports" "${OUT}" "\$env:CLAUDE_CONFIG_DIR = '${PROFILE}'"
