  [[ -n "${FAKE_CLAUDE_LOGIN:-}" ]] || { print -r -- "Login cancelled"; exit 1 }
  set -- ${(s: :)FAKE_CLAUDE_LOGIN}
  jq --arg e "$1" --arg u "$2" --arg o "$3" '.oauthAccount = {emailAddress: $e, accountUuid: $u, organizationUuid: ("org-" + $u), organizationName: $o}' "${CLAUDE_CONFIG_DIR}/.claude.json" > "${CLAUDE_CONFIG_DIR}/.claude.json.new" && mv "${CLAUDE_CONFIG_DIR}/.claude.json.new" "${CLAUDE_CONFIG_DIR}/.claude.json"
  print -r -- "{\"claudeAiOauth\": {\"accessToken\": \"${4}\", \"refreshToken\": \"rt-${4}\", \"expiresAt\": 1900000000000, \"scopes\": [\"user:inference\"]}}" > "${CLAUDE_CONFIG_DIR}/.credentials.json"
  print -r -- "Logged in as $1"
  exit 0
fi
