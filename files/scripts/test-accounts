contains "the live kiro entry's credits, from the live rows" "${OUT}" "$(row kiro 7 grace grace@example.com IamIdentityCenter active 'credit 25% (0s)')"
contains "a stored entry's, from its stored rows" "${OUT}" "$(row kiro 6 frank frank@example.com BuilderId '' 'credit 100% (0s)')"
