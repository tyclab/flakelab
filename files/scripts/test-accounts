check "the window is a month, an ISO reset as an epoch" "$(jq -r '.entries["6"].windows[0] | [.class, .resetsAtEpoch] | join(" ")' "${STORE}/usage.json")" "month 1793491200"
FLAKELAB_ACCOUNTS_TOOLS=kiro run auto --once --json
check "a spent month is no reason to move" "$(print -r -- "$OUT" | jq -r 'select(.event == "no-switch") | [.reason, .detail] | join(" ")')" "below-threshold no window reported"
# Nothing refreshes a stored Kiro token: past its expiry it is reported as
# such, not sent to be refused, and a refusal is an error with backoff, not
# a quarantine (nothing here proves a seat gone).
jq '.auth_kv["kirocli:odic:token"] |= (fromjson | .expires_at = "2020-01-01T00:00:00Z" | tojson) ' "${STORE}/6/token.json" > "${BASE}/t" && mv "${BASE}/t" "${STORE}/6/token.json"
jq '.entries["6"].nextPollAt = 0' "${STORE}/usage.json" > "${BASE}/t" && mv "${BASE}/t" "${STORE}/usage.json"
: > "${FAKE_CURL}/requests.log"
run --fetch
check "an expired stored kiro token is reported as expired" "$(jq -r '.entries["6"].lastError' "${STORE}/usage.json")" "expired"
check "without a request" "$(grep -c acc-f "${FAKE_CURL}/requests.log")" "0"
jq '.auth_kv["kirocli:odic:token"] |= (fromjson | .expires_at = "2030-01-01T00:00:00Z" | tojson) ' "${STORE}/6/token.json" > "${BASE}/t" && mv "${BASE}/t" "${STORE}/6/token.json"
jq '.entries["6"].nextPollAt = 0 | .entries["6"].backoffUntil = 0' "${STORE}/usage.json" > "${BASE}/t" && mv "${BASE}/t" "${STORE}/usage.json"
print -n 401 > "${FAKE_CURL}/usage.acc-f.status"
run --fetch
check "a 401 is unauthorized, an error with backoff" "$(jq -r '.entries["6"].lastError' "${STORE}/usage.json")" "unauthorized"
check "and not a quarantine" "$(jq -r '.quarantine["6"] // "none"' "${STORE}/usage.json")" "none"
print -n 200 > "${FAKE_CURL}/usage.acc-f.status"
