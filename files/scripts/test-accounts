# ---------------------------------------------------------------------------
print -r -- ""
print -r -- "the Codex adapter: auth.json whole, no lock, no refresh of ours, usage through the tool"
FAKE_CODEX="${BASE}/codex"
mkdir -p "${FAKE_CODEX}" "${HOME}/.codex"
b64url() { print -rn -- "$1" | base64 -w0 | tr '+/' '-_' | tr -d '=' }
# A JWT with the claims Codex's id_token carries, and an access token with an expiry.
jwt() { print -r -- "$(b64url '{"alg":"none"}').$(b64url "$1").sig" }
# codex_login <email> <account id> <plan> <access token> [<exp>]
codex_login() {
  local email="$1" acct="$2" plan="$3" tok="$4" exp="${5:-1900000000}"
  cat > "${HOME}/.codex/auth.json" <<EOF
{"OPENAI_API_KEY": null, "tokens": {"id_token": "$(jwt "{\"email\": \"${email}\", \"https://api.openai.com/auth\": {\"chatgpt_account_id\": \"${acct}\", \"chatgpt_plan_type\": \"${plan}\"}}")", "access_token": "$(jwt "{\"sub\": \"${tok}\", \"exp\": ${exp}}")", "refresh_token": "rt-${tok}", "account_id": "${acct}"}, "last_refresh": "2026-09-24T10:00:00Z"}
EOF
  chmod 600 "${HOME}/.codex/auth.json"
}
codex_live() { jq -r '.tokens.refresh_token' "${HOME}/.codex/auth.json" }
# The codex stand-in: `login status` exits FAKE_CODEX_LOGIN_RC; `app-server`
# answers the rateLimits read from limits.<refresh token>.json (or an error
# from error.<refresh token>.txt), logs CODEX_HOME, and rewrites auth.json from
# refresh.<refresh token>.json when that exists, as a refresh would; anything
# else prints the environment it ran with.
cat > "${STUBS}/codex" <<'STUB'
#!/usr/bin/env zsh
if [[ "$1" == login && "$2" == status ]]; then exit "${FAKE_CODEX_LOGIN_RC:-0}"; fi
if [[ "$1" == app-server ]]; then
  rt="$(jq -r '.tokens.refresh_token // empty' "${CODEX_HOME}/auth.json" 2>/dev/null)"
  print -r -- "CODEX_HOME=${CODEX_HOME} rt=${rt}" >> "${FAKE_CODEX}/calls.log"
  [[ -f "${FAKE_CODEX}/refresh.${rt}.json" ]] && cp "${FAKE_CODEX}/refresh.${rt}.json" "${CODEX_HOME}/auth.json"
  while IFS= read -r line; do
    case "$line" in
      *'"id":1'*) print -r -- '{"jsonrpc":"2.0","id":1,"result":{"userAgent":"codex/0.0"}}' ;;
      *'account/rateLimits/read'*)
        if [[ -f "${FAKE_CODEX}/error.${rt}.txt" ]]; then print -r -- "{\"jsonrpc\":\"2.0\",\"id\":2,\"error\":{\"code\":-32000,\"message\":\"$(<"${FAKE_CODEX}/error.${rt}.txt")\"}}"
        elif [[ -f "${FAKE_CODEX}/limits.${rt}.json" ]]; then cat "${FAKE_CODEX}/limits.${rt}.json"
        fi ;;
    esac
  done
  exit 0
fi
print -r -- "codex ran: CODEX_HOME=${CODEX_HOME-unset} OPENAI_API_KEY=${OPENAI_API_KEY-unset} args=$*"
STUB
chmod +x "${STUBS}/codex"
export FAKE_CODEX

run add codex
check "add codex without a login exits 2" "${RC}" "2"
print -r -- '{"OPENAI_API_KEY": "sk-abc", "tokens": null}' > "${HOME}/.codex/auth.json"
run add codex
check "an API-key login is refused" "${RC}" "2"
contains "with the shell-variable hint" "${ERR}" "API key"
codex_login dana@example.com acct-d plus tok-d
