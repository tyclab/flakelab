check "nothing changed" "$(kiro_live_refresh)" "rt-s"
run switch frank
check "a switch with none running exits 0" "${RC}" "0"
check "the token row is frank's" "$(kiro_live_refresh)" "rt-f"
check "and the only token row" "$(sqlite3 "${KIRO_DB}" "SELECT count(*) FROM auth_kv WHERE key LIKE 'kirocli:%:token'")" "1"
check "the profile row followed" "$(kiro_live_arn)" "arn:aws:codewhisperer:us-east-1:123:profile/p-f"
