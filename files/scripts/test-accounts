print -r -- $'Retry-After: 0\r' > "${FAKE_CURL}/usage.tok-a.headers"
export FLAKELAB_NOW=$(( 1758700000 + 7200 + 121 ))
run --fetch
check "Retry-After: 0 is the saturated edge, 5 minutes" "$(jq -r '.entries["1"].nextPollAt' "${STORE}/usage.json")" "$(( FLAKELAB_NOW + 300 ))"
# The binding window (7d, at 91%) moves four points, so the cadence would
# halve to 225 s; the hour after a 429 floors it at 6 minutes.
usage_answer tok-a 70 95 40
export FLAKELAB_NOW=$(( 1758700000 + 7200 + 121 + 300 ))
run --fetch
check "after the 429s the cadence floors at 6 minutes for the hour" "$(jq -r '.entries["1"].intervalS' "${STORE}/usage.json")" "360"
check "a success clears the failure count" "$(jq -r '.entries["1"].failures' "${STORE}/usage.json")" "0"

# Alice's stored token is expired: the fetch refreshes it first, persists the
# rotated refresh token, then asks with the new access token.
jq '.claudeAiOauth.expiresAt = 1' "${STORE}/1/credentials.json" > "${BASE}/t" && mv "${BASE}/t" "${STORE}/1/credentials.json"
print -r -- '{"access_token": "tok-a-new", "expires_in": 3600, "refresh_token": "rt-a-new", "scope": "user:inference user:profile"}' > "${FAKE_CURL}/token.json"
print -n 200 > "${FAKE_CURL}/token.status"
usage_answer tok-a-new 63 91 40
: > "${FAKE_CURL}/requests.log"
export FLAKELAB_NOW=$(( 1758700000 + 7200 + 121 + 300 + 361 ))
run --fetch
check "an expired inactive token is refreshed before the fetch" "$(head -1 "${FAKE_CURL}/requests.log" | cut -d' ' -f1)" "https://platform.claude.com/v1/oauth/token"
contains "the refresh sends the stored refresh token and the client id" "$(head -1 "${FAKE_CURL}/requests.log")" '"refresh_token":"rt-tok-a","client_id":"9d1c250a-e61b-44d9-88ed-5944d1962f5e"'
check "the fetch then uses the new access token" "$(sed -n 2p "${FAKE_CURL}/requests.log" | cut -d' ' -f2)" "tok-a-new"
check "the rotated refresh token is persisted" "$(jq -r '.claudeAiOauth.refreshToken' "${STORE}/1/credentials.json")" "rt-a-new"
check "with its new expiry" "$(jq -r '.claudeAiOauth.expiresAt' "${STORE}/1/credentials.json")" "$(( (FLAKELAB_NOW + 3600) * 1000 ))"
check "and the scopes" "$(jq -c '.claudeAiOauth.scopes' "${STORE}/1/credentials.json")" '["user:inference","user:profile"]'
contains "and the listing moved" "${OUT}" "5h 63% · 7d 91%"

# The active entry's token is never refreshed, expired or not.
jq '.claudeAiOauth.expiresAt = 1' "${HOME}/.claude/.credentials.json" > "${BASE}/t" && mv "${BASE}/t" "${HOME}/.claude/.credentials.json"
: > "${FAKE_CURL}/requests.log"
export FLAKELAB_NOW=$(( FLAKELAB_NOW + 7200 ))
run --fetch
excludes "the active entry's expired token is left to Claude Code" "$(<"${FAKE_CURL}/requests.log")" "rt-tok-b"

# A dead lineage: the refresh answers invalid_grant, the entry is quarantined
# and left alone until its credential changes.
jq '.claudeAiOauth.expiresAt = 1' "${STORE}/1/credentials.json" > "${BASE}/t" && mv "${BASE}/t" "${STORE}/1/credentials.json"
print -r -- '{"error": "invalid_grant", "error_description": "refresh token revoked"}' > "${FAKE_CURL}/token.json"
print -n 400 > "${FAKE_CURL}/token.status"
export FLAKELAB_NOW=$(( FLAKELAB_NOW + 7200 ))
run --fetch
contains "invalid_grant quarantines the entry" "${ERR}" "entry 1 is quarantined: its refresh token was refused (invalid_grant)"
contains "and the listing says so" "${OUT}" "quarantined (invalid_grant)"
check "the quarantine remembers the lineage" "$(jq -r '.quarantine["1"].fingerprint' "${STORE}/usage.json")" "sha256:$(print -rn rt-a-new | sha256sum | cut -d' ' -f1)"
: > "${FAKE_CURL}/requests.log"
export FLAKELAB_NOW=$(( FLAKELAB_NOW + 7200 ))
run --fetch
excludes "a quarantined entry is not polled" "$(<"${FAKE_CURL}/requests.log")" "tok-a"
# A fresh login lifts it.
login alice@example.com "${UUID_A}" personal tok-a-fresh
run add claude
contains "a refreshed credential lifts the quarantine" "${ERR}" "entry 1 left quarantine"
check "and the quarantine is gone" "$(jq -r '.quarantine["1"] // "none"' "${STORE}/usage.json")" "none"
login bob@example.com "${UUID_B}" "Example GmbH" tok-b
run switch work
check "bob is live again" "$(live_email)" "bob@example.com"

# The network down: a transient error, backed off, nothing quarantined. Bob
# is parked at the reset that frees his 5h window; the clock is moved past it
# by hand, the way the reset would.
jq '.entries["2"].nextPollAt = 0' "${STORE}/usage.json" > "${BASE}/t" && mv "${BASE}/t" "${STORE}/usage.json"
export FAKE_CURL_DOWN=1
export FLAKELAB_NOW=$(( FLAKELAB_NOW + 7200 ))
run --fetch
contains "a network failure shows as such" "${OUT}" "network"
check "a failed read records its backoff, which the plan and the tick honour" "$(jq -r '[.entries[] | select(.lastError != null)] | (length > 0) and all(.backoffUntil == .nextPollAt and .backoffUntil > .lastErrorAt)' "${STORE}/usage.json")" "true"
check "and backs off 30 seconds the first time" "$(jq -r '.entries["2"].nextPollAt' "${STORE}/usage.json")" "$(( FLAKELAB_NOW + 30 ))"
unset FAKE_CURL_DOWN

