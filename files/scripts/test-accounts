check "the entry takes the next id, with the identity from the id_token's claims" "${OUT}" "Added codex 4: dana@example.com [plus] as dana"
check "the store holds auth.json whole, private" "$(stat -c %a "${STORE}/4/auth.json") $(jq -r '.tokens.refresh_token' "${STORE}/4/auth.json")" "600 rt-tok-d"
check "the roster's id is the chatgpt account id" "$(jq -r '.accounts["4"].id' "${STORE}/accounts.json")" "acct-d"
codex_login erin@example.com acct-e pro tok-e
run add codex --alias erin
check "a second codex login is a second entry" "${OUT}" "Added codex 5: erin@example.com [pro] as erin"
check "and the active codex entry" "$(jq -r '.active.codex' "${STORE}/accounts.json")" "5"
run
contains "the listing shows both tools" "${OUT}" "$(row codex 4 dana dana@example.com '' -)"
contains "with the codex entry active" "${OUT}" "$(row codex 5 erin erin@example.com active -)"
run status
contains "status reports codex too" "${OUT}" "codex: 5 (erin) erin@example.com [pro]"

