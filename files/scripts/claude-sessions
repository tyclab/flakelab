#!/usr/bin/env zsh

set -uo pipefail

#
# claude-sessions — the agent sessions running in this distro (Claude Code,
# Codex): list them, host them in tmux so they outlive their
# terminal, save the list, print what brings each one back after a restart.
#
# A `wsl --shutdown` or a reboot kills every shell, and each tool keeps its
# conversation on disk — Claude Code under ~/.claude/projects/<slug>/<id>.jsonl,
# Codex under ~/.codex/sessions/<date>/rollout-<stamp>-<id>.jsonl — so the
# sessions survive, but only if the session ids are known. That is what this
# command records before the restart.
#
# Process candidates come from exact names and Claude's PID registry (Claude
# may rename itself to a version number). Registry-only candidates must still
# have a live Claude executable. Never pgrep -f, which also matches helpers.
# Claude's registry supplies the id, with an open transcript as fallback.
# Codex's shared app-server may hold many rollouts: enumerate all user sessions
# and use each rollout's metadata directory, excluding internal subagents.
# A CLI client may hold no transcript itself; its session is saved from the
# server. The newest transcript in a shared directory is never an identity.

# --start runs a session in a window of the `agents` tmux session; terminals are grouped views that can close at will.
#
# Usage:
#   claude-sessions                    table: tool, pid, age, session id, host, directory
#   claude-sessions --start <tool> [dir] [--detach] [-- args...]
#                                      a new session of claude|codex in dir
#                                      (default: here) in its own tmux window,
#                                      attached unless --detach or no terminal
#   claude-sessions --start codex [dir] (--prompt TEXT | --prompt-file FILE)
#                   [--model M] [--effort E] [--name NAME] [--trust] [--detach]
#                                      a Codex session on Codex's shared server with
#                                      that model and effort and that first prompt,
#                                      and its window (a lane; see below)
#   claude-sessions --close [--force] [--archive] <window|session-id>...
#                                      remove a lane's window once its session is
#                                      finished, and print what brings it back
#   claude-sessions --attach [id|window]
#                                      join the window holding that session, or
#                                      that window by name; none: the whole server
#   claude-sessions --save [file]      also write "<tool>  <dir>  <id>" lines to file
#   claude-sessions --resume [file]    print the resume command per session,
#                                      from a saved file (default: this box's
#                                      newest save), or from the live sessions
#                                      if none
#   claude-sessions --open [file]      the same sessions, each in its own new
#                                      Windows Terminal tab (WSL only); with tmux
#                                      on PATH each tab is a view on a window that
#                                      outlives it. One still running is not
#                                      resumed again: its window gets a tab
#                                      unless a client already shows it
#   claude-sessions --autosave         the crash-recovery snapshot (below)
#   claude-sessions --recent [hours]   sessions NOT running whose transcript
#                                      changed in the last <hours> (default 24),
#                                      newest first: the window closed by mistake
#   claude-sessions --json             the live sessions as a JSON array
#
# --resume lines are one per terminal. A directory this box lacks gets no `cd`:
# `claude --resume <id>` works from anywhere, and a failing `cd` would stop the line.
#
# --autosave keeps ONE <box>-autosave-<boot>.txt per boot, never rewritten empty (the first ticks after a crash
# see nothing open). --resume/--open default to this box's newest save that is not this boot's autosave.
#
# <box> is <hostname>-<12 hex of machine-id>: two boxes share hostname and save dir, and by host alone a reboot
# here brought the other box's sessions back (2026-10-04). Another box's file still resumes when named.
#
# Saves go to $FLAKELAB_STATE_ROOT/claude/sessions/ (else ~/.local/state/flakelab/sessions/);
# never ~/.claude/sessions, which is Claude Code's own registry.
#
# Saved lines: "<tool>  <dir>  <id>", two spaces between fields. A file from
# before the tool column ("<dir>  <id>") reads as Claude Code.
#
# Lanes. Codex's command line cannot set the reasoning effort without leaving
# the shared server, and a Codex window is a client that holds no rollout, so
# nothing ties it to its session. A lane is started through Codex's own
# protocol instead (lib/codex_threads.py): the conversation is created with
# its model and effort, its first turn is started, and only then a window
# opens on it with `codex resume <id>` (a window that opens before the first
# turn applies its own defaults). The id is recorded on the window as the tmux
# option @flakelab_session: the table shows it, with the session's state, and
# --close judges by it. Codex saves a trust entry by itself for a folder it
# holds no decision for, so a lane starts only where it holds one, or with
# --trust. Design: docs/superpowers/specs/2026-11-13-sessions-codex-lanes-design.md
#

# The terminal prompts: --start without a tool and --attach without a target
# ask at a terminal, and are the error and the whole-server attach they always
# were anywhere else.
SCRIPT_DIR="${0:A:h}"
source "${SCRIPT_DIR}/lib/prompt.zsh" || exit 1

PROC_ROOT="${FLAKELAB_PROC_ROOT:-/proc}"
# The kernel's id for this boot: a crash, a reboot or a `wsl --shutdown` starts
# a new one. FLAKELAB_BOOT_ID_FILE is a test seam.
BOOT_ID_FILE="${FLAKELAB_BOOT_ID_FILE:-/proc/sys/kernel/random/boot_id}"
# What tells this box from one with the same hostname; FLAKELAB_MACHINE_ID_FILE
# is a test seam. Unreadable, the box is the host alone.
MACHINE_ID_FILE="${FLAKELAB_MACHINE_ID_FILE:-/etc/machine-id}"
REGISTRY="${HOME}/.claude/sessions"
# tycswap profile sessions keep registry and transcript under <store>/sessions/<n>-<email>/; the env var is a test seam.
TYCSWAP_ROOT="${FLAKELAB_TYCSWAP_ROOT:-${XDG_DATA_HOME:-${HOME}/.local/share}/tycswap}"
TYCSWAP_PROFILES="${TYCSWAP_ROOT}/sessions"
TYCSWAP_GROUPS="${TYCSWAP_ROOT}/groups"
# The tmux session every --start window lands in, and the prefix of the view
# sessions --attach and --open create on it.
TMUX_SESSION="${FLAKELAB_TMUX_SESSION:-agents}"
MODE=list
FILE=""
RECENT_HOURS=24
# This host's autosaves kept; the newest is the current boot's.
AUTOSAVE_KEEP=5
START_TOOL=""
START_DIR=""
START_DETACH=false
# --start with no tool at a terminal: tool and directory are asked for.
START_ASK=false
typeset -a START_ARGS=()
ATTACH_TARGET=""
# The lane flags of --start codex, and --close.
LANE_MODEL=""; LANE_EFFORT=""; LANE_NAME=""; LANE_PROMPT=""; LANE_PROMPT_FILE=""
LANE_TRUST=false
typeset -a LANE_FLAGS=() CLOSE_TARGETS=()
CLOSE_FORCE=false
CLOSE_ARCHIVE=false
# Seconds a lane's window must survive: a `codex resume` that cannot open its
# conversation ended within 1.0 s in three runs. The env var is a test seam.
LANE_SETTLE="${FLAKELAB_SESSIONS_SETTLE:-3}"

typeset -a TOOLS=(claude codex)
# The process name each tool runs as, and the command that starts a session.
typeset -A TOOL_PROC=(claude claude codex codex)
typeset -A TOOL_CMD=(claude claude codex codex)

usage() {
  cat <<'USAGE'
Usage: flakelab sessions [--start <tool> [dir] [--detach] [-- args...]]
                         [--start codex [dir] (--prompt TEXT | --prompt-file FILE)
                            [--model M] [--effort E] [--name NAME] [--trust] [--detach]]
                         [--close [--force] [--archive] <window|session-id>...]
                         [--attach [id|window]] [--save [file]] [--resume [file]]
                         [--open [file]] [--autosave] [--recent [hours]] [--json]

  (no flag)         list the running agent sessions (Claude Code, Codex)
  --start <tool> [dir] [--detach] [-- args...]
                    start claude|codex in dir (default: here) in its own
                    window of the `agents` tmux session, and attach to it —
                    unless --detach, or there is no terminal. At a terminal,
                    with no tool, the tool and the directory are asked for
  --start codex [dir] --prompt TEXT | --prompt-file FILE
                    a lane: a Codex session on Codex's shared server whose
                    turns run on --model M and --effort E (default: yours),
                    started with that prompt, in a window named --name NAME.
                    The model and effort hold for this session only. A folder
                    Codex holds no trust decision for is refused: --trust
                    starts there, and Codex may then save it as trusted
  --close [--force] [--archive] <window|session-id>...
                    remove a lane's window when its session is finished, and
                    print the command that reopens it. A session that works,
                    waits, or has a helper agent or a command running is
                    refused; --force stops those first, for every window
                    that shows the session. --archive also archives it
  --attach [id|window]
                    attach this terminal to the window holding session id, or
                    to the window named; with neither, to the whole server —
                    at a terminal, picked from a list of the windows first
  --save [file]     list, and save tool, directory and actual session id;
                    profile sessions also store their profile in JSON lines
  --resume [file]   print the resume commands, one per terminal, from file
                    (default: this box's newest save, else the live sessions)
  --open [file]     open each of those sessions in its own Windows Terminal
                    tab (WSL only); with tmux on PATH, as a view on a window
                    that outlives the tab. A session still running is not
                    resumed again: its window gets a tab unless one shows it
  --autosave        snapshot the running sessions for crash recovery: one
                    file per boot, only when the set changed, never empty
  --recent [hours]  sessions not running whose transcript changed in the
                    last <hours> (default 24), with the command to resume each
  --json            the live sessions as a JSON array

The table's STATE (for a lane, and for sessions on Codex's shared server):
idle, working, approval, question, unloaded, error; - not asked, ? no answer.
USAGE
}

while (( $# > 0 )); do
  case $1 in
    --start)
      MODE=start
      if [[ -n "${2:-}" && "${2}" != -* ]]; then
        START_TOOL="$2"; shift
        if [[ -n "${2:-}" && "${2}" != -* ]]; then START_DIR="$2"; shift; fi
      else
        prompt_tty || { print -ru2 -- "Error: --start needs a tool: ${(j:|:)TOOLS}"; exit 2 }
        START_ASK=true
      fi
      ;;
    --group)
      # tycswap retired its session groups: the default login follows the model.
      print -ru2 -- "Error: --group is retired; plain claude switches accounts by model"; exit 2 ;;
    --detach) START_DETACH=true ;;
    --model|--effort|--name|--prompt|--prompt-file)
      # An empty value is none: it would silently become the default.
      (( $# >= 2 )) && [[ -n "$2" ]] || { print -ru2 -- "Error: $1 needs a value"; exit 2 }
      LANE_FLAGS+=("$1")
      case $1 in
        --model) LANE_MODEL="$2" ;;
        --effort) LANE_EFFORT="$2" ;;
        --name) LANE_NAME="$2" ;;
        --prompt) LANE_PROMPT="$2" ;;
        --prompt-file) LANE_PROMPT_FILE="$2" ;;
      esac
      shift ;;
    --trust) LANE_TRUST=true; LANE_FLAGS+=("$1") ;;
    --close) MODE=close ;;
    --force) CLOSE_FORCE=true ;;
    --archive) CLOSE_ARCHIVE=true ;;
    --attach) MODE=attach; [[ "${2:-}" == -* || -z "${2:-}" ]] || { ATTACH_TARGET="$2"; shift } ;;
    --save)   MODE=save;   [[ "${2:-}" == -* || -z "${2:-}" ]] || { FILE="$2"; shift } ;;
    --resume) MODE=resume; [[ "${2:-}" == -* || -z "${2:-}" ]] || { FILE="$2"; shift } ;;
    --open)   MODE=open;   [[ "${2:-}" == -* || -z "${2:-}" ]] || { FILE="$2"; shift } ;;
    --autosave) MODE=autosave ;;
    --recent) MODE=recent; [[ "${2:-}" == <1-> ]] && { RECENT_HOURS="$2"; shift } ;;
    --json)   MODE=json ;;
    --) shift; START_ARGS=("$@"); break ;;
    --help|-h) usage; exit 0 ;;
    *)
      if [[ "$MODE" == start && -n "$START_TOOL" && -z "$START_DIR" && "$1" != -* ]]; then
        START_DIR="$1"
      elif [[ "$MODE" == close && "$1" != -* ]]; then
        CLOSE_TARGETS+=("$1")
      else
        print -ru2 -- "Unknown option: $1"; usage >&2; exit 2
      fi ;;
  esac
  shift
done

if (( ${#LANE_FLAGS} > 0 )) && [[ "$MODE" != start ]]; then
  print -ru2 -- "Error: ${LANE_FLAGS[1]} belongs to --start codex"; exit 2
fi
if [[ "$MODE" != close ]] && { $CLOSE_FORCE || $CLOSE_ARCHIVE }; then
  print -ru2 -- "Error: --force and --archive belong to --close"; exit 2
fi

save_dir() {
  if [[ -n "${FLAKELAB_STATE_ROOT:-}" ]]; then
    print -r -- "${FLAKELAB_STATE_ROOT}/claude/sessions"
  else
    print -r -- "${HOME}/.local/state/flakelab/sessions"
  fi
}

# The first twelve hex digits of the boot id: unique enough per host, short
# enough for a file name.
boot_id() {
  local b
  [[ -r "${BOOT_ID_FILE}" ]] || return 1
  b="$(<"${BOOT_ID_FILE}")"
  b="${b//-/}"
  [[ -n "$b" ]] || return 1
  print -r -- "${b[1,12]}"
}

# <hostname>-<machine>: the prefix of every file this box writes, and the only
# prefix the default --resume/--open reads.
box_id() {
  local m=""
  [[ -r "${MACHINE_ID_FILE}" ]] && m="$(<"${MACHINE_ID_FILE}")"
  m="${m//[^0-9a-f]/}"
  print -r -- "${HOST}${m:+-${m[1,12]}}"
}
BOX="$(box_id)"

autosave_name() { print -r -- "${BOX}-autosave-$1.txt" }

is_tool() { (( ${TOOLS[(Ie)$1]} )) }

# ---------------------------------------------------------------------------
# tmux: where a process lives, and the windows --start / --open create.

# A tmux that is on PATH but cannot answer -V (broken, or the suite's stand-in
# for absence) counts as no tmux.
have_tmux() { command -v tmux >/dev/null 2>&1 && tmux -V >/dev/null 2>&1 }

# pane pid -> "<window id> US <window name>", for every pane of the agents
# session. Empty when tmux is absent or no server runs; never an error.
typeset -A PANE_WINDOW=()
# window id -> the Codex session flakelab started or resumed in it (the tmux
# window option @flakelab_session). Kept apart from PANE_WINDOW, whose readers
# take the window name as their last field.
typeset -A WINDOW_SESSION=()
load_panes() {
  local line pid sess wid wname wsid
  PANE_WINDOW=()
  WINDOW_SESSION=()
  have_tmux || return 0
  while IFS="$US" read -r pid sess wid wname wsid; do
    [[ "$sess" == "$TMUX_SESSION" ]] || continue
    PANE_WINDOW[$pid]="${wid}${US}${wname}"
    [[ -n "$wsid" ]] && WINDOW_SESSION[$wid]="$wsid"
  done < <(tmux list-panes -a -F "#{pane_pid}${US}#{session_name}${US}#{window_id}${US}#{window_name}${US}#{@flakelab_session}" 2>/dev/null)
  return 0
}

# The parent pid from /proc/<pid>/stat: field 4, after the ")" that closes the
# comm, which may itself hold spaces and parentheses.
ppid_of() {
  local stat
  stat="$(<"${PROC_ROOT}/$1/stat")" 2>/dev/null || return 1
  stat="${stat##*) }"
  print -r -- "${${(s: :)stat}[2]}"
}

# The agents window whose pane is an ancestor of pid: "<window id> US <name>",
# or empty. Bounded: a /proc that lies about ppid must not loop.
host_of() {
  local p="$1" hop
  (( ${#PANE_WINDOW} > 0 )) || return 0
  for hop in {1..64}; do
    [[ -n "$p" && "$p" != 0 && "$p" != 1 ]] || return 0
    if (( ${+PANE_WINDOW[$p]} )); then print -r -- "${PANE_WINDOW[$p]}"; return 0; fi
    p="$(ppid_of "$p")" || return 0
  done
  return 0
}

# A window name tmux targets take unambiguously: no ":" or ".", which are
# target separators, and no spaces.
window_name() {
  local n="$1-${2:t}"
  n="${n//[:. ]/_}"
  print -r -- "${n[1,40]}"
}

# The command a window runs, one shell word per argument.
tool_command() {
  local tool="$1"; shift
  local cmd="${TOOL_CMD[$tool]}"
  (( $# > 0 )) && cmd+=" ${(j: :)${(q)@}}"
  print -r -- "$cmd"
}

typeset -a WINDOW_ENV=()
# The window gets the caller's PATH: it runs with the server's env, and any client may have started the server.
new_window() {
  local name="$1" dir="$2" cmd="$3" handover_cwd="${TYCSWAP_HANDOVER_CWD:-}" digest="${TYCSWAP_HANDOVER_DIGEST:-}"
  local -a env_args=(-e "PATH=${PATH}" -e TYCSWAP_HANDOVER_CWD= -e TYCSWAP_HANDOVER_DIGEST=)
  if [[ -n "$handover_cwd" || -n "$digest" ]]; then
    [[ "$handover_cwd" == /* && -d "$handover_cwd" && "$digest" =~ '^[[:xdigit:]]{64}$' ]] || {
      print -ru2 -- "Error: handover needs an absolute existing directory and a 64-hex digest"; return 2
    }
    env_args=(-e "PATH=${PATH}" -e "TYCSWAP_HANDOVER_CWD=${handover_cwd}" -e "TYCSWAP_HANDOVER_DIGEST=${digest}")
  fi
  # A lane's window must reach the Codex home its session was created in, handover or not.
  (( ${#WINDOW_ENV} > 0 )) && env_args+=("${WINDOW_ENV[@]}")
  if tmux has-session -t "$TMUX_SESSION" 2>/dev/null; then
    tmux new-window -d -P -F '#{window_id}' -t "$TMUX_SESSION" -n "$name" "${env_args[@]}" -c "$dir" "$cmd"
  else
    tmux new-session -d -P -F '#{window_id}' -s "$TMUX_SESSION" -n "$name" "${env_args[@]}" -c "$dir" "$cmd"
  fi
}

# Not `destroy-unattached`: since tmux 3.4 it kills a detached-made view before anything attaches.
new_view() {
  local wid="$1" view
  view="${TMUX_SESSION}-${wid#@}-$$"
  tmux new-session -d -t "$TMUX_SESSION" -s "$view" >/dev/null 2>&1 || return 1
  tmux set-hook -t "$view" client-detached "kill-session -t ${view}" >/dev/null 2>&1 || true
  tmux select-window -t "${view}:${wid}" >/dev/null 2>&1 || true
  print -r -- "$view"
}

# Attach this terminal to window wid — a switch when it is already inside
# tmux, a fresh view otherwise. An empty wid attaches to the whole server.
attach_window() {
  local wid="$1" view
  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$TMUX_SESSION" || return 1
    [[ -n "$wid" ]] && tmux select-window -t "$wid"
    return 0
  fi
  if [[ -z "$wid" ]]; then
    exec tmux attach-session -t "$TMUX_SESSION"
  fi
  view="$(new_view "$wid")" || { print -ru2 -- "Error: could not open a view on ${wid}"; return 1 }
  exec tmux attach-session -t "$view"
}

# ---------------------------------------------------------------------------
# The live sessions.

typeset -a ROWS=()
US=$'\x1f'
# Codex session ids whose state the table asks Codex's shared server for: the
# ones recorded on windows and the ones the shared server's own process holds.
# A session held by another Codex process is not asked for: the shared server
# would call it unloaded while it runs.
typeset -A ASK=()
typeset -A STATE_OF=() MODEL_OF=() EFFORT_OF=()

# lib/codex_threads.py; FLAKELAB_CODEX_THREADS is the suite's seam.
codex_threads() {
  if [[ -n "${FLAKELAB_CODEX_THREADS:-}" ]]; then
    "${FLAKELAB_CODEX_THREADS}" "$@"
  else
    python3 "${SCRIPT_DIR}/lib/codex_threads.py" "$@"
  fi
}

# Only the table and --json ask. The other modes need ids, not states, and
# must not wait on a server: 5 s for all ids together, because the dashboard
# gives this command 60 s and polls every 15.
load_states() {
  local out sid st model effort
  local -i unanswered=0
  (( ${#ASK} > 0 )) || return 0
  for sid in "${(@k)ASK}"; do STATE_OF[$sid]="?"; done
  out="$(codex_threads state --deadline 5 "${(@k)ASK}" 2>/dev/null)" || {
    print -ru2 -- "note: Codex's shared server did not answer; STATE and MODEL are unknown"
    return 0
  }
  # "none": the server gave no answer for this id in time, or an error. "missing": it
  # does not know the id. Both show ?, only the first is worth a note.
  while IFS="$US" read -r sid st model effort; do
    [[ -n "$sid" ]] || continue
    case "$st" in
      none) st="?"; (( unanswered++ )) ;;
      missing) st="?" ;;
    esac
    STATE_OF[$sid]="$st"; MODEL_OF[$sid]="$model"; EFFORT_OF[$sid]="$effort"
  done < <(print -r -- "$out" | jq -r '.[] | [.session, (.state // "none"), (.model // ""), (.effort // "")] | join("\u001f")' 2>/dev/null)
  (( unanswered > 0 )) && print -ru2 -- "note: Codex's shared server answered for $(( ${#ASK} - unanswered )) of ${#ASK} sessions; the others show ?"
  return 0
}

# The uuid the process holds open: for Claude Code a transcript, for Codex a
# rollout file whose name ends in the id. The most-opened uuid wins, so a
# stray path that merely contains one cannot outvote the transcript.
open_uuid() {
  local p="$1" pattern="$2"
  for f in "${PROC_ROOT}/${p}"/fd/*(@N); do readlink "$f"; done 2>/dev/null |
    grep -E "$pattern" |
    grep -oE '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' |
    sort | uniq -c | sort -rn | head -1 | awk '{print $2}'
}

# Claude can rename its process to a version number. Its registry supplies
# candidates, but only a local Claude executable makes a PID live: a synced or
# stale registry entry must never identify an unrelated process on this box.
claude_pids() {
  local reg p exe
  pgrep -x "${TOOL_PROC[claude]}" 2>/dev/null
  for reg in "${REGISTRY}"/<->.json(N) "${TYCSWAP_PROFILES}"/*/sessions/<->.json(N) "${TYCSWAP_GROUPS}"/{fable,opus}/profile/sessions/<->.json(N); do
    p="${reg:t:r}"
    exe="$(readlink "${PROC_ROOT}/${p}/exe" 2>/dev/null)" || continue
    [[ "${exe:t}" == claude || "$exe" == */claude/versions/* ]] && print -r -- "$p"
  done
  return 0
}

# A daemon may hold many conversations. Keep every distinct rollout, with its
# own directory, and exclude internal subagents (including guardian threads).
# Never infer a session from the newest file in a shared/synced directory.
codex_sessions() {
  local p="$1" fallback="$2" f transcript sid meta cwd
  local -A seen=()
  for f in "${PROC_ROOT}/${p}"/fd/*(@N); do
    transcript="$(readlink "$f" 2>/dev/null)" || continue
    [[ "${transcript:t}" == rollout-*.jsonl ]] || continue
    sid="$(print -r -- "${transcript:t}" | grep -oE '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\.jsonl$')"
    sid="${sid%.jsonl}"
    [[ -n "$sid" && -z "${seen[$sid]:-}" ]] || continue
    seen[$sid]=1
    cwd="$fallback"
    if [[ -r "$f" ]]; then
      meta="$(head -n 1 "$f" 2>/dev/null)"
      if print -r -- "$meta" | jq -e '.type == "session_meta"' >/dev/null 2>&1; then
        print -r -- "$meta" | jq -e '.payload.source | type == "object" and has("subagent")' >/dev/null 2>&1 && continue
        cwd="$(print -r -- "$meta" | jq -r '.payload.cwd // empty')"
        [[ -n "$cwd" ]] || cwd="$fallback"
      fi
    fi
    print -r -- "${sid}${US}${cwd}"
  done
  return 0
}

profile_group() {
  case "$1" in
    "${TYCSWAP_GROUPS}/fable/profile") print fable ;;
    "${TYCSWAP_GROUPS}/opus/profile") print opus ;;
  esac
  return 0
}

process_profile() {
  local p="$1" item f target
  if [[ -r "${PROC_ROOT}/${p}/environ" ]]; then
    for item in "${(@0)$(<"${PROC_ROOT}/${p}/environ")}"; do
      [[ "$item" == CLAUDE_CONFIG_DIR=* ]] && { print -r -- "${item#*=}"; return 0; }
    done
  fi
  for f in "${PROC_ROOT}/${p}"/fd/*(@N); do
    target="$(readlink "$f" 2>/dev/null)" || continue
    [[ "$target" == */projects/*/*.jsonl ]] || continue
    print -r -- "${target%%/projects/*}"; return 0
  done
  return 0
}

# Records are unit-separator delimited: a tab is IFS whitespace to `read`, so an empty id would shift the cwd.
gather() {
  local tool p cwd sid age reg started now host wid wname record group profile
  local -a pids args sessions
  now="$(date +%s)"
  load_panes
  for tool in "${TOOLS[@]}"; do
    if [[ "$tool" == claude ]]; then
      pids=( ${(f)"$(claude_pids | sort -nu)"} )
    else
      pids=( $(pgrep -x "${TOOL_PROC[$tool]}" 2>/dev/null) )
    fi
    for p in "${pids[@]}"; do
      cwd="$(readlink "${PROC_ROOT}/${p}/cwd" 2>/dev/null)" || continue
      args=()
      [[ -r "${PROC_ROOT}/${p}/cmdline" ]] && args=( "${(@0)$(<"${PROC_ROOT}/${p}/cmdline")}" )
      # Supervisors have no conversation to restore. The app-server itself
      # is scanned below because it owns the CLI clients' conversations.
      [[ "$tool" == claude && "${args[2]:-}" == daemon ]] && continue
      [[ "$tool" == codex && "${args[2]:-}" == app-server && "${args[3]:-}" == daemon ]] && continue
      sid=""; age=""; sessions=(); group=""; profile=""
      case "$tool" in
        claude)
          profile="$(process_profile "$p")"
          [[ -n "$profile" ]] && profile="${profile:A}"
          reg="${profile:-${HOME}/.claude}/sessions/${p}.json"
          if [[ -z "$profile" && ! -r "$reg" ]]; then
            for reg in "${TYCSWAP_GROUPS}"/{fable,opus}/profile/sessions/${p}.json(N) "${TYCSWAP_PROFILES}"/*/sessions/${p}.json(N); do
              profile="${reg:h:h}"; break
            done
          fi
          [[ "$profile" == "${HOME}/.claude" ]] && profile=""
          group="$(profile_group "$profile")"
          if [[ -r "$reg" ]]; then
            sid="$(jq -r '.sessionId // empty' "$reg" 2>/dev/null)"
            started="$(jq -r '.startedAt // empty' "$reg" 2>/dev/null)"
            [[ "$started" == <-> ]] && age=$(( now - started / 1000 ))
          fi
          [[ -n "$sid" ]] || sid="$(open_uuid "$p" '\.jsonl$')"
          sessions=("${sid}${US}${cwd}")
          ;;
        codex)
          sessions=( "${(@f)$(codex_sessions "$p" "$cwd")}" )
          # A server with no user conversations is infrastructure, not a
          # starting session. An id-less CLI can be starting or be a client.
          if [[ -z "${sessions[1]:-}" ]]; then
            [[ "${args[2]:-}" == app-server ]] && continue
            sessions=("${US}${cwd}")
          fi
          ;;
      esac
      [[ -n "$age" ]] || age="$(ps -o etimes= -p "$p" 2>/dev/null | tr -d ' ')"
      host="$(host_of "$p")"
      IFS="$US" read -r wid wname <<<"$host"
      for record in "${sessions[@]}"; do
        IFS="$US" read -r sid cwd <<<"$record"
        if [[ "$tool" == codex ]]; then
          # The client in a lane's window holds no rollout: its window names its session.
          [[ -z "$sid" && -n "${wid:-}" && -n "${WINDOW_SESSION[${wid:-none}]:-}" ]] && sid="${WINDOW_SESSION[$wid]}"
          [[ -n "$sid" ]] && { [[ "${args[2]:-}" == app-server || -n "${WINDOW_SESSION[${wid:-none}]:-}" ]] && ASK[$sid]=1 }
        fi
        [[ -z "$sid" ]] && print -ru2 -- "note: ${tool} pid ${p} in ${cwd} has no local session id: starting or a client of a shared server; nothing to save or resume by this pid"
        ROWS+=("${tool}${US}${p}${US}${age:-0}${US}${sid}${US}${cwd}${US}${wid:-}${US}${wname:-}${US}${group}${US}${profile}")
      done
    done
  done
}

typeset -a SESSION_ROWS=()
# One row per session; the oldest process wins by age, not pgrep's pid order, which breaks after pid wraparound.
dedupe_sessions() {
  local row tool p age sid cwd wid wname group profile key
  local -A best=() best_age=()
  local -a order=()
  for row in "${ROWS[@]}"; do
    IFS="$US" read -r tool p age sid cwd wid wname group profile <<<"$row"
    [[ -n "$sid" ]] || continue
    key="${tool}${US}${sid}${US}${profile}"
    if (( ${+best[$key]} )); then
      (( age > best_age[$key] )) || continue
    else
      order+=("$key")
    fi
    best[$key]="$row"
    best_age[$key]=$age
  done
  SESSION_ROWS=()
  for key in "${order[@]}"; do SESSION_ROWS+=("${best[$key]}"); done
}

fmt_age() {
  local -i s=${1:-0}
  if (( s >= 86400 )); then printf '%dd%02dh' $(( s / 86400 )) $(( s % 86400 / 3600 ))
  elif (( s >= 3600 )); then printf '%dh%02dm' $(( s / 3600 )) $(( s % 3600 / 60 ))
  else printf '%dm' $(( s / 60 ))
  fi
}

print_table() {
  local row tool p age sid cwd wid wname group profile st model
  if (( ${#ROWS[@]} == 0 )); then
    print -ru2 -- "no running agent sessions"
    return 0
  fi
  printf '%-7s %-8s %-7s %-36s %-18s %-9s %-22s %-8s %s\n' TOOL PID AGE SESSION HOST STATE MODEL GROUP DIRECTORY
  for row in "${ROWS[@]}"; do
    IFS="$US" read -r tool p age sid cwd wid wname group profile <<<"$row"
    st="${STATE_OF[${sid:-none}]:--}"
    model="${MODEL_OF[${sid:-none}]:-}"
    [[ -n "$model" ]] && model+="${EFFORT_OF[${sid:-none}]:+ ${EFFORT_OF[${sid:-none}]}}"
    printf '%-7s %-8s %-7s %-36s %-18s %-9s %-22s %-8s %s\n' "$tool" "$p" "$(fmt_age "$age")" "${sid:--}" "${wname:--}" "$st" "${model:--}" "${group:--}" "$cwd"
  done
}

print_json() {
  local row tool p age sid cwd wid wname group profile
  for row in "${ROWS[@]}"; do
    IFS="$US" read -r tool p age sid cwd wid wname group profile <<<"$row"
    jq -n --arg tool "$tool" --argjson pid "$p" --argjson age "$age" --arg session "$sid" --arg cwd "$cwd" \
      --arg group "$group" --arg profile "$profile" --arg distro "${WSL_DISTRO_NAME:-}" --arg tmux "$TMUX_SESSION" --arg wid "$wid" --arg wname "$wname" \
      --arg state "${STATE_OF[${sid:-none}]:-}" --arg model "${MODEL_OF[${sid:-none}]:-}" --arg effort "${EFFORT_OF[${sid:-none}]:-}" \
      '{tool: $tool, pid: $pid, age_seconds: $age, session: (if $session == "" then null else $session end), cwd: $cwd,
        state: (if $state == "" or $state == "?" then null else $state end),
        model: (if $model == "" then null else $model end), effort: (if $effort == "" then null else $effort end),
        group: (if $group == "" then null else $group end), profile: (if $profile == "" then null else $profile end),
        host: (if $wid == "" then null else {session: $tmux, window: $wname, id: $wid} end),
        distro: (if $distro == "" then null else $distro end)}'
  done | jq -s .
}

# Profile sessions use JSON lines with group/profile and the actual session id.
# Unmanaged sessions keep the older two-space format.
save_line() {
  if [[ -n "${5:-}" ]]; then
    jq -cn --arg tool "$1" --arg cwd "$2" --arg session "$3" --arg group "${4:-}" --arg profile "$5" \
      '{tool:$tool,cwd:$cwd,session:$session,group:$group,profile:$profile}'
  else
    print -r -- "$1  $2  $3"
  fi
}

write_save() {
  local dir tmp row tool p age sid cwd wid wname group profile
  local -a lines=()
  if [[ -z "$FILE" ]]; then
    dir="$(save_dir)"
    mkdir -p "$dir" || { print -ru2 -- "Error: cannot create ${dir}"; return 1 }
    FILE="${dir}/${BOX}-$(date +%Y-%m-%dT%H%M).txt"
  fi
  dedupe_sessions
  for row in "${SESSION_ROWS[@]}"; do
    IFS="$US" read -r tool p age sid cwd wid wname group profile <<<"$row"
    lines+=("$(save_line "$tool" "$cwd" "$sid" "$group" "$profile")")
  done
  # The same atomic replacement and sync-excluded scratch names as autosave.
  # Check each write: a later successful counter must not hide a disk error.
  tmp="$(mktemp "${FILE:h}/.${FILE:t}.flakelab-tmp.XXXXXX")" || { print -ru2 -- "Error: cannot write ${FILE}"; return 1 }
  if ! {
    print -r -- "# claude-sessions ${BOX}${WSL_DISTRO_NAME:+ distro=${WSL_DISTRO_NAME}} $(date -Is)" &&
      { (( ${#lines[@]} == 0 )) || print -rl -- "${lines[@]}"; }
  } > "$tmp" || ! mv -fT -- "$tmp" "$FILE"; then
    rm -f -- "$tmp"
    print -ru2 -- "Error: cannot write ${FILE}"
    return 1
  fi
  print -ru2 -- "saved ${#lines[@]} session(s) to ${FILE}"
}

# The timer's snapshot, in the save shape. Sorted, so a changed pgrep order is
# not a changed set; quiet when nothing changed; placed by rename, because the
# save directory may be a synced folder. The temp name is one the state sync
# already treats as scratch.
write_autosave() {
  local boot dir file tmp row tool p age sid cwd wid wname group profile
  local -a lines=() old=()
  boot="$(boot_id)" || { print -ru2 -- "Error: cannot read the boot id from ${BOOT_ID_FILE}"; return 1 }
  gather 2>/dev/null
  dedupe_sessions
  for row in "${SESSION_ROWS[@]}"; do
    IFS="$US" read -r tool p age sid cwd wid wname group profile <<<"$row"
    lines+=("$(save_line "$tool" "$cwd" "$sid" "$group" "$profile")")
  done
  # Nothing running keeps the last snapshot: after a crash that is the record.
  (( ${#lines[@]} > 0 )) || return 0
  lines=("${(@o)lines}")
  dir="$(save_dir)"
  mkdir -p "$dir" || { print -ru2 -- "Error: cannot create ${dir}"; return 1 }
  file="${dir}/$(autosave_name "$boot")"
  if [[ -f "$file" && "$(grep -v '^#' "$file")" == "${(F)lines}" ]]; then
    return 0
  fi
  tmp="$(mktemp "${dir}/.${file:t}.flakelab-tmp.XXXXXX")" || { print -ru2 -- "Error: cannot write in ${dir}"; return 1 }
  if ! {
    print -r -- "# claude-sessions autosave ${BOX}${WSL_DISTRO_NAME:+ distro=${WSL_DISTRO_NAME}} boot=${boot} $(date -Is)" &&
      print -rl -- "${lines[@]}"
  } > "$tmp" || ! mv -fT -- "$tmp" "$file"; then
    rm -f "$tmp"
    print -ru2 -- "Error: cannot write ${file}"
    return 1
  fi
  print -ru2 -- "autosaved ${#lines[@]} session(s) to ${file}"
  old=("${dir}/${BOX}"-autosave-*.txt(Nom))
  (( ${#old[@]} > AUTOSAVE_KEEP )) && rm -f -- "${old[@]:$AUTOSAVE_KEEP}"
  return 0
}

# A saved line into tool, cwd and sid. The tool column is new; a line without
# one (a file from before it, or written by hand) is Claude Code. Split at
# the LAST double space for the id and the FIRST for the tool, so a directory
# with two spaces in its name still parses.
parse_line() {
  local line="$1" rest
  PL_TOOL=claude; PL_GROUP=""; PL_PROFILE=""
  if [[ "$line" == \{* ]]; then
    local fields
    fields="$(print -r -- "$line" | jq -er '[.tool,.cwd,.session,(.group // ""),(.profile // "")] | if all(.[]; type == "string" and (contains("\u001f") | not)) then join("\u001f") else error("bad snapshot") end' 2>/dev/null)" || return 1
    IFS="$US" read -r PL_TOOL PL_CWD PL_SID PL_GROUP PL_PROFILE <<<"$fields"
    is_tool "$PL_TOOL" && [[ -n "$PL_SID" && ( -z "$PL_GROUP" || "$PL_GROUP" == fable || "$PL_GROUP" == opus ) ]] || return 1
    return 0
  fi
  if [[ "$line" == *"  "*"  "* ]] && is_tool "${line%%  *}"; then
    PL_TOOL="${line%%  *}"
    line="${line#*  }"
  fi
  PL_SID="${line##*  }"
  PL_CWD="${line%  *}"
}
PL_TOOL=""; PL_SID=""; PL_CWD=""; PL_GROUP=""; PL_PROFILE=""

# PAIRS: "<tool> US <cwd> US <sid>" per session to bring back — from FILE,
# else the newest save, else the live sessions. Prints the source as a comment.
typeset -a PAIRS=()
collect_pairs() {
  local src="$FILE" line row tool p age sid cwd wid wname group profile f cur=""
  if [[ -z "$src" ]]; then
    # This box's newest save; (N) keeps an empty directory from being a glob
    # error. Another box's files, even from the same hostname, name that box's
    # sessions, and this boot's own autosave is the live set: neither is what
    # a restart here left behind.
    cur="$(boot_id)" || cur=""
    for f in "$(save_dir)"/${BOX}-*.txt(Nom); do
      [[ -n "$cur" && "${f:t}" == "$(autosave_name "$cur")" ]] && continue
      src="$f"
      break
    done
  fi
  if [[ -n "$src" ]]; then
    [[ -r "$src" ]] || { print -ru2 -- "Error: cannot read ${src}"; return 1 }
    print -r -- "# from ${src}"
    while IFS= read -r line; do
      [[ "$line" == \#* || -z "$line" ]] && continue
      parse_line "$line" || { print -ru2 -- "Error: invalid snapshot line in ${src}"; return 1 }
      PAIRS+=("${PL_TOOL}${US}${PL_CWD}${US}${PL_SID}${US}${PL_GROUP}${US}${PL_PROFILE}")
    done < "$src"
  else
    gather
    print -r -- "# from the live sessions (no saved file)"
    for row in "${ROWS[@]}"; do
      IFS="$US" read -r tool p age sid cwd wid wname group profile <<<"$row"
      [[ -n "$sid" ]] || continue
      PAIRS+=("${tool}${US}${cwd}${US}${sid}${US}${group}${US}${profile}")
    done
  fi
  # A saved file can carry the same session twice as well — one written
  # before this fix, or one merged from two boxes — so the dedupe covers
  # every source, not just the live one.
  local -A seen=()
  local -a uniq=()
  for row in "${PAIRS[@]}"; do
    IFS="$US" read -r tool cwd sid group profile <<<"$row"
    (( ${+seen[${tool}${US}${sid}${US}${profile}]} )) && continue
    seen[${tool}${US}${sid}${US}${profile}]=1
    uniq+=("$row")
  done
  PAIRS=("${uniq[@]}")
  (( ${#PAIRS[@]} > 0 )) || { print -ru2 -- "nothing to resume"; return 1 }
}

# The tool's own resume command for a session id.
typeset -a RESUME_ARGS=()
# A retired tycswap group's history is copied into ~/.claude when the group
# retires, so its sessions resume on the default login; until then, in the
# group's own profile.
resume_args() {
  local tool="$1" sid="$2" group="${3:-}" profile="${4:-}"
  if [[ "$tool" == claude && -n "$group" ]] && default_copy "$sid"; then
    RESUME_ARGS=(claude --resume "$sid")
  elif [[ "$tool" == claude && -n "$profile" ]]; then
    RESUME_ARGS=(env "CLAUDE_CONFIG_DIR=${profile}" claude --resume "$sid")
  elif [[ "$tool" == claude ]]; then
    RESUME_ARGS=(claude --resume "$sid")
  else
    RESUME_ARGS=(codex resume "$sid")
  fi
}

default_copy() {
  local -a copies=("${HOME}"/.claude/projects/*/${1}.jsonl(N))
  (( ${#copies} > 0 ))
}

resume_cmd() {
  resume_args "$@"
  print -r -- "${(j: :)${(@q)RESUME_ARGS}}"
}

# One resume line: the cd only where this box has the directory.
resume_line() {
  local tool="$1" cwd="$2" sid="$3" note="${4:-}" group="${5:-}" profile="${6:-}" cmd
  cmd="$(resume_cmd "$tool" "$sid" "$group" "$profile")"
  if [[ -n "$cwd" && -d "$cwd" ]]; then
    print -r -- "cd ${(q)cwd} && ${cmd}${note:+  # ${note}}"
  elif [[ -n "$cwd" ]]; then
    print -r -- "${cmd}  # ${note:+${note}, }${cwd} is not on this box"
  else
    print -r -- "${cmd}${note:+  # ${note}}"
  fi
}

print_resume() {
  local pair tool cwd sid group profile
  collect_pairs || return 1
  print -r -- "# one line per terminal — in one shell they run in sequence"
  for pair in "${PAIRS[@]}"; do
    IFS="$US" read -r tool cwd sid group profile <<<"$pair"
    resume_line "$tool" "$cwd" "$sid" "" "$group" "$profile"
  done
}

# `-w 0` targets this shell's terminal window; with interop off there is no wt.exe and --resume is the answer.
# A session still running is never resumed again: both processes would append
# to one transcript. Its agents window gets a view instead, unless a client
# already shows it.
open_tabs() {
  local pair tool cwd sid group profile tab_cwd wid wname view key row p age att n=0 use_tmux=false
  local -A live_pid=() live_wid=() live_wname=() shown=()
  [[ -n "${WSL_DISTRO_NAME:-}" ]] || { print -ru2 -- "Error: --open needs a WSL distro (WSL_DISTRO_NAME is unset)"; return 2 }
  command -v wt.exe >/dev/null 2>&1 || { print -ru2 -- "Error: wt.exe not on PATH — is WSL interop on? Use --resume instead"; return 2 }
  have_tmux && use_tmux=true
  collect_pairs || return 1
  ROWS=()
  gather 2>/dev/null
  for row in "${ROWS[@]}"; do
    IFS="$US" read -r tool p age sid cwd wid wname group profile <<<"$row"
    [[ -n "$sid" ]] || continue
    key="${tool}${US}${sid}${US}${profile}"
    if (( ! ${+live_pid[$key]} )) || [[ -z "${live_wid[$key]}" && -n "$wid" ]]; then
      live_pid[$key]="$p"; live_wid[$key]="$wid"; live_wname[$key]="$wname"
    fi
  done
  if $use_tmux; then
    while IFS="$US" read -r view att wid; do
      [[ "$att" == <-> ]] && (( att > 0 )) && shown[$wid]=1
    done < <(tmux list-sessions -F "#{session_name}${US}#{session_attached}${US}#{window_id}" 2>/dev/null)
  fi
  for pair in "${PAIRS[@]}"; do
    IFS="$US" read -r tool cwd sid group profile <<<"$pair"
    key="${tool}${US}${sid}${US}${profile}"
    wid=""
    if (( ${+live_pid[$key]} )); then
      wid="${live_wid[$key]}"
      if ! $use_tmux || [[ -z "$wid" ]]; then
        print -ru2 -- "${tool} ${sid} is already running (pid ${live_pid[$key]}), not resumed again"
        continue
      fi
      if (( ${+shown[$wid]} )); then
        print -ru2 -- "${tool} ${sid} is already open in a tab (${live_wname[$key]})"
        continue
      fi
    fi
    tab_cwd="$cwd"
    [[ -d "$tab_cwd" ]] || tab_cwd="$HOME"
    if $use_tmux; then
      if [[ -z "$wid" ]]; then
        wid="$(new_window "$(window_name "$tool" "$cwd")" "$tab_cwd" "$(resume_cmd "$tool" "$sid" "$group" "$profile")")" || { print -ru2 -- "tmux could not start a window for ${cwd} ${sid}"; continue }
        # So a session brought back after a restart can be found and closed like a lane.
        if [[ "$tool" == codex ]] && ! tmux set-option -w -t "$wid" @flakelab_session "$sid" >/dev/null 2>&1; then
          print -ru2 -- "note: window ${wid} could not be marked with session ${sid}: the table and --close will not know it"
        fi
      fi
      view="$(new_view "$wid")" || { print -ru2 -- "tmux could not open a view on ${wid}"; continue }
      shown[$wid]=1
      wt.exe -w 0 new-tab --title "${cwd:t}" wsl.exe -d "${WSL_DISTRO_NAME}" -- tmux attach-session -t "$view" </dev/null >/dev/null 2>&1 &&
        (( ++n )) || print -ru2 -- "wt.exe failed for ${cwd} ${sid}"
    else
      [[ "$tab_cwd" == "$HOME" ]] && tab_cwd="~"
      resume_args "$tool" "$sid" "$group" "$profile"
      wt.exe -w 0 new-tab --title "${cwd:t}" wsl.exe -d "${WSL_DISTRO_NAME}" --cd "${tab_cwd}" -- "${RESUME_ARGS[@]}" </dev/null >/dev/null 2>&1 &&
        (( ++n )) || print -ru2 -- "wt.exe failed for ${cwd} ${sid}"
    fi
  done
  print -ru2 -- "opened ${n} tab(s)"
}

# Session files only (<slug>/<id>.jsonl): subagent transcripts sit a level
# deeper. The cwd is the last one the session recorded — where it was working
# when it stopped — read from the tail, never the whole transcript. A Codex
# rollout names its id in the file name and its cwd in the session_meta line
# at its head.
# print_recent collects "<mtime> US <resume line>" here and sorts it, so the
# list is newest first across all tools.
typeset -a RECENT=()
recent_add() {
  local f="$1" tool="$2" cwd="$3" sid="$4" extra="${5:-}" group="${6:-}" profile="${7:-}" stamp
  stamp="$(date -r "$f" '+%s %Y-%m-%d %H:%M')"
  RECENT+=("${stamp%% *}${US}$(resume_line "$tool" "$cwd" "$sid" "${stamp#* }${extra:+, ${extra}}" "$group" "$profile")")
}

print_recent() {
  local -A live=() seen=()
  local row tool p age sid cwd wid wname group profile f
  gather 2>/dev/null
  for row in "${ROWS[@]}"; do
    IFS="$US" read -r tool p age sid cwd wid wname group profile <<<"$row"
    [[ -n "$sid" ]] && live[${tool}${US}${sid}${US}${profile}]=1
  done
  print -r -- "# not running, changed in the last ${RECENT_HOURS}h — newest first"
  # A profile that shares the history links projects/ to ~/.claude's, so the
  # same transcript is globbed twice: the first sighting lists it.
  for f in "${HOME}"/.claude/projects/*/*.jsonl(N.mh-${RECENT_HOURS}om) "${TYCSWAP_PROFILES}"/*/projects/*/*.jsonl(N.mh-${RECENT_HOURS}om) "${TYCSWAP_GROUPS}"/{fable,opus}/profile/projects/*/*.jsonl(N.mh-${RECENT_HOURS}om); do
    sid="${f:t:r}"
    profile="${${f:A}:h:h:h}"
    [[ "$profile" == "${HOME}/.claude" ]] && profile=""
    # A retired group's copy in ~/.claude is the one listed.
    [[ -n "$(profile_group "$profile")" ]] && default_copy "$sid" && continue
    [[ -n "${live[claude${US}${sid}${US}${profile}]:-}" || -n "${seen[claude${US}${sid}${US}${profile}]:-}" ]] && continue
    seen[claude${US}${sid}${US}${profile}]=1
    cwd="$(tail -n 50 "$f" | jq -R -r 'fromjson? | .cwd? // empty' 2>/dev/null | tail -n 1)"
    group="$(profile_group "$profile")"
    recent_add "$f" claude "$cwd" "$sid" "" "$group" "$profile"
  done
  for f in "${HOME}"/.codex/sessions/**/rollout-*.jsonl(N.mh-${RECENT_HOURS}om); do
    sid="$(print -r -- "${f:t}" | grep -oE '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' | tail -1)"
    [[ -n "$sid" ]] || continue
    [[ -n "${live[codex${US}${sid}${US}]:-}" ]] && continue
    seen[codex${US}${sid}${US}]=1
    cwd="$(head -n 5 "$f" | jq -R -r 'fromjson? | select(.type? == "session_meta") | .payload.cwd? // empty' 2>/dev/null | head -n 1)"
    recent_add "$f" codex "$cwd" "$sid"
  done
  # The state root's synced transcripts (remote-sessions.md): what
  # another box left there and this one has not pulled yet. Resuming one
  # needs the pull first; the line says so. A session already listed from
  # this box's own copy is not repeated.
  if [[ -n "${FLAKELAB_STATE_ROOT:-}" && -d "${FLAKELAB_STATE_ROOT}" ]]; then
    local pull="synced, not yet pulled here: flakelab backup --state-only first"
    for f in "${FLAKELAB_STATE_ROOT}"/claude/projects/*/*.jsonl(N.mh-${RECENT_HOURS}om); do
      sid="${f:t:r}"
      [[ -n "${live[claude${US}${sid}${US}]:-}" || -n "${seen[claude${US}${sid}${US}]:-}" ]] && continue
      [[ -f "${HOME}/.claude/projects/${f:h:t}/${f:t}" ]] && continue
      cwd="$(tail -n 50 "$f" | jq -R -r 'fromjson? | .cwd? // empty' 2>/dev/null | tail -n 1)"
      recent_add "$f" claude "$cwd" "$sid" "${pull}"
    done
    for f in "${FLAKELAB_STATE_ROOT}"/codex/sessions/**/rollout-*.jsonl(N.mh-${RECENT_HOURS}om); do
      sid="$(print -r -- "${f:t}" | grep -oE '[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}' | tail -1)"
      [[ -n "$sid" ]] || continue
      [[ -n "${live[codex${US}${sid}${US}]:-}" || -n "${seen[codex${US}${sid}${US}]:-}" ]] && continue
      cwd="$(head -n 5 "$f" | jq -R -r 'fromjson? | select(.type? == "session_meta") | .payload.cwd? // empty' 2>/dev/null | head -n 1)"
      recent_add "$f" codex "$cwd" "$sid" "${pull}"
    done
  fi
  for row in "${(@On)RECENT}"; do print -r -- "${row#*${US}}"; done
  (( ${#RECENT} > 0 )) || print -ru2 -- "no stopped session changed in the last ${RECENT_HOURS}h"
  return 0
}

# The home directory as ~, for a line a person reads.
tilde() { [[ "$1" == "$HOME" || "$1" == "$HOME"/* ]] && print -r -- "~${1#$HOME}" || print -r -- "$1" }

# --start with no tool, at a terminal: which tool, then where (this directory
# unless changed), then the command that would have said so. tmux first, so
# nobody answers two questions for a start that cannot happen.
ask_start() {
  local t
  local -a labels=()
  typeset -A name=(claude 'Claude Code' codex 'Codex')
  have_tmux || { print -ru2 -- "Error: --start needs tmux on PATH"; return 2 }
  for t in "${TOOLS[@]}"; do
    if command -v "${TOOL_PROC[$t]}" >/dev/null 2>&1; then
      labels+=("$(printf '%-7s %s' "$t" "${name[$t]}")")
    else
      labels+=("$(printf '%-7s %s (not on PATH)' "$t" "${name[$t]}")")
    fi
  done
  prompt_choose "Start which tool?" "${labels[@]}" || return 130
  START_TOOL="${TOOLS[PROMPT_INDEX]}"
  # Emptied, the answer is here, as a start without a directory is; the line
  # printed below must name it, since '' is no directory the flags take.
  prompt_input "In which directory?" "$PWD" || return 130
  START_DIR="${PROMPT_TEXT:-$PWD}"
  prompt_ran flakelab sessions --start "$START_TOOL" "$START_DIR" ${${START_DETACH:#false}:+--detach} ${START_ARGS:+--} "${START_ARGS[@]}"
}

# --start: a window in the agents session running the tool, then a view on it.
# A lane: the session is created and its first turn started through Codex's
# protocol, then its window opens on it. The order is the point: see the header.
start_lane() {
  local dir="${START_DIR:-$PWD}" name out sid model effort wid
  local -a helper_args=() taken=() alive=()
  [[ "$START_TOOL" == codex ]] || { print -ru2 -- "Error: ${LANE_FLAGS[1]} is for --start codex; ${START_TOOL} takes its own flags after --"; return 2 }
  (( ${#START_ARGS} == 0 )) || { print -ru2 -- "Error: ${LANE_FLAGS[1]} cannot be combined with -- args"; return 2 }
  (( ${LANE_FLAGS[(Ie)--prompt]} && ${LANE_FLAGS[(Ie)--prompt-file]} )) && { print -ru2 -- "Error: --prompt and --prompt-file exclude each other"; return 2 }
  [[ -n "$LANE_PROMPT" || -n "$LANE_PROMPT_FILE" ]] || { print -ru2 -- "Error: ${LANE_FLAGS[1]} needs --prompt or --prompt-file: a Codex session has no file, and keeps no effort, before its first turn"; return 2 }
  if [[ -n "$LANE_PROMPT_FILE" ]]; then
    [[ -f "$LANE_PROMPT_FILE" && -r "$LANE_PROMPT_FILE" && -s "$LANE_PROMPT_FILE" ]] || { print -ru2 -- "Error: --prompt-file ${LANE_PROMPT_FILE} is missing, unreadable or empty"; return 2 }
  fi
  if (( ${LANE_FLAGS[(Ie)--name]} )); then
    # A name tmux targets take and the window list can carry: the list is read line by line.
    [[ "$LANE_NAME" != -* && "$LANE_NAME" != *[[:space:][:cntrl:]:.]* && ${#LANE_NAME} -le 40 ]] || { print -ru2 -- "Error: --name must be a window name: no ':', '.', space or control character, no leading '-', at most 40 characters"; return 2 }
  fi
  have_tmux || { print -ru2 -- "Error: --start needs tmux on PATH"; return 2 }
  [[ -d "$dir" ]] || { print -ru2 -- "Error: no such directory: ${dir}"; return 2 }
  # Absolute, in the caller's spelling: Codex may hold the trust decision under a symlink's name.
  dir="${dir:a}"
  name="${LANE_NAME:-$(window_name codex "$dir")}"
  # Read into an array, then look: a pipe into grep -q can fail a match under pipefail.
  taken=( "${(@f)$(tmux list-windows -t "$TMUX_SESSION" -F '#{window_name}' 2>/dev/null)}" )
  if [[ -n "$LANE_NAME" ]] && (( ${taken[(Ie)$LANE_NAME]} )); then
    print -ru2 -- "Error: a window named ${LANE_NAME} exists in ${TMUX_SESSION}"; return 1
  fi
  helper_args=(start --cwd "$dir")
  # As one word each: a value that begins with a dash stays a value.
  [[ -n "$LANE_MODEL" ]] && helper_args+=("--model=${LANE_MODEL}")
  [[ -n "$LANE_EFFORT" ]] && helper_args+=("--effort=${LANE_EFFORT}")
  [[ -n "$LANE_NAME" ]] && helper_args+=("--name=${LANE_NAME}")
  $LANE_TRUST && helper_args+=(--trust)
  # The prompt goes to the helper on stdin, byte for byte, never on its command line.
  if [[ -n "$LANE_PROMPT_FILE" ]]; then
    out="$(codex_threads "${helper_args[@]}" < "$LANE_PROMPT_FILE")" || return $?
  else
    out="$(print -rn -- "$LANE_PROMPT" | codex_threads "${helper_args[@]}")" || return $?
  fi
  IFS="$US" read -r sid model effort <<<"$(print -r -- "$out" | jq -r '[.session, .model, .effort] | join("\u001f")' 2>/dev/null)"
  [[ -n "$sid" ]] || { print -ru2 -- "Error: the helper named no session"; return 1 }
  # From here the session runs, whatever becomes of its window.
  [[ -n "${CODEX_HOME:-}" ]] && WINDOW_ENV=(-e "CODEX_HOME=${CODEX_HOME}")
  wid="$(new_window "$name" "$dir" "$(tool_command codex resume "$sid")")" || {
    print -ru2 -- "Error: tmux could not start the window; the session runs without one: codex resume ${sid}"; return 1
  }
  # Written and read back: without the mark the table does not know the window, and --close refuses it.
  if ! tmux set-option -w -t "$wid" @flakelab_session "$sid" >/dev/null 2>&1 ||
    [[ "$(tmux show-options -w -v -t "$wid" @flakelab_session 2>/dev/null)" != "$sid" ]]; then
    print -ru2 -- "Error: window ${name} (${wid}) could not be marked with its session, so the table and --close will not know it; the session runs: codex resume ${sid}"
    return 1
  fi
  sleep "$LANE_SETTLE"
  alive=( "${(@f)$(tmux list-windows -t "$TMUX_SESSION" -F '#{window_id}' 2>/dev/null)}" )
  (( ${alive[(Ie)$wid]} )) || {
    print -ru2 -- "Error: the window closed at once; the session runs without one: codex resume ${sid}"; return 1
  }
  print -ru2 -- "started codex ${model} ${effort} in ${dir} as ${TMUX_SESSION}:${name} (${wid}), session ${sid}"
  if $START_DETACH || [[ ! -t 0 || ! -t 1 ]]; then
    print -ru2 -- "attach with: flakelab sessions --attach ${name}"
    print -ru2 -- "close with:  flakelab sessions --close ${name}"
    return 0
  fi
  attach_window "$wid"
}

# The windows of the agents session as tmux has them now: id, name, recorded session,
# panes, start command.
typeset -a LANE_ROWS=()
lane_rows() {
  local line rows
  LANE_ROWS=()
  rows="$(tmux list-windows -t "$TMUX_SESSION" -F "#{window_id}${US}#{window_name}${US}#{@flakelab_session}${US}#{window_panes}${US}#{pane_start_command}" 2>/dev/null)" || return 1
  while IFS= read -r line; do
    [[ -n "$line" ]] && LANE_ROWS+=("$line")
  done <<<"$rows"
  return 0
}

# Why a window is not a lane flakelab may remove; nothing when it is one. It must record
# a session id, have one pane, and that pane's start command must be exactly the
# `codex resume <id>` flakelab starts lanes with: a command that merely contains those
# words is someone else's. tmux reports a command with spaces in double quotes.
lane_fault() {
  local wsid="$1" panes="$2" startcmd="$3" want
  if [[ -z "$wsid" ]]; then
    print -r -- "records no Codex session; flakelab cannot judge what runs in it"
  elif [[ ! "$wsid" =~ '^[0-9a-f]{8}-([0-9a-f]{4}-){3}[0-9a-f]{12}$' ]]; then
    print -r -- "records something that is no session id"
  elif [[ "$panes" != 1 ]]; then
    print -r -- "has ${panes} panes"
  else
    want="$(tool_command codex resume "$wsid")"
    [[ "$startcmd" == "$want" || "$startcmd" == "\"${want}\"" ]] || print -r -- "was not started by flakelab on session ${wsid}"
  fi
  return 0
}

# Remove window wid if it still is the lane of session sid. tmux decides in one step: its
# server compares pane count, recorded session and start command at the moment of the
# kill, so a window that was split or reused after it was last read stays. 0: it is gone.
kill_lane() {
  local wid="$1" sid="$2" want fmt
  want="$(tool_command codex resume "$sid")"
  fmt="#{&&:#{==:#{session_name},${TMUX_SESSION}},#{&&:#{==:#{window_panes},1},#{&&:#{==:#{@flakelab_session},${sid}},#{||:#{==:#{pane_start_command},${want}},#{==:#{pane_start_command},\"${want}\"}}}}}"
  lane_in_time || return 1
  tmux if-shell -F -t "$wid" "$fmt" "kill-window -t ${wid}" >/dev/null 2>&1 || return 1
  lane_absent "$wid"
}

lane_absent() {
  local rows
  local -a alive=()
  rows="$(tmux list-windows -a -F '#{window_id}' 2>/dev/null)" || return 1
  alive=( "${(@f)rows}" )
  (( ! ${alive[(Ie)$1]} ))
}

lane_in_time() {
  [[ -z "${FLAKELAB_CODEX_UNTIL:-}" ]] && return 0
  python3 -c 'import os,sys,time; sys.exit(time.monotonic() >= float(os.environ["FLAKELAB_CODEX_UNTIL"]))' && return 0
  print -ru2 -- "not closed: the stop deadline expired; ${LANE_STOP_DONE}; no further window removal or archive was sent"
  return 1
}

# --close: a window is a view, the conversation lives on Codex's server. The
# window goes when the session, its helper agents and its commands are
# finished; --force stops those first, for every view of the session. Nothing
# locks the conversation: another client can send it a prompt after the last
# look, which lib/codex_threads.py takes immediately before this removes the
# window. The window itself is read again then, and tmux compares it once more
# at the kill (kill_lane): what is removed is the lane that was judged.
close_sessions() {
  local line wid wname wsid panes startcmd target sid w check cwd fault stopped
  local -x FLAKELAB_CODEX_UNTIL=""
  local LANE_STOP_DONE=""
  local -i rc=0
  local bad found
  local -a by_id=() by_name=() by_session=() chosen=() order=() removed=() kept=()
  local -A windows_of=()
  have_tmux || { print -ru2 -- "Error: --close needs tmux on PATH"; return 2 }
  (( ${#CLOSE_TARGETS} > 0 )) || { print -ru2 -- "Error: --close needs a window or a session id"; return 2 }
  lane_rows || { print -ru2 -- "Error: windows of ${TMUX_SESSION} could not be read; nothing was closed"; return 1 }
  # A target that selects no window is a usage error, found before anything is closed.
  for target in "${CLOSE_TARGETS[@]}"; do
    bad=true
    for line in "${LANE_ROWS[@]}"; do
      IFS="$US" read -r wid wname wsid panes startcmd <<<"$line"
      [[ "$wid" == "$target" || "$wname" == "$target" || ( -n "$wsid" && "$wsid" == "$target" ) ]] && { bad=false; break }
    done
    $bad && { print -ru2 -- "Error: no window of ${TMUX_SESSION} is named '${target}' or holds that session — flakelab sessions lists them"; return 2 }
  done
  for target in "${CLOSE_TARGETS[@]}"; do
    by_id=(); by_name=(); by_session=()
    for line in "${LANE_ROWS[@]}"; do
      IFS="$US" read -r wid wname wsid panes startcmd <<<"$line"
      [[ "$wid" == "$target" ]] && by_id+=("$line")
      [[ "$wname" == "$target" ]] && by_name+=("$line")
      [[ -n "$wsid" && "$wsid" == "$target" ]] && by_session+=("$line")
    done
    if (( ${#by_id} > 0 )); then chosen=("${by_id[@]}")
    elif (( ${#by_name} == 1 )); then chosen=("${by_name[@]}")
    elif (( ${#by_name} > 1 )); then
      print -ru2 -- "not closed: several windows are named '${target}': ${(j: :)${(@)by_name%%${US}*}}; name one by its id"
      rc=1; continue
    else chosen=("${by_session[@]}")
    fi
    bad=false
    for line in "${chosen[@]}"; do
      IFS="$US" read -r wid wname wsid panes startcmd <<<"$line"
      fault="$(lane_fault "$wsid" "$panes" "$startcmd")"
      [[ -n "$fault" ]] && { print -ru2 -- "not closed: window ${wname} (${wid}) ${fault}"; bad=true }
    done
    $bad && { rc=1; continue }
    for line in "${chosen[@]}"; do
      IFS="$US" read -r wid wname wsid panes startcmd <<<"$line"
      (( ${order[(Ie)$wsid]} )) || order+=("$wsid")
      [[ " ${windows_of[$wsid]:-} " == *" ${wid} "* ]] || windows_of[$wsid]="${windows_of[$wsid]:-} ${wid}"
    done
  done
  for sid in "${order[@]}"; do
    FLAKELAB_CODEX_UNTIL=""
    if $CLOSE_FORCE; then
      # A stop that fails says what it had done; its windows stay.
      stopped="$(codex_threads stop --with-deadline "$sid")" || { rc=1; continue }
      FLAKELAB_CODEX_UNTIL="$(print -r -- "$stopped" | jq -r '.until // empty')"
      LANE_STOP_DONE="$(print -r -- "$stopped" | jq -r '"interrupted: " + (.interrupted | join(", ")) + "; background commands ended in: " + (.cleaned | join(", "))')"
      [[ -n "$FLAKELAB_CODEX_UNTIL" ]] || { print -ru2 -- "Error: stop named no deadline; ${LANE_STOP_DONE}; windows untouched"; rc=1; continue }
      # After a stop an error state no longer holds the window: what could be ended, was.
      check="$(codex_threads close-check --after-stop "$sid")" || { print -ru2 -- "not closed: ${sid}; ${LANE_STOP_DONE}; windows untouched"; rc=1; continue }
    else
      check="$(codex_threads close-check "$sid")" || { rc=1; continue }
    fi
    if [[ "$(print -r -- "$check" | jq -r '.finished')" != true ]]; then
      print -ru2 -- "not closed: ${sid}: $(print -r -- "$check" | jq -r '.reasons | join("; ")')$($CLOSE_FORCE || print -r -- " — --force stops that first")"
      rc=1; continue
    fi
    cwd="$(print -r -- "$check" | jq -r '.cwd // ""')"
    # The windows as they are now: the check above took time, and so did earlier targets.
    lane_rows || { print -ru2 -- "not closed: windows of ${sid} could not be read; unverified:${windows_of[$sid]}; nothing was archived"; rc=1; continue }
    lane_in_time || { rc=1; continue }
    removed=(); kept=()
    for w in ${=windows_of[$sid]}; do
      found=false; fault=""
      for line in "${LANE_ROWS[@]}"; do
        IFS="$US" read -r wid wname wsid panes startcmd <<<"$line"
        [[ "$wid" == "$w" ]] || continue
        found=true
        fault="$(lane_fault "$wsid" "$panes" "$startcmd")"
        [[ -z "$fault" && "$wsid" != "$sid" ]] && fault="now records session ${wsid}"
        break
      done
      if ! $found; then
        if lane_absent "$w"; then
          removed+=("$w")
        else
          print -ru2 -- "not closed: window ${w} left ${TMUX_SESSION}, or its absence could not be verified"
          kept+=("$w")
        fi
      elif [[ -n "$fault" ]]; then
        print -ru2 -- "not closed: window ${w} changed since it was judged: it ${fault}"
        kept+=("$w")
      elif kill_lane "$w" "$sid"; then
        removed+=("$w")
      else
        print -ru2 -- "not closed: window ${w} could not be removed, or changed at the last moment"
        kept+=("$w")
      fi
    done
    if (( ${#kept} > 0 )); then
      print -ru2 -- "session ${sid}: still there: ${(j: :)kept}; removed: ${${(j: :)removed}:-none}; nothing was archived"
      rc=1; continue
    fi
    if $CLOSE_ARCHIVE; then
      lane_in_time || {
        print -ru2 -- "Error: windows ${(j: :)removed} of ${sid} are gone and the session is not archived"
        resume_line codex "$cwd" "$sid"
        rc=1; continue
      }
      if codex_threads archive "$sid" >/dev/null; then
        print -r -- "codex unarchive ${sid}"
      else
        print -ru2 -- "Error: the window of ${sid} is gone and the session is not archived"; rc=1
      fi
    fi
    resume_line codex "$cwd" "$sid"
    print -ru2 -- "closed ${sid} ($(print -r -- "$check" | jq -r '.state'))"
  done
  return $rc
}

start_session() {
  if $START_ASK; then ask_start || return $?; fi
  if (( ${#LANE_FLAGS} > 0 )); then start_lane; return $?; fi
  local dir="${START_DIR:-$PWD}" name cmd wid
  is_tool "$START_TOOL" || { print -ru2 -- "Error: unknown tool '${START_TOOL}' (${(j:|:)TOOLS})"; return 2 }
  have_tmux || { print -ru2 -- "Error: --start needs tmux on PATH"; return 2 }
  [[ -d "$dir" ]] || { print -ru2 -- "Error: no such directory: ${dir}"; return 2 }
  dir="${dir:A}"
  name="$(window_name "$START_TOOL" "$dir")"
  cmd="$(tool_command "$START_TOOL" "${START_ARGS[@]}")"
  wid="$(new_window "$name" "$dir" "$cmd")" || { print -ru2 -- "Error: tmux could not start the window"; return 1 }
  print -ru2 -- "started ${START_TOOL} in ${dir} as ${TMUX_SESSION}:${name} (${wid})"
  if $START_DETACH || [[ ! -t 0 || ! -t 1 ]]; then
    print -ru2 -- "attach with: flakelab sessions --attach ${name}"
    return 0
  fi
  attach_window "$wid"
}

# --attach with no target, at a terminal: every window of the agents session,
# the session each one runs where there is one, and the whole server last.
# Sets ATTACH_WID (empty: the whole server) and prints the command that says so.
ATTACH_WID=""
ask_attach() {
  local row tool p age sid cwd wid wname group profile
  local -a labels=() wids=() keys=()
  local -A seen=()
  gather 2>/dev/null
  for row in "${ROWS[@]}"; do
    IFS="$US" read -r tool p age sid cwd wid wname group profile <<<"$row"
    [[ -n "$wid" && -z "${seen[$wid]:-}" ]] || continue
    seen[$wid]=1
    labels+=("$(printf '%-7s %-7s %-9s %s' "$tool" "$(fmt_age "$age")" "${${sid:--}[1,8]}" "$(tilde "$cwd")")")
    wids+=("$wid"); keys+=("${sid:-$wid}")
  done
  for row in "${(v)PANE_WINDOW[@]}"; do
    IFS="$US" read -r wid wname <<<"$row"
    [[ -z "${seen[$wid]:-}" ]] || continue
    seen[$wid]=1
    labels+=("$(printf '%-7s %s' window "$wname")")
    wids+=("$wid"); keys+=("$wid")
  done
  labels+=("every window (the whole ${TMUX_SESSION} session)")
  wids+=(""); keys+=("")
  prompt_choose "Attach to which session?" "${labels[@]}" || return 130
  ATTACH_WID="${wids[PROMPT_INDEX]}"
  prompt_ran flakelab sessions --attach ${keys[PROMPT_INDEX]:+"${keys[PROMPT_INDEX]}"}
}

# --attach: by session id (the window its process runs in), by window name, or
# the whole server.
attach_session() {
  local target="$ATTACH_TARGET" row tool p age sid cwd wid wname group profile found=""
  have_tmux || { print -ru2 -- "Error: --attach needs tmux on PATH"; return 2 }
  tmux has-session -t "$TMUX_SESSION" 2>/dev/null || { print -ru2 -- "Error: no '${TMUX_SESSION}' tmux session — start one with: flakelab sessions --start <tool>"; return 2 }
  if [[ -z "$target" ]] && prompt_tty; then
    ask_attach || return $?
    attach_window "$ATTACH_WID"
    return $?
  fi
  if [[ -z "$target" ]]; then
    attach_window ""
    return $?
  fi
  gather 2>/dev/null
  for row in "${ROWS[@]}"; do
    IFS="$US" read -r tool p age sid cwd wid wname group profile <<<"$row"
    [[ -n "$wid" ]] || continue
    if [[ "$sid" == "$target" || "$wname" == "$target" || "$wid" == "$target" ]]; then found="$wid"; break; fi
  done
  if [[ -z "$found" ]]; then
    load_panes
    for row in "${(v)PANE_WINDOW[@]}"; do
      IFS="$US" read -r wid wname <<<"$row"
      [[ "$wname" == "$target" || "$wid" == "$target" ]] && { found="$wid"; break }
    done
  fi
  [[ -n "$found" ]] || { print -ru2 -- "Error: no window holds '${target}' — flakelab sessions lists the hosts"; return 2 }
  attach_window "$found"
}

case "$MODE" in
  list)     gather; load_states; print_table ;;
  json)     gather; load_states; print_json ;;
  save)     gather; print_table; write_save ;;
  resume)   print_resume ;;
  open)     open_tabs ;;
  autosave) write_autosave ;;
  recent)   print_recent ;;
  start)    start_session ;;
  attach)   attach_session ;;
  close)    close_sessions ;;
esac
