#!/usr/bin/env zsh

set -uo pipefail

# Activate pre-commit hooks across cloned repos, in two passes: repos shipping their
# own hooks/ directory get core.hooksPath, repos with a .pre-commit-config.yaml get
# the framework shims installed or repointed.
# The stdout markers report what happened; the exit status is the gate, so a repo
# left unhooked fails the run rather than being reported as success.

REPOS_DIR=""

while (( $# > 0 )); do
  case $1 in
    --repos-dir) REPOS_DIR="$2"; shift ;;
    --help|-h)
      echo "Usage: activate-hooks --repos-dir <path>"
      exit 0 ;;
    *) echo "Unknown arg: $1" >&2; exit 1 ;;
  esac
  shift
done

if [[ -z "$REPOS_DIR" ]]; then
  echo "Missing --repos-dir argument" >&2
  exit 1
fi

if [[ ! -d "$REPOS_DIR" ]]; then
  echo "SUMMARY repos-dir $REPOS_DIR does not exist yet, nothing to do"
  exit 0
fi

# PATH first: on NixOS pre-commit is in the profile, which no hardcoded path covers.
# The explicit list is the fallback for callers with a stripped PATH.
PRECOMMIT="$(command -v pre-commit 2>/dev/null || true)"
for pc in "$HOME/.local/bin/pre-commit" /usr/bin/pre-commit /usr/local/bin/pre-commit /home/linuxbrew/.linuxbrew/bin/pre-commit; do
  [[ -n "$PRECOMMIT" ]] && break
  if [[ -x "$pc" ]]; then
    PRECOMMIT="$pc"
    break
  fi
done

shim_count=0
shim_installed=0
shim_skipped=0
shim_failed=0
pc_missing_count=0
hooksdir_count=0
hooksdir_set=0

# Pass 1: repos shipping their own hooks/ directory.
while IFS= read -r hooks_dir; do
  repo="${hooks_dir%/hooks}"
  [[ -d "$repo/.git" ]] || continue
  # Only claim a hooks/ that holds git hooks: pointing core.hooksPath at a directory
  # of application code silently disables every hook in that repo.
  has_git_hook=0
  for hook_name in pre-commit pre-push commit-msg prepare-commit-msg pre-rebase \
                   pre-merge-commit post-checkout post-merge post-commit post-rewrite; do
    [[ -x "$hooks_dir/$hook_name" ]] && { has_git_hook=1; break; }
  done
  (( has_git_hook )) || continue
  hooksdir_count=$((hooksdir_count + 1))
  current=$(git -C "$repo" config --local --get core.hooksPath 2>/dev/null || true)
  if [[ "$current" != "hooks" ]]; then
    # A hooksPath resolving to a live directory is that repo's own gate.
    if [[ -n "$current" ]]; then
      cur_target="$current"
      [[ "$cur_target" == /* ]] || cur_target="$repo/$cur_target"
      [[ -d "$cur_target" ]] && continue
    fi
    git -C "$repo" config --local core.hooksPath hooks
    hooksdir_set=$((hooksdir_set + 1))
    echo "HOOKSPATH_SET $repo"
  fi
done < <(find "$REPOS_DIR" -type d -name hooks -not -path '*/.git/*' 2>/dev/null)

# Pass 2: repos with .pre-commit-config.yaml
while IFS= read -r config; do
  shim_count=$((shim_count + 1))
  repo="${config%/.pre-commit-config.yaml}"
  [[ -d "$repo/.git" ]] || continue

  current_hooks_path=$(git -C "$repo" config --local --get core.hooksPath 2>/dev/null || true)

  # Do not unset a live core.hooksPath to let pre-commit install: that disables the
  # repo's real hook, and some repos keep the config for --all-files only.
  if [[ -n "$current_hooks_path" ]]; then
    hooks_target="$current_hooks_path"
    [[ "$hooks_target" == /* ]] || hooks_target="$repo/$hooks_target"
    if [[ -d "$hooks_target" ]]; then
      shim_skipped=$((shim_skipped + 1))
      continue
    fi
  fi

  shim_exists=0
  if grep -q 'pre-commit.com' "$repo/.git/hooks/pre-commit" 2>/dev/null; then
    shim_exists=1
  fi
  push_shim_exists=0
  if grep -q 'pre-commit.com' "$repo/.git/hooks/pre-push" 2>/dev/null; then
    push_shim_exists=1
  fi

  # Both types must be in place, or a `stages: [pre-push]` hook silently never runs.
  # Staleness is whether the recorded interpreter still exists - a collected
  # /nix/store python kills every commit - not a comparison against pre-commit's own
  # shebang, which is a bash wrapper and would repoint every repo on every run.
  if [[ $shim_exists -eq 1 && $push_shim_exists -eq 1 && -z "$current_hooks_path" ]]; then
    cur_py=$(sed -n 's/^INSTALL_PYTHON=//p' "$repo/.git/hooks/pre-commit" 2>/dev/null | head -1)
    if [[ -z "$cur_py" || -x "$cur_py" ]]; then
      continue
    fi
    if [[ -z "$PRECOMMIT" ]]; then
      pc_missing_count=$((pc_missing_count + 1))
      echo "PRECOMMIT_NOT_FOUND cannot repoint dead shim in $repo"
      continue
    fi
    if ( cd "$repo" && "$PRECOMMIT" install --overwrite -t pre-commit -t pre-push >/dev/null ); then
      shim_installed=$((shim_installed + 1))
      echo "SHIM_REPOINTED $repo"
    else
      shim_failed=$((shim_failed + 1))
      echo "SHIM_FAILED $repo (repoint)"
    fi
    continue
  fi

  if [[ -z "$PRECOMMIT" ]]; then
    pc_missing_count=$((pc_missing_count + 1))
    echo "PRECOMMIT_NOT_FOUND skipping $repo"
    continue
  fi

  # A dangling hooksPath gates nothing and blocks the shim install.
  if [[ -n "$current_hooks_path" ]]; then
    git -C "$repo" config --local --unset-all core.hooksPath 2>/dev/null || true
  fi

  # Keep stderr and the status: a swallowed failure leaves the repo unhooked while
  # the run still reports "changed".
  if [[ -f "$repo/Makefile" ]] && grep -q '^install-hooks:' "$repo/Makefile"; then
    ( PATH="$(dirname "$PRECOMMIT"):$PATH" make -C "$repo" install-hooks >/dev/null )
    install_rc=$?
    # An install-hooks target predating the pre-push type leaves that hook out.
    if (( install_rc == 0 )) && [[ ! -f "$repo/.git/hooks/pre-push" ]]; then
      ( cd "$repo" && "$PRECOMMIT" install -t pre-push >/dev/null )
      install_rc=$?
    fi
  else
    ( cd "$repo" && "$PRECOMMIT" install -t pre-commit -t pre-push >/dev/null )
    install_rc=$?
  fi

  if (( install_rc == 0 )); then
    shim_installed=$((shim_installed + 1))
    echo "SHIM_INSTALLED $repo"
  else
    shim_failed=$((shim_failed + 1))
    echo "SHIM_FAILED $repo (rc=$install_rc)"
  fi
done < <(find "$REPOS_DIR" -type f -name '.pre-commit-config.yaml' -not -path '*/.git/*' 2>/dev/null)

echo "SUMMARY hooks/=$hooksdir_count set=$hooksdir_set precommit-config=$shim_count installed=$shim_installed skipped(hooksPath)=$shim_skipped skipped(already_ok)=$((shim_count - shim_installed - shim_failed - pc_missing_count - shim_skipped)) failed=$shim_failed pc_missing=$pc_missing_count"

# A repo left unhooked by a missing binary is the same false green as a failed
# install. Key on the count, not on $PRECOMMIT: a fully-shimmed box must still pass.
if (( pc_missing_count > 0 )); then
  echo "ERROR: pre-commit binary not found; $pc_missing_count repo(s) left without hooks" >&2
  exit 1
fi

if (( shim_failed > 0 )); then
  echo "ERROR: pre-commit hook install failed for $shim_failed repo(s)" >&2
  exit 1
fi

exit 0
