print -r -- ""
print -r -- "a session on a tycswap profile (tycswap run / tycswap env)"
SID_P=facefeed-0000-0000-0000-000000000009
PROFILE="${HOME}/.local/share/tycswap/sessions/2-b_example.com"
mkdir -p "${PROFILE}/sessions" "${PROFILE}/projects/-other"
print -r -- "{\"pid\":300,\"sessionId\":\"${SID_P}\",\"cwd\":\"${BASE}/other\",\"startedAt\":${NOW_MS}}" > "${PROFILE}/sessions/300.json"
run
# Match the row without its age: on a loaded box this can run past 1m.
check "pid 300 takes its id from the profile's own registry" \
  "$(print -r -- "${OUT}" | grep -E '^claude  300 +[0-9]+[dhm]' | grep -c -- "${SID_P}")" "1"
excludes "and is no longer noted as id-less" "${ERR}" "claude pid 300"
SID_Q=facefeed-0000-0000-0000-000000000010
print -r -- "{\"type\":\"user\",\"cwd\":\"${BASE}/other\"}" > "${PROFILE}/projects/-other/${SID_Q}.jsonl"
run --recent
contains "--recent reads a transcript a profile kept for itself" "${OUT}" "claude --resume ${SID_Q}  # "
excludes "and leaves the running profile session out" "${OUT}" "${SID_P}"
run --save "${BASE}/legacy-profile.txt"
check "a legacy profile snapshot retains the profile" "$(jq -Rr --arg id "$SID_P" 'fromjson? | select(.session == $id) | .profile' "${BASE}/legacy-profile.txt")" "$PROFILE"
run --resume "${BASE}/legacy-profile.txt"
contains "a legacy profile resumes in its original config directory" "$OUT" "env CLAUDE_CONFIG_DIR=${PROFILE} claude --resume ${SID_P}"
# A profile that shares the history (tycswap's default) links projects/ to
# ~/.claude's: the same transcript is globbed twice and listed once.
mkdir -p "${PROFILE:h}/3-c_example.com"
ln -s "${HOME}/.claude/projects" "${PROFILE:h}/3-c_example.com/projects"
run --recent
check "a transcript reached through a profile's projects link is listed once" "$(print -r -- "$OUT" | grep -c "claude --resume ${SID_C}")" "1"
# The seam: another store root, the registry moved there and gone from the default one.
mkdir -p "${BASE}/root2/sessions/9-z_example.com/sessions"
mv "${PROFILE}/sessions/300.json" "${BASE}/root2/sessions/9-z_example.com/sessions/300.json"
check "FLAKELAB_TYCSWAP_ROOT points the scan at another store" \
  "$(FLAKELAB_TYCSWAP_ROOT="${BASE}/root2" "${CMD}" 2>/dev/null | grep -E '^claude  300 +[0-9]+[dhm]' | grep -c -- "${SID_P}")" "1"

