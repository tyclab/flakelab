print -r -- "@3${US}lane-a${US}${SID_S}${US}1${US}codex resume ${SID_S}" > "${TMUX_WINDOWS}"
run_lane --start codex "${WORK}" --name lane-a --prompt go --detach
check "a name already in use exits 1" "${RC}" "1"
