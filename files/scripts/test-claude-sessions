# The table. Pid 8600 is the client in a lane's window (@6, which records
# SID_L): it holds no rollout. Pid 8700 is Codex's shared server and holds
# SID_S. Pid 500 holds its own rollout and is no shared server.
print -r -- ""
print -r -- "lanes: the table's session, STATE and MODEL"
mk_proc 8060 "${WORK}" 1
mk_proc 8600 "${WORK}" 8060 /dev/null
mk_proc 8700 "${BASE}/other" 1 "${HOME}/.codex/sessions/2026/09/24/rollout-2026-09-24T11-00-00-${SID_S}.jsonl"
printf 'codex\0app-server\0--listen\0' > "${PROC}/8700/cmdline"
{
  print -r -- "20${US}agents${US}@2${US}claude-work_dir${US}"
  print -r -- "50${US}agents${US}@5${US}codex-codex_proj${US}"
  print -r -- "8060${US}agents${US}@6${US}lane-a${US}${SID_L}"
} > "${TMUX_PANES}"
LANE_PIDS=$'500\n8600\n8700'
fresh
HELPER_BUSY="${SID_L}" FAKE_PGREP_ONLY="${LANE_PIDS}" run_lane
check "the table with lanes exits 0" "${RC}" "0"
contains "the client in a lane's window shows the session its window records, working, with model and effort" "${OUT}" "codex   8600     0m      ${SID_L} lane-a             working   gpt-6.1-sol xhigh      -        ${WORK}"
contains "a session of the shared server shows its state" "${OUT}" "${SID_S} -                  idle      gpt-6.1-sol xhigh"
contains "a Codex process that holds its own rollout is not asked about" "${OUT}" "${SID_X} codex-codex_proj   -         -     "
check "one helper call for all ids, with the 5 s limit" "$(<"${HELPER_LOG}")" "state --deadline 5 ${SID_L} ${SID_S}"
excludes "the lane's client is no longer a row without a session" "${ERR}" "pid 8600"

fresh
HELPER_BUSY="${SID_L}" FAKE_PGREP_ONLY="${LANE_PIDS}" run_lane --json
check "--json: state, model and effort of the lane" "$(print -r -- "$OUT" | jq -c '.[] | select(.pid == 8600) | [.session, .state, .model, .effort, .host.window]')" "[\"${SID_L}\",\"working\",\"gpt-6.1-sol\",\"xhigh\",\"lane-a\"]"
check "--json: null for a session that is not asked about" "$(print -r -- "$OUT" | jq -c '.[] | select(.pid == 500) | [.state, .model, .effort]')" "[null,null,null]"
check "--json keeps its keys and their types" "$(print -r -- "$OUT" | jq -c '.[] | select(.pid == 8600) | [(.pid|type), (.age_seconds|type), (.cwd|type), (.host|type), (.group|type), (.profile|type), (.distro|type)]')" '["number","number","string","object","null","null","null"]'

fresh
HELPER_FAIL=state FAKE_PGREP_ONLY="${LANE_PIDS}" run_lane
check "a server that does not answer leaves the table and exit 0" "${RC}" "0"
contains "with ? for what was asked" "${OUT}" "${SID_L} lane-a             ?         -     "
contains "and one note" "${ERR}" "Codex's shared server did not answer"
HELPER_FAIL=state FAKE_PGREP_ONLY="${LANE_PIDS}" run_lane --json
check "--json: null when the server did not answer" "$(print -r -- "$OUT" | jq -c '.[] | select(.pid == 8600) | .state')" "null"

fresh
HELPER_NO_ANSWER="${SID_L}" FAKE_PGREP_ONLY="${LANE_PIDS}" run_lane
check "an answer for only some sessions leaves the table and exit 0" "${RC}" "0"
contains "with ? for the one without" "${OUT}" "${SID_L} lane-a             ?         -     "
contains "the state of the other" "${OUT}" "${SID_S} -                  idle      gpt-6.1-sol xhigh"
contains "and one note that says how many" "${ERR}" "note: Codex's shared server answered for 1 of 2 sessions; the others show ?"

: > "${TMUX_LOG}"
FAKE_PGREP_ONLY="${LANE_PIDS}" run_tmux --attach "${SID_L}"
check "--attach by a lane's session id exits 0" "${RC}" "0"
contains "and finds the lane's window through the id it records" "$(<"${TMUX_LOG}")" "select-window -t agents-6-"

fresh
export FLAKELAB_STATE_ROOT="${BASE}/lane-state"
FAKE_PGREP_ONLY="${LANE_PIDS}" run_lane --save "${BASE}/lane-save.txt"
FAKE_PGREP_ONLY="${LANE_PIDS}" run_lane --autosave
FAKE_PGREP_ONLY="${LANE_PIDS}" run_lane --resume "${BASE}/lane-save.txt"
FAKE_PGREP_ONLY="${LANE_PIDS}" run_lane --recent
unset FLAKELAB_STATE_ROOT
check "--save, --autosave, --resume and --recent ask the helper nothing" "$(wc -l < "${HELPER_LOG}")" "0"
check "a lane is saved once, like any session" "$(grep -c "${SID_L}" "${BASE}/lane-save.txt")" "1"

# --close. The windows file is what tmux lists: id, name, recorded session,
# panes, start command.
print -r -- ""
print -r -- "lanes: --close"
# tmux reports a start command that holds spaces in double quotes; that is what a lane's row looks like.
win() { print -r -- "$1${US}$2${US}$3${US}${4:-1}${US}${5-\"codex resume $3\"}" }
# The windows of every case, written anew each time: a closed window leaves the list.
windows() {
  {
    win @6 lane-a "${SID_L}"
    win @7 lane-b "${SID_S}"
    win @8 lane-b-view "${SID_S}"
    win @9 plain ""
    win @11 split "${SID_L}" 2
    win @12 switched "${SID_L}" 1 "\"codex resume ${SID_X}\""
    win @13 twin "${SID_L}"
    win @14 twin "${SID_L}"
    win @15 argv "${SID_L}" 1 "codex resume ${SID_L}"
    win @16 shell "${SID_L}" 1 "\"printf 'resume ${SID_L}'; exec sh\""
    win @17 other-talk "${SID_L}" 1 "\"codex resume ${SID_X} 'resume ${SID_L}'\""
    win @18 odd-mark "not-a-session}" 1 "\"codex resume not-a-session}\""
  } > "${TMUX_WINDOWS}"
}
left() { cut -d"$US" -f1 "${TMUX_WINDOWS}" | tr '\n' ' ' }
kills() { grep '^kill-window' "${TMUX_LOG}" | tr '\n' ' ' }

fresh; windows
run_lane --close lane-a
check "a finished lane closes with exit 0" "${RC}" "0"
check "after one look at its session" "$(<"${HELPER_LOG}")" "close-check ${SID_L}"
check "its window is removed" "$(kills)" "kill-window -t @6 "
check "by a kill that tmux itself guards with pane count, session and start command" "$(grep -c "^if-shell -F -t @6 #{&&:#{==:#{window_panes},1},#{&&:#{==:#{@flakelab_session},${SID_L}},#{||:#{==:#{pane_start_command},codex resume ${SID_L}},#{==:#{pane_start_command},\"codex resume ${SID_L}\"}}}} kill-window -t @6\$" "${TMUX_LOG}")" "1"
check "stdout is the command that reopens it" "${OUT}" "cd ${(q)WORK} && codex resume ${SID_L}"
fresh; windows
run_lane --close argv
check "a start command tmux reports without quotes is a lane as well" "${RC}/$(kills)" "0/kill-window -t @15 "

fresh; windows
HELPER_BUSY="${SID_L}" run_lane --close lane-a
check "a lane that is not finished exits 1" "${RC}" "1"
contains "with the reasons" "${ERR}" "not closed: ${SID_L}: the session is working; runs: sleep 300"
contains "and what would close it" "${ERR}" "--force stops that first"
check "its window stays" "$(kills)" ""
check "nothing is printed to reopen" "${OUT}" ""

fresh; windows
HELPER_BUSY="${SID_L}" run_lane --close --force @6
check "--force closes it" "${RC}" "0"
check "by stopping first, then looking with the stop taken into account" "$(<"${HELPER_LOG}")" "stop ${SID_L}"$'\n'"close-check --after-stop ${SID_L}"
check "then removing the window" "$(kills)" "kill-window -t @6 "
fresh; windows
HELPER_FAIL=stop HELPER_BUSY="${SID_L}" run_lane --close --force lane-a
check "a stop that fails closes nothing and looks no further" "${RC}/$(kills)/$(<"${HELPER_LOG}")" "1//stop ${SID_L}"

fresh; windows
run_lane --close --archive lane-a
check "--archive: exit 0" "${RC}" "0"
check "the unarchive line comes before the resume line" "${OUT}" "codex unarchive ${SID_L}"$'\n'"cd ${(q)WORK} && codex resume ${SID_L}"
check "the session is archived after its window is gone" "$(( $(event 'tmux kill-window') > 0 && $(event 'helper archive') > $(event 'tmux kill-window') ))" "1"
fresh; windows
HELPER_FAIL=archive run_lane --close --archive lane-a
check "an archive that fails exits 1" "${RC}" "1"
contains "and says what is so now" "${ERR}" "the window of ${SID_L} is gone and the session is not archived"

# What --close must never remove.
fresh; windows
for label target reason in \
  "a window that records no session" plain "records no Codex session" \
  "a window with two panes" split "has 2 panes" \
  "a window started on another session" switched "was not started by flakelab on session ${SID_L}" \
  "a shell whose command merely holds the words" shell "was not started by flakelab on session ${SID_L}" \
  "another conversation whose prompt holds the words" other-talk "was not started by flakelab on session ${SID_L}" \
  "a mark that is no session id" odd-mark "records something that is no session id"; do
  run_lane --close --force --archive "${target}"
  check "${label} is refused" "${RC}" "1"
  contains "${label}: the reason" "${ERR}" "${reason}"
done
run_lane --close twin
check "a name on two windows is refused" "${RC}" "1"
contains "with their ids" "${ERR}" "@13 @14"
check "none of them asked the helper or removed a window" "$(wc -l < "${HELPER_LOG}")/$(kills)" "0/"

# The window is read again after the session was judged, and tmux compares once more at the kill.
SPLIT='awk -F"$US" -v OFS="$US" "\$1 == \"@6\" { \$4 = 2; \$5 = \"vim important.txt\" } { print }" "${TMUX_WINDOWS}" > "${TMUX_WINDOWS}.n"; mv "${TMUX_WINDOWS}.n" "${TMUX_WINDOWS}"'
fresh; windows
US="${US}" HELPER_DURING_CHECK="${SPLIT}" run_lane --close --archive lane-a
check "a window that was split and reused while its session was judged is not removed" "${RC}/$(kills)" "1/"
contains "and the reason is what it has become" "${ERR}" "not closed: window @6 changed since it was judged: it has 2 panes"
check "nothing is archived and nothing printed to reopen" "$(grep -c '^archive' "${HELPER_LOG}")/${OUT}" "0/"
# A window that became a sound lane of another session meanwhile: one pane, mark and command agree.
RELANE='awk -F"$US" -v OFS="$US" -v sid="$OTHER" "\$1 == \"@6\" { \$3 = sid; \$5 = \"codex resume \" sid } { print }" "${TMUX_WINDOWS}" > "${TMUX_WINDOWS}.n"; mv "${TMUX_WINDOWS}.n" "${TMUX_WINDOWS}"'
fresh; windows
US="${US}" OTHER="${SID_X}" HELPER_DURING_CHECK="${RELANE}" run_lane --close --archive lane-a
check "a window that became another session's lane while its session was judged is not removed" "${RC}/$(kills)" "1/"
contains "and the reason names the session it records now" "${ERR}" "not closed: window @6 changed since it was judged: it now records session ${SID_X}"
check "no kill was tried on it and nothing is archived" "$(grep -c '^if-shell' "${TMUX_LOG}")/$(grep -c '^archive' "${HELPER_LOG}")/${OUT}" "0/0/"
fresh; windows
US="${US}" FAKE_TMUX_BEFORE_KILL="${SPLIT}" run_lane --close --archive lane-a
check "a window that changes at the very last moment is left by tmux's own comparison" "${RC}/$(kills)" "1/"
contains "and that is said" "${ERR}" "not closed: window @6 could not be removed, or changed at the last moment"
check "nothing is archived then either" "$(grep -c '^archive' "${HELPER_LOG}")/${OUT}" "0/"

fresh; windows
FAKE_TMUX_KILL_FAILS=@6 run_lane --close --archive lane-a
check "a window that cannot be removed exits 1" "${RC}" "1"
excludes "the session is not called closed" "${ERR}" "closed ${SID_L}"
check "and is not archived" "$(grep -c '^archive' "${HELPER_LOG}")/${OUT}" "0/"
fresh; windows
FAKE_TMUX_KILL_FAILS=@8 run_lane --close --archive "${SID_S}"
check "one of a session's two windows staying exits 1" "${RC}" "1"
contains "and says which stayed and which went" "${ERR}" "session ${SID_S}: still there: @8; removed: @7; nothing was archived"
check "without archiving" "$(grep -c '^archive' "${HELPER_LOG}")" "0"

fresh; windows
run_lane --close "${SID_S}"
check "a session id closes every window that records it" "$(kills)" "kill-window -t @7 kill-window -t @8 "
check "after one look" "$(<"${HELPER_LOG}")" "close-check ${SID_S}"
fresh; windows
run_lane --close lane-b @7 "${SID_S}"
check "a window named three ways is closed once" "$(grep -c "^kill-window -t @7" "${TMUX_LOG}")/$(grep -c '^close-check' "${HELPER_LOG}")" "1/1"

fresh; windows
run_lane --close lane-a nowhere
check "a target that selects no window exits 2" "${RC}" "2"
check "before anything is closed" "$(wc -l < "${HELPER_LOG}")/$(kills)" "0/"
fresh; windows
HELPER_BUSY="${SID_S}" run_lane --close lane-a lane-b @14
check "several targets, one refused: exit 1" "${RC}" "1"
check "the finished ones are closed, the refused one stays" "$(kills)" "kill-window -t @6 kill-window -t @14 "
check "the tmux stand-in was asked nothing it does not know" "$(<"${TMUX_UNKNOWN}")" ""
unset FLAKELAB_CODEX_THREADS

# The real helper against the stand-in server: start, the table, a refused
# close and a forced one, end to end.
print -r -- ""
print -r -- "lanes: the real helper against lib/codex_fake_server.py"
if command -v python3 >/dev/null 2>&1; then
  FAKE_HOME="${BASE}/fh"
  mkdir -p "${FAKE_HOME}"
  mkfifo "${BASE}/fake.ready"
  # Beside the lane the case starts: a session in an error state with a command still
  # running, and an idle session whose helper agent works. Lists come one item a page.
  SID_E=01a1d6cc-0000-7000-8000-00000000000c
  SID_P=01a1d6dd-0000-7000-8000-00000000000d
  SID_C=01a1d6ee-0000-7000-8000-00000000000e
  jq -n --arg work "${WORK}" --arg e "${SID_E}" --arg p "${SID_P}" --arg c "${SID_C}" \
    '{projects: {($work): "trusted"}, page_size: 1, terminals: {($e): ["sleep 300"]},
      threads: {($e): {state: "error"}, ($p): {}, ($c): {state: "working", parent: $p, name: "Darwin"}}}' > "${BASE}/scenario.json"
  python3 "${SCRIPT_DIR}/lib/codex_fake_server.py" "${FAKE_HOME}" "${BASE}/scenario.json" > "${BASE}/fake.ready" 2>"${BASE}/fake.err" &
  FAKE_PID=$!
  read -r READY < "${BASE}/fake.ready"
  check "the stand-in server listens" "${READY}" "ready"
  export CODEX_HOME="${FAKE_HOME}"
  # The tmux stand-in writes its calls into the server's own request log: one order for both.
  export EVENT_SINK="${FAKE_HOME}/requests.jsonl"
  nth() { local n; n="$(jq -r '.method' "${FAKE_HOME}/requests.jsonl" | grep -n -m1 -x -- "$1" | cut -d: -f1)"; print -r -- "${n:-0}" }
  requests() { jq -c "select(.method == \"$1\") | .params" "${FAKE_HOME}/requests.jsonl" }
  fresh
  : > "${TMUX_WINDOWS}"
  run_lane --start codex "${WORK}" --model gpt-6-luna --effort low --name real-lane --prompt "${PROMPT}" --detach
  check "the real helper starts a lane" "${RC}" "0"
  REAL_SID="$(requests turn/start | jq -r '.threadId')"
  check "the conversation is created with model and effort" "$(requests thread/start)" "{\"cwd\":\"${WORK}\",\"model\":\"gpt-6-luna\",\"config\":{\"model_reasoning_effort\":\"low\"}}"
  check "the first turn carries model, effort and the prompt" "$(requests turn/start | jq -c '[.model, .effort, .input[0].text]')" "$(jq -cn --arg p "${PROMPT}" '["gpt-6-luna","low",$p]')"
  contains "the window opens on the session the server created" "$(<"${TMUX_LOG}")" "codex resume ${REAL_SID}"
  check "the first turn is started before the window is created" "$(( $(nth turn/start) > 0 && $(nth turn/start) < $(nth tmux/new-window) ))" "1"
  check "and the prompt went out once" "$(requests turn/start | wc -l | tr -d ' ')" "1"
  run_lane --start codex "${WORK}" --model gpt-9-nope --prompt go --detach
  check "an unknown model is the real helper's usage error" "${RC}" "2"
  contains "with the models offered" "${ERR}" "gpt-6.1-sol"
  run_lane --start codex "${BASE}/other" --prompt go --detach
  check "a folder without a trust decision is refused" "${RC}" "1"
  contains "naming --trust" "${ERR}" "--trust"
  print -r -- "8060${US}agents${US}@6${US}real-lane${US}${REAL_SID}" > "${TMUX_PANES}"
  FAKE_PGREP_ONLY=8600 run_lane
  contains "the table reads the lane's state from the server" "${OUT}" "${REAL_SID} real-lane          working   gpt-6-luna low"
  win @6 real-lane "${REAL_SID}" > "${TMUX_WINDOWS}"
  fresh
  run_lane --close real-lane
  check "the working lane is not closed" "${RC}/$(grep -c '^kill-window' "${TMUX_LOG}")" "1/0"
  contains "because it is working" "${ERR}" "the session is working"
  run_lane --close --force real-lane
  check "--force closes it" "${RC}/$(grep -c '^kill-window' "${TMUX_LOG}")" "0/1"
  check "after interrupting the turn the server started" "$(requests turn/interrupt | jq -r '.threadId')" "${REAL_SID}"
  check "stdout is the resume line" "${OUT}" "cd ${(q)WORK} && codex resume ${REAL_SID}"

  { win @21 broken "${SID_E}"; win @22 parent "${SID_P}" } > "${TMUX_WINDOWS}"
  fresh
  run_lane --close broken
  check "a session in an error state is not closed" "${RC}/$(kills)" "1/"
  contains "because of that state and its running command" "${ERR}" "the session is in an error state; runs: sleep 300"
  run_lane --close --force broken
  check "--force closes it" "${RC}/$(kills)" "0/kill-window -t @21 "
  check "after ending its command, without an interrupt" "$(requests thread/backgroundTerminals/clean | jq -r '.threadId' | grep -c "${SID_E}")/$(requests turn/interrupt | jq -r '.threadId' | grep -c "${SID_E}")" "1/0"
  fresh
  run_lane --close parent
  check "an idle session whose helper agent works is not closed" "${RC}/$(kills)" "1/"
  contains "and the helper, found on a later page of the list, is named" "${ERR}" "helper agent Darwin is working"
  run_lane --close --force parent
  check "--force closes it" "${RC}/$(kills)" "0/kill-window -t @22 "
  check "after interrupting the helper" "$(requests turn/interrupt | jq -r '.threadId' | grep -c "${SID_C}")" "1"
  check "the tmux stand-in was asked nothing it does not know" "$(<"${TMUX_UNKNOWN}")" ""
  unset EVENT_SINK
  kill "${FAKE_PID}" 2>/dev/null
  wait "${FAKE_PID}" 2>/dev/null
  unset CODEX_HOME
else
  print -r -- "  skip (python3 is not on PATH)"
fi
unset FAKE_TMUX_HAS FLAKELAB_SESSIONS_SETTLE
rm -rf "${PROC}/8060" "${PROC}/8600" "${PROC}/8700"

run --help
check "--help exits 0" "${RC}" "0"
run --bogus
check "an unknown flag exits 2" "${RC}" "2"

print -r -- ""
print -r -- "${PASS} passed, ${FAIL} failed"
(( FAIL == 0 ))
