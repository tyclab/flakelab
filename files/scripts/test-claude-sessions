run --resume "${DUP_SAVE}"
check "--resume prints one line per session" "$(print -r -- "$OUT" | grep -c 'resume')" "3"

export FLAKELAB_BOOT_ID_FILE="${BASE}/boot_id_dup"
print -r -- "dddddddd-1111-2222-3333-444444444444" > "${FLAKELAB_BOOT_ID_FILE}"
run --autosave
contains "--autosave counts sessions, not processes" "${ERR}" "autosaved 3 session(s) to"
unset FLAKELAB_BOOT_ID_FILE FAKE_PGREP_DUP

# A file written before the dedupe, or merged from two boxes, carries the
# duplicate itself.
print -rl -- "# doubled by an older save" "${WORK}  ${SID_A}" "${WORK}  ${SID_A}" > "${BASE}/doubled.txt"
run --resume "${BASE}/doubled.txt"
check "a doubled saved file resumes once" "$(print -r -- "$OUT" | grep -c 'claude --resume')" "1"

