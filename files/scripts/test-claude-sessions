#!/usr/bin/env zsh

set -uo pipefail

# Offline suite for claude-sessions (files/scripts/claude-sessions): a fake
# /proc tree plus stub pgrep/ps on PATH stand in for running sessions, so the
# id-from-open-transcript rule, the save shape and the --resume round trip are
# checked without a single real claude process.
#
# Usage: files/scripts/test-claude-sessions

SCRIPT_DIR="${0:A:h}"
CMD="${SCRIPT_DIR}/claude-sessions"
typeset -i PASS=0 FAIL=0

ok()       { print -r -- "  ok   $1"; (( PASS++ )); return 0 }
bad()      { print -r -u2 -- "  FAIL $1"; (( FAIL++ )); return 0 }
check()    { [[ "$2" == "$3" ]] && ok "$1" || { bad "$1"; print -r -u2 -- "       expected: $3"; print -r -u2 -- "       actual:   $2" } }
contains() { [[ "$2" == *"$3"* ]] && ok "$1" || { bad "$1"; print -r -u2 -- "       missing: $3"; print -r -u2 -- "       in: $2" } }
excludes() { [[ "$2" != *"$3"* ]] && ok "$1" || bad "$1 (unexpected: $3)" }

BASE="$(mktemp -d)"
trap 'rm -rf "${BASE}"' EXIT
export HOME="${BASE}/home"
mkdir -p "${HOME}"

# ---------------------------------------------------------------------------
# Three "processes": two sessions sharing one directory (the case the
# newest-transcript heuristic gets wrong), one still starting with neither a
# registry entry nor a transcript open. Pid 100 is registered in
# ~/.claude/sessions the way Claude Code does it (and its registry id wins
# over the transcript it holds open); pid 200 has no registry file and falls
# back to its open transcript — the stray non-transcript uuid must not win
# the vote. A registry file for a dead pid (999) is not a session.
PROC="${BASE}/proc"
SID_A=11111111-2222-3333-4444-555555555555
SID_B=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee
WORK="${BASE}/work dir"
mkdir -p "${WORK}" "${BASE}/other"
mk_proc() {
  local pid="$1" cwd="$2"; shift 2
  mkdir -p "${PROC}/${pid}/fd"
  ln -s "${cwd}" "${PROC}/${pid}/cwd"
  local -i i=3
  for t in "$@"; do ln -s "$t" "${PROC}/${pid}/fd/${i}"; (( i++ )); done
}
SID_OLD=99999999-0000-0000-0000-000000000000
mk_proc 100 "${WORK}" "${HOME}/.claude/projects/-work/${SID_OLD}.jsonl" "${HOME}/.claude/projects/-work/${SID_OLD}.jsonl" /dev/null
mk_proc 200 "${WORK}" "${HOME}/.claude/projects/-work/${SID_B}.jsonl" "${HOME}/.claude/projects/-work/${SID_B}.jsonl" "/tmp/claude/${SID_A}/scratch"
mk_proc 300 "${BASE}/other" /dev/null
mkdir -p "${HOME}/.claude/sessions"
NOW_MS=$(( $(date +%s) * 1000 ))
print -r -- "{\"pid\":100,\"sessionId\":\"${SID_A}\",\"cwd\":\"${WORK}\",\"startedAt\":$(( NOW_MS - 7261000 ))}" > "${HOME}/.claude/sessions/100.json"
print -r -- "{\"pid\":999,\"sessionId\":\"${SID_OLD}\",\"cwd\":\"${WORK}\",\"startedAt\":${NOW_MS}}" > "${HOME}/.claude/sessions/999.json"

STUBS="${BASE}/bin"
mkdir -p "${STUBS}"
cat > "${STUBS}/pgrep" <<'STUB'
#!/usr/bin/env zsh
[[ "$1" == "-x" && "$2" == "claude" ]] || exit 1
print -l 100 200 300
STUB
cat > "${STUBS}/ps" <<'STUB'
#!/usr/bin/env zsh
case "$4" in 100) print 1 ;; 200) print 90000 ;; *) print 5 ;; esac
STUB
# wt.exe stand-in: records its argv, one call per line
cat > "${STUBS}/wt.exe" <<'STUB'
#!/usr/bin/env zsh
print -r -- "$*" >> "${WT_LOG}"
STUB
chmod +x "${STUBS}"/*
export PATH="${STUBS}:${PATH}"
export FLAKELAB_PROC_ROOT="${PROC}"
unset FLAKELAB_STATE_ROOT WSL_DISTRO_NAME

# stdout and stderr apart: --json's stdout must parse on its own.
run() { OUT="$("${CMD}" "$@" 2>"${BASE}/err")"; RC=$?; ERR="$(<"${BASE}/err")"; }
typeset -i RC=0
OUT=""
ERR=""

# ---------------------------------------------------------------------------
print -r -- "list"
run
check "list exits 0" "${RC}" "0"
contains "pid 100 takes id and age from its registry file, not its open transcript" "${OUT}" "100      2h01m   ${SID_A}"
contains "pid 200 falls back to its own transcript, not the shared directory's newest" "${OUT}" "200      1d01h   ${SID_B}"
excludes "a registry file for a dead pid is not a session" "${OUT}" "999"
contains "a process with no id is noted on stderr" "${ERR}" "note: pid 300 in ${BASE}/other has no session id yet"
contains "the directory with a space is printed intact" "${OUT}" "${WORK}"

run --json
check "--json exits 0" "${RC}" "0"
check "--json carries three rows" "$(print -r -- "$OUT" | jq 'length')" "3"
check "--json session for pid 200" "$(print -r -- "$OUT" | jq -r '.[] | select(.pid == 200) | .session')" "${SID_B}"
check "--json null session for the starting process" "$(print -r -- "$OUT" | jq -r '.[] | select(.pid == 300) | .session')" "null"

# ---------------------------------------------------------------------------
print -r -- ""
print -r -- "save + resume round trip"
run --save
check "--save exits 0" "${RC}" "0"
SAVED="$(ls "${HOME}"/.local/state/flakelab/sessions/*.txt 2>/dev/null | head -1)"
[[ -n "${SAVED}" ]] && ok "--save writes under ~/.local/state/flakelab/sessions without a state root" || bad "--save wrote nothing under ~/.local/state/flakelab/sessions"
[[ -z "$(ls "${HOME}"/.claude/sessions/*.txt 2>/dev/null)" ]] && ok "--save leaves Claude's own ~/.claude/sessions alone" || bad "--save wrote into ~/.claude/sessions"
contains "--save reports the count, transcript-less process excluded" "${ERR}" "saved 2 session(s) to"
check "saved lines are '<dir>  <id>'" "$(grep -v '^#' "${SAVED}" | head -1)" "${WORK}  ${SID_A}"

run --resume
check "--resume exits 0" "${RC}" "0"
contains "--resume names its source" "${OUT}" "# from ${SAVED}"
contains "--resume quotes the directory" "${OUT}" "cd ${(q)WORK} && claude --resume ${SID_A}"
contains "--resume prints the second session" "${OUT}" "claude --resume ${SID_B}"
excludes "--resume never prints an id-less row" "${OUT}" "${BASE}/other"

run --resume "${BASE}/missing.txt"
check "--resume on a missing file exits 1" "${RC}" "1"

# ---------------------------------------------------------------------------
print -r -- ""
print -r -- "--open: one Windows Terminal tab per session"
export WT_LOG="${BASE}/wt.log"
run --open
check "--open without a distro exits 2" "${RC}" "2"
export WSL_DISTRO_NAME=flakelab
run --open
check "--open exits 0" "${RC}" "0"
check "--open calls wt.exe once per session" "$(wc -l < "${WT_LOG}")" "2"
contains "--open targets the current window, the distro, the directory and the id" \
  "$(head -1 "${WT_LOG}")" "-w 0 new-tab --title work dir wsl.exe -d flakelab --cd ${WORK} -- claude --resume ${SID_A}"
contains "--open reports the count" "${ERR}" "opened 2 tab(s)"
excludes "--open does not report a failure for the first tab" "${ERR}" "wt.exe failed"
unset WSL_DISTRO_NAME

# state root wins over ~/.claude
export FLAKELAB_STATE_ROOT="${BASE}/state"
run --save
contains "--save under a state root lands in <root>/claude/sessions" "${ERR}" "${BASE}/state/claude/sessions/"
unset FLAKELAB_STATE_ROOT

# ---------------------------------------------------------------------------
print -r -- ""
print -r -- "resume with nothing saved falls back to the live sessions"
rm -rf "${HOME}/.local/state/flakelab/sessions"
run --resume
check "live fallback exits 0" "${RC}" "0"
contains "live fallback says so" "${OUT}" "# from the live sessions (no saved file)"
contains "live fallback prints a resume line" "${OUT}" "claude --resume ${SID_B}"

run --help
check "--help exits 0" "${RC}" "0"
run --bogus
check "an unknown flag exits 1" "${RC}" "1"

print -r -- ""
print -r -- "${PASS} passed, ${FAIL} failed"
(( FAIL == 0 ))
