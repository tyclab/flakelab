#!/usr/bin/env zsh

set -uo pipefail

# Offline suite for claude-sessions (files/scripts/claude-sessions): a fake
# /proc tree plus stub pgrep/ps on PATH stand in for running sessions, so the
# id-from-open-transcript rule, the save shape and the --resume round trip are
# checked without a single real claude process.
#
# Usage: files/scripts/test-claude-sessions

SCRIPT_DIR="${0:A:h}"
CMD="${SCRIPT_DIR}/claude-sessions"
typeset -i PASS=0 FAIL=0

ok()       { print -r -- "  ok   $1"; (( PASS++ )); return 0 }
bad()      { print -r -u2 -- "  FAIL $1"; (( FAIL++ )); return 0 }
check()    { [[ "$2" == "$3" ]] && ok "$1" || { bad "$1"; print -r -u2 -- "       expected: $3"; print -r -u2 -- "       actual:   $2" } }
contains() { [[ "$2" == *"$3"* ]] && ok "$1" || { bad "$1"; print -r -u2 -- "       missing: $3"; print -r -u2 -- "       in: $2" } }
excludes() { [[ "$2" != *"$3"* ]] && ok "$1" || bad "$1 (unexpected: $3)" }

BASE="$(mktemp -d)"
trap 'rm -rf "${BASE}"' EXIT
export HOME="${BASE}/home"
mkdir -p "${HOME}"

# ---------------------------------------------------------------------------
# Three "processes": two sessions sharing one directory (the case the
# newest-transcript heuristic gets wrong), one still starting with neither a
# registry entry nor a transcript open. Pid 100 is registered in
# ~/.claude/sessions the way Claude Code does it (and its registry id wins
# over the transcript it holds open); pid 200 has no registry file and falls
# back to its open transcript — the stray non-transcript uuid must not win
# the vote. A registry file for a dead pid (999) is not a session.
PROC="${BASE}/proc"
SID_A=11111111-2222-3333-4444-555555555555
SID_B=aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee
WORK="${BASE}/work dir"
mkdir -p "${WORK}" "${BASE}/other"
mk_proc() {
  local pid="$1" cwd="$2"; shift 2
  mkdir -p "${PROC}/${pid}/fd"
  ln -s "${cwd}" "${PROC}/${pid}/cwd"
  local -i i=3
  for t in "$@"; do ln -s "$t" "${PROC}/${pid}/fd/${i}"; (( i++ )); done
}
SID_OLD=99999999-0000-0000-0000-000000000000
mk_proc 100 "${WORK}" "${HOME}/.claude/projects/-work/${SID_OLD}.jsonl" "${HOME}/.claude/projects/-work/${SID_OLD}.jsonl" /dev/null
mk_proc 200 "${WORK}" "${HOME}/.claude/projects/-work/${SID_B}.jsonl" "${HOME}/.claude/projects/-work/${SID_B}.jsonl" "/tmp/claude/${SID_A}/scratch"
mk_proc 300 "${BASE}/other" /dev/null
mkdir -p "${HOME}/.claude/sessions"
NOW_MS=$(( $(date +%s) * 1000 ))
print -r -- "{\"pid\":100,\"sessionId\":\"${SID_A}\",\"cwd\":\"${WORK}\",\"startedAt\":$(( NOW_MS - 7261000 ))}" > "${HOME}/.claude/sessions/100.json"
print -r -- "{\"pid\":999,\"sessionId\":\"${SID_OLD}\",\"cwd\":\"${WORK}\",\"startedAt\":${NOW_MS}}" > "${HOME}/.claude/sessions/999.json"
# A second process on SID_A, in another directory: the same session, resumed
# or reattached. Only --json and the table have a pid to tell them apart.
mk_proc 400 "${BASE}/other" /dev/null
print -r -- "{\"pid\":400,\"sessionId\":\"${SID_A}\",\"cwd\":\"${BASE}/other\",\"startedAt\":${NOW_MS}}" > "${HOME}/.claude/sessions/400.json"

STUBS="${BASE}/bin"
mkdir -p "${STUBS}"
cat > "${STUBS}/pgrep" <<'STUB'
#!/usr/bin/env zsh
[[ "$1" == "-x" && "$2" == "claude" ]] || exit 1
# FAKE_PGREP_NONE: nothing running, the first minutes after a crash.
[[ -n "${FAKE_PGREP_NONE:-}" ]] && exit 1
# FAKE_PGREP_DUP: pid 400 is a second, YOUNGER process on pid 100's session,
# listed first — pgrep order and start order disagree, as after a wraparound.
[[ -n "${FAKE_PGREP_DUP:-}" ]] && { print -l 400 100 200 300; exit 0 }
print -l 100 200 300
STUB
cat > "${STUBS}/ps" <<'STUB'
#!/usr/bin/env zsh
case "$4" in 100) print 1 ;; 200) print 90000 ;; *) print 5 ;; esac
STUB
# wt.exe stand-in: records its argv, one call per line
cat > "${STUBS}/wt.exe" <<'STUB'
#!/usr/bin/env zsh
print -r -- "$*" >> "${WT_LOG}"
STUB
chmod +x "${STUBS}"/*
export PATH="${STUBS}:${PATH}"
export FLAKELAB_PROC_ROOT="${PROC}"
unset FLAKELAB_STATE_ROOT WSL_DISTRO_NAME

# stdout and stderr apart: --json's stdout must parse on its own.
run() { OUT="$("${CMD}" "$@" 2>"${BASE}/err")"; RC=$?; ERR="$(<"${BASE}/err")"; }
typeset -i RC=0
OUT=""
ERR=""

# ---------------------------------------------------------------------------
print -r -- "list"
run
check "list exits 0" "${RC}" "0"
contains "pid 100 takes id and age from its registry file, not its open transcript" "${OUT}" "100      2h01m   ${SID_A}"
contains "pid 200 falls back to its own transcript, not the shared directory's newest" "${OUT}" "200      1d01h   ${SID_B}"
excludes "a registry file for a dead pid is not a session" "${OUT}" "999"
contains "a process with no id is noted on stderr" "${ERR}" "note: pid 300 in ${BASE}/other has no session id yet"
contains "the directory with a space is printed intact" "${OUT}" "${WORK}"

run --json
check "--json exits 0" "${RC}" "0"
check "--json carries three rows" "$(print -r -- "$OUT" | jq 'length')" "3"
check "--json session for pid 200" "$(print -r -- "$OUT" | jq -r '.[] | select(.pid == 200) | .session')" "${SID_B}"
check "--json null session for the starting process" "$(print -r -- "$OUT" | jq -r '.[] | select(.pid == 300) | .session')" "null"

# ---------------------------------------------------------------------------
print -r -- ""
print -r -- "save + resume round trip"
run --save
check "--save exits 0" "${RC}" "0"
SAVED="$(ls "${HOME}"/.local/state/flakelab/sessions/*.txt 2>/dev/null | head -1)"
[[ -n "${SAVED}" ]] && ok "--save writes under ~/.local/state/flakelab/sessions without a state root" || bad "--save wrote nothing under ~/.local/state/flakelab/sessions"
[[ -z "$(ls "${HOME}"/.claude/sessions/*.txt 2>/dev/null)" ]] && ok "--save leaves Claude's own ~/.claude/sessions alone" || bad "--save wrote into ~/.claude/sessions"
contains "--save reports the count, transcript-less process excluded" "${ERR}" "saved 2 session(s) to"
check "saved lines are '<dir>  <id>'" "$(grep -v '^#' "${SAVED}" | head -1)" "${WORK}  ${SID_A}"

run --resume
check "--resume exits 0" "${RC}" "0"
contains "--resume names its source" "${OUT}" "# from ${SAVED}"
contains "--resume quotes the directory" "${OUT}" "cd ${(q)WORK} && claude --resume ${SID_A}"
contains "--resume prints the second session" "${OUT}" "claude --resume ${SID_B}"
excludes "--resume never prints an id-less row" "${OUT}" "${BASE}/other"

run --resume "${BASE}/missing.txt"
check "--resume on a missing file exits 1" "${RC}" "1"

# ---------------------------------------------------------------------------
print -r -- ""
print -r -- "--open: one Windows Terminal tab per session"
export WT_LOG="${BASE}/wt.log"
run --open
check "--open without a distro exits 2" "${RC}" "2"
export WSL_DISTRO_NAME=flakelab
run --open
check "--open exits 0" "${RC}" "0"
check "--open calls wt.exe once per session" "$(wc -l < "${WT_LOG}")" "2"
contains "--open targets the current window, the distro, the directory and the id" \
  "$(head -1 "${WT_LOG}")" "-w 0 new-tab --title work dir wsl.exe -d flakelab --cd ${WORK} -- claude --resume ${SID_A}"
contains "--open reports the count" "${ERR}" "opened 2 tab(s)"
excludes "--open does not report a failure for the first tab" "${ERR}" "wt.exe failed"
unset WSL_DISTRO_NAME

# state root wins over ~/.claude
export FLAKELAB_STATE_ROOT="${BASE}/state"
run --save
contains "--save under a state root lands in <root>/claude/sessions" "${ERR}" "${BASE}/state/claude/sessions/"
unset FLAKELAB_STATE_ROOT

# ---------------------------------------------------------------------------
print -r -- ""
print -r -- "resume with nothing saved falls back to the live sessions"
rm -rf "${HOME}/.local/state/flakelab/sessions"
run --resume
check "live fallback exits 0" "${RC}" "0"
contains "live fallback says so" "${OUT}" "# from the live sessions (no saved file)"
contains "live fallback prints a resume line" "${OUT}" "claude --resume ${SID_B}"

# ---------------------------------------------------------------------------
print -r -- ""
print -r -- "a directory this box does not have gets no cd"
GONE="${BASE}/gone dir"
print -rl -- "# written on another machine" "${GONE}  ${SID_A}" > "${BASE}/elsewhere.txt"
run --resume "${BASE}/elsewhere.txt"
check "--resume with a missing directory exits 0" "${RC}" "0"
contains "--resume resumes by id and names the missing path" "${OUT}" "claude --resume ${SID_A}  # ${GONE} is not on this box"
excludes "--resume never cds into it" "${OUT}" "cd ${(q)GONE}"
export WSL_DISTRO_NAME=flakelab
: > "${WT_LOG}"
run --open "${BASE}/elsewhere.txt"
contains "--open starts that tab in the home directory" "$(head -1 "${WT_LOG}")" "--cd ~ -- claude --resume ${SID_A}"
unset WSL_DISTRO_NAME

# ---------------------------------------------------------------------------
print -r -- ""
print -r -- "--autosave: one file per boot, sorted, quiet when unchanged, never empty"
SAVES="${HOME}/.local/state/flakelab/sessions"
rm -rf "${SAVES}"
export FLAKELAB_BOOT_ID_FILE="${BASE}/boot_id"
print -r -- "aaaaaaaa-1111-2222-3333-444444444444" > "${FLAKELAB_BOOT_ID_FILE}"
AUTO_A="${SAVES}/${HOST}-autosave-aaaaaaaa1111.txt"
run --autosave
check "--autosave exits 0" "${RC}" "0"
[[ -f "${AUTO_A}" ]] && ok "--autosave writes <host>-autosave-<boot>.txt" || bad "--autosave wrote no ${AUTO_A:t}"
contains "--autosave reports the write" "${ERR}" "autosaved 2 session(s) to ${AUTO_A}"
check "--autosave lines are the save shape, sorted" "$(grep -v '^#' "${AUTO_A}")" "${WORK}  ${SID_A}"$'\n'"${WORK}  ${SID_B}"
check "--autosave leaves no scratch file" "$(ls -A "${SAVES}" | grep -c flakelab-tmp)" "0"
run --autosave
check "an unchanged set is not rewritten" "${ERR}" ""
export FAKE_PGREP_NONE=1
run --autosave
unset FAKE_PGREP_NONE
check "nothing running exits 0" "${RC}" "0"
check "nothing running keeps the snapshot" "$(grep -vc '^#' "${AUTO_A}")" "2"

# A new boot: what --resume brings back is the file the last boot left, never
# this boot's own snapshot and never another host's.
print -r -- "bbbbbbbb-1111-2222-3333-444444444444" > "${FLAKELAB_BOOT_ID_FILE}"
AUTO_B="${SAVES}/${HOST}-autosave-bbbbbbbb1111.txt"
touch -d '1 minute ago' "${AUTO_A}"
run --autosave
[[ -f "${AUTO_B}" ]] && ok "a new boot gets a file of its own" || bad "no autosave for the new boot"
[[ -f "${AUTO_A}" ]] && ok "the previous boot's file survives" || bad "the previous boot's autosave is gone"
run --resume
contains "--resume takes the previous boot's snapshot, not this boot's" "${OUT}" "# from ${AUTO_A}"
print -rl -- "# another host" "${WORK}  ${SID_A}" > "${SAVES}/otherhost-autosave-cccccccc1111.txt"
run --resume
contains "--resume never takes another host's autosave" "${OUT}" "# from ${AUTO_A}"

for i in 1 2 3 4 5 6; do
  print -r -- "# old" > "${SAVES}/${HOST}-autosave-old00000000${i}.txt"
  touch -d "${i} hours ago" "${SAVES}/${HOST}-autosave-old00000000${i}.txt"
done
print -r -- "cccccccc-1111-2222-3333-444444444444" > "${FLAKELAB_BOOT_ID_FILE}"
run --autosave
check "--autosave keeps this host's five newest" "$(print -l "${SAVES}/${HOST}"-autosave-*.txt(N) | wc -l | tr -d ' ')" "5"
[[ -f "${SAVES}/${HOST}-autosave-cccccccc1111.txt" ]] && ok "the pruning keeps the file it just wrote" || bad "the pruning removed the new autosave"
[[ -f "${SAVES}/otherhost-autosave-cccccccc1111.txt" ]] && ok "the pruning never touches another host's files" || bad "another host's autosave was pruned"
unset FLAKELAB_BOOT_ID_FILE

# ---------------------------------------------------------------------------
print -r -- ""
print -r -- "--recent: stopped sessions, newest first, the running ones left out"
PROJ="${HOME}/.claude/projects/-work"
SID_C=cccccccc-dddd-eeee-ffff-000000000000
SID_D=dddddddd-eeee-ffff-0000-111111111111
mkdir -p "${PROJ}/${SID_C}/subagents"
# The last complete line's cwd wins; a half-written tail line is skipped.
print -r -- "{\"type\":\"user\",\"cwd\":\"/somewhere/else\",\"sessionId\":\"${SID_C}\"}" > "${PROJ}/${SID_C}.jsonl"
print -r -- "{\"type\":\"assistant\",\"cwd\":\"${WORK}\",\"sessionId\":\"${SID_C}\"}" >> "${PROJ}/${SID_C}.jsonl"
print -rn -- "{\"type\":\"user\",\"cwd\":\"/half" >> "${PROJ}/${SID_C}.jsonl"
print -r -- "{\"type\":\"user\",\"cwd\":\"${WORK}\",\"sessionId\":\"${SID_D}\"}" > "${PROJ}/${SID_D}.jsonl"
touch -d '3 days ago' "${PROJ}/${SID_D}.jsonl"
print -r -- "{\"type\":\"user\",\"cwd\":\"${WORK}\",\"sessionId\":\"${SID_B}\"}" > "${PROJ}/${SID_B}.jsonl"
print -r -- "{\"type\":\"user\",\"cwd\":\"${WORK}\"}" > "${PROJ}/${SID_C}/subagents/agent-1.jsonl"
run --recent
check "--recent exits 0" "${RC}" "0"
contains "--recent resumes a stopped session from the last directory it recorded" "${OUT}" "cd ${(q)WORK} && claude --resume ${SID_C}  # "
excludes "--recent leaves a running session out" "${OUT}" "${SID_B}"
excludes "--recent leaves a session older than the window out" "${OUT}" "${SID_D}"
excludes "--recent lists session files, never subagent transcripts" "${OUT}" "agent-1"
run --recent 96
contains "--recent <hours> widens the window" "${OUT}" "claude --resume ${SID_D}"

# ---------------------------------------------------------------------------
print -r -- ""
print -r -- "one session open in two processes counts once"
export FAKE_PGREP_DUP=1
DUP_SAVE="${BASE}/dup-save.txt"
run --save "${DUP_SAVE}"
check "--save with a doubled session exits 0" "${RC}" "0"
contains "--save counts sessions, not processes" "${ERR}" "saved 2 session(s) to"
check "the doubled session is written once, from its OLDEST process" \
  "$(grep -v '^#' "${DUP_SAVE}")" "${WORK}  ${SID_A}"$'\n'"${WORK}  ${SID_B}"

run --json
check "--json still reports every process" "$(print -r -- "$OUT" | jq 'length')" "4"
check "--json keeps both pids of the doubled session" \
  "$(print -r -- "$OUT" | jq -r --arg s "${SID_A}" '[.[] | select(.session == $s) | .pid] | sort | join(",")')" "100,400"

run --resume "${DUP_SAVE}"
check "--resume prints one line per session" "$(print -r -- "$OUT" | grep -c 'claude --resume')" "2"

export FLAKELAB_BOOT_ID_FILE="${BASE}/boot_id_dup"
print -r -- "dddddddd-1111-2222-3333-444444444444" > "${FLAKELAB_BOOT_ID_FILE}"
run --autosave
contains "--autosave counts sessions, not processes" "${ERR}" "autosaved 2 session(s) to"
unset FLAKELAB_BOOT_ID_FILE FAKE_PGREP_DUP

# A file written before the dedupe, or merged from two boxes, carries the
# duplicate itself.
print -rl -- "# doubled by an older save" "${WORK}  ${SID_A}" "${WORK}  ${SID_A}" > "${BASE}/doubled.txt"
run --resume "${BASE}/doubled.txt"
check "a doubled saved file resumes once" "$(print -r -- "$OUT" | grep -c 'claude --resume')" "1"

run --help
check "--help exits 0" "${RC}" "0"
run --bogus
check "an unknown flag exits 1" "${RC}" "1"

print -r -- ""
print -r -- "${PASS} passed, ${FAIL} failed"
(( FAIL == 0 ))
