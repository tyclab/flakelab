check "a value that begins with a dash stays a value" "$(<"${HELPER_LOG}")/$(<"${HELPER_STDIN}")" "start --cwd ${WORK}/-- not a flag"
contains "without --name the window is named as before" "$(<"${TMUX_LOG}")" "-n codex-work_dir "
excludes "and no Codex home is passed when the caller has none" "$(<"${TMUX_LOG}")" "CODEX_HOME"

