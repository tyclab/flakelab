HELPER_FAIL=start HELPER_RC=2 run_lane --start codex "${WORK}" --model nope --prompt go --detach
check "a refusal of the helper is the exit code" "${RC}" "2"
contains "with its reason" "${ERR}" "start failed on purpose"
excludes "and no window" "$(<"${TMUX_LOG}")" "new-window"

