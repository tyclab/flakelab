print -r -- ""
print -r -- "retired tycswap groups: no launcher, live profiles listed, plain resumes"
: > "${TMUX_LOG}"
run_tmux --start claude --group fable "${WORK}" --detach -- --model fable
check "--group is retired" "$RC" 2
contains "and says plain claude switches by model" "$ERR" "--group is retired"
excludes "a retired group starts nothing" "$(<"${TMUX_LOG}")" new-window
: > "$TMUX_LOG"
HANDOVER_DIGEST="$(printf '%064d' 0)"
TYCSWAP_HANDOVER_CWD="$WORK" TYCSWAP_HANDOVER_DIGEST="$HANDOVER_DIGEST" FAKE_TMUX_HAS=1 run_tmux --start claude "$WORK" --detach
check "an attested handover starts on an existing tmux server" "$RC" 0
contains "the new window receives exactly the handover directory and digest" "$(<"$TMUX_LOG")" "-e TYCSWAP_HANDOVER_CWD=${WORK} -e TYCSWAP_HANDOVER_DIGEST=${HANDOVER_DIGEST}"
: > "$TMUX_LOG"
TYCSWAP_HANDOVER_CWD="$WORK" TYCSWAP_HANDOVER_DIGEST="$HANDOVER_DIGEST" run_tmux --start codex "$WORK" --detach
contains "the first server window also receives the attestation" "$(<"$TMUX_LOG")" "-s agents -n codex-work_dir -e PATH=${TMUXBIN}:${PATH} -e TYCSWAP_HANDOVER_CWD=${WORK} -e TYCSWAP_HANDOVER_DIGEST=${HANDOVER_DIGEST}"
: > "$TMUX_LOG"
run_tmux --start codex "$WORK" --detach
contains "an ordinary launch clears stale server handover variables" "$(<"$TMUX_LOG")" '-e TYCSWAP_HANDOVER_CWD= -e TYCSWAP_HANDOVER_DIGEST='
: > "$TMUX_LOG"
TYCSWAP_HANDOVER_CWD="$WORK" TYCSWAP_HANDOVER_DIGEST=bad run_tmux --start codex "$WORK" --detach
check "an invalid digest refuses the window" "$RC" 1
excludes "an invalid attestation starts no process" "$(<"$TMUX_LOG")" new-session
TYCSWAP_HANDOVER_CWD=relative TYCSWAP_HANDOVER_DIGEST="$HANDOVER_DIGEST" run_tmux --start codex "$WORK" --detach
check "a relative handover directory refuses the window" "$RC" 1
TYCSWAP_HANDOVER_CWD="$WORK" run_tmux --start codex "$WORK" --detach
check "a partial handover pair refuses the window" "$RC" 1
run --resume --group fable
check "a retired group on --resume is a usage error" "$RC" 2

GROUP_ROOT="${HOME}/.local/share/tycswap/groups"
FABLE_PROFILE="${GROUP_ROOT}/fable/profile"
OPUS_PROFILE="${GROUP_ROOT}/opus/profile"
SID_M=abcd1234-1111-2222-3333-444444444444
SID_N=abcd5678-1111-2222-3333-444444444444
for profile in "$FABLE_PROFILE" "$OPUS_PROFILE"; do
  mkdir -p "${profile}/sessions" "${profile}/projects/-work"
  print -r -- 'DO-NOT-EXPOSE-CREDENTIAL' > "${profile}/.credentials.json"
done
for p in 310 320; do
  mk_proc "$p" "$WORK" 1 /dev/null
  ln -s /opt/claude/versions/2.1.292 "${PROC}/${p}/exe"
done
printf 'CLAUDE_CONFIG_DIR=%s\0' "$FABLE_PROFILE" > "${PROC}/310/environ"
printf 'CLAUDE_CONFIG_DIR=%s\0' "$OPUS_PROFILE" > "${PROC}/320/environ"
print -r -- "{\"pid\":310,\"sessionId\":\"${SID_M}\",\"startedAt\":${NOW_MS}}" > "${FABLE_PROFILE}/sessions/310.json"
print -r -- "{\"pid\":320,\"sessionId\":\"${SID_N}\",\"startedAt\":${NOW_MS}}" > "${OPUS_PROFILE}/sessions/320.json"
print -r -- "{\"pid\":310,\"sessionId\":\"${SID_A}\"}" > "${HOME}/.claude/sessions/310.json"
run --json
check "group profile registry wins over a stale default entry" "$(print -r -- "$OUT" | jq -r '.[] | select(.pid == 310) | .session')" "$SID_M"
check "Fable ownership is visible" "$(print -r -- "$OUT" | jq -r '.[] | select(.pid == 310) | .group')" fable
check "Opus keeps its own profile" "$(print -r -- "$OUT" | jq -r '.[] | select(.pid == 320) | .profile')" "$OPUS_PROFILE"
excludes "listing never reads profile credentials" "$OUT" DO-NOT-EXPOSE-CREDENTIAL
run --save "${BASE}/groups.txt"
check "saved metadata contains the actual migrated id and profile" "$(jq -Rr --arg id "$SID_M" 'fromjson? | select(.session == $id) | [.group,.profile] | join("|")' "${BASE}/groups.txt")" "fable|${FABLE_PROFILE}"
# Fable's history is already in ~/.claude (retired); Opus's is not yet.
print -r -- "{\"type\":\"user\",\"cwd\":\"${WORK}\"}" > "${HOME}/.claude/projects/-work/${SID_M}.jsonl"
run --resume "${BASE}/groups.txt"
contains "a retired group's session resumes on the default login" "$OUT" "&& claude --resume ${SID_M}"
contains "a group not yet retired resumes in its own profile" "$OUT" "env CLAUDE_CONFIG_DIR=${OPUS_PROFILE} claude --resume ${SID_N}"
excludes "no resume goes through tycswap" "$OUT" 'tycswap run'
export WSL_DISTRO_NAME=flakelab
: > "$WT_LOG"
FAKE_PGREP_NONE=1 with_stopped 310 320 -- run --open "${BASE}/groups.txt"
contains "direct tabs resume a group session on the default login" "$(<"$WT_LOG")" "-- claude --resume ${SID_M}"
: > "$TMUX_LOG"
FAKE_PGREP_NONE=1 with_stopped 310 320 -- run_tmux --open "${BASE}/groups.txt"
contains "tmux tabs resume a group session on the default login" "$(<"$TMUX_LOG")" "claude --resume ${SID_N}"
unset WSL_DISTRO_NAME

print -r -- "{\"type\":\"user\",\"cwd\":\"${WORK}\"}" > "${HOME}/.claude/projects/-work/${SID_A}.jsonl"
run --resume "${BASE}/old-shape.txt"
contains "the Codex line in a mixed old snapshot keeps its tool" "$OUT" "codex resume ${SID_B}"
# A group's history before retirement resumes in the group's profile; once
# retirement copied it into ~/.claude, only that copy is listed.
print -r -- "{\"type\":\"user\",\"cwd\":\"${WORK}\"}" > "${FABLE_PROFILE}/projects/-work/${SID_N}.jsonl"
run --recent
contains "a stopped group session not yet retired resumes in its profile" "$OUT" "env CLAUDE_CONFIG_DIR=${FABLE_PROFILE} claude --resume ${SID_N}"
print -r -- "{\"type\":\"user\",\"cwd\":\"${WORK}\"}" > "${HOME}/.claude/projects/-work/${SID_N}.jsonl"
run --recent
contains "a retired group's copied history resumes on the default login" "$OUT" "&& claude --resume ${SID_N}"
check "and is listed once" "$(print -r -- "$OUT" | grep -c -- "--resume ${SID_N}")" "1"
run --autosave
AUTO_GROUP="${HOME}/.local/state/flakelab/sessions/${BOX}-autosave-$(tr -d '-' < /proc/sys/kernel/random/boot_id | cut -c1-12).txt"
contains "autosave stores group ownership and the actual id" "$(<"$AUTO_GROUP")" "\"session\":\"${SID_M}\",\"group\":\"fable\""
print -r -- '{"tool":"claude","cwd":"/tmp","session":"x","group":"bogus","profile":"/tmp"}' > "${BASE}/bad-group.txt"
run --resume "${BASE}/bad-group.txt"
check "corrupt group metadata fails before launching" "$RC" 1
rm -rf "${PROC}/310" "${PROC}/320" "$GROUP_ROOT"
rm "${HOME}/.claude/sessions/310.json" "${HOME}/.claude/projects/-work/${SID_A}.jsonl" "${HOME}/.claude/projects/-work/${SID_N}.jsonl" "${HOME}/.claude/projects/-work/${SID_M}.jsonl"

# ---------------------------------------------------------------------------
print -r -- ""
print -r -- "manual snapshots: single/empty, atomic failure, shared state"
export FAKE_PGREP_ONLY=500
run --save "${BASE}/single.txt"
check "saving exactly one session exits 0" "$RC" 0
contains "and reports one session" "$ERR" "saved 1 session(s)"
run --resume "${BASE}/single.txt"
contains "that session resumes with its directory" "$OUT" "cd ${(q)WORK} && codex resume ${SID_X}"
FAKE_PGREP_NONE=1 run --save "${BASE}/empty.txt"
check "saving no sessions exits 0" "$RC" 0
contains "and reports zero" "$ERR" "saved 0 session(s)"
check "an empty snapshot has only its header" "$(wc -l < "${BASE}/empty.txt" | tr -d ' ')" 1

# A rename failure leaves the old snapshot byte-for-byte intact, and no temp.
cp "${BASE}/single.txt" "${BASE}/before.txt"
print -rl -- '#!/usr/bin/env zsh' 'exit 1' > "${STUBS}/mv"
chmod +x "${STUBS}/mv"
run --save "${BASE}/single.txt"
check "a real write/rename failure exits 1" "$RC" 1
cmp -s "${BASE}/single.txt" "${BASE}/before.txt" && ok "failed replacement preserves the previous save" || bad "failed replacement lost the previous save"
check "failed replacement removes its sync-excluded scratch file" "$(find "$BASE" -name '*.flakelab-tmp.*' | wc -l | tr -d ' ')" 0
rm "${STUBS}/mv"
mkdir "${BASE}/directory.txt"
run --save "${BASE}/directory.txt"
check "a directory destination is a failure, not a moved scratch file" "$RC" 1
check "a failed destination leaves no scratch file" "$(find "$BASE" -name '*.flakelab-tmp.*' | wc -l | tr -d ' ')" 0
run --save "${BASE}/missing-parent/save.txt"
check "a missing explicit parent is a write failure" "$RC" 1

export FLAKELAB_STATE_ROOT="${BASE}/shared"
run --save
A_SAVE="$(print -rl -- "${BASE}/shared/claude/sessions/"*.txt)"
cp "$A_SAVE" "${BASE}/a-before.txt"
print -r -- bbbbbbbbbbbb0000000000000000000000 > "${BASE}/machine-b"
FLAKELAB_MACHINE_ID_FILE="${BASE}/machine-b" run --save
check "a second instance can save to the same state root" "$RC" 0
cmp -s "$A_SAVE" "${BASE}/a-before.txt" && ok "the second instance leaves the first snapshot intact" || bad "another instance overwrote the snapshot"
check "same-hostname instances get distinct snapshots" "$(find "${BASE}/shared/claude/sessions" -name '*.txt' | wc -l | tr -d ' ')" 2
run --resume
contains "default resume still selects this instance" "$OUT" "# from ${A_SAVE}"
FLAKELAB_MACHINE_ID_FILE="${BASE}/machine-b" run --resume
contains "the second instance selects its own snapshot" "$OUT" "${HOST}-bbbbbbbbbbbb-"
check "successful saves leave no scratch files to sync" "$(find "${BASE}/shared" -name '*.flakelab-tmp.*' | wc -l | tr -d ' ')" 0
unset FLAKELAB_STATE_ROOT FAKE_PGREP_ONLY

print -r -- ""
print -r -- "renamed Claude processes and shared Codex servers"
# Registry candidates still need a live local Claude executable. A dead PID
# and a PID reused by another executable must not become sessions.
mk_proc 700 "$WORK" 1 /dev/null
mk_proc 701 "$WORK" 1 /dev/null
ln -s /opt/claude/versions/2.1.292 "${PROC}/700/exe"
ln -s /usr/bin/sleep "${PROC}/701/exe"
for p in 700 701; do
  print -r -- "{\"pid\":${p},\"sessionId\":\"${SID_P}\",\"startedAt\":${NOW_MS}}" > "${HOME}/.claude/sessions/${p}.json"
done
run --json
check "a version-named Claude process is found from its registry" "$(print -r -- "$OUT" | jq -r '.[] | select(.pid == 700) | .session')" "$SID_P"
check "a registry PID reused by another executable is excluded" "$(print -r -- "$OUT" | jq '[.[] | select(.pid == 701)] | length')" 0
rm "${HOME}/.claude/sessions/700.json" "${HOME}/.claude/sessions/701.json"

CODEX_ROLLOUTS="${BASE}/daemon-rollouts"
mkdir "$CODEX_ROLLOUTS"
for sid in "$SID_X" "$SID_A" "$SID_B"; do
  print -r -- "{\"type\":\"session_meta\",\"payload\":{\"id\":\"${sid}\",\"cwd\":\"${WORK}\",\"source\":\"cli\"}}" > "${CODEX_ROLLOUTS}/rollout-now-${sid}.jsonl"
done
# Internal guardian/worker sessions must not become standalone resume tabs.
print -r -- "{\"type\":\"session_meta\",\"payload\":{\"cwd\":\"${WORK}\",\"source\":{\"subagent\":{\"other\":\"guardian\"}}}}" > "${CODEX_ROLLOUTS}/rollout-now-${SID_B}.jsonl"
mk_proc 800 "$BASE" 1 "${CODEX_ROLLOUTS}/rollout-now-${SID_X}.jsonl" "${CODEX_ROLLOUTS}/rollout-now-${SID_A}.jsonl" "${CODEX_ROLLOUTS}/rollout-now-${SID_B}.jsonl" "${CODEX_ROLLOUTS}/rollout-now-${SID_X}.jsonl"
printf 'codex\0app-server\0--managed-daemon\0' > "${PROC}/800/cmdline"
export FAKE_PGREP_ONLY=800
run --json
check "one server lists both distinct user sessions" "$(print -r -- "$OUT" | jq 'length')" 2
check "the internal guardian session is excluded" "$(print -r -- "$OUT" | jq --arg sid "$SID_B" '[.[] | select(.session == $sid)] | length')" 0
check "both sessions use transcript cwd, not server cwd" "$(print -r -- "$OUT" | jq --arg cwd "$WORK" '[.[] | select(.cwd == $cwd)] | length')" 2
run --save "${BASE}/daemon.txt"
check "all server user sessions save successfully" "$RC" 0
contains "two sessions, not one process, are counted" "$ERR" "saved 2 session(s)"
run --resume "${BASE}/daemon.txt"
check "both saved sessions resume once" "$(print -r -- "$OUT" | grep -c 'codex resume')" 2
# A supervisor and a server with no conversations have nothing to resume.
printf 'codex\0app-server\0daemon\0pid-update-loop\0' > "${PROC}/800/cmdline"
run --json
check "the daemon supervisor is excluded" "$(print -r -- "$OUT" | jq 'length')" 0
printf 'codex\0app-server\0--managed-daemon\0' > "${PROC}/800/cmdline"
rm "${PROC}/800/fd/3" "${PROC}/800/fd/4" "${PROC}/800/fd/6"
run --json
check "a server holding only an internal thread is excluded" "$(print -r -- "$OUT" | jq 'length')" 0
unset FAKE_PGREP_ONLY
printf 'claude\0daemon\0run\0' > "${PROC}/300/cmdline"
run --json
check "the Claude daemon is excluded" "$(print -r -- "$OUT" | jq '[.[] | select(.pid == 300)] | length')" 0

# ---------------------------------------------------------------------------
# Lanes: --start codex with a model, an effort and a prompt, the table's STATE
# and MODEL, and --close. The helper (lib/codex_threads.py) is replaced by a
# stand-in that logs its arguments and its stdin and prints the documents the
# real one prints; the last block runs the real helper against
# lib/codex_fake_server.py instead, so the two sides are also tested against
# each other. The tmux stand-in of this section fails on any command or format
# string it does not know.
print -r -- ""
print -r -- "lanes: --start codex with model, effort and prompt"
SID_L=01a1d6aa-0000-7000-8000-00000000000a
SID_S=01a1d6bb-0000-7000-8000-00000000000b
LANEBIN="${BASE}/lanebin"
mkdir -p "${LANEBIN}"
cat > "${LANEBIN}/tmux" <<'STUB'
#!/usr/bin/env zsh
US=$'\x1f'
print -r -- "$*" >> "${TMUX_LOG}"
[[ -n "${EVENTS:-}" ]] && print -r -- "tmux $1" >> "${EVENTS}"
[[ -n "${EVENT_SINK:-}" ]] && print -r -- "{\"method\":\"tmux/$1\"}" >> "${EVENT_SINK}"
# Anything this stand-in does not know is recorded, and the suite asserts the record is empty:
# a caller that hides tmux's stderr must not hide a call the stand-in cannot answer.
unknown() { print -r -- "$*" >> "${TMUX_UNKNOWN}"; print -ru2 -- "tmux stand-in: unknown $*"; exit 1 }
case "$1" in
  -V) print -r -- "tmux 3.4"; exit 0 ;;
  has-session) [[ -n "${FAKE_TMUX_HAS:-}" ]]; exit $? ;;
  list-panes)
    [[ "$*" == "list-panes -a -F #{pane_pid}${US}#{session_name}${US}#{window_id}${US}#{window_name}${US}#{@flakelab_session}" ]] || unknown "$@"
    [[ -r "${TMUX_PANES:-}" ]] && cat "${TMUX_PANES}"; exit 0 ;;
  list-windows)
    case "$*" in
      "list-windows -t agents -F #{window_name}") [[ -r "${TMUX_WINDOWS:-}" ]] && cut -d"$US" -f2 "${TMUX_WINDOWS}"; exit 0 ;;
      "list-windows -t agents -F #{window_id}")
        [[ -r "${TMUX_WINDOW_IDS:-}" ]] && cat "${TMUX_WINDOW_IDS}"
        [[ -r "${TMUX_WINDOWS:-}" ]] && cut -d"$US" -f1 "${TMUX_WINDOWS}"
        exit 0 ;;
      "list-windows -t agents -F #{window_id}${US}#{window_name}${US}#{@flakelab_session}${US}#{window_panes}${US}#{pane_start_command}") [[ -r "${TMUX_WINDOWS:-}" ]] && cat "${TMUX_WINDOWS}"; exit 0 ;;
    esac
    unknown "$@" ;;
  new-session|new-window)
    [[ -n "${FAKE_TMUX_NO_WINDOW:-}" ]] && exit 1
    [[ " $* " == *" -P -F #{window_id} "* ]] || unknown "$@"
    print -r -- "@10"; exit 0 ;;
  set-option)
    [[ "$2 $3 $5" == "-w -t @flakelab_session" && $# == 6 ]] || unknown "$@"
    [[ -n "${FAKE_TMUX_NO_MARK:-}" ]] && exit 1
    print -r -- "$4${US}$6" >> "${TMUX_MARKS}"; exit 0 ;;
  show-options)
    [[ "$2 $3 $4 $6" == "-w -v -t @flakelab_session" && $# == 6 ]] || unknown "$@"
    [[ -n "${FAKE_TMUX_WRONG_MARK:-}" ]] && { print -r -- "something-else"; exit 0 }
    awk -F"$US" -v w="$5" '$1 == w { v = $2 } END { if (v != "") print v }' "${TMUX_MARKS}"; exit 0 ;;
  if-shell)
    # if-shell -F -t <window> <format> "kill-window -t <window>": the kill tmux's server
    # decides on. The stand-in holds the window's row as it is at this moment and takes the
    # format at its word: one pane, and it must compare the recorded session and the start
    # command with exactly what the row has. Only then is the row removed.
    [[ "$2 $3" == "-F -t" && $# == 6 && "$6" == "kill-window -t $4" ]] || unknown "$@"
    [[ -n "${FAKE_TMUX_BEFORE_KILL:-}" ]] && eval "${FAKE_TMUX_BEFORE_KILL}"
    row="$(awk -F"$US" -v w="$4" '$1 == w' "${TMUX_WINDOWS}")"
    [[ -n "$row" ]] || exit 1
    IFS="$US" read -r wid wname wsid panes startcmd <<<"$row"
    if [[ "$panes" == 1 && "$5" == *"#{==:#{window_panes},1}"* && "$5" == *"#{==:#{@flakelab_session},${wsid}}"* &&
          "$5" == *"#{==:#{pane_start_command},${startcmd}}"* && " ${FAKE_TMUX_KILL_FAILS:-} " != *" $4 "* ]]; then
      print -r -- "kill-window -t $4" >> "${TMUX_LOG}"
      [[ -n "${EVENTS:-}" ]] && print -r -- "tmux kill-window" >> "${EVENTS}"
      awk -F"$US" -v w="$4" '$1 != w' "${TMUX_WINDOWS}" > "${TMUX_WINDOWS}.new"
      mv "${TMUX_WINDOWS}.new" "${TMUX_WINDOWS}"
    fi
    exit 0 ;;
esac
unknown "$@"
STUB
# The helper stand-in: its documents are the ones lib/codex_threads.py prints.
cat > "${LANEBIN}/helper" <<'STUB'
#!/usr/bin/env zsh
print -r -- "$*" >> "${HELPER_LOG}"
[[ -n "${EVENTS:-}" ]] && print -r -- "helper $1" >> "${EVENTS}"
[[ "$1" == start ]] && cat > "${HELPER_STDIN}"
[[ " ${HELPER_FAIL:-} " == *" $1 "* ]] && { print -ru2 -- "Error: $1 failed on purpose"; exit ${HELPER_RC:-1} }
case "$1" in
  start) print -r -- "{\"session\":\"${HELPER_SID}\",\"model\":\"gpt-6.1-sol\",\"effort\":\"xhigh\",\"turn\":\"t1\",\"server\":\"0.169.0\"}" ;;
  state) shift 3; jq -cn --arg busy "${HELPER_BUSY:-}" --arg mute "${HELPER_NO_ANSWER:-}" '[$ARGS.positional[] | if . == $mute then {session: ., state: null, model: null, effort: null, name: null} else {session: ., state: (if . == $busy then "working" else "idle" end), model: "gpt-6.1-sol", effort: "xhigh", name: null} end]' --args "$@" ;;
  close-check)
    sid="${@[-1]}"
    # What happens to the windows while the session is being looked at.
    [[ -n "${HELPER_DURING_CHECK:-}" ]] && eval "${HELPER_DURING_CHECK}"
    if [[ " ${HELPER_BUSY:-} " == *" ${sid} "* && ! -e "${HELPER_STOPPED}.${sid}" ]]; then
      jq -cn --arg s "$sid" --arg cwd "${HELPER_CWD}" '{session: $s, finished: false, state: "working", reasons: ["the session is working", "runs: sleep 300"], cwd: $cwd, name: null}'
    else
      jq -cn --arg s "$sid" --arg cwd "${HELPER_CWD}" '{session: $s, finished: true, state: "idle", reasons: [], cwd: $cwd, name: null}'
    fi ;;
  stop) : > "${HELPER_STOPPED}.$2"; print -r -- "{\"session\":\"$2\",\"interrupted\":[\"$2\"],\"cleaned\":[\"$2\"]}" ;;
  archive) print -r -- "{\"session\":\"$2\",\"archived\":true}" ;;
  *) exit 2 ;;
esac
STUB
chmod +x "${LANEBIN}"/*
export HELPER_LOG="${BASE}/helper.log" HELPER_STDIN="${BASE}/helper.stdin" HELPER_SID="${SID_L}" HELPER_CWD="${WORK}" HELPER_STOPPED="${BASE}/stopped"
export FLAKELAB_CODEX_THREADS="${LANEBIN}/helper" FLAKELAB_SESSIONS_SETTLE=0
export TMUX_WINDOWS="${BASE}/windows" TMUX_WINDOW_IDS="${BASE}/window-ids" TMUX_MARKS="${BASE}/marks" TMUX_UNKNOWN="${BASE}/tmux-unknown"
export EVENTS="${BASE}/events"
: > "${TMUX_UNKNOWN}"
export FAKE_TMUX_HAS=1
run_lane() { OUT="$(PATH="${LANEBIN}:${PATH}" "${CMD}" "$@" 2>"${BASE}/err")"; RC=$?; ERR="$(<"${BASE}/err")"; }
fresh() { : > "${TMUX_LOG}"; : > "${HELPER_LOG}"; : > "${HELPER_STDIN}"; : > "${TMUX_MARKS}"; : > "${EVENTS}"; rm -f "${HELPER_STOPPED}".*(N); }
# The first line number of an event, 0 when it never happened: for "this came before that".
event() { local n; n="$(grep -n -m1 -x -- "$1" "${EVENTS}" | cut -d: -f1)"; print -r -- "${n:-0}" }
print -r -- "@10" > "${TMUX_WINDOW_IDS}"
: > "${TMUX_WINDOWS}"
print -r -- "from a file" > "${BASE}/prompt.txt"

fresh
# Each usage error by its own reason: the folder's name holds a space, and a
# case that merely exits 2 would also pass on a mis-split argument.
usage_error() {
  local label="$1" reason="$2"; shift 2
  run_lane "$@"
  check "${label} exits 2" "${RC}" "2"
  contains "${label}: the reason" "${ERR}" "${reason}"
}
usage_error "a lane flag with --start claude" "is for --start codex" --start claude "${WORK}" --model opus --prompt go
usage_error "a lane flag without a prompt" "needs --prompt or --prompt-file" --start codex "${WORK}" --model gpt-6.1-sol
usage_error "both prompt flags" "exclude each other" --start codex "${WORK}" --prompt go --prompt-file "${BASE}/prompt.txt"
usage_error "a lane flag with -- args" "cannot be combined with -- args" --start codex "${WORK}" --prompt go -- -m gpt-6.1-sol
usage_error "a missing prompt file" "is missing, unreadable or empty" --start codex "${WORK}" --prompt-file "${BASE}/no-such-file"
: > "${BASE}/empty.txt"
usage_error "an empty prompt file" "is missing, unreadable or empty" --start codex "${WORK}" --prompt-file "${BASE}/empty.txt"
usage_error "a name tmux cannot target" "must be a window name" --start codex "${WORK}" --prompt go --name a.b
usage_error "a name of 41 characters" "must be a window name" --start codex "${WORK}" --prompt go --name "${(l:41::x:):-}"
usage_error "a lane flag without a value" "--prompt needs a value" --start codex "${WORK}" --prompt
usage_error "a lane flag without --start" "belongs to --start codex" --model gpt-6.1-sol
usage_error "--force without --close" "belong to --close" --force
usage_error "--close without a target" "needs a window or a session id" --close
usage_error "a lane in a folder that does not exist" "no such directory" --start codex "${BASE}/nowhere" --prompt go
usage_error "both prompt flags, one of them empty" "--prompt needs a value" --start codex "${WORK}" --prompt "" --prompt-file "${BASE}/prompt.txt"
usage_error "an empty model" "--model needs a value" --start codex "${WORK}" --prompt go --model ""
usage_error "an empty effort" "--effort needs a value" --start codex "${WORK}" --prompt go --effort ""
usage_error "a name that begins with a dash" "must be a window name" --start codex "${WORK}" --prompt go --name "-lane"
usage_error "a name with a line break" "must be a window name" --start codex "${WORK}" --prompt go --name $'lane\nnext'
usage_error "a name with a tab" "must be a window name" --start codex "${WORK}" --prompt go --name $'lane\tnext'
check "no usage error reached the helper or created a window" "$(wc -l < "${HELPER_LOG}")/$(grep -c '^new-' "${TMUX_LOG}")" "0/0"

fresh
PROMPT=$'Read BRIEF.md in full.\nThen: prüfe §3 — "alles".'
CODEX_HOME="${BASE}/codex home" run_lane --start codex "${WORK}" --model GPT-6.1-Sol --effort xhigh --name lane-a --prompt "${PROMPT}" --detach
check "a lane start exits 0" "${RC}" "0"
check "the helper gets folder, model, effort and name, each value in one word" "$(<"${HELPER_LOG}")" "start --cwd ${WORK} --model=GPT-6.1-Sol --effort=xhigh --name=lane-a"
print -rn -- "${PROMPT}" > "${BASE}/prompt.want"
check "the prompt reaches the helper on stdin, byte for byte" "$(cmp "${BASE}/prompt.want" "${HELPER_STDIN}" 2>&1)" ""
excludes "and is on no helper command line" "$(<"${HELPER_LOG}")" "BRIEF"
contains "the window runs codex resume on the session the helper named" "$(<"${TMUX_LOG}")" "-c ${WORK} codex resume ${SID_L}"
contains "under the lane's name" "$(<"${TMUX_LOG}")" "new-window -d -P -F #{window_id} -t agents -n lane-a "
contains "with the caller's Codex home" "$(<"${TMUX_LOG}")" "-e CODEX_HOME=${BASE}/codex home"
contains "the session is recorded on the window" "$(<"${TMUX_LOG}")" "set-option -w -t @10 @flakelab_session ${SID_L}"
check "the helper has started the session before the window is created, and the mark follows" "$(( $(event 'helper start') > 0 && $(event 'helper start') < $(event 'tmux new-window') && $(event 'tmux new-window') < $(event 'tmux set-option') ))" "1"
check "the mark is read back" "$(grep -c '^show-options -w -v -t @10 @flakelab_session$' "${TMUX_LOG}")" "1"
contains "the report names model, effort, window and session" "${ERR}" "started codex gpt-6.1-sol xhigh in ${WORK} as agents:lane-a (@10), session ${SID_L}"
contains "and how to close it" "${ERR}" "flakelab sessions --close lane-a"

fresh
