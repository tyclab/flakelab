#!/usr/bin/env zsh

set -uo pipefail

#
# gitcleaner — retire local branches and worktrees whose work has landed
#
# Per repo: fast-forward strictly-behind branches, prune worktree entries whose directory is gone, delete branches
# merged into the default, and gone-upstream branches whose forge MR/PR merged (squash case, -d refuses).
# Never touched: the default branch, an open MR/PR's branch, unpushed commits. A checkout (HEAD or a worktree) on a
# landed branch is reported as parked and moved off it only when asked, or under --unpark --yes.
# Asks per branch at a terminal; without one it only reports unless --yes. Each delete prints its SHA (undo:
# `git branch <name> <sha>`). Agents plan with --json, then act with `--only <branch> --yes`; a non-candidate name fails.
#
# Usage:
#   gitcleaner [--repos-dir DIR]... [--repo PATH]... [--dry-run|--yes]
#              [--only BRANCH]... [--unpark] [--json] [--max-depth N] [DIR...]
#
# Exit status:
#   0  nothing to clean
#   1  stale items found — removed, reported, or kept at the prompt
#   2  preflight failure, per-repo fetch/forge/parse failure, a refused delete,
#      or a usage error
#

# Shared with gitchecker so the reporter and the deleter never disagree about which repos are in scope.
GITSCAN_PROG=gitcleaner
source "${0:A:h}/lib/gitscan.zsh" || exit 2
# The y/N questions, asked the one way every flakelab command asks them.
source "${0:A:h}/lib/prompt.zsh" || exit 2

typeset -a ROOTS=() REPO_ARGS=() ONLY=()
MAX_DEPTH=6
DRY_RUN=0
FF=1
FF_DIRTY=0
ASSUME_YES=0
UNPARK=0
QUIT_ALL=0
JSON=0

usage() {
  cat <<'EOF'
gitcleaner — retire the branches and worktrees whose work has landed

Usage: gitcleaner [options] [repos-dir...]

The mutating half of `gitchecker`: where that reports a branch as stale, this
one removes it. Per repo it prunes worktree entries whose checkout directory is
gone, deletes local branches merged into the default branch, and deletes
branches whose remote branch was pruned AND whose MR/PR the forge reports as
merged — the squash-merge case, where `git branch -d` refuses because the
commits are not ancestors of anything.

Never touched: the default branch, a branch with an open MR/PR, and a branch
holding commits the remote has never seen. A repo without origin/HEAD is
skipped rather than guessed at.

A branch that is checked out — HEAD here, or in a linked worktree — is reported
as parked when its work landed AND its remote branch was deleted, so a fresh
local branch never counts. At a terminal you are asked whether to switch the
checkout to the default branch (or remove the worktree) and delete the branch;
under --yes that needs --unpark. Uncommitted changes, untracked files in a
worktree, and a worktree lock that names no pid or a running one leave it alone.

Every deletion prints the SHA it removed, so the undo is the
`git branch <name> <sha>` already on your screen.

At a terminal each candidate is shown and confirmed one at a time (y/N/a/q):
y delete, n keep, a the rest of this repo, q stop. That prompt IS the
confirmation — there is no separate apply step. With no terminal there is
nobody to ask, so it reports and changes nothing unless --yes.

Options:
  --repos-dir <path>  Root dir to scan (repeatable; default: ~/git)
  --repo <path>       Clean exactly this repo (repeatable; skips discovery)
  --max-depth <N>     Max search depth for nested repos (default: 6)
  --dry-run           Report only; never delete or fast-forward, even at a terminal
  --no-ff             Do not fast-forward strictly-behind branches first
  --ff-dirty          Also try that fast-forward when the working tree is dirty
  --yes               Delete without asking (for scripts; needs no terminal)
  --only <branch>     Restrict deletion to this branch (repeatable). A name
                      that is not a candidate is an error, not a no-op.
  --unpark            With --yes, also move parked checkouts off their branch
                      (switch HEAD to the default, remove the worktree) first
  --json              One JSON document on stdout; never prompts
  -h, --help          Show this help

Examples:
  gitcleaner                             walk every candidate, confirm each
  gitcleaner --dry-run                   list them, change nothing
  gitcleaner --repo . --json             what would go here, machine-readable
  gitcleaner --repo . --only old/feat --yes
                                         remove exactly that one, guards intact
  gitcleaner --repo . --only old/feat --unpark --yes
                                         the same while it is checked out

Exit: 0 nothing to clean, 1 items found (removed, reported or kept), 2 failure
EOF
}

die() { gitscan_die "$@" }

while (( $# > 0 )); do
  case $1 in
    --repos-dir) ROOTS+=("$2"); shift ;;
    --repo)      REPO_ARGS+=("$2"); shift ;;
    --max-depth) MAX_DEPTH="$2"; shift ;;
    # A fast-forward is a change, so --dry-run opts out; a later --ff-dirty does not re-enable it.
    --dry-run)   DRY_RUN=1; FF=0 ;;
    --no-ff)     FF=0 ;;
    --ff-dirty)  FF_DIRTY=1 ;;
    --yes|-y)    ASSUME_YES=1 ;;
    --only)      ONLY+=("$2"); shift ;;
    --unpark)    UNPARK=1 ;;
    --json)      JSON=1 ;;
    -h|--help)   usage; exit 0 ;;
    -*)          print -r -u2 -- "Unknown option: $1"; usage >&2; exit 2 ;;
    *)           ROOTS+=("$1") ;;
  esac
  shift
done

if (( ${#REPO_ARGS[@]} == 0 && ${#ROOTS[@]} == 0 )); then
  ROOTS=("${HOME}/git")
fi

# Three modes, decided once: ask (a terminal to ask at), delete (--yes), or
# report (no terminal, --dry-run, or --json without --yes). Reading the tty here
# rather than per prompt keeps the summary honest about what the run was allowed
# to do. --json never prompts even at a terminal: a half-written document with a
# question in the middle of it is not a document.
MODE=report
if (( DRY_RUN )); then
  MODE=report
elif (( ASSUME_YES )); then
  MODE=delete
elif (( JSON )); then
  MODE=report
elif prompt_tty; then
  MODE=ask
fi

(( JSON )) && GITSCAN_DIE_JSON=1

gitscan_preflight
typeset -a ABS_ROOTS=()
if (( ${#ROOTS[@]} > 0 )); then
  gitscan_abs_roots "${ROOTS[@]}"
  ABS_ROOTS=("${GITSCAN_ABS_ROOTS[@]}")
fi
gitscan_timeouts
gitscan_colors
(( JSON )) && { C_RESET=""; C_RED=""; C_GREEN=""; C_YELLOW=""; C_CYAN=""; C_DIM="" }

WORKDIR="$(mktemp -d)"
trap 'rm -rf "${WORKDIR}"' EXIT

gitscan_ssh_mux "${WORKDIR}"

# Unlike gitchecker, worktrees are not swept as repos: deleting through one writes the parent's ref store.
GITSCAN_SKIP_WORKTREES=1
typeset -a GITDIRS=()
if (( ${#ABS_ROOTS[@]} > 0 )); then
  gitscan_discover "${MAX_DEPTH}" "${ABS_ROOTS[@]}"
  GITDIRS=("${GITSCAN_GITDIRS[@]}")
fi
# A named repo that is not one is a usage error: a caller that mistyped a path
# must not be told there was nothing to clean.
for repo_arg in "${REPO_ARGS[@]}"; do
  [[ -d "${repo_arg:A}/.git" ]] || die "not a git repo: ${repo_arg}"
  GITDIRS+=("${repo_arg:A}/.git")
done

if (( ${#GITDIRS[@]} == 0 )); then
  if (( JSON )); then
    jq -n '{ok: true, aborted: null, mode: "report", scanned: 0, repos: [],
            found: {branches: 0, worktrees: 0}, removed: {branches: 0, worktrees: 0},
            kept: 0, failed: 0, skipped: 0}'
  else
    print -r -- "No git repos found under: ${(j:, :)ABS_ROOTS}"
  fi
  exit 0
fi

gitscan_require_gh "${GITDIRS[@]}"

# Found and removed are separate counts: a declined delete says nothing about the tree.
typeset -i FOUND_BRANCHES=0 FOUND_WORKTREES=0
typeset -i GONE_BRANCHES=0 GONE_WORKTREES=0 KEPT_BRANCHES=0 FAILED_BRANCHES=0
typeset -i FOUND_PARKED=0 GONE_PARKED=0
typeset -i REPOS_TOUCHED=0 SKIPPED=0
typeset -i REC_IDX=0
typeset -a ONLY_MATCHED=() ONLY_NEEDS_UNPARK=()
LAST_SKIP=""

# The report is for the operator; --json owns stdout when it is on, so every
# human line goes through here and every machine fact through rec_line. One
# run produces one of the two, never a blend.
say() { (( JSON )) || print -r -- "$@" }

rec_line() { print -r -- "${(pj:\t:)@}" >> "${REC}" }

# skip <reason> [detail]: the reason reaches both the operator and the JSON.
skip() {
  LAST_SKIP="$1"
  print -r -u2 -- "gitcleaner: $1"
  [[ -n "${2-}" ]] && print -r -u2 -- "  $2"
  return 2
}

# /proc first: it sees every user's processes and needs no ps on the pinned PATH. With neither, the pid counts as alive.
pid_alive() {
  [[ -d /proc/self ]] && { [[ -d "/proc/$1" ]]; return }
  command -v ps >/dev/null || return 0
  ps -p "$1" >/dev/null 2>&1
}

clean_repo() {
  local repo="$1"
  local default_branch head_branch branch upstream_track remote_url forge_line forge project
  local open_srcs="" wt_out
  # No queryable forge: the ancestor test still stands, the squash case is skipped rather than guessed.
  local -i have_forge=0
  typeset -a to_delete_safe=() to_delete_squashed=() pruned_worktrees=() parked=()
  typeset -A held_path=() held_lock=() checked_sha=()
  # "all" is per repo: agreeing to sweep one repo is not agreeing to the rest.
  typeset -i REPO_ALL=0

  # Accurate "merged" and "gone" both depend on current remote refs.
  if ! gitnet_retry git -C "${repo}" fetch --prune; then
    skip "fetch failed in ${repo} (after retry, ${GITNET_WHY}) — skipping" "${GITNET_OUT}"
    return 2
  fi

  default_branch="$(git -C "${repo}" symbolic-ref --short -q refs/remotes/origin/HEAD 2>/dev/null)"
  default_branch="${default_branch#origin/}"
  # No origin/HEAD, no answer to "merged into what": guessing main/master deletes the wrong branch.
  # Read AFTER the fetch, which re-creates a missing origin/HEAD from the server's advertised symref.
  [[ -z "${default_branch}" ]] && {
    skip "${repo}: no origin/HEAD — run 'git remote set-head origin -a'; skipping"
    return 2
  }
  head_branch="$(git -C "${repo}" symbolic-ref --short -q HEAD 2>/dev/null)"

  # Fast-forward first: "merged" is judged against the LOCAL default ref. --no-ff opts out.
  if (( FF )); then
    local -i ff_dirty_count=0
    ff_dirty_count="$(git -C "${repo}" status --porcelain=v1 2>/dev/null | grep -c . || true)"
    # Declared once, outside the loop: a bare `local x` for a declared name prints it and corrupts --json.
    local ffb ffu ff_allow ffcounts ffahead ffbehind
    while IFS= read -r ffb || [[ -n "${ffb}" ]]; do
      [[ -z "${ffb}" ]] && continue
      ffu="$(git -C "${repo}" rev-parse --abbrev-ref --symbolic-full-name "${ffb}@{upstream}" 2>/dev/null)" || continue
      # Strictly behind only: left-right count is ahead on the right.
      ffcounts="$(git -C "${repo}" rev-list --count --left-right "${ffu}...${ffb}" 2>/dev/null)" || continue
      ffbehind="${ffcounts%%[[:space:]]*}"; ffahead="${ffcounts##*[[:space:]]}"
      (( ffahead != 0 || ffbehind == 0 )) && continue
      ff_allow=false
      (( FF_DIRTY )) && ff_allow=true
      if gitscan_ff_branch "${repo}" "${ffb}" "${ffu}" "${head_branch}" "${ff_dirty_count}" "${ff_allow}"; then
        say "  fast-forwarded ${ffb} (${ffbehind} behind)"
      fi
    done < <(git -C "${repo}" for-each-ref --format='%(refname:short)' refs/heads/ 2>/dev/null)
  fi

  # Worktrees whose checkout directory is gone leave admin entries behind that
  # keep their branch "checked out" and therefore undeletable. `--dry-run`
  # reports on stderr, not stdout. Checked, not assumed: a failed command's
  # error text would otherwise be read back as a list of stale entries.
  local -i wt_rc=0
  wt_out="$(git -C "${repo}" worktree prune --dry-run --verbose 2>&1)" || wt_rc=$?
  if (( wt_rc != 0 )); then
    skip "worktree prune --dry-run failed in ${repo} — skipping" "${wt_out}"
    return 2
  fi
  if [[ -n "${wt_out}" ]]; then
    while IFS= read -r line; do
      [[ -z "${line}" ]] && continue
      pruned_worktrees+=("${line}")
    done <<< "${wt_out}"
  fi

  # Prune before deleting anything: a stale entry still holds its branch, and
  # `git branch -d` refuses a branch any worktree claims. A directory that is
  # gone has no work in it to lose, so this needs no prompt. A refused prune is
  # a skip — reporting those entries as pruned would be the false green.
  if [[ "${MODE}" != report ]] && (( ${#pruned_worktrees[@]} > 0 )); then
    if ! wt_out="$(git -C "${repo}" worktree prune 2>&1)"; then
      skip "worktree prune failed in ${repo} — skipping" "${wt_out}"
      return 2
    fi
  fi

  # A checked-out branch is never deleted from under its checkout; it can only be reported as parked.
  local wt_path="" wt_branch=""
  while IFS= read -r line; do
    case "${line}" in
      worktree\ *) wt_path="${line#worktree }"; wt_branch="" ;;
      branch\ *)   wt_branch="${${line#branch }#refs/heads/}"
                   [[ -d "${wt_path}" ]] && held_path[${wt_branch}]="${wt_path}" ;;
      locked*)     [[ -n "${wt_branch}" ]] && held_lock[${wt_branch}]="${line}" ;;
    esac
  done < <(git -C "${repo}" worktree list --porcelain 2>/dev/null)
  [[ -n "${head_branch}" ]] && held_path[${head_branch}]="${repo}"

  remote_url="$(git -C "${repo}" config --get remote.origin.url 2>/dev/null)"
  if [[ -n "${remote_url}" ]] && forge_line="$(gitscan_forge_of "${remote_url}")"; then
    IFS=$'\t' read -r forge project <<< "${forge_line}"
    have_forge=1
    # Open MRs pin their source branch; every page, since a first-hundred guard is no guard.
    if ! gitscan_open_requests "${forge}" "${project}"; then
      skip "${GITSCAN_FORGE_WHY} for ${project} — skipping ${repo}" "${GITSCAN_FORGE_JSON}"
      return 2
    fi
    if [[ "${forge}" == gitlab ]]; then
      if ! gitscan_jq "${GITSCAN_FORGE_JSON}" '.[].source_branch'; then
        skip "could not parse the open MR list for ${project} — skipping ${repo}" "${GITSCAN_JQ_ERR}"
        return 2
      fi
    else
      if ! gitscan_jq "${GITSCAN_FORGE_JSON}" '.[].headRefName'; then
        skip "could not parse the open PR list for ${project} — skipping ${repo}" "${GITSCAN_JQ_ERR}"
        return 2
      fi
    fi
    open_srcs="${GITSCAN_JQ_OUT}"
  fi

  while IFS= read -r branch || [[ -n "${branch}" ]]; do
    [[ -z "${branch}" ]] && continue
    [[ "${branch}" == "${default_branch}" ]] && continue
    # An open MR means the work is in flight, whatever the ref graph says.
    (( ${${(f)open_srcs}[(Ie)${branch}]} )) && continue
    checked_sha[${branch}]="$(git -C "${repo}" rev-parse --verify "refs/heads/${branch}" 2>/dev/null)" || continue
    upstream_track="$(git -C "${repo}" for-each-ref --format='%(upstream:track)' "refs/heads/${branch}" 2>/dev/null)"
    # Checked out: parked only once pushed and its remote branch deleted, or a branch just started would qualify.
    if (( ${+held_path[${branch}]} )); then
      [[ "${upstream_track}" == *gone* ]] || continue
      if git -C "${repo}" merge-base --is-ancestor \
           "${checked_sha[${branch}]}" "refs/remotes/origin/${default_branch}" 2>/dev/null; then
        parked+=("${branch}"$'\t'"merged into ${default_branch}")
        continue
      fi
      (( have_forge )) || continue
      gitscan_branch_merged "${forge}" "${project}" "${branch}" \
        "${checked_sha[${branch}]}"
      case $? in
        0) parked+=("${branch}"$'\t'"MR merged, upstream pruned") ;;
        1) ;;
        *) skip "${GITSCAN_FORGE_WHY} — skipping ${repo}"; return 2 ;;
      esac
      continue
    fi

    # Every commit is reachable from origin/<default>: nothing is lost.
    if git -C "${repo}" merge-base --is-ancestor \
         "${checked_sha[${branch}]}" "refs/remotes/origin/${default_branch}" 2>/dev/null; then
      to_delete_safe+=("${branch}")
      continue
    fi

    # Squash merges: only the forge can say it landed, only a pruned upstream proves the ref is the leftover.
    # The forge is asked per branch: a merged-MR list is one page of an unbounded history.
    [[ "${upstream_track}" == *gone* ]] || continue
    (( have_forge )) || continue
    gitscan_branch_merged "${forge}" "${project}" "${branch}" \
      "${checked_sha[${branch}]}"
    case $? in
      0) to_delete_squashed+=("${branch}") ;;
      1) ;;
      *) skip "${GITSCAN_FORGE_WHY} — skipping ${repo}"; return 2 ;;
    esac
  done < <(git -C "${repo}" for-each-ref --format='%(refname:short)' refs/heads/ 2>/dev/null)

  # --only narrows deletions only: a stale worktree entry has nothing to lose, and pruning it unblocks the branch.
  if (( ${#ONLY[@]} > 0 )); then
    typeset -a keep_safe=() keep_squashed=()
    for branch in "${to_delete_safe[@]}"; do
      (( ${ONLY[(Ie)${branch}]} )) && { keep_safe+=("${branch}"); ONLY_MATCHED+=("${branch}") }
    done
    for branch in "${to_delete_squashed[@]}"; do
      (( ${ONLY[(Ie)${branch}]} )) && { keep_squashed+=("${branch}"); ONLY_MATCHED+=("${branch}") }
    done
    to_delete_safe=("${keep_safe[@]}")
    to_delete_squashed=("${keep_squashed[@]}")
    typeset -a keep_parked=()
    local entry
    for entry in "${parked[@]}"; do
      branch="${entry%%$'\t'*}"
      (( ${ONLY[(Ie)${branch}]} )) || continue
      keep_parked+=("${entry}")
      if [[ "${MODE}" == delete ]] && (( ! UNPARK )); then
        ONLY_NEEDS_UNPARK+=("${branch}")
      else
        ONLY_MATCHED+=("${branch}")
      fi
    done
    parked=("${keep_parked[@]}")
  fi

  (( ${#to_delete_safe[@]} + ${#to_delete_squashed[@]} + ${#pruned_worktrees[@]} + ${#parked[@]} == 0 )) && return 0

  (( REC_IDX++ ))
  REC="${WORKDIR}/rec.$(printf '%04d' ${REC_IDX})"
  rec_line REPO "${repo}" "${default_branch}"

  say ""
  say "${C_CYAN}${repo}${C_RESET} ${C_DIM}(default: ${default_branch})${C_RESET}"
  (( REPOS_TOUCHED++ ))

  local b line sha reason
  for line in "${pruned_worktrees[@]}"; do
    (( FOUND_WORKTREES++ ))
    if [[ "${MODE}" == report ]]; then
      say "  ${C_YELLOW}stale worktree${C_RESET} ${C_DIM}${line}${C_RESET}"
      rec_line WT "${line}" reported
    else
      say "  ${C_GREEN}pruned worktree${C_RESET} ${C_DIM}${line}${C_RESET}"
      rec_line WT "${line}" pruned
      (( GONE_WORKTREES++ ))
    fi
  done

  # confirm <prompt> [each]: y delete, n keep, a rest of this repo, q stop the run; "each" ignores an earlier a.
  confirm() {
    local _p="$1"
    [[ "${MODE}" == delete ]] && return 0
    [[ "${MODE}" == report ]] && return 1
    (( REPO_ALL )) && [[ "${2-}" != each ]] && return 0
    prompt_keys "${_p}" "y/N/a/q"
    case "${PROMPT_KEY}" in
      [yY]) return 0 ;;
      [aA]) REPO_ALL=1; return 0 ;;
      [qQ]) QUIT_ALL=1; return 1 ;;
      *)    return 1 ;;
    esac
  }

  # Forge queries and operator confirmation can wait while another session commits.
  branch_unchanged() {
    local _current
    _current="$(git -C "${repo}" rev-parse --verify "refs/heads/$1" 2>/dev/null)" || return 1
    [[ "${_current}" == "${checked_sha[$1]}" ]]
  }

  # Prints the SHA it removed: that line is the whole undo procedure.
  delete_branch() {
    local _b="$1" _flag="$2" _why="$3" _sha
    _sha="$(git -C "${repo}" rev-parse --short "${checked_sha[${_b}]}" 2>/dev/null)"
    if ! branch_unchanged "${_b}"; then
      _why="${_why}; branch tip changed since eligibility check"
    elif git -C "${repo}" branch "${_flag}" "${_b}" >/dev/null 2>&1; then
      say "  ${C_GREEN}deleted${C_RESET} ${_b} ${C_DIM}(${_why}) — restore: git -C ${repo} branch ${_b} ${_sha}${C_RESET}"
      rec_line BRANCH "${_b}" "${_why}" "${_sha}" deleted
      (( GONE_BRANCHES++ ))
      return
    fi
    # A refused delete is a failure, not a quiet no-op: the summary must not
    # count this branch as handled either way.
    print -r -u2 -- "  ${C_RED}FAILED${C_RESET} to delete ${_b} (${_why})"
    rec_line BRANCH "${_b}" "${_why}" "${_sha}" failed
    (( FAILED_BRANCHES++ ))
  }

  for b in "${to_delete_safe[@]}"; do
    (( QUIT_ALL )) && break
    (( FOUND_BRANCHES++ ))
    reason="merged into ${default_branch}"
    if [[ "${MODE}" == report ]]; then
      say "  ${C_YELLOW}stale${C_RESET} ${b} ${C_DIM}(${reason})${C_RESET}"
      rec_line BRANCH "${b}" "${reason}" \
        "$(git -C "${repo}" rev-parse --short "refs/heads/${b}" 2>/dev/null)" reported
      continue
    fi
    if confirm "delete ${b} (${reason})?"; then
      # -D: ancestry vs origin/<default> is already proved above; -d re-judges
      # against HEAD and refuses when the checkout is parked on an older branch.
      delete_branch "${b}" -D "${reason}"
    else
      (( KEPT_BRANCHES++ ))
      rec_line BRANCH "${b}" "${reason}" \
        "$(git -C "${repo}" rev-parse --short "refs/heads/${b}" 2>/dev/null)" kept
      (( QUIT_ALL )) || say "  ${C_DIM}kept${C_RESET} ${b}"
    fi
  done

  for b in "${to_delete_squashed[@]}"; do
    (( QUIT_ALL )) && break
    (( FOUND_BRANCHES++ ))
    reason="MR merged, upstream pruned"
    if [[ "${MODE}" == report ]]; then
      say "  ${C_YELLOW}stale${C_RESET} ${b} ${C_DIM}(${reason})${C_RESET}"
      rec_line BRANCH "${b}" "${reason}" \
        "$(git -C "${repo}" rev-parse --short "refs/heads/${b}" 2>/dev/null)" reported
      continue
    fi
    # -D, not -d: the squashed commits are not ancestors, so -d refuses. The
    # forge said this branch's MR merged and its remote is gone, which is the
    # evidence -d cannot see.
    if confirm "delete ${b} (${reason})?"; then
      delete_branch "${b}" -D "${reason}"
    else
      (( KEPT_BRANCHES++ ))
      rec_line BRANCH "${b}" "${reason}" \
        "$(git -C "${repo}" rev-parse --short "refs/heads/${b}" 2>/dev/null)" kept
      (( QUIT_ALL )) || say "  ${C_DIM}kept${C_RESET} ${b}"
    fi
  done

  # Moves the checkout off the branch, then deletes it. A refusal stops before the delete; a lock lifted for the
  # removal goes back on.
  unpark() {
    local _b="$1" _why="$2" _sha="$3" _wt="$4" _lock="$5" _out
    if ! branch_unchanged "${_b}"; then
      _out="branch tip changed since eligibility check"
      print -r -u2 -- "  ${C_RED}FAILED${C_RESET} to unpark ${_b}: ${_out}"
      rec_line PARKED "${_b}" "${_why}" "${_sha}" "${_wt}" failed "${_out}"
      (( FAILED_BRANCHES++ )); return
    fi
    if [[ "${_wt}" == "${repo}" ]]; then
      if ! _out="$(git -C "${repo}" switch -q "${default_branch}" 2>&1)"; then
        print -r -u2 -- "  ${C_RED}FAILED${C_RESET} to switch ${repo} to ${default_branch}: ${_out}"
        rec_line PARKED "${_b}" "${_why}" "${_sha}" "${_wt}" failed "${_out}"
        (( FAILED_BRANCHES++ )); return
      fi
      say "  ${C_GREEN}switched${C_RESET} to ${default_branch} ${C_DIM}(was ${_b})${C_RESET}"
    else
      [[ -n "${_lock}" ]] && git -C "${repo}" worktree unlock "${_wt}" >/dev/null 2>&1
      if ! _out="$(git -C "${repo}" worktree remove "${_wt}" 2>&1)"; then
        [[ -n "${_lock}" ]] && git -C "${repo}" worktree lock --reason "${${_lock#locked}# }" "${_wt}" >/dev/null 2>&1
        print -r -u2 -- "  ${C_RED}FAILED${C_RESET} to remove worktree ${_wt}: ${_out}"
        rec_line PARKED "${_b}" "${_why}" "${_sha}" "${_wt}" failed "${_out}"
        (( FAILED_BRANCHES++ )); return
      fi
      say "  ${C_GREEN}removed worktree${C_RESET} ${_wt}"
    fi
    if ! branch_unchanged "${_b}"; then
      _out="branch tip changed since eligibility check"
    elif git -C "${repo}" branch -D "${_b}" >/dev/null 2>&1; then
      say "  ${C_GREEN}deleted${C_RESET} ${_b} ${C_DIM}(${_why}) — restore: git -C ${repo} branch ${_b} ${_sha}${C_RESET}"
      rec_line PARKED "${_b}" "${_why}" "${_sha}" "${_wt}" unparked ""
      (( GONE_PARKED++ ))
      return
    else
      _out="branch -D refused"
    fi
    print -r -u2 -- "  ${C_RED}FAILED${C_RESET} to delete ${_b}: ${_out}"
    rec_line PARKED "${_b}" "${_why}" "${_sha}" "${_wt}" failed "${_out}"
    (( FAILED_BRANCHES++ ))
  }

  local wt lock pid what blocker hint question
  local -i may_act=0
  for line in "${parked[@]}"; do
    (( QUIT_ALL )) && break
    (( FOUND_PARKED++ ))
    b="${line%%$'\t'*}"; reason="${line#*$'\t'}"
    wt="${held_path[${b}]}"; lock="${held_lock[${b}]-}"
    sha="$(git -C "${repo}" rev-parse --short "${checked_sha[${b}]}" 2>/dev/null)"
    blocker=""
    if [[ "${wt}" == "${repo}" ]]; then
      what="checked out here"
      [[ -n "$(git -C "${repo}" status --porcelain --untracked-files=no 2>/dev/null)" ]] && blocker="uncommitted changes"
    else
      what="worktree ${wt}"
      [[ -n "$(git -C "${wt}" status --porcelain 2>/dev/null)" ]] && blocker="uncommitted or untracked changes"
      # A lock names its holder's pid when a tool set it (Claude Code does); one that names none, or a live one, stands.
      if [[ -z "${blocker}" && -n "${lock}" ]]; then
        pid=""; [[ "${lock}" =~ 'pid ([0-9]+)' ]] && pid="${match[1]}"
        if [[ -z "${pid}" ]] || pid_alive "${pid}"; then
          blocker="${lock}"
        fi
      fi
    fi
    may_act=0
    [[ "${MODE}" == ask ]] && may_act=1
    [[ "${MODE}" == delete ]] && (( UNPARK )) && may_act=1
    if [[ -n "${blocker}" ]] || (( ! may_act )); then
      if [[ -n "${blocker}" ]]; then hint="${blocker}; left alone"
      elif [[ "${wt}" == "${repo}" ]]; then hint="switch to ${default_branch} first, or --unpark"
      else hint="remove the worktree first, or --unpark"
      fi
      say "  ${C_YELLOW}parked${C_RESET} ${b} ${C_DIM}(${reason}; ${what}) — ${hint}${C_RESET}"
      rec_line PARKED "${b}" "${reason}" "${sha}" "${wt}" "$([[ -n "${blocker}" ]] && print blocked || print reported)" "${blocker}"
      continue
    fi
    question="remove worktree ${wt} and delete ${b} (${reason})?"
    [[ "${wt}" == "${repo}" ]] && question="switch to ${default_branch} and delete ${b} (${reason})?"
    # Moving a checkout is asked one at a time: "a" agreed to deleting branches, not to this.
    if confirm "${question}" each; then
      unpark "${b}" "${reason}" "${sha}" "${wt}" "${lock}"
    else
      rec_line PARKED "${b}" "${reason}" "${sha}" "${wt}" kept ""
      (( QUIT_ALL )) || say "  ${C_DIM}kept${C_RESET} ${b} ${C_DIM}(${what})${C_RESET}"
    fi
  done

  return 0
}

# Sequential on purpose: this deletes, and interleaved output from parallel
# workers is unreadable exactly when someone needs to audit what went.
typeset -i rc=0 repo_rc=0
for gitdir in "${GITDIRS[@]}"; do
  (( QUIT_ALL )) && break
  clean_repo "${gitdir:h}"
  repo_rc=$?
  if (( repo_rc == 2 )); then
    rc=2
    (( SKIPPED++ ))
    (( REC_IDX++ ))
    REC="${WORKDIR}/rec.$(printf '%04d' ${REC_IDX})"
    rec_line SKIP "${gitdir:h}" "${LAST_SKIP}"
  fi
done

# A named branch that matched nothing is the caller's mistake, and answering it
# with a clean exit would let an agent believe it deleted something it did not.
typeset -a ONLY_MISSED=()
for only_branch in "${ONLY[@]}"; do
  (( ${ONLY_MATCHED[(Ie)${only_branch}]} )) || ONLY_MISSED+=("${only_branch}")
done
if (( ${#ONLY_MISSED[@]} > 0 )); then
  print -r -u2 -- "gitcleaner: --only named branches that are not candidates: ${(j:, :)ONLY_MISSED}"
  print -r -u2 -- "  a branch is a candidate only when every guard clears it; run --json to see the list"
  (( ${#ONLY_NEEDS_UNPARK[@]} > 0 )) && \
    print -r -u2 -- "  checked out (parked): ${(j:, :)ONLY_NEEDS_UNPARK} — add --unpark to move the checkout off first"
  rc=2
fi

# render_json — the whole run as one document. Built with jq so a branch name
# with a quote in it cannot produce something the caller has to repair.
render_json() {
  local rec
  local -i idx=0
  for rec in "${WORKDIR}"/rec.*(N); do
    (( idx++ ))
    jq -n \
      --arg path "$(cut -f2 <<< "$(grep -m1 $'^REPO\t' "${rec}" 2>/dev/null || grep -m1 $'^SKIP\t' "${rec}")")" \
      --arg default_branch "$(grep -m1 $'^REPO\t' "${rec}" 2>/dev/null | cut -f3)" \
      --arg skipped "$(grep -m1 $'^SKIP\t' "${rec}" 2>/dev/null | cut -f3)" \
      --argjson branches "$(grep $'^BRANCH\t' "${rec}" 2>/dev/null | cut -f2- | jq -R -s 'split("\n") | map(select(length > 0)) | map(split("\t")) | map({name: .[0], reason: .[1], sha: .[2], action: .[3]})')" \
      --argjson worktrees "$(grep $'^WT\t' "${rec}" 2>/dev/null | cut -f2- | jq -R -s 'split("\n") | map(select(length > 0)) | map(split("\t")) | map({entry: .[0], action: .[1]})')" \
      --argjson parked "$(grep $'^PARKED\t' "${rec}" 2>/dev/null | cut -f2- | jq -R -s 'split("\n") | map(select(length > 0)) | map(split("\t")) | map({name: .[0], reason: .[1], sha: .[2], checkout: .[3], action: .[4], blocker: (if (.[5] // "") == "" then null else .[5] end)})')" \
      '{path: $path,
        default_branch: (if $default_branch == "" then null else $default_branch end),
        skipped: (if $skipped == "" then null else $skipped end),
        branches: $branches, worktrees: $worktrees, parked: $parked}' \
      > "${WORKDIR}/json.$(printf '%04d' ${idx})"
  done

  # `< /dev/null`: with zero per-repo documents jq -s would read stdin instead,
  # which at an interactive terminal is a hang until EOF.
  jq -s \
    --arg mode "${MODE}" \
    --argjson scanned "${#GITDIRS[@]}" \
    --argjson found_b "${FOUND_BRANCHES}" --argjson found_w "${FOUND_WORKTREES}" \
    --argjson gone_b "${GONE_BRANCHES}" --argjson gone_w "${GONE_WORKTREES}" \
    --argjson found_p "${FOUND_PARKED}" --argjson gone_p "${GONE_PARKED}" \
    --argjson kept "${KEPT_BRANCHES}" --argjson failed "${FAILED_BRANCHES}" \
    --argjson skipped "${SKIPPED}" \
    --argjson only_missed "$(print -rn -- "${(F)ONLY_MISSED}" | jq -R -s 'split("\n") | map(select(length > 0))')" \
    '{ok: ($failed == 0 and $skipped == 0 and ($only_missed | length) == 0),
      aborted: null,
      mode: $mode, scanned: $scanned, repos: .,
      found: {branches: $found_b, worktrees: $found_w, parked: $found_p},
      removed: {branches: $gone_b, worktrees: $gone_w, parked: $gone_p},
      kept: $kept, failed: $failed, skipped: $skipped,
      only_not_found: $only_missed}' \
    "${WORKDIR}"/json.*(N) < /dev/null
}

if (( JSON )); then
  render_json
  (( rc == 2 || FAILED_BRANCHES > 0 )) && exit 2
  (( FOUND_BRANCHES + FOUND_WORKTREES + FOUND_PARKED == 0 )) && exit 0
  exit 1
fi

print -r -- ""
# Gated on what was found, not on what went: keeping every candidate is still a
# run that found work.
if (( FOUND_BRANCHES + FOUND_WORKTREES + FOUND_PARKED == 0 )); then
  # A skip leaves that repo unread, so "nothing to clean" cannot cover it.
  if (( rc == 2 )); then
    print -r -- "Nothing to clean in the repos that were readable; ${SKIPPED} skipped (see errors above)."
    exit 2
  fi
  print -r -- "Nothing to clean in ${#GITDIRS[@]} repos."
  exit 0
fi

if [[ "${MODE}" == report ]]; then
  print -r -- "${FOUND_BRANCHES} branches and ${FOUND_WORKTREES} worktree entries are stale in ${REPOS_TOUCHED} repos."
  (( FOUND_PARKED > 0 )) && print -r -- "${FOUND_PARKED} checkouts are parked on a landed branch."
  if (( DRY_RUN )); then
    print -r -- "Drop --dry-run to work through them one at a time."
  else
    print -r -- "No terminal to ask at — run this from a shell, or pass --yes (--unpark for parked checkouts)."
  fi
else
  print -r -- "Removed ${GONE_BRANCHES} of ${FOUND_BRANCHES} branches and ${GONE_WORKTREES} of ${FOUND_WORKTREES} worktree entries in ${REPOS_TOUCHED} repos."
  (( FOUND_PARKED > 0 )) && print -r -- "Unparked ${GONE_PARKED} of ${FOUND_PARKED} parked checkouts."
  (( KEPT_BRANCHES > 0 )) && print -r -- "${KEPT_BRANCHES} branches kept at your request."
  (( QUIT_ALL )) && print -r -- "Stopped at your request; the rest were left alone."
fi
(( SKIPPED > 0 )) && print -r -- "${SKIPPED} repos skipped (see errors above)."
# A refused delete leaves the tree other than the run reported, which is the
# failure direction nothing downstream can detect.
if (( FAILED_BRANCHES > 0 )); then
  print -r -- "${FAILED_BRANCHES} branches could not be deleted (see errors above)."
  rc=2
fi
(( rc == 2 )) && exit 2
exit 1
