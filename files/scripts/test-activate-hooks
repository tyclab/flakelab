#!/usr/bin/env zsh

set -uo pipefail

# Offline suite for activate-hooks (files/scripts/activate-hooks), the hook
# installer the clone sweep runs last: a throwaway repos dir with one repo per
# case, and a `pre-commit` stand-in on PATH that writes the shims the real one
# would and records what it was asked. No network, no real pre-commit.
#
# Usage: files/scripts/test-activate-hooks

SCRIPT_DIR="${0:A:h}"
CMD="${SCRIPT_DIR}/activate-hooks"
typeset -i PASS=0 FAIL=0

# Both end in `return 0`: `(( PASS++ ))` yields the pre-increment value, so an
# `&& ok || bad` chain would run both arms on the first call.
ok()       { print -r -- "  ok   $1"; (( PASS++ )); return 0 }
bad()      { print -r -u2 -- "  FAIL $1"; (( FAIL++ )); return 0 }
check()    { [[ "$2" == "$3" ]] && ok "$1" || { bad "$1"; print -r -u2 -- "       expected: $3"; print -r -u2 -- "       actual:   $2" } }
contains() { [[ "$2" == *"$3"* ]] && ok "$1" || { bad "$1"; print -r -u2 -- "       missing: $3"; print -r -u2 -- "       in: $2" } }
excludes() { [[ "$2" != *"$3"* ]] && ok "$1" || bad "$1 (unexpected: $3)" }

BASE="$(mktemp -d)"
trap 'rm -rf "${BASE}"' EXIT
export HOME="${BASE}/home"
REPOS="${BASE}/git"
STUBS="${BASE}/bin"
export CALLS="${BASE}/pre-commit.log"
mkdir -p "${HOME}" "${REPOS}" "${STUBS}"
git config --global init.defaultBranch main
git config --global user.name "test-activate-hooks"
git config --global user.email "hooks@example.invalid"

# The pre-commit stand-in: `install [-t TYPE]... [--overwrite]` writes one shim
# per type into .git/hooks of the cwd, marked the way the real ones are (the
# pre-commit.com line, an INSTALL_PYTHON line naming a live interpreter);
# FAKE_PC_FAIL makes every call fail.
export FAKE_PC_PYTHON="$(command -v zsh)"
cat > "${STUBS}/pre-commit" <<'STUB'
#!/usr/bin/env zsh
print -r -- "pre-commit $* in ${PWD:t}" >> "${CALLS}"
[[ -n "${FAKE_PC_FAIL:-}" ]] && exit 1
[[ "$1" == install ]] || exit 1
shift
typeset -a types=()
while (( $# > 0 )); do
  case $1 in
    -t) types+=("$2"); shift ;;
    --overwrite) ;;
    *) exit 1 ;;
  esac
  shift
done
(( ${#types} )) || types=(pre-commit)
for t in "${types[@]}"; do
  printf '#!/usr/bin/env bash\n# File generated by pre-commit: https://pre-commit.com\nINSTALL_PYTHON=%s\n' "${FAKE_PC_PYTHON}" > ".git/hooks/${t}"
  chmod +x ".git/hooks/${t}"
done
STUB
chmod +x "${STUBS}/pre-commit"

# A real shim pair as the stand-in writes it, with the interpreter given.
shims() { local repo="$1" py="$2" t
  for t in pre-commit pre-push; do
    printf '#!/usr/bin/env bash\n# File generated by pre-commit: https://pre-commit.com\nINSTALL_PYTHON=%s\n' "$py" > "${repo}/.git/hooks/${t}"
    chmod +x "${repo}/.git/hooks/${t}"
  done
}
mkrepo() { git init -q "${REPOS}/$1" && print -r -- "${REPOS}/$1" }

typeset -i RC=0
OUT=""
run() { rm -f "${CALLS}"; OUT="$(PATH="${STUBS}:${PATH}" "${CMD}" "$@" 2>&1)"; RC=$?; }
calls() { cat "${CALLS}" 2>/dev/null }

print -r -- "test-activate-hooks"

print -r -- "a repos dir that does not exist yet"
run --repos-dir "${BASE}/not-yet"
check "exits 0" "${RC}" "0"
contains "and says there is nothing to do" "${OUT}" "SUMMARY repos-dir ${BASE}/not-yet does not exist yet, nothing to do"

print -r -- ""
print -r -- "usage"
run
check "no --repos-dir is a usage error" "${RC}" "2"
run --repos-dir "${REPOS}" --bogus
check "an unknown argument is a usage error" "${RC}" "2"
run --help
check "--help exits 0" "${RC}" "0"
contains "with the usage" "${OUT}" "Usage: activate-hooks --repos-dir <path>"

print -r -- ""
print -r -- "one sweep over every shape of repo"
# Ships its own git hooks: core.hooksPath is pointed at them.
r="$(mkrepo hooked)"; mkdir -p "${r}/hooks"; print -r -- '#!/bin/sh' > "${r}/hooks/pre-commit"; chmod +x "${r}/hooks/pre-commit"
# A hooks/ directory of application code, not git hooks: left alone.
r="$(mkrepo appcode)"; mkdir -p "${r}/hooks"; print -r -- 'not a hook' > "${r}/hooks/README"
# A framework config and no shims yet.
r="$(mkrepo plain)"; : > "${r}/.pre-commit-config.yaml"
# A Makefile with an install-hooks target predating the pre-push type.
r="$(mkrepo maked)"; : > "${r}/.pre-commit-config.yaml"
printf 'install-hooks:\n\tpre-commit install -t pre-commit\n' > "${r}/Makefile"
# Shims whose recorded interpreter is gone (a collected store path).
r="$(mkrepo dead)"; : > "${r}/.pre-commit-config.yaml"; shims "${r}" /nix/store/gone-python3/bin/python3
# Shims that still work: nothing to do.
r="$(mkrepo fine)"; : > "${r}/.pre-commit-config.yaml"; shims "${r}" "${FAKE_PC_PYTHON}"
# A config kept for --all-files only, beside the repo's own live hooks.
r="$(mkrepo owned)"; : > "${r}/.pre-commit-config.yaml"; mkdir -p "${r}/hooks"
print -r -- '#!/bin/sh' > "${r}/hooks/pre-commit"; chmod +x "${r}/hooks/pre-commit"
git -C "${r}" config --local core.hooksPath hooks
# A hooksPath pointing nowhere, which would block the shim install.
r="$(mkrepo dangling)"; : > "${r}/.pre-commit-config.yaml"; git -C "${r}" config --local core.hooksPath gone-hooks
# A config outside any repository.
mkdir -p "${REPOS}/notgit"; : > "${REPOS}/notgit/.pre-commit-config.yaml"

run --repos-dir "${REPOS}"
check "exits 0" "${RC}" "0"
contains "a repo shipping git hooks gets core.hooksPath"      "${OUT}" "HOOKSPATH_SET ${REPOS}/hooked"
check    "pointed at hooks/"                                  "$(git -C "${REPOS}/hooked" config --local --get core.hooksPath)" "hooks"
excludes "a hooks/ of application code is not claimed"        "${OUT}" "${REPOS}/appcode"
check    "and its hooksPath stays unset"                      "$(git -C "${REPOS}/appcode" config --local --get core.hooksPath; print -n -- "<unset>")" "<unset>"
contains "a plain config gets both shim types"                "${OUT}" "SHIM_INSTALLED ${REPOS}/plain"
contains "in one install"                                     "$(calls)" "pre-commit install -t pre-commit -t pre-push in plain"
[[ -x "${REPOS}/plain/.git/hooks/pre-commit" && -x "${REPOS}/plain/.git/hooks/pre-push" ]] && ok "and both shims are there" || bad "a shim is missing in plain"
contains "a Makefile's install-hooks target is used"          "$(calls)" "pre-commit install -t pre-commit in maked"
contains "and the pre-push hook it left out is added"         "$(calls)" "pre-commit install -t pre-push in maked"
contains "counted as installed"                               "${OUT}" "SHIM_INSTALLED ${REPOS}/maked"
contains "a dead interpreter is repointed"                    "${OUT}" "SHIM_REPOINTED ${REPOS}/dead"
contains "by an overwriting install of both types"            "$(calls)" "pre-commit install --overwrite -t pre-commit -t pre-push in dead"
check    "and the shim now names the live one"                "$(sed -n 's/^INSTALL_PYTHON=//p' "${REPOS}/dead/.git/hooks/pre-commit")" "${FAKE_PC_PYTHON}"
excludes "working shims are left alone"                       "$(calls)" "in fine"
excludes "a repo whose own hooksPath is live is left alone"   "$(calls)" "in owned"
check    "and keeps its hooksPath"                            "$(git -C "${REPOS}/owned" config --local --get core.hooksPath)" "hooks"
contains "a dangling hooksPath is dropped and the shims go in" "${OUT}" "SHIM_INSTALLED ${REPOS}/dangling"
check    "the dangling hooksPath is gone"                     "$(git -C "${REPOS}/dangling" config --local --get core.hooksPath; print -n -- "<unset>")" "<unset>"
excludes "a config outside a repository is not touched"       "$(calls)" "in notgit"
contains "the summary counts every class"                     "${OUT}" "SUMMARY hooks/=2 set=1 precommit-config=7 installed=4 skipped(hooksPath)=1 skipped(already_ok)=2 failed=0 pc_missing=0"

print -r -- ""
print -r -- "a second sweep changes nothing"
run --repos-dir "${REPOS}"
check "exits 0" "${RC}" "0"
check "pre-commit is not called" "$(calls)" ""
excludes "nothing is installed" "${OUT}" "SHIM_INSTALLED"
excludes "nothing is repointed" "${OUT}" "SHIM_REPOINTED"
excludes "no hooksPath is set again" "${OUT}" "HOOKSPATH_SET"

print -r -- ""
print -r -- "a failed install is the run's failure"
r="$(mkrepo broken)"; : > "${r}/.pre-commit-config.yaml"
FAKE_PC_FAIL=1 run --repos-dir "${REPOS}"
check "exits 1" "${RC}" "1"
contains "names the repo" "${OUT}" "SHIM_FAILED ${REPOS}/broken (rc=1)"
contains "and says how many" "${OUT}" "ERROR: pre-commit hook install failed for 1 repo(s)"
unset FAKE_PC_FAIL
run --repos-dir "${REPOS}"
check "with the stand-in working again it installs" "${RC}" "0"
contains "the shims" "${OUT}" "SHIM_INSTALLED ${REPOS}/broken"

print -r -- ""
print -r -- "no pre-commit anywhere is a failure, not a quiet skip"
r="$(mkrepo orphan)"; : > "${r}/.pre-commit-config.yaml"
# The script also looks in a few fixed places; a box with a system pre-commit
# there would find it, so the case only runs where none exists.
if [[ -x /usr/bin/pre-commit || -x /usr/local/bin/pre-commit || -x /home/linuxbrew/.linuxbrew/bin/pre-commit || -x "${HOME}/.local/bin/pre-commit" ]]; then
  ok "a system pre-commit is installed on this box, so the missing-binary case cannot be staged here"
else
  # Every tool on PATH but pre-commit, linked into one directory: a profile's bin
  # holds git and pre-commit side by side, so no directory of PATH can be kept.
  TOOLS="${BASE}/tools"
  mkdir -p "${TOOLS}"
  for f in ${^path}/*(N-*); do
    [[ "${f:t}" == pre-commit ]] && continue
    [[ -e "${TOOLS}/${f:t}" ]] || ln -s "${f}" "${TOOLS}/${f:t}"
  done
  OUT="$(PATH="${TOOLS}" "${CMD}" --repos-dir "${REPOS}" 2>&1)"; RC=$?
  check "exits 1" "${RC}" "1"
  contains "names the repo left unhooked" "${OUT}" "PRECOMMIT_NOT_FOUND skipping ${REPOS}/orphan"
  contains "and the count" "${OUT}" "ERROR: pre-commit binary not found; 1 repo(s) left without hooks"
fi

print -r -- ""
print -r -- "${PASS} passed, ${FAIL} failed"
(( FAIL == 0 ))
