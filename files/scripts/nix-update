#!/usr/bin/env zsh
# Update THIS distro to the current flake + overlay: a pre-flight over the
# configured repo checkout, then `sudo nixos-rebuild switch`.
# No `set -e`: the pre-flight is `|| return` control flow and `read -k` prompts,
# which errexit would turn into silent aborts.
set -uo pipefail

_self="${0:t}"

# print -P prompt-expands the whole string, so a `%` in a path, a branch or a
# URL-encoded hash reads as an escape (`%3D` prints a date), and print without -r
# turns `\t` in a Windows path into a tab. Only the colour is markup here.
_say() { print -rP -- "%F{$1}${2//\%/%%}%f" }

# Set by the nix wrapper; the fallback lets this run straight from a checkout.
if [[ -n "${FLAKELAB_REPO_ROOT:-}" ]]; then
  _repo="${FLAKELAB_REPO_ROOT}"
elif [[ -f "${0:A:h:h:h}/flake.nix" ]]; then
  _repo="${0:A:h:h:h}"
else
  print -ru2 -- "${_self}: FLAKELAB_REPO_ROOT unset and no flake checkout found."
  exit 1
fi

# The same lib the sweep scripts source, so the retry behaviour cannot drift.
source "${0:A:h}/lib/git-net.zsh" || exit 1

# _url_path <filesystem path> -> the body of a `path:` flake URL. Unescaped, a
# space makes nix read the whole string as a relative path and `#`/`?` truncate it;
# `%` goes first or the later escapes are escaped again.
_url_path() {
  local s="$1"
  s="${s//\%/%25}"
  s="${s// /%20}"
  s="${s//\#/%23}"
  s="${s//\?/%3F}"
  print -r -- "$s"
}

_run_clone=0
while (( $# )); do
  case "$1" in
    --all) _run_clone=1 ;;
    -h|--help)
      print -r -- "${_self} [--all]"
      print -r -- ""
      print -r -- "  Rebuild this distro from ${_repo} after a pre-flight: fetch --all --prune,"
      print -r -- "  pull --rebase a clean checkout that is behind its remote, and refuse one"
      print -r -- "  that is dirty or conflicts (skipped, and said so, when it is not a"
      print -r -- "  checkout or has no remote). A branch behind the default branch is"
      print -r -- "  warned about and, at a terminal, offered a rebase."
      print -r -- ""
      print -r -- "  --all   also run nix-clone-repos after an applied switch"
      print -r -- ""
      print -r -- "  FLAKELAB_STALE_OK=1  rebuild the checkout as it is: behind, dirty, or unverified"
      exit 0
      ;;
    *)
      print -ru2 -- "${_self}: unknown argument: $1 (try --help)"
      exit 2
      ;;
  esac
  shift
done

# A clean checkout behind its own upstream has nothing to lose, so it is pulled
# without asking, terminal or not. Uncommitted changes refuse rather than
# autostash: a stash the operator did not ask for is one they will not look for.
# A conflict is aborted so nothing half-applied waits for the next run.
# FLAKELAB_STALE_OK=1 is the one override: rebuild the tree as it is.
_nix_pull() {
  local _dir="${_repo}" _out
  if [[ "${FLAKELAB_STALE_OK:-}" == 1 ]]; then
    _say yellow "  FLAKELAB_STALE_OK=1 — rebuilding the stale tree as it is"
    return 0
  fi
  if [[ -n "$(git -C "$_dir" status --porcelain 2>/dev/null)" ]]; then
    _say red "✗ uncommitted changes in ${_dir} — commit or stash first, or set FLAKELAB_STALE_OK=1 to rebuild the stale tree"
    return 1
  fi
  if _out="$(git -C "$_dir" pull --rebase 2>&1)"; then
    _say green "✓ pulled --rebase: now at $(git -C "$_dir" rev-parse --short HEAD)"
    return 0
  fi
  git -C "$_dir" rebase --abort 2>/dev/null || true
  _say red "✗ pull --rebase failed — tree restored; resolve it by hand, or set FLAKELAB_STALE_OK=1 to rebuild the stale tree"
  print -r -- "$_out"
  return 1
}

# --all --prune: every remote, and refs that are gone upstream go here too, so a
# merged branch does not linger as a stale origin/ ref. No ControlMaster: one
# fetch, so there is no second connection to reuse. An explicit GIT_SSH_COMMAND
# from the environment wins.
_nix_fetch() {
  local _dir="$1"
  local -x GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh ${GITNET_SSH_BASE}}"
  local -a GITNET_TIMEOUT_CMD=(timeout 20)
  gitnet_retry git -C "$_dir" fetch -q --all --prune && return 0
  _say yellow "⚠ Could not fetch ${_dir} — fetch failed after retry (${GITNET_WHY})"
  [[ -n "$GITNET_OUT" ]] && print -r -- "$GITNET_OUT"
  return 1
}

# Warn when the clone has drifted from origin, and return non-zero when a requested
# pull failed so the caller aborts instead of rebuilding the code it replaced.
_nix_check_remote() {
  local _dir="${_repo}"
  if [[ -n "$(git -C "$_dir" status --porcelain 2>/dev/null)" ]]; then
    _say yellow "⚠ ${_repo} has uncommitted changes"
  fi
  if ! _nix_fetch "$_dir"; then
    # An unverified tree is not a current one: fail closed.
    if [[ ! -t 0 ]]; then
      [[ "${FLAKELAB_STALE_OK:-}" == 1 ]] && return 0
      return 1
    fi
    local _reply=""
    read -k 1 "_reply?Rebuild anyway from the unverified tree? [y/N] "
    echo
    [[ "$_reply" == [yY] ]] || return 1
  fi
  local _local=$(git -C "$_dir" rev-parse HEAD)
  local _remote=$(git -C "$_dir" rev-parse @{u} 2>/dev/null) || return 0
  [[ "$_local" == "$_remote" ]] && return 0
  local _behind=$(git -C "$_dir" rev-list --count HEAD..@{u} 2>/dev/null)
  local _ahead=$(git -C "$_dir" rev-list --count @{u}..HEAD 2>/dev/null)
  if [[ "$_behind" -gt 0 && "$_ahead" -gt 0 ]]; then
    _say yellow "⚠ repo has diverged (${_ahead} ahead, ${_behind} behind)"
    _nix_pull || return 1
  elif [[ "$_behind" -gt 0 ]]; then
    _say yellow "⚠ repo is ${_behind} commit(s) behind remote"
    _nix_pull || return 1
  elif [[ "$_ahead" -gt 0 ]]; then
    _say cyan "ℹ repo is ${_ahead} commit(s) ahead of remote (unpushed)"
  fi
}

# HEAD against the default branch: a feature branch in sync with its own upstream
# still misses what landed on the default branch, and rebuilding from it reverts
# that work here. Declaration and assignment stay separate, because `local x=$(cmd)`
# takes `local`'s status and `|| return` would never fire.
_nix_check_base() {
  local _dir="${_repo}" _default _head _behind _reply="" _out
  _default="$(git -C "$_dir" symbolic-ref --short -q refs/remotes/origin/HEAD 2>/dev/null)"
  _default="${_default#origin/}"
  if [[ -z "$_default" ]]; then
    _say yellow "⚠ flakelab has no origin/HEAD — run 'git remote set-head origin -a'; skipping the default-branch check"
    return 0
  fi
  _head="$(git -C "$_dir" symbolic-ref --short -q HEAD 2>/dev/null)" || {
    _say yellow "⚠ flakelab is on a detached HEAD — not compared against origin/${_default}"
    return 0
  }
  [[ "$_head" == "$_default" ]] && return 0
  # A stale origin/HEAD fails here rather than calling a behind branch current.
  if ! _behind="$(git -C "$_dir" rev-list --count "HEAD..origin/${_default}" 2>/dev/null)"; then
    _say yellow "⚠ flakelab cannot be compared against origin/${_default} — run 'git remote set-head origin -a'"
    return 0
  fi
  (( _behind > 0 )) || return 0

  _say yellow "⚠ flakelab is on ${_head}, ${_behind} commit(s) behind origin/${_default}"

  if [[ -n "$(git -C "$_dir" status --porcelain 2>/dev/null)" ]]; then
    _say yellow "  uncommitted changes — not offering a rebase; commit or stash first"
    return 0
  fi
  if [[ ! -t 0 ]]; then
    _say yellow "  no terminal to ask — rebuilding from it anyway; rebase with: git -C ${_dir} rebase origin/${_default}"
    return 0
  fi

  read -k 1 "_reply?Rebase onto origin/${_default} now? [y/N] "
  echo
  [[ "$_reply" == [yY] ]] || return 0
  if _out="$(git -C "$_dir" rebase "origin/${_default}" 2>&1)"; then
    _say green "✓ rebased ${_head} onto origin/${_default}"
    return 0
  fi
  # Leave nothing half-applied for the next run to trip over.
  git -C "$_dir" rebase --abort 2>/dev/null || true
  _say red "✗ rebase onto origin/${_default} conflicted — tree restored, refusing to rebuild from a branch behind ${_default}"
  print -r -- "$_out"
  return 1
}

# A switch overlapping the distro's own boot activation tears down the caller's
# session mid-run, so wait for the boot to settle: bounded, and never on
# `degraded`, which is a finished boot. systemctl must resolve from the caller's
# PATH, so it talks to the running systemd.
_nix_wait_boot() {
  [[ -n "${FLAKELAB_BOOT_OK:-}" ]] && return 0
  command -v systemctl > /dev/null 2>&1 || return 0
  local _unit="home-manager-${USER:-$(id -un)}.service" _limit="${FLAKELAB_BOOT_WAIT:-180}"
  local _state _hm _said=0 _deadline=$(( SECONDS + _limit ))
  while true; do
    _state="$(systemctl is-system-running 2> /dev/null)"
    _hm="$(systemctl is-active "${_unit}" 2> /dev/null)"
    if [[ "${_state}" != (initializing|starting) && "${_hm}" != (activating|reloading) ]]; then
      (( _said )) && _say green "✓ boot activation finished"
      return 0
    fi
    if (( SECONDS >= _deadline )); then
      _say red "✗ still booting after ${_limit}s (system: ${_state:-?}, ${_unit}: ${_hm:-?}) — refusing to switch into a running boot activation"
      _say red "  inspect: systemctl status ${_unit}; retry once it settles, or set FLAKELAB_BOOT_OK=1 to switch anyway"
      return 1
    fi
    if (( ! _said )); then
      _say yellow "⚠ the distro is still booting (system: ${_state:-?}, ${_unit}: ${_hm:-?}) — waiting up to ${_limit}s; a switch now would stop that activation and tear down this login session"
      _said=1
    fi
    sleep 2
  done
}
_nix_wait_boot || exit 1

# A plain directory becomes the repository the generators leave: one commit, no
# remote, the same shape `provision` and `flakelab overlay-gen` write today. It
# is what `provision` wrote before that, and what a hand-made overlay still is.
# Nothing is lost by it - .git is added, no file is touched - so it happens
# without asking, terminal or not, like the pull of a clean checkout. Two things
# stop it: no .gitignore, because the overlay holds key material, secrets.env and
# the backup payload and only the template .gitignore keeps them out of the
# commit; and a .gitignore that still lets one of those through, in which case
# the repository just made is removed again rather than left holding a secret.
_nix_adopt_overlay() {
  local _d="${_repo}" _leak
  if ! command -v git > /dev/null 2>&1; then
    _say cyan "ℹ ${_d} is not a git checkout — no drift check (git init it to get one)"
    return 1
  fi
  if [[ ! -f "${_d}/.gitignore" ]]; then
    _say yellow "⚠ ${_d} is not a git checkout and has no .gitignore — left as it is: the overlay holds key material and secrets that only the template .gitignore keeps out of a commit"
    _say yellow "  copy templates/overlay/.gitignore from the flakelab checkout into it, then: flakelab update"
    return 1
  fi
  if ! git -C "${_d}" init -q --initial-branch=main 2> /dev/null; then
    _say yellow "⚠ git init failed in ${_d} — no drift check"
    return 1
  fi
  git -C "${_d}" config core.autocrlf false
  git -C "${_d}" add -A
  _leak="$(git -C "${_d}" ls-files \
    | grep -E '(^|/)(id_ed25519|id_rsa|secrets\.env|credentials)$|\.pem$|^files/config/(instances|shared|snapshots)/' \
    | grep -v -F 'files/config/shared/ssh/keys/.gitkeep')"
  if [[ -n "${_leak}" ]]; then
    rm -rf "${_d}/.git"
    _say red "✗ ${_d} not initialised: its .gitignore would let secret-shaped files into the first commit — repository removed again"
    print -r -- "${_leak}" | sed 's/^/    /'
    _say red "  bring .gitignore up to templates/overlay/.gitignore in the flakelab checkout, then: flakelab update"
    return 1
  fi
  if ! git -C "${_d}" -c user.name=flakelab -c user.email=flakelab@localhost \
      commit -q -m "overlay adopted by flakelab update"; then
    _say yellow "⚠ git commit failed in ${_d} — the repository is initialised, nothing is committed"
    return 1
  fi
  _say green "✓ ${_d} initialised as a repository (one commit, no remote) — hand-edits are diffs from here on"
  return 0
}

# The overlay comes in three shapes, and the drift check applies to one of
# them. A plain directory is adopted above; a repository with no remote is what
# the generator leaves; the proxmox-vm bootstrap clones from one with a remote.
# Nothing can be behind a remote that does not exist, so the first two get one
# line and the switch - not a fetch. Uncommitted changes are still worth a
# warning in a local repository: that is drift against its own history.
_nix_repo_shape() {
  if ! git -C "${_repo}" rev-parse --git-dir > /dev/null 2>&1; then
    _nix_adopt_overlay || return 1
  fi
  [[ -n "$(git -C "${_repo}" remote 2>/dev/null)" ]] && return 0
  if [[ -n "$(git -C "${_repo}" status --porcelain 2>/dev/null)" ]]; then
    _say yellow "⚠ ${_repo} has uncommitted changes"
  fi
  _say cyan "ℹ ${_repo} has no git remote — no drift check (add one to get it)"
  return 1
}

# Order matters: an accepted pull moves HEAD, which the next check measures.
if _nix_repo_shape; then
  _nix_check_remote || exit 1
  _nix_check_base || exit 1
fi

# A `path:` flakelab input is mutable but its lock entry is not, so without
# re-locking a `git pull` over there leaves this flake on the previous snapshot and
# the switch silently builds the old flakelab. `git+file:` is not re-lockable this
# way and is left alone. `nix eval` rather than jq: the wrapper's PATH has no jq.
_nix_relock_flakelab() {
  local _lock="${_repo}/flake.lock" _ty _out
  [[ -f "${_lock}" ]] || return 0
  _ty="$(FLAKELAB_LOCK="${_lock}" nix eval --raw --impure --expr '
    let
      l = builtins.fromJSON (builtins.readFile (builtins.getEnv "FLAKELAB_LOCK"));
      n = l.nodes.${l.root}.inputs.flakelab or null;
    in if n == null then "" else "${l.nodes.${n}.locked.type or ""} ${l.nodes.${n}.locked.path or ""}"
  ' 2>/dev/null)"
  local _where="${_ty#* }"; _ty="${_ty%% *}"
  # git+file: serves committed content only, so the edit under test may be absent.
  if [[ "${_ty}" == git+file ]]; then
    _say yellow "⚠ LOCAL flakelab (git+file: ${_where}) — only committed content is in this build"
    return 0
  fi
  [[ -n "${_ty}" ]] || return 0
  # Unprivileged: a root-written lock on the 9p mount breaks the operator's next
  # `nix` command with "opening file flake.lock: Permission denied".
  if _out="$(nix flake update flakelab --flake "path:$(_url_path "${_repo}")" 2>&1)"; then
    if [[ "${_ty}" == path ]]; then
      _say yellow "⚠ LOCAL flakelab: ${_where} — overrides the published repo (re-locked)"
    else
      _say cyan "ℹ flakelab input updated"
    fi
  else
    # A path: input the caller cannot re-lock for want of a writable lock would
    # switch into the stale snapshot, so that one refuses; any other failure warns.
    if [[ "${_ty}" == path && ! -w "${_lock}" ]]; then
      _say red "✗ could not re-lock the path: flakelab input — ${_lock} is not writable by ${USER:-$(id -un)}; refusing to switch into the previously locked snapshot"
      print -r -- "${_out}"
      print -r -- "  fix: sudo chown $(id -u):$(id -g) ${(qq)_lock}"
      return 1
    fi
    _say yellow "⚠ could not re-lock the path: flakelab input — the switch may evaluate the previously locked snapshot"
    print -r -- "${_out}"
  fi
}

# nix rewrites the overlay's lock whenever an input moves, so one the caller cannot
# write fails the re-lock above and the switch evaluates the stale snapshot:
# silently while that is still in the store, as "NAR hash mismatch" once it is
# collected. Root leaves one behind whenever its switch had to lock - an overlay
# with no lock yet, which is every overlay right after setup-wsl-nix.ps1, or a
# re-lock that failed. The directory is the caller's, so a copy renamed over the
# lock takes it back without sudo and keeps every pin. `cat`, not `cp`, which
# would carry the read-only mode across; braced so a failed redirection is quiet.
# A symlinked lock is the operator's arrangement, and the rename would replace the
# link, so it is left alone. Warns only: the re-lock decides whether it matters.
_nix_reclaim_lock() {
  local _lock="${_repo}/flake.lock" _tmp="${_repo}/.flake.lock.reclaim.$$"
  [[ -e "${_lock}" && ! -L "${_lock}" && ! -w "${_lock}" ]] || return 0
  if { cat -- "${_lock}" > "${_tmp}" && mv -f -- "${_tmp}" "${_lock}" } 2> /dev/null; then
    _say cyan "ℹ ${_lock} was not writable by ${USER:-$(id -un)} — took it back, pins unchanged"
    return 0
  fi
  rm -f -- "${_tmp}" 2> /dev/null
  _say yellow "⚠ ${_lock} is not writable by ${USER:-$(id -un)} and could not be taken back"
  print -r -- "  fix: sudo chown $(id -u):$(id -g) ${(qq)_lock}"
  return 1
}
_nix_reclaim_lock
_nix_relock_flakelab || exit 1

# `nixos-rebuild switch` restarts home-manager-<user>.service only when the
# generation changed, so a switch that builds the same closure never re-runs the
# activation — and every step it deferred for want of an ssh key stays deferred
# behind a green run. That is the fresh-provision shape exactly: the key arrives
# between the two switches, and the second one builds what the first did. The
# unit's own start timestamp is what tells a restart from a no-op apart.
_hm_unit="home-manager-${USER:-$(id -un)}.service"
_hm_stamp() {
  command -v systemctl > /dev/null 2>&1 || return 0
  systemctl show -p ActiveEnterTimestampMonotonic --value "${_hm_unit}" 2> /dev/null
}
_hm_before="$(_hm_stamp)"

# `path:`, not a bare path: a bare path resolves as `git+file:`, which sees only
# tracked files, so it finds no lock, rewrites one as root, and the operator's next
# unprivileged `nix` command in that checkout dies on a permission error.
# sudo and nixos-rebuild resolve from the caller's PATH, so the rebuild uses the
# running system's nixos-rebuild. Only the path is encoded: the `#` after it is the
# flake URL's fragment.
# The lock is taken back after it too, failed or not: nix locks before it evaluates,
# so even a failed switch can leave a root-written lock, which breaks the operator's
# own `nix` commands in the overlay until the next run.
_switch_rc=0
sudo nixos-rebuild switch --flake "path:$(_url_path "${_repo}")#${FLAKELAB_FLAKE_ATTR:-default}" || _switch_rc=$?
_nix_reclaim_lock

# The switch's status is not its result - a 4 can stand over a failed activation -
# so flakelab-switch-result reads what the system recorded (its header has the
# contract). Applied and degraded carry on, degraded to an exit 4 at the end; every
# other verdict stops here with its own code. Without the classifier (a checkout run
# outside the wrapper's PATH) only a clean status carries on.
_result_rc=0
if command -v flakelab-switch-result > /dev/null 2>&1; then
  _result="$(flakelab-switch-result --rc "${_switch_rc}")" || _result_rc=$?
else
  _result=""
  if (( _switch_rc != 0 )); then
    _say red "✗ the switch exited ${_switch_rc}, and without flakelab-switch-result on PATH that cannot be told apart from a failed activation"
    exit "${_switch_rc}"
  fi
fi
case "${_result_rc}" in
  0) ;;
  4)
    _failed=""
    for _line in "${(@f)_result}"; do
      [[ "${_line}" == failed=* ]] && _failed="${_line#failed=}"
    done
    _say yellow "⚠ the switch activated its generation, but units are not running: ${_failed:-none named still failed, see the switch output above} — carrying on, then exiting 4. Inspect: systemctl status <unit>"
    ;;
  *) exit "${_result_rc}" ;;
esac

# Same closure as the running generation: the switch left the activation alone,
# so run it here instead. Failures warn only — the switch itself is applied.
if [[ -n "${_hm_before}" && "$(_hm_stamp)" == "${_hm_before}" ]]; then
  _say cyan "ℹ generation unchanged, so the switch left ${_hm_unit} alone — restarting it to retry the deferred steps"
  sudo systemctl restart "${_hm_unit}" \
    || _say yellow "⚠ ${_hm_unit} did not restart cleanly — inspect: systemctl status ${_hm_unit}"
fi

# What activation could not do is never fatal and never printed by the switch, so
# without this it surfaces only in `flakelab doctor`. Read with zsh's own split:
# this runs before any PATH beyond the wrapper's is assumed.
_deferred="$HOME/.local/state/flakelab/activation-deferred"
if [[ -s "${_deferred}" ]]; then
  _deferred_lines=("${(@f)$(< "${_deferred}")}")
  _say yellow "⚠ activation deferred ${#_deferred_lines} step(s), also listed by flakelab doctor:"
  print -l -- "${_deferred_lines[@]/#/    }"
fi

# The activation that does this only re-runs when the built config changed, while
# the marketplace clone is runtime data, so replay it after every switch. Failures
# warn only: the switch itself is applied.
_claude_marketplaces="$HOME/.claude/plugins/marketplaces"
if command -v claude > /dev/null 2>&1 && [ -d "${_claude_marketplaces}" ]; then
  for _m in "${_claude_marketplaces}"/*(N/); do
    claude plugin marketplace update "${_m:t}" > /dev/null 2>&1 \
      || _say yellow "⚠ claude marketplace ${_m:t} not refreshed (offline, or no agent key) — the permissions merge below uses its last fetch"
  done
  # `plugin install` is a no-op on an installed plugin, so a merged bump would stay
  # on its installed version; only plugins whose fetched version differs are updated,
  # which is readable only for marketplace-tree sources. </dev/null bounds the
  # confirmation prompt an install command would raise, so it warns instead of hanging.
  _installed="$HOME/.claude/plugins/installed_plugins.json"
  if [ -f "${_installed}" ] && command -v jq > /dev/null 2>&1; then
    for _m in "${_claude_marketplaces}"/*(N/); do
      [ -f "${_m}/.claude-plugin/marketplace.json" ] || continue
      jq -r '.plugins[] | select(.source | type == "string" and startswith("./")) | "\(.name) \(.source)"' \
        "${_m}/.claude-plugin/marketplace.json" 2> /dev/null | while read -r _name _src; do
        _key="${_name}@${_m:t}"
        _have="$(jq -r --arg k "${_key}" '.plugins[$k][0].version // empty' "${_installed}" 2> /dev/null)"
        _want="$(jq -r '.version // empty' "${_m}/${_src}/.claude-plugin/plugin.json" 2> /dev/null)"
        { [ -n "${_have}" ] && [ -n "${_want}" ] && [ "${_have}" != "${_want}" ]; } || continue
        claude plugin update "${_key}" < /dev/null > /dev/null 2>&1 \
          || _say yellow "⚠ claude plugin ${_key} not updated; it stays on ${_have} (marketplace has ${_want})"
      done
    done
  fi
  _settings="$HOME/.claude/settings.json"
  _recommended="$(find "${_claude_marketplaces}" -type f -name recommended-permissions.json 2> /dev/null | head -1)"
  if [ -n "${_recommended}" ] && [ -f "${_settings}" ] && command -v jq > /dev/null 2>&1; then
    _tmp="$(mktemp)"
    # Asserted, not unioned: a union only grows, and a withdrawn rule would stay.
    if jq -s '.[0] * {permissions: {allow: .[1]}}' \
         "${_settings}" "${_recommended}" > "${_tmp}" 2> /dev/null && [ -s "${_tmp}" ]; then
      mv "${_tmp}" "${_settings}"
    else
      _say yellow "⚠ Claude pre-approved permissions not asserted in settings.json"
    fi
    rm -f "${_tmp}"
  fi
  # A marketplace without the file leaves permissions.ask alone.
  _recommendedask="$(find "${_claude_marketplaces}" -type f -name recommended-ask.json 2> /dev/null | head -1)"
  if [ -n "${_recommendedask}" ] && [ -f "${_settings}" ] && command -v jq > /dev/null 2>&1; then
    _tmp="$(mktemp)"
    if jq -s '.[0] * {permissions: {ask: .[1]}}' \
         "${_settings}" "${_recommendedask}" > "${_tmp}" 2> /dev/null && [ -s "${_tmp}" ]; then
      mv "${_tmp}" "${_settings}"
    else
      _say yellow "⚠ Claude recommended ask tier not asserted in settings.json"
    fi
    rm -f "${_tmp}"
  fi
fi

(( _run_clone )) || exit "${_result_rc}"

if ! command -v nix-clone-repos > /dev/null 2>&1; then
  _say red "✗ --all: nix-clone-repos is not on PATH — the switch is applied, the clone sweep did not run"
  exit 1
fi
nix-clone-repos || exit $?
exit "${_result_rc}"
