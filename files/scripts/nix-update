#!/usr/bin/env zsh
# Update THIS distro to the current flake + overlay: a pre-flight over the
# configured repo checkout, then `sudo nixos-rebuild switch`.
# No `set -e`: the pre-flight is `|| return` control flow and `read -k` prompts,
# which errexit would turn into silent aborts.
set -uo pipefail

_self="${0:t}"

# Set by the nix wrapper; the fallback lets this run straight from a checkout.
if [[ -n "${FLAKELAB_REPO_ROOT:-}" ]]; then
  _repo="${FLAKELAB_REPO_ROOT}"
elif [[ -f "${0:A:h:h:h}/flake.nix" ]]; then
  _repo="${0:A:h:h:h}"
else
  print -u2 "${_self}: FLAKELAB_REPO_ROOT unset and no flake checkout found."
  exit 1
fi

# The same lib the sweep scripts source, so the retry behaviour cannot drift.
source "${0:A:h}/lib/git-net.zsh" || exit 1

# _url_path <filesystem path> -> the body of a `path:` flake URL. Unescaped, a
# space makes nix read the whole string as a relative path and `#`/`?` truncate it;
# `%` goes first or the later escapes are escaped again.
_url_path() {
  local s="$1"
  s="${s//\%/%25}"
  s="${s// /%20}"
  s="${s//\#/%23}"
  s="${s//\?/%3F}"
  print -r -- "$s"
}

_run_clone=0
while (( $# )); do
  case "$1" in
    --all) _run_clone=1 ;;
    -h|--help)
      print -r -- "${_self} [--all]"
      print -r -- ""
      print -r -- "  Rebuild this distro from ${_repo} after a pre-flight that checks the"
      print -r -- "  checkout against its remote and against the default branch (skipped,"
      print -r -- "  and said so, when it is not a checkout or has no remote)."
      print -r -- ""
      print -r -- "  --all   also run nix-clone-repos after a successful switch"
      print -r -- ""
      print -r -- "  FLAKELAB_STALE_OK=1  waive the stale/unverified-tree refusal (automation)"
      exit 0
      ;;
    *)
      print -u2 "${_self}: unknown argument: $1 (try --help)"
      exit 2
      ;;
  esac
  shift
done

# `read -k 1`, not `read -q`: the answer must be testable, or a non-"y" read
# silently skips the pull and the rebuild runs the stale tree. With no terminal a
# stale tree refuses; FLAKELAB_STALE_OK=1 is the waiver for automation.
_nix_offer_pull() {
  local _dir="${_repo}" _reply=""
  if [[ ! -t 0 ]]; then
    [[ "${FLAKELAB_STALE_OK:-}" == 1 ]] && return 0
    print -P "%F{red}✗ stale flakelab tree and no terminal to ask — git -C ${_repo} pull --rebase, or set FLAKELAB_STALE_OK=1 to rebuild anyway%f"
    return 1
  fi
  read -k 1 "_reply?Pull --rebase now? [y/N] "
  echo
  [[ "$_reply" == [yY] ]] || return 0
  if ! git -C "$_dir" pull --rebase; then
    print -P "%F{red}✗ flakelab pull failed — refusing to rebuild from a stale tree%f"
    return 1
  fi
}

# No ControlMaster: one fetch, so there is no second connection to reuse. An
# explicit GIT_SSH_COMMAND from the environment wins.
_nix_fetch() {
  local _dir="$1"
  local -x GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh ${GITNET_SSH_BASE}}"
  local -a GITNET_TIMEOUT_CMD=(timeout 20)
  gitnet_retry git -C "$_dir" fetch -q && return 0
  print -P "%F{yellow}⚠ Could not check for flakelab updates — fetch failed after retry (${GITNET_WHY})%f"
  [[ -n "$GITNET_OUT" ]] && print -r -- "$GITNET_OUT"
  return 1
}

# Warn when the clone has drifted from origin, and return non-zero when a requested
# pull failed so the caller aborts instead of rebuilding the code it replaced.
_nix_check_remote() {
  local _dir="${_repo}"
  if [[ -n "$(git -C "$_dir" status --porcelain 2>/dev/null)" ]]; then
    print -P "%F{yellow}⚠ ${_repo} has uncommitted changes%f"
  fi
  if ! _nix_fetch "$_dir"; then
    # An unverified tree is not a current one: fail closed.
    if [[ ! -t 0 ]]; then
      [[ "${FLAKELAB_STALE_OK:-}" == 1 ]] && return 0
      return 1
    fi
    local _reply=""
    read -k 1 "_reply?Rebuild anyway from the unverified tree? [y/N] "
    echo
    [[ "$_reply" == [yY] ]] || return 1
  fi
  local _local=$(git -C "$_dir" rev-parse HEAD)
  local _remote=$(git -C "$_dir" rev-parse @{u} 2>/dev/null) || return 0
  [[ "$_local" == "$_remote" ]] && return 0
  local _behind=$(git -C "$_dir" rev-list --count HEAD..@{u} 2>/dev/null)
  local _ahead=$(git -C "$_dir" rev-list --count @{u}..HEAD 2>/dev/null)
  if [[ "$_behind" -gt 0 && "$_ahead" -gt 0 ]]; then
    print -P "%F{yellow}⚠ repo has diverged (${_ahead} ahead, ${_behind} behind)%f"
    _nix_offer_pull || return 1
  elif [[ "$_behind" -gt 0 ]]; then
    print -P "%F{yellow}⚠ repo is ${_behind} commit(s) behind remote%f"
    _nix_offer_pull || return 1
  elif [[ "$_ahead" -gt 0 ]]; then
    print -P "%F{cyan}ℹ repo is ${_ahead} commit(s) ahead of remote (unpushed)%f"
  fi
}

# HEAD against the default branch: a feature branch in sync with its own upstream
# still misses what landed on the default branch, and rebuilding from it reverts
# that work here. Declaration and assignment stay separate, because `local x=$(cmd)`
# takes `local`'s status and `|| return` would never fire.
_nix_check_base() {
  local _dir="${_repo}" _default _head _behind _reply="" _out
  _default="$(git -C "$_dir" symbolic-ref --short -q refs/remotes/origin/HEAD 2>/dev/null)"
  _default="${_default#origin/}"
  if [[ -z "$_default" ]]; then
    print -P "%F{yellow}⚠ flakelab has no origin/HEAD — run 'git remote set-head origin -a'; skipping the default-branch check%f"
    return 0
  fi
  _head="$(git -C "$_dir" symbolic-ref --short -q HEAD 2>/dev/null)" || {
    print -P "%F{yellow}⚠ flakelab is on a detached HEAD — not compared against origin/${_default}%f"
    return 0
  }
  [[ "$_head" == "$_default" ]] && return 0
  # A stale origin/HEAD fails here rather than calling a behind branch current.
  if ! _behind="$(git -C "$_dir" rev-list --count "HEAD..origin/${_default}" 2>/dev/null)"; then
    print -P "%F{yellow}⚠ flakelab cannot be compared against origin/${_default} — run 'git remote set-head origin -a'%f"
    return 0
  fi
  (( _behind > 0 )) || return 0

  print -P "%F{yellow}⚠ flakelab is on ${_head}, ${_behind} commit(s) behind origin/${_default}%f"

  if [[ -n "$(git -C "$_dir" status --porcelain 2>/dev/null)" ]]; then
    print -P "%F{yellow}  uncommitted changes — not offering a rebase; commit or stash first%f"
    return 0
  fi
  if [[ ! -t 0 ]]; then
    print -P "%F{yellow}  no terminal to ask — rebuilding from it anyway; rebase with: git -C ${_dir} rebase origin/${_default}%f"
    return 0
  fi

  read -k 1 "_reply?Rebase onto origin/${_default} now? [y/N] "
  echo
  [[ "$_reply" == [yY] ]] || return 0
  if _out="$(git -C "$_dir" rebase "origin/${_default}" 2>&1)"; then
    print -P "%F{green}✓ rebased ${_head} onto origin/${_default}%f"
    return 0
  fi
  # Leave nothing half-applied for the next run to trip over.
  git -C "$_dir" rebase --abort 2>/dev/null || true
  print -P "%F{red}✗ rebase onto origin/${_default} conflicted — tree restored, refusing to rebuild from a branch behind ${_default}%f"
  print -r -- "$_out"
  return 1
}

# A switch overlapping the distro's own boot activation tears down the caller's
# session mid-run, so wait for the boot to settle: bounded, and never on
# `degraded`, which is a finished boot. systemctl must resolve from the caller's
# PATH, so it talks to the running systemd.
_nix_wait_boot() {
  [[ -n "${FLAKELAB_BOOT_OK:-}" ]] && return 0
  command -v systemctl > /dev/null 2>&1 || return 0
  local _unit="home-manager-${USER:-$(id -un)}.service" _limit="${FLAKELAB_BOOT_WAIT:-180}"
  local _state _hm _said=0 _deadline=$(( SECONDS + _limit ))
  while true; do
    _state="$(systemctl is-system-running 2> /dev/null)"
    _hm="$(systemctl is-active "${_unit}" 2> /dev/null)"
    if [[ "${_state}" != (initializing|starting) && "${_hm}" != (activating|reloading) ]]; then
      (( _said )) && print -P "%F{green}✓ boot activation finished%f"
      return 0
    fi
    if (( SECONDS >= _deadline )); then
      print -P "%F{red}✗ still booting after ${_limit}s (system: ${_state:-?}, ${_unit}: ${_hm:-?}) — refusing to switch into a running boot activation%f"
      print -P "%F{red}  inspect: systemctl status ${_unit}; retry once it settles, or set FLAKELAB_BOOT_OK=1 to switch anyway%f"
      return 1
    fi
    if (( ! _said )); then
      print -P "%F{yellow}⚠ the distro is still booting (system: ${_state:-?}, ${_unit}: ${_hm:-?}) — waiting up to ${_limit}s; a switch now would stop that activation and tear down this login session%f"
      _said=1
    fi
    sleep 2
  done
}
_nix_wait_boot || exit 1

# The overlay comes in three shapes, and the drift check applies to one of
# them. A plain directory is what `provision` wrote before the overlay became
# a repository, and what a hand-made overlay still is; a repository with no
# remote is what the generator leaves now; the proxmox-vm bootstrap clones
# from one with a remote. Nothing can be behind a remote that does not exist,
# so the first two get one line and the switch - not a fetch, which used to
# fail with "not a git repository", retry, and refuse the rebuild without a
# terminal, then advise `git remote set-head origin -a` on a repository that
# has no origin. Uncommitted changes are still worth a warning in a local
# repository: that is drift against its own history.
_nix_repo_shape() {
  if ! git -C "${_repo}" rev-parse --git-dir > /dev/null 2>&1; then
    print -P "%F{cyan}ℹ ${_repo} is not a git checkout — no drift check (git init it to get one)%f"
    return 1
  fi
  [[ -n "$(git -C "${_repo}" remote 2>/dev/null)" ]] && return 0
  if [[ -n "$(git -C "${_repo}" status --porcelain 2>/dev/null)" ]]; then
    print -P "%F{yellow}⚠ ${_repo} has uncommitted changes%f"
  fi
  print -P "%F{cyan}ℹ ${_repo} has no git remote — no drift check (add one to get it)%f"
  return 1
}

# Order matters: an accepted pull moves HEAD, which the next check measures.
if _nix_repo_shape; then
  _nix_check_remote || exit 1
  _nix_check_base || exit 1
fi

# A `path:` flakelab input is mutable but its lock entry is not, so without
# re-locking a `git pull` over there leaves this flake on the previous snapshot and
# the switch silently builds the old flakelab. `git+file:` is not re-lockable this
# way and is left alone. `nix eval` rather than jq: the wrapper's PATH has no jq.
_nix_relock_flakelab() {
  local _lock="${_repo}/flake.lock" _ty _out
  [[ -f "${_lock}" ]] || return 0
  _ty="$(FLAKELAB_LOCK="${_lock}" nix eval --raw --impure --expr '
    let
      l = builtins.fromJSON (builtins.readFile (builtins.getEnv "FLAKELAB_LOCK"));
      n = l.nodes.${l.root}.inputs.flakelab or null;
    in if n == null then "" else "${l.nodes.${n}.locked.type or ""} ${l.nodes.${n}.locked.path or ""}"
  ' 2>/dev/null)"
  local _where="${_ty#* }"; _ty="${_ty%% *}"
  # git+file: serves committed content only, so the edit under test may be absent.
  if [[ "${_ty}" == git+file ]]; then
    print -P "%F{yellow}⚠ LOCAL flakelab (git+file: ${_where}) — only committed content is in this build%f"
    return 0
  fi
  [[ -n "${_ty}" ]] || return 0
  # Unprivileged: a root-written lock on the 9p mount breaks the operator's next
  # `nix` command with "opening file flake.lock: Permission denied".
  if _out="$(nix flake update flakelab --flake "path:$(_url_path "${_repo}")" 2>&1)"; then
    if [[ "${_ty}" == path ]]; then
      print -P "%F{yellow}⚠ LOCAL flakelab: ${_where} — overrides the published repo (re-locked)%f"
    else
      print -P "%F{cyan}ℹ flakelab input updated%f"
    fi
  else
    print -P "%F{yellow}⚠ could not re-lock the path: flakelab input — the switch may evaluate the previously locked snapshot%f"
    print -r -- "${_out}"
  fi
}
_nix_relock_flakelab

# `path:`, not a bare path: a bare path resolves as `git+file:`, which sees only
# tracked files, so it finds no lock, rewrites one as root, and the operator's next
# unprivileged `nix` command in that checkout dies on a permission error.
# sudo and nixos-rebuild resolve from the caller's PATH, so the rebuild uses the
# running system's nixos-rebuild. Only the path is encoded: the `#` after it is the
# flake URL's fragment. `exit $?`, so nixos-rebuild's own codes reach the caller.
sudo nixos-rebuild switch --flake "path:$(_url_path "${_repo}")#${FLAKELAB_FLAKE_ATTR:-default}" || exit $?

# The activation that does this only re-runs when the built config changed, while
# the marketplace clone is runtime data, so replay it after every switch. Failures
# warn only: the switch itself succeeded.
_claude_marketplaces="$HOME/.claude/plugins/marketplaces"
if command -v claude > /dev/null 2>&1 && [ -d "${_claude_marketplaces}" ]; then
  for _m in "${_claude_marketplaces}"/*(N/); do
    claude plugin marketplace update "${_m:t}" > /dev/null 2>&1 \
      || print -P "%F{yellow}⚠ claude marketplace ${_m:t} not refreshed (offline, or no agent key) — the permissions merge below uses its last fetch%f"
  done
  # `plugin install` is a no-op on an installed plugin, so a merged bump would stay
  # on its installed version; only plugins whose fetched version differs are updated,
  # which is readable only for marketplace-tree sources. </dev/null bounds the
  # confirmation prompt an install command would raise, so it warns instead of hanging.
  _installed="$HOME/.claude/plugins/installed_plugins.json"
  if [ -f "${_installed}" ] && command -v jq > /dev/null 2>&1; then
    for _m in "${_claude_marketplaces}"/*(N/); do
      [ -f "${_m}/.claude-plugin/marketplace.json" ] || continue
      jq -r '.plugins[] | select(.source | type == "string" and startswith("./")) | "\(.name) \(.source)"' \
        "${_m}/.claude-plugin/marketplace.json" 2> /dev/null | while read -r _name _src; do
        _key="${_name}@${_m:t}"
        _have="$(jq -r --arg k "${_key}" '.plugins[$k][0].version // empty' "${_installed}" 2> /dev/null)"
        _want="$(jq -r '.version // empty' "${_m}/${_src}/.claude-plugin/plugin.json" 2> /dev/null)"
        { [ -n "${_have}" ] && [ -n "${_want}" ] && [ "${_have}" != "${_want}" ]; } || continue
        claude plugin update "${_key}" < /dev/null > /dev/null 2>&1 \
          || print -P "%F{yellow}⚠ claude plugin ${_key} not updated; it stays on ${_have} (marketplace has ${_want})%f"
      done
    done
  fi
  _settings="$HOME/.claude/settings.json"
  _recommended="$(find "${_claude_marketplaces}" -type f -name recommended-permissions.json 2> /dev/null | head -1)"
  if [ -n "${_recommended}" ] && [ -f "${_settings}" ] && command -v jq > /dev/null 2>&1; then
    _tmp="$(mktemp)"
    # Additive on permissions.allow, so nothing added by hand is removed here.
    if jq -s '.[0] * {permissions: {allow: ((.[0].permissions.allow // []) + .[1] | unique)}}' \
         "${_settings}" "${_recommended}" > "${_tmp}" 2> /dev/null && [ -s "${_tmp}" ]; then
      mv "${_tmp}" "${_settings}"
    else
      print -P "%F{yellow}⚠ Claude pre-approved permissions not merged into settings.json%f"
    fi
    rm -f "${_tmp}"
  fi
fi

(( _run_clone )) || exit 0

if ! command -v nix-clone-repos > /dev/null 2>&1; then
  print -P "%F{red}✗ --all: nix-clone-repos is not on PATH — the switch succeeded, the clone sweep did not run%f"
  exit 1
fi
nix-clone-repos
