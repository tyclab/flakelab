# Runtime secrets for a flakelab box. Copy to ~/.config/flakelab/secrets.env and fill it
# in from your secret store. That path is NOT in the repo and NOT in the Nix
# store; nix/home/zsh.nix sources it at zsh start (`set -a`) so every wired MCP
# server inherits it.
#
# `flakelab backup` does copy this file into the payload beside the overlay
# (<overlay>-payload/shared/secrets/secrets.env, 0600) so it survives a distro
# rebuild. That copy is cleartext on an unencrypted Windows mount — rotate every
# token below if the mount or the payload is ever exposed.
#
#   mkdir -p ~/.config/flakelab
#   cp files/config/secrets.env.example ~/.config/flakelab/secrets.env
#   chmod 600 ~/.config/flakelab/secrets.env
#
# PLACEHOLDERS ONLY — never commit real values. The non-secret counterparts
# (HASS_URL, PROXMOX_API_URL, GRAFANA_URL,
# WHATSAPP_BRIDGE_HOST) belong in the overlay's sessionVariables instead.

# Git forges — GITLAB_TOKEN also drives `flakelab clone` group discovery.
GITLAB_TOKEN=""
GH_TOKEN=""

# Home Assistant (long-lived access token); mapped to HA_TOKEN for the plugins.
HASS_TOKEN=""

# Proxmox VE API token, split id/secret: a dedicated read-only, privsep, expiring
# token (never a root@pam one), minted by the IaC that owns the cluster and
# banked in the vault the box reads.
PROXMOX_TOKEN_ID=""
PROXMOX_TOKEN_SECRET=""

# Grafana service-account token (Viewer + datasources:query is enough for read).
GRAFANA_SERVICE_ACCOUNT_TOKEN=""

# `flakelab notify` (flakelab.notify.enable and Codex's notify hook), read at use
# time; set either target or both. ntfy: the topic URL and, for a protected
# topic, an access token. A JSON webhook, e.g. Home Assistant's
# https://ha.example.com/api/webhook/<id>: the id is the secret. Under sops, set
# sopsKeyFiles.NOTIFY_WEBHOOK_URL = null: notify reads it from the render, so the
# shell need not export it to every process.
NTFY_URL=""
NTFY_TOKEN=""
NOTIFY_WEBHOOK_URL=""
