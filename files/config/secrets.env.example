# Runtime secrets for a flakelab box. Copy to ~/.config/tyc/secrets.env and fill in
# from OpenBao (`bao kv get …`). That path is NOT in the repo and NOT in the Nix
# store; nix/home/zsh.nix sources it at zsh start (`set -a`) so every wired MCP
# server inherits it.
#
# `nix-backup` does copy this file into the overlay checkout at
# files/config/shared/secrets/secrets.env (gitignored, 0600) so it survives a
# distro rebuild. That copy is cleartext on an unencrypted Windows mount — rotate
# every token below if the mount or the checkout is ever exposed.
#
#   mkdir -p ~/.config/tyc
#   cp files/config/secrets.env.example ~/.config/tyc/secrets.env
#   chmod 600 ~/.config/tyc/secrets.env
#
# PLACEHOLDERS ONLY — never commit real values. The non-secret counterparts
# (HASS_URL, PROXMOX_API_URL, SYNOLOGY_HOST/PORT/HTTPS/USERNAME, GRAFANA_URL,
# WHATSAPP_BRIDGE_HOST) belong in the overlay's sessionVariables instead.

# Git forges — GITLAB_TOKEN also drives nix-clone-repos group discovery.
GITLAB_TOKEN=""
GH_TOKEN=""

# Home Assistant (long-lived access token); mapped to HA_TOKEN for the plugins.
HASS_TOKEN=""

# Proxmox VE API token, split id/secret.
PROXMOX_TOKEN_ID=""
PROXMOX_TOKEN_SECRET=""

# Synology DSM. DEVICE_ID is the trusted-device binding that skips 2FA prompts;
# leave empty if the account has no 2FA.
SYNOLOGY_PASSWORD=""
SYNOLOGY_DEVICE_ID=""

# Grafana service-account token (Viewer + datasources:query is enough for read).
GRAFANA_SERVICE_ACCOUNT_TOKEN=""
