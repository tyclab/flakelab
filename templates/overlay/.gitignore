# No key material or secrets in git; `flakelab update` and the generators also measure a first commit against this.
id_*
!id_*.pub
*.pem
secrets.env
.env
.env.*
files/config/user_data.yaml
.claude/settings.local.json

# A committed lock pins a local flakelab checkout's NAR hash and the next change there aborts with "NAR hash mismatch".
flake.lock

# Old payload layout: kept so an overlay not yet moved to <overlay>-payload cannot commit them.
files/config/instances/
files/config/shared/
files/config/snapshots/
files/config/.backup.lock
files/config/.last-restore-kept

.migrated-from-wslkube

result
result-*
